<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="@dimen/auto_dimen2_8" android:topRightRadius="@dimen/auto_dimen2_8" />
            <solid android:color="@color/custom_normal_day_color_pressed_denza" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="@dimen/auto_dimen2_8" android:topRightRadius="@dimen/auto_dimen2_8" />
            <solid android:color="@color/custom_normal_day_color_disabled_denza" />
        </shape>
    </item>
    <item android:state_enabled="true">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="@dimen/auto_dimen2_8" android:topRightRadius="@dimen/auto_dimen2_8" />
            <solid android:color="@color/transparent_color" />
        </shape>
    </item>
</selector>
