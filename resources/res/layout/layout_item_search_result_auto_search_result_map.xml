<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_search_result"
    android:paddingLeft="@dimen/auto_dimen2_24"
    android:paddingRight="@dimen/auto_dimen2_24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/auto_dimen2_80"
    android:paddingHorizontal="@dimen/auto_dimen2_24"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/search_result_icon_text_color_day_selector"
        android:gravity="center"
        android:id="@+id/siv_icon"
        android:layout_width="@dimen/auto_dimen2_24"
        android:layout_height="@dimen/auto_dimen2_32"
        app:layout_constraintBottom_toTopOf="@+id/ct_search_child_station"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/space_content1"
        app:textColor4Night="@color/search_result_icon_text_color_night_selector"
        app:textColor4Skin="@color/search_result_icon_text_color_day_selector"/>
    <com.autonavi.skin.view.SkinImageFilterView
        android:id="@+id/ifv_search_result_img"
        android:background="@drawable/search_item_photo_default_day"
        android:visibility="gone"
        android:layout_width="@dimen/auto_dimen2_56"
        android:layout_height="@dimen/auto_dimen2_56"
        android:scaleType="centerCrop"
        android:layout_marginStart="@dimen/sys_padding_m"
        app:background4Night="@drawable/search_item_photo_default_night"
        app:background4Skin="@drawable/search_item_photo_default_day"
        app:layout_constraintBottom_toBottomOf="@+id/siv_icon"
        app:layout_constraintStart_toEndOf="@+id/siv_icon"
        app:layout_constraintTop_toTopOf="@+id/siv_icon"
        app:round="@dimen/auto_dimen2_6"/>
    <Space
        android:id="@+id/space_content1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/auto_dimen2_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_20"
        android:textColor="@color/byd_search_text_day"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/stv_text_title_search_result"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/auto_dimen2_25"
        android:text="@string/auto_search_result_map_text_title_search_result"
        android:maxLines="1"
        android:lineSpacingExtra="@dimen/auto_dimen2_5"
        android:layout_marginStart="@dimen/sys_padding_m"
        android:layout_marginEnd="@dimen/sys_padding_l"
        app:layout_constraintBottom_toTopOf="@+id/stv_distance_search_result_textview"
        app:layout_constraintEnd_toStartOf="@+id/layout_operate"
        app:layout_constraintStart_toEndOf="@+id/ifv_search_result_img"
        app:layout_constraintTop_toBottomOf="@+id/space_content1"
        app:layout_goneMarginEnd="@dimen/auto_dimen2_96"
        app:textColor4Night="@color/auto_search_main_text_color_selector"
        app:textColor4Skin="@color/byd_search_text_day"/>
    <include
        android:id="@+id/layout_operate"
        android:layout_width="@dimen/auto_dimen2_120"
        android:layout_height="@dimen/auto_dimen2_48"
        app:layout_constraintBottom_toBottomOf="@+id/stv_distance_search_result_textview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/stv_text_title_search_result"
        layout="@layout/layout_operate_goto_navi"/>
    <include
        android:id="@+id/layout_distance"
        android:visibility="gone"
        android:layout_width="@dimen/auto_dimen2_120"
        android:layout_height="@dimen/auto_dimen2_40"
        app:layout_constraintBottom_toBottomOf="@+id/stv_distance_search_result_textview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/stv_text_title_search_result"
        layout="@layout/layout_distance_text"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/byd_search_home_item_sub_tip_day"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/stv_distance_search_result_textview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_6"
        android:minHeight="@dimen/auto_dimen2_24"
        android:text="@string/auto_search_result_map_distance_search_result_textview"
        android:singleLine="true"
        android:lineSpacingExtra="@dimen/auto_dimen2_4"
        android:layout_marginEnd="@dimen/sys_padding_l"
        app:layout_constraintBottom_toTopOf="@+id/space_center_content"
        app:layout_constraintEnd_toStartOf="@+id/layout_operate"
        app:layout_constraintStart_toEndOf="@+id/cl_charging_price_container"
        app:layout_constraintTop_toBottomOf="@+id/stv_text_title_search_result"
        app:layout_goneMarginEnd="@dimen/auto_dimen2_96"
        app:textColor4Night="@color/byd_search_home_item_sub_tip_night"
        app:textColor4Skin="@color/byd_search_home_item_sub_tip_day"/>
    <include
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/cl_charging_price_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/auto_dimen2_24"
        app:layout_constraintBottom_toBottomOf="@+id/stv_distance_search_result_textview"
        app:layout_constraintStart_toEndOf="@+id/stv_parking_poi_tag"
        app:layout_constraintTop_toTopOf="@+id/stv_distance_search_result_textview"
        layout="@layout/layout_charge_price_container"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/byd_search_home_item_sub_tip_day"
        android:gravity="start|center_vertical"
        android:id="@+id/stv_parking_poi_tag"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="@dimen/auto_dimen2_6"
        android:paddingEnd="@dimen/auto_dimen2_8"
        app:layout_constraintBottom_toBottomOf="@+id/stv_distance_search_result_textview"
        app:layout_constraintStart_toStartOf="@+id/stv_text_title_search_result"
        app:layout_constraintTop_toTopOf="@+id/stv_distance_search_result_textview"
        app:textColor4Night="@color/byd_search_home_item_sub_tip_night"
        app:textColor4Skin="@color/byd_search_home_item_sub_tip_day"/>
    <View
        android:id="@+id/space_center_content"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/auto_dimen2_24"
        android:layout_marginTop="@dimen/auto_dimen2_2"
        app:layout_constraintBottom_toTopOf="@+id/cl_head_container"
        app:layout_constraintEnd_toEndOf="@+id/layout_operate"
        app:layout_constraintStart_toStartOf="@+id/stv_text_title_search_result"
        app:layout_constraintTop_toBottomOf="@+id/stv_distance_search_result_textview"/>
    <com.autonavi.adapter.container.ACChargingInfoIndexView
        android:gravity="center_vertical"
        android:id="@+id/cl_charging_detail"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:interface_key="charging_info"
        app:layout_constraintBottom_toBottomOf="@+id/space_center_content"
        app:layout_constraintStart_toStartOf="@+id/stv_text_title_search_result"
        app:layout_constraintTop_toTopOf="@+id/space_center_content"/>
    <include
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/cl_star_rating_container"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/auto_dimen2_24"
        app:layout_constraintBottom_toBottomOf="@+id/space_center_content"
        app:layout_constraintStart_toStartOf="@+id/stv_text_title_search_result"
        app:layout_constraintTop_toTopOf="@+id/space_center_content"
        layout="@layout/layout_star_rating_container"/>
    <com.autonavi.skin.view.SkinLinearLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:id="@+id/cl_head_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/auto_dimen2_10"
        app:layout_constraintBottom_toTopOf="@+id/cl_business_hours"
        app:layout_constraintEnd_toEndOf="@+id/layout_operate"
        app:layout_constraintStart_toStartOf="@+id/stv_text_title_search_result"
        app:layout_constraintTop_toBottomOf="@+id/space_center_content">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_12"
            android:textColor="@color/byd_search_home_item_sub_tip_day"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/stv_text_hot_spot"
            android:background="@drawable/item_featured_label_background_day"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/auto_dimen2_20"
            android:layout_marginTop="@dimen/auto_dimen2_4"
            android:layout_marginBottom="@dimen/auto_dimen2_2"
            android:text=""
            android:singleLine="true"
            android:paddingStart="@dimen/auto_dimen2_8"
            android:paddingEnd="@dimen/auto_dimen2_8"
            android:layout_marginEnd="@dimen/auto_dimen2_12"
            app:background4Night="@drawable/item_featured_label_background_night"
            app:background4Skin="@drawable/item_featured_label_background_day"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/byd_search_home_item_sub_tip_night"
            app:textColor4Skin="@color/byd_search_home_item_sub_tip_day"/>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/rv_search_result_featured_label"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_4"
            android:layout_marginBottom="@dimen/auto_dimen2_2"
            android:layout_centerHorizontal="true"
            android:overScrollMode="never"/>
    </com.autonavi.skin.view.SkinLinearLayout>
    <com.autonavi.skin.view.SkinLinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/cl_business_hours"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_24"
        android:layout_marginTop="@dimen/sys_padding_xs"
        android:layout_marginEnd="@dimen/sys_padding_l"
        app:layout_constraintBottom_toTopOf="@+id/ct_search_child_station"
        app:layout_constraintEnd_toStartOf="@+id/layout_operate"
        app:layout_constraintStart_toStartOf="@+id/stv_text_title_search_result"
        app:layout_constraintTop_toBottomOf="@+id/cl_head_container">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_12"
            android:textColor="@color/search_label_open_status_text_day_selector"
            android:gravity="center"
            android:id="@+id/stv_text_rest"
            android:background="@drawable/search_label_open_status_bg_day_selector"
            android:paddingTop="@dimen/auto_dimen2_2"
            android:paddingBottom="@dimen/auto_dimen2_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_search_result_map_text_rest"
            android:paddingStart="@dimen/auto_dimen2_6"
            android:paddingEnd="@dimen/auto_dimen2_6"
            android:layout_marginEnd="@dimen/auto_dimen2_8"
            app:background4Night="@drawable/search_label_open_status_bg_night_selector"
            app:background4Skin="@drawable/search_label_open_status_bg_day_selector"
            app:textColor4Night="@color/search_label_open_status_text_night_selector"
            app:textColor4Skin="@color/search_label_open_status_text_day_selector"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_14"
            android:textColor="@color/byd_search_text_day_85"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/stv_search_cmsinfo"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/auto_search_result_map_search_cmsinfo"
            android:singleLine="true"
            android:lineSpacingExtra="@dimen/auto_dimen2_1"
            app:textColor4Night="@color/sys_color_default_dark"
            app:textColor4Skin="@color/byd_search_text_day_85"/>
    </com.autonavi.skin.view.SkinLinearLayout>
    <com.autonavi.skin.view.SkinLinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/sll_parking_info_layout"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_24"
        android:layout_marginEnd="@dimen/sys_padding_m"
        app:layout_constraintBottom_toBottomOf="@+id/space_center_content"
        app:layout_constraintEnd_toStartOf="@+id/layout_operate"
        app:layout_constraintStart_toEndOf="@+id/ct_search_gasinfo"
        app:layout_constraintTop_toTopOf="@+id/space_center_content">
        <com.autonavi.adapter.container.ACParkingInfoIndexView
            android:id="@+id/ac_parking_info"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/auto_dimen2_24"
            android:paddingEnd="@dimen/sys_padding_l"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_12"
            android:textColor="@color/byd_search_home_item_sub_tip_day"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/stv_search_priceinfo"
            android:background="@drawable/item_featured_label_background_day"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/auto_dimen2_20"
            android:singleLine="true"
            android:paddingStart="@dimen/auto_dimen2_8"
            android:paddingEnd="@dimen/auto_dimen2_8"
            android:layout_marginEnd="@dimen/auto_dimen2_12"
            app:background4Night="@drawable/item_featured_label_background_night"
            app:background4Skin="@drawable/item_featured_label_background_day"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/byd_search_home_item_sub_tip_night"
            app:textColor4Skin="@color/byd_search_home_item_sub_tip_day"/>
    </com.autonavi.skin.view.SkinLinearLayout>
    <com.autonavi.view.custom.CustomFlowLayout
        android:orientation="vertical"
        android:id="@+id/ct_search_gasinfo"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/auto_dimen2_16"
        app:itemSpacing="@dimen/auto_dimen2_16"
        app:layout_constraintBottom_toBottomOf="@+id/space_center_content"
        app:layout_constraintStart_toStartOf="@+id/stv_text_title_search_result"
        app:layout_constraintTop_toTopOf="@+id/space_center_content"
        app:lineSpacing="@dimen/auto_dimen2_8"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ct_search_parkinfo"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_16"
        android:layout_marginEnd="@dimen/auto_dimen2_22"
        app:layout_constraintBottom_toTopOf="@+id/ct_search_roadstat"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/stv_search_priceinfo"
        app:layout_constraintTop_toBottomOf="@+id/ct_search_gasinfo"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ct_search_roadstat"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_11"
        android:layout_marginStart="@dimen/auto_dimen2_32"
        android:layout_marginEnd="@dimen/auto_dimen2_45"
        app:layout_constraintBottom_toTopOf="@+id/ct_search_child_station"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/ct_search_gasinfo"
        app:layout_constraintTop_toBottomOf="@+id/ct_search_parkinfo"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ct_search_child_station"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/space_content2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/stv_text_title_search_result"
        app:layout_constraintTop_toBottomOf="@+id/cl_business_hours"/>
    <Space
        android:id="@+id/space_content2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/auto_dimen2_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</com.autonavi.skin.view.SkinConstraintLayout>
