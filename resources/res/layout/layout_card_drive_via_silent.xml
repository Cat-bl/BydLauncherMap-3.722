<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_auto_navi_info_panel_via"
    android:layout_width="match_parent"
    android:layout_height="@dimen/auto_dimen2_174"
    android:minHeight="@dimen/auto_dimen2_174"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinView
        android:background="@drawable/custom_normal_card_bg_day"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:background4Night="@drawable/custom_normal_card_bg_night"
        app:background4Skin="@drawable/custom_normal_card_bg_day"
        app:layout_constraintBottom_toBottomOf="@+id/cl_auto_navi_info_panel_via"
        app:layout_constraintEnd_toEndOf="@+id/cl_auto_navi_info_panel_via"
        app:layout_constraintStart_toStartOf="@+id/cl_auto_navi_info_panel_via"
        app:layout_constraintTop_toTopOf="@+id/cl_auto_navi_info_panel_via"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_waypoint"
        android:background="@drawable/auto_navi_drive_icon_via_point"
        android:layout_width="@dimen/auto_dimen2_24"
        android:layout_height="@dimen/auto_dimen2_24"
        android:layout_marginTop="@dimen/auto_dimen2_20"
        android:layout_marginStart="@dimen/auto_dimen2_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_20"
        android:textColor="@color/navi_card_title_color_day"
        android:gravity="center"
        android:id="@+id/stv_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_navi_text_waypoint_heading"
        android:singleLine="true"
        android:layout_marginStart="@dimen/auto_dimen2_8"
        app:layout_constraintBottom_toBottomOf="@+id/siv_waypoint"
        app:layout_constraintStart_toEndOf="@+id/siv_waypoint"
        app:layout_constraintTop_toTopOf="@+id/siv_waypoint"
        app:textColor4Night="@color/navi_card_title_color_night"
        app:textColor4Skin="@color/navi_card_title_color_day"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/navi_card_subtitle_color_day"
        android:ellipsize="end"
        android:gravity="top|left"
        android:id="@+id/stv_text_location_waypoint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/auto_dimen2_16"
        android:text="@string/gas_warning_advise"
        android:maxLines="2"
        android:lineSpacingMultiplier="0.8"
        app:layout_constraintBottom_toTopOf="@+id/button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/siv_waypoint"
        app:layout_constraintTop_toBottomOf="@+id/siv_waypoint"
        app:textColor4Night="@color/navi_card_subtitle_color_night"
        app:textColor4Skin="@color/navi_card_subtitle_color_day"/>
    <com.autonavi.skin.view.SkinLinearLayout
        android:id="@+id/button"
        android:paddingBottom="@dimen/auto_dimen2_26"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.autonavi.skin.view.SkinConstraintLayout
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/auto_dimen2_24"
            android:layout_marginRight="@dimen/auto_dimen2_12"
            android:layout_weight="1">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/byd_custom_highlight_btn_text_color_selector_day"
                android:gravity="center"
                android:id="@+id/stv_text_arrived"
                android:background="@drawable/byd_custom_highlight_btn_bg_selector_day"
                android:layout_width="0dp"
                android:layout_height="@dimen/auto_dimen2_40"
                android:maxWidth="@dimen/auto_dimen2_144"
                android:text="@string/auto_navi_text_waypoint_delete"
                app:background4Night="@drawable/byd_custom_highlight_btn_bg_selector_night"
                app:background4Skin="@drawable/byd_custom_highlight_btn_bg_selector_day"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.7"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"
                app:tag="DisableAtRunTime"
                app:textColor4Night="@color/byd_custom_highlight_btn_text_color_selector_night"
                app:textColor4Skin="@color/byd_custom_highlight_btn_text_color_selector_day"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/auto_dimen2_12"
            android:layout_marginRight="@dimen/auto_dimen2_24"
            android:layout_weight="1">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/byd_custom_normal_btn_text_color_selector_day"
                android:gravity="center"
                android:id="@+id/stv_text_delete"
                android:background="@drawable/byd_custom_normal_btn_bg_selector_day"
                android:layout_width="0dp"
                android:layout_height="@dimen/auto_dimen2_40"
                android:maxWidth="@dimen/auto_dimen2_144"
                android:text="@string/auto_navi_text_ignore"
                app:background4Night="@drawable/byd_custom_normal_btn_bg_selector_night"
                app:background4Skin="@drawable/byd_custom_normal_btn_bg_selector_day"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"
                app:tag="DisableAtRunTime"
                app:textColor4Night="@color/byd_custom_normal_btn_text_color_selector_night"
                app:textColor4Skin="@color/byd_custom_normal_btn_text_color_selector_day"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
    </com.autonavi.skin.view.SkinLinearLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
