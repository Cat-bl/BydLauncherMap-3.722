<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="2dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.autonavi.skin.view.SkinConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/wel_layout"
        android:background="@drawable/talk_message_text_day_denza"
        android:paddingLeft="@dimen/auto_dimen2_5"
        android:paddingRight="@dimen/auto_dimen2_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/auto_dimen2_55"
        app:background4Night="@drawable/talk_message_text_night_denza"
        app:background4Skin="@drawable/talk_message_text_day_denza">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_18"
            android:textColor="@color/auto_color_message_text_color_day"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/wel_name"
            android:paddingLeft="@dimen/auto_dimen2_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/auto_dimen2_2"
            android:text="我"
            android:maxEms="3"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/bt_team_voice_talk_item"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/auto_color_message_text_color_night"
            app:textColor4Skin="@color/auto_color_message_text_color_day"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_18"
            android:textColor="@color/auto_color_message_text_color_day"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/wel_content"
            android:paddingRight="@dimen/auto_dimen2_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/auto_dimen2_10"
            android:text="@string/user_team_team_member_welcome"
            android:maxLines="3"
            android:maxEms="12"
            android:layout_marginStart="@dimen/auto_dimen2_2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/wel_name"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/auto_color_message_text_color_night"
            app:textColor4Skin="@color/auto_color_message_text_color_day"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/message_layout"
        android:paddingRight="@dimen/auto_dimen2_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.autonavi.skin.view.SkinConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/message_layout_voice"
            android:background="@drawable/talk_message_voice_day_denza"
            android:padding="@dimen/auto_dimen2_5"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/auto_dimen2_58"
            android:maxWidth="@dimen/auto_dimen2_260"
            android:minWidth="@dimen/auto_dimen2_120"
            app:background4Night="@drawable/talk_message_voice_night_denza"
            app:background4Skin="@drawable/talk_message_voice_day_denza">
            <com.autonavi.view.custom.CustomCircleImageView
                android:gravity="center"
                android:id="@+id/bt_team_voice_talk_item"
                android:layout_width="@dimen/auto_dimen2_34"
                android:layout_height="@dimen/auto_dimen2_34"
                android:src="@drawable/icon_user_default_head_180"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/auto_dimen2_4"
                app:civ_border_color="@color/custom_text_day_color_05_denza"
                app:civ_border_color_day="@color/custom_text_day_color_05_denza"
                app:civ_border_color_night="@color/auto_color_86909B"
                app:civ_border_width="@dimen/auto_dimen2_1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.35"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/auto_color_message_text_color_day"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/message_name"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/auto_dimen2_40"
                android:layout_marginLeft="@dimen/auto_dimen2_12"
                android:text="me"
                android:maxEms="3"
                android:singleLine="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/bt_team_voice_talk_item"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5"
                app:textColor4Night="@color/auto_color_message_text_color_night"
                app:textColor4Skin="@color/auto_color_message_text_color_day"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/auto_color_message_text_color_day"
                android:gravity="center_vertical"
                android:id="@+id/left_colon"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/auto_dimen2_40"
                android:layout_marginLeft="@dimen/auto_dimen2_2"
                android:text=":"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/message_name"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5"
                app:textColor4Night="@color/auto_color_message_text_color_night"
                app:textColor4Skin="@color/auto_color_message_text_color_day"/>
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/ivAnim"
                android:background="@drawable/anim_voice_day"
                android:padding="@dimen/auto_dimen2_2"
                android:layout_width="@dimen/auto_dimen2_40"
                android:layout_height="@dimen/auto_dimen2_38"
                android:layout_marginStart="4dp"
                app:background4Night="@drawable/anim_voice_night"
                app:background4Skin="@drawable/anim_voice_day"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/left_colon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.4"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/auto_color_message_text_color_day"
                android:gravity="center_vertical"
                android:id="@+id/textView_time"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/auto_dimen2_40"
                android:text=" 2&apos;&apos;"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.926"
                app:layout_constraintStart_toEndOf="@+id/ivAnim"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5"
                app:textColor4Night="@color/auto_color_message_text_color_night"
                app:textColor4Skin="@color/auto_color_message_text_color_day"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinTextView
            android:id="@+id/circle_red"
            android:background="@drawable/message_red_small_circle"
            android:layout_width="@dimen/auto_dimen2_8"
            android:layout_height="@dimen/auto_dimen2_8"
            android:layout_marginTop="@dimen/auto_dimen2_5"
            android:layout_marginRight="@dimen/auto_dimen2_4"
            android:layout_marginStart="@dimen/auto_dimen2_4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/message_layout_voice"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/message_layout_text"
        android:background="@drawable/talk_message_text_day_denza"
        android:paddingLeft="@dimen/auto_dimen2_5"
        android:paddingRight="@dimen/auto_dimen2_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/auto_dimen2_36"
        app:background4Night="@drawable/talk_message_text_night_denza"
        app:background4Skin="@drawable/talk_message_text_day_denza">
        <com.autonavi.view.custom.CustomCircleImageView
            android:gravity="top"
            android:id="@+id/bt_team_voice_talk_item_text"
            android:layout_width="@dimen/auto_dimen2_34"
            android:layout_height="@dimen/auto_dimen2_34"
            android:src="@drawable/icon_user_default_head_180"
            android:layout_marginStart="@dimen/auto_dimen2_4"
            app:civ_border_color="@color/auto_color_ffffff"
            app:civ_border_color_day="@color/auto_color_ffffff"
            app:civ_border_color_night="@color/auto_color_86909B"
            app:civ_border_width="@dimen/auto_dimen2_1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.08"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_18"
            android:textColor="@color/auto_color_message_text_color_day"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/textView_content_text"
            android:paddingRight="@dimen/auto_dimen2_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/auto_dimen2_12"
            android:text="fgdrdsjfeeowfeoiwjefewiofewjfwAJEIAWJFI"
            android:maxLines="3"
            android:maxEms="8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/bt_team_voice_talk_item_text"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5"
            app:textColor4Night="@color/auto_color_message_text_color_night"
            app:textColor4Skin="@color/auto_color_message_text_color_day"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</LinearLayout>
