<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_circle_home_btn"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.view.custom.CustomBtnMoreView
        android:id="@+id/cbm_home_left"
        android:layout_width="@dimen/auto_dimen2_80"
        android:layout_height="@dimen/auto_dimen2_80"
        android:layout_marginLeft="@dimen/auto_dimen2_6"
        android:layout_marginTop="@dimen/auto_dimen2_3"
        android:layout_marginRight="@dimen/auto_dimen2_6"
        android:layout_marginBottom="@dimen/auto_dimen2_9"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shadowColor="@color/auto_ui_000000_33"
        app:shadowColorNight="@color/auto_ui_000000_33"
        app:shadowCorner="@dimen/auto_dimen2_40"
        app:shadowCornerBottomLeft="@dimen/auto_dimen2_0"
        app:shadowCornerBottomRight="@dimen/auto_dimen2_0"
        app:shadowCornerTopLeft="@dimen/auto_dimen2_0"
        app:shadowCornerTopRight="@dimen/auto_dimen2_0"
        app:shadowDx="@dimen/auto_dimen2_0"
        app:shadowDy="@dimen/auto_dimen2_3"
        app:shadowRadius="@dimen/auto_dimen2_6"
        app:shadowShapeType="rectangle"
        app:shadowSide="all"
        app:shadowVisibility="true"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_home1"
        android:background="@drawable/index_home1_day"
        android:layout_width="@dimen/auto_dimen2_40"
        android:layout_height="@dimen/auto_dimen2_40"
        app:background4Night="@drawable/index_home1_night"
        app:background4Skin="@drawable/index_home1_day"
        app:layout_constraintBottom_toBottomOf="@+id/cbm_home_left"
        app:layout_constraintEnd_toEndOf="@+id/cbm_home_left"
        app:layout_constraintStart_toStartOf="@+id/cbm_home_left"
        app:layout_constraintTop_toTopOf="@+id/cbm_home_left"/>
</com.autonavi.skin.view.SkinConstraintLayout>
