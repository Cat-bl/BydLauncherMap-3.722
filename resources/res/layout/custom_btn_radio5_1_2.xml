<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_custom_btn_radio2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_bg"
        android:background="@drawable/custom_btn_radio2_bg_day_bg_selector"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:background4Night="@drawable/custom_btn_radio4_bg_night_bg_selector"
        app:background4Skin="@drawable/custom_btn_radio2_bg_day_bg_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_animation"
        android:background="@drawable/custom_btn_radio2_animation_day_bg_selector"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/auto_dimen2_1"
        app:background4Night="@drawable/custom_btn_radio2_animation_night_bg_selector"
        app:background4Skin="@drawable/custom_btn_radio2_animation_day_bg_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/stv_radio1"
        app:layout_constraintStart_toStartOf="@+id/stv_radio1"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_20"
        android:textColor="@color/byd_text_450_4_textcolor_day_selector"
        android:gravity="center"
        android:id="@+id/stv_radio1"
        android:background="@drawable/custom_btn_radio2_radio1_day_bg_selector"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/custom_btn_radio5_radio1"
        app:background4Night="@drawable/custom_btn_radio2_radio1_night_bg_selector"
        app:background4Skin="@drawable/custom_btn_radio2_radio1_day_bg_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/stv_radio2"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintHorizontal_weight="160"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/byd_text_450_4_textcolor_night_selector"
        app:textColor4Skin="@color/byd_text_450_4_textcolor_day_selector"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_20"
        android:textColor="@color/byd_text_450_4_textcolor_day_selector"
        android:gravity="center"
        android:id="@+id/stv_radio2"
        android:background="@drawable/custom_btn_radio2_radio2_day_bg_selector"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/custom_btn_radio5_radio2"
        app:background4Night="@drawable/custom_btn_radio2_radio1_night_bg_selector"
        app:background4Skin="@drawable/custom_btn_radio2_radio1_day_bg_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/stv_radio3"
        app:layout_constraintHorizontal_weight="160"
        app:layout_constraintStart_toEndOf="@+id/stv_radio1"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/byd_text_450_4_textcolor_night_selector"
        app:textColor4Skin="@color/byd_text_450_4_textcolor_day_selector"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_20"
        android:textColor="@color/byd_text_450_4_textcolor_day_selector"
        android:gravity="center"
        android:id="@+id/stv_radio3"
        android:background="@drawable/custom_btn_radio2_radio2_day_bg_selector"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/custom_btn_radio5_radio3"
        app:background4Night="@drawable/custom_btn_radio2_radio1_night_bg_selector"
        app:background4Skin="@drawable/custom_btn_radio2_radio1_day_bg_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="160"
        app:layout_constraintStart_toEndOf="@+id/stv_radio2"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/byd_text_450_4_textcolor_night_selector"
        app:textColor4Skin="@color/byd_text_450_4_textcolor_day_selector"/>
</merge>
