<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_custom_bar_loading3"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinProgressBar
        android:id="@+id/pb_loading2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:maxHeight="@dimen/auto_dimen2_8"
        android:max="100"
        android:progress="0"
        android:indeterminateOnly="false"
        android:progressDrawable="@drawable/custom_bar_downloading1_loading2_day_layerlist"
        android:minHeight="@dimen/auto_dimen2_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:progressDrawable4Night="@drawable/custom_bar_loading3_loading2_night_layerlist"
        app:progressDrawable4Skin="@drawable/custom_bar_downloading1_loading2_day_layerlist"/>
</merge>
