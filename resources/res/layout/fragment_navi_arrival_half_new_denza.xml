                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/auto_dimen2_24"
                android:layout_marginEnd="@dimen/auto_dimen2_24">
                <com.autonavi.skin.view.SkinConstraintLayout
                    android:id="@+id/scl_driver_info"
                    android:background="@drawable/custom_bg_arrive_day"
                    android:paddingTop="@dimen/auto_dimen2_16"
                    android:paddingBottom="@dimen/auto_dimen2_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auto_dimen2_8"
                    android:paddingVertical="@dimen/auto_dimen2_16"
                    app:background4Night="@drawable/custom_bg_arrive_night"
                    app:background4Skin="@drawable/custom_bg_arrive_day"
