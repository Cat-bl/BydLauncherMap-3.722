<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/constant"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:shadowDayNightStyle="1"
    app:skinDayNightExtraStyle="true">
    <com.autonavi.skin.view.SkinLinearLayout
        android:orientation="vertical"
        android:id="@+id/cl_navi_and_route_container"
        android:background="@color/transparent"
        android:visibility="gone"
        android:layout_width="@dimen/auto_dimen2_400"
        android:layout_height="@dimen/auto_dimen2_148"
        android:layout_marginTop="@dimen/auto_dimen2_228"
        android:layout_marginStart="@dimen/auto_dimen2_2350"
        app:background4Night="@color/transparent"
        app:background4Skin="@color/transparent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ct_navigation_info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.autonavi.view.custom.CustomMeterTrafficLaneView
            android:id="@+id/display_traffic_lane"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auto_dimen2_64"
            app:shadowDayNightStyle="1"
            app:skinDayNightExtraStyle="true"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ct_second_info_top"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"/>
    </com.autonavi.skin.view.SkinLinearLayout>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/meter_tip_layout"
        android:background="@drawable/meter_tips_layout_selected_bg"
        android:visibility="invisible"
        android:layout_width="@dimen/auto_dimen2_396"
        android:layout_height="@dimen/auto_dimen2_304"
        android:layout_marginTop="@dimen/auto_dimen2_228"
        android:layout_marginStart="@dimen/auto_dimen2_2350"
        app:background4Night="@drawable/meter_tips_layout_selected_bg"
        app:background4Skin="@drawable/meter_tips_layout_selected_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shadowDayNightStyle="1"
        app:skinDayNightExtraStyle="true">
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/iv_tip_location"
            android:background="@drawable/meter_tips_layout_selected_bg"
            android:layout_width="@dimen/auto_dimen2_240"
            android:layout_height="@dimen/auto_dimen2_240"
            app:background4Night="@drawable/meter_tips_layout_selected_bg"
            app:background4Skin="@drawable/meter_tips_layout_selected_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_dimen2_32"
            android:textColor="@color/meter_tips_text_color_day"
            android:gravity="center"
            android:id="@+id/iv_tip_text"
            android:layout_width="0dp"
            android:layout_height="@dimen/auto_dimen2_96"
            android:layout_marginTop="@dimen/auto_dimen2_192"
            android:layout_marginBottom="@dimen/auto_dimen2_8"
            android:layout_marginStart="@dimen/auto_dimen2_12"
            android:layout_marginEnd="@dimen/auto_dimen2_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/meter_tips_text_color_night"
            app:textColor4Skin="@color/meter_tips_text_color_day"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
