<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_custom_ar_gpsloading"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_clockwise"
        android:background="@drawable/custom_ar_gpsloading_clockwise"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:background4Skin="@drawable/custom_ar_gpsloading_clockwise"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_anticlockwise"
        android:background="@drawable/custom_ar_gpsloading_anticlockwise"
        android:layout_width="@dimen/auto_dimen2_70"
        android:layout_height="@dimen/auto_dimen2_70"
        app:background4Skin="@drawable/custom_ar_gpsloading_anticlockwise"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
