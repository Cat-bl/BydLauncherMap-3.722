<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rlLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.byd.viewsup.BydScrollerSupportedFrameLayout
        android:paddingTop="?attr/bydPvtTitleTabPaddingVertical"
        android:paddingBottom="?attr/bydPvtTitleTabPaddingVertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/iconContainer"
        android:paddingVertical="?attr/bydPvtTitleTabPaddingVertical"
        app:bydOrientation="horizontal">
        <com.byd.widget.tab.BydTitleSubTabView
            android:layout_gravity="center_vertical"
            android:id="@+id/bydTitleScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>
    </com.byd.viewsup.BydScrollerSupportedFrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/iconContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true">
        <ImageView
            android:id="@+id/imageIcon_0"
            style="?attr/bydPvtTitleTabImageViewStyle"/>
        <ImageView
            android:id="@+id/imageIcon_1"
            style="?attr/bydPvtTitleTabImageViewStyle"/>
        <ImageView
            android:id="@+id/imageIcon_2"
            style="?attr/bydPvtTitleTabImageViewStyle"/>
    </LinearLayout>
</RelativeLayout>
