<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="false" android:drawable="@color/transparent_color" />
    <item android:state_checked="true">
        <layer-list>
            <item android:gravity="center|bottom" android:height="@dimen/auto_dimen2_4" android:width="@dimen/auto_dimen2_20">
                <shape android:shape="rectangle">
                    <solid android:color="@color/search_main_color" />
                    <corners android:radius="@dimen/auto_dimen2_4" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
