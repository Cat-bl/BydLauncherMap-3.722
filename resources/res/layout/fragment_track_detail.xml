                    app:textColor4Skin="@color/byd_pvt_black_900_60"/>
            </com.autonavi.skin.view.SkinConstraintLayout>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/line3"
            android:background="@color/byd_track_12_0F1117"
            android:layout_width="@dimen/auto_dimen2_0_5"
            android:layout_height="@dimen/auto_dimen2_56"
            android:layout_marginTop="@dimen/auto_dimen2_27"
