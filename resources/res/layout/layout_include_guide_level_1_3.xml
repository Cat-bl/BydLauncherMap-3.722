<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinLinearLayout
        android:orientation="horizontal"
        android:id="@+id/sll_guide_level"
        android:background="@drawable/custom_normal_navi_btn_bg_day"
        android:paddingBottom="@dimen/auto_dimen2_12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/auto_dimen2_10"
        app:background4Night="@drawable/custom_normal_navi_btn_bg_night"
        app:background4Skin="@drawable/custom_normal_navi_btn_bg_day"
        app:layout_constraintBottom_toTopOf="@+id/cl_exitnavi"
        app:layout_constraintStart_toStartOf="@+id/cl_exitnavi">
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/scl_guide_level_1"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/auto_dimen2_100"
            android:minWidth="@dimen/auto_dimen2_152"
            android:paddingEnd="@dimen/auto_dimen2_8">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_16"
                android:textColor="@color/guide_level_text_color_day"
                android:id="@+id/stv_guide_level_1_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auto_dimen2_8"
                android:text="更省时"
                android:layout_marginStart="@dimen/auto_dimen2_16"
                app:layout_constraintBottom_toTopOf="@+id/stv_guide_level_1_time"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:textColor4Night="@color/guide_level_text_color_night"
                app:textColor4Skin="@color/guide_level_text_color_day"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_24"
                android:textStyle="bold"
                android:textColor="@color/guide_level_text_color_day"
                android:id="@+id/stv_guide_level_1_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1小时 23分钟"
                app:layout_constraintBottom_toTopOf="@+id/sll_guide_level_1_more"
                app:layout_constraintStart_toStartOf="@+id/stv_guide_level_1_title"
                app:layout_constraintTop_toBottomOf="@+id/stv_guide_level_1_title"
                app:textColor4Night="@color/guide_level_text_color_night"
                app:textColor4Skin="@color/guide_level_text_color_day"/>
            <com.autonavi.skin.view.SkinLinearLayout
                android:gravity="center_vertical"
                android:id="@+id/sll_guide_level_1_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@+id/stv_guide_level_1_title"
                app:layout_constraintTop_toBottomOf="@+id/stv_guide_level_1_time">
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_16"
                    android:textColor="@color/guide_level_text_color_day"
                    android:id="@+id/stv_guide_level_1_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60公里"
                    app:textColor4Night="@color/guide_level_text_color_night"
                    app:textColor4Skin="@color/guide_level_text_color_day"/>
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_16"
                    android:textColor="@color/guide_level_text_color_day"
                    android:id="@+id/stv_guide_level_1_cost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/auto_dimen2_8"
                    android:text="$10"
                    app:textColor4Night="@color/guide_level_text_color_night"
                    app:textColor4Skin="@color/guide_level_text_color_day"/>
                <com.autonavi.skin.view.SkinImageView
                    android:id="@+id/siv_guide_level_light_count_icon1"
                    android:background="@drawable/vector_drawable_route_traffic_light_slow_day"
                    android:layout_width="@dimen/auto_dimen2_13"
                    android:layout_height="@dimen/auto_dimen2_22"
                    android:layout_marginLeft="@dimen/auto_dimen2_8"
                    app:background4Night="@drawable/vector_drawable_route_traffic_light_slow_night"
                    app:background4Skin="@drawable/vector_drawable_route_traffic_light_slow_day"/>
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_16"
                    android:textColor="@color/guide_level_text_color_day"
                    android:id="@+id/stv_guide_level_1_light_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10"
                    app:textColor4Night="@color/guide_level_text_color_night"
                    app:textColor4Skin="@color/guide_level_text_color_day"/>
            </com.autonavi.skin.view.SkinLinearLayout>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinView
            android:layout_gravity="center_vertical"
            android:id="@+id/view_guide_level_1"
            android:background="@drawable/auto_navi_guide_level_divider_day"
            android:layout_width="@dimen/auto_dimen2_1"
            android:layout_height="@dimen/auto_dimen2_40"
            app:background4Night="@drawable/auto_navi_guide_level_divider_night"
            app:background4Skin="@drawable/auto_navi_guide_level_divider_day"/>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/scl_guide_level_2"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/auto_dimen2_100"
            android:minWidth="@dimen/auto_dimen2_152"
            android:paddingEnd="@dimen/auto_dimen2_8">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_16"
                android:textColor="@color/guide_level_text_color_day"
                android:id="@+id/stv_guide_level_2_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auto_dimen2_8"
                android:text="更省时"
                android:layout_marginStart="@dimen/auto_dimen2_16"
                app:layout_constraintBottom_toTopOf="@+id/stv_guide_level_2_time"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:textColor4Night="@color/guide_level_text_color_night"
                app:textColor4Skin="@color/guide_level_text_color_day"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_24"
                android:textStyle="bold"
                android:textColor="@color/guide_level_text_color_day"
                android:id="@+id/stv_guide_level_2_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23分钟"
                app:layout_constraintBottom_toTopOf="@+id/sll_guide_level_2_more"
                app:layout_constraintStart_toStartOf="@+id/stv_guide_level_2_title"
                app:layout_constraintTop_toBottomOf="@+id/stv_guide_level_2_title"
                app:textColor4Night="@color/guide_level_text_color_night"
                app:textColor4Skin="@color/guide_level_text_color_day"/>
            <com.autonavi.skin.view.SkinLinearLayout
                android:gravity="center_vertical"
                android:id="@+id/sll_guide_level_2_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@+id/stv_guide_level_2_title"
                app:layout_constraintTop_toBottomOf="@+id/stv_guide_level_2_time">
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_16"
                    android:textColor="@color/guide_level_text_color_day"
                    android:id="@+id/stv_guide_level_2_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60公里"
                    app:textColor4Night="@color/guide_level_text_color_night"
                    app:textColor4Skin="@color/guide_level_text_color_day"/>
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_16"
                    android:textColor="@color/guide_level_text_color_day"
                    android:id="@+id/stv_guide_level_2_cost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/auto_dimen2_8"
                    android:text="$10"
                    app:textColor4Night="@color/guide_level_text_color_night"
                    app:textColor4Skin="@color/guide_level_text_color_day"/>
                <com.autonavi.skin.view.SkinImageView
                    android:id="@+id/siv_guide_level_light_count_icon2"
                    android:background="@drawable/vector_drawable_route_traffic_light_slow_day"
                    android:layout_width="@dimen/auto_dimen2_13"
                    android:layout_height="@dimen/auto_dimen2_22"
                    android:layout_marginLeft="@dimen/auto_dimen2_8"
                    app:background4Night="@drawable/vector_drawable_route_traffic_light_slow_night"
                    app:background4Skin="@drawable/vector_drawable_route_traffic_light_slow_day"/>
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_16"
                    android:textColor="@color/guide_level_text_color_day"
                    android:id="@+id/stv_guide_level_2_light_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10"
                    app:textColor4Night="@color/guide_level_text_color_night"
                    app:textColor4Skin="@color/guide_level_text_color_day"/>
            </com.autonavi.skin.view.SkinLinearLayout>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinView
            android:layout_gravity="center_vertical"
            android:id="@+id/view_guide_level_2"
            android:background="@drawable/auto_navi_guide_level_divider_day"
            android:layout_width="@dimen/auto_dimen2_1"
            android:layout_height="@dimen/auto_dimen2_40"
            app:background4Night="@drawable/auto_navi_guide_level_divider_night"
            app:background4Skin="@drawable/auto_navi_guide_level_divider_day"/>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/scl_guide_level_3"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/auto_dimen2_100"
            android:minWidth="@dimen/auto_dimen2_152"
            android:paddingEnd="@dimen/auto_dimen2_8">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_16"
                android:textColor="@color/guide_level_text_color_day"
                android:id="@+id/stv_guide_level_3_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auto_dimen2_8"
                android:text="更省时"
                android:layout_marginStart="@dimen/auto_dimen2_16"
                app:layout_constraintBottom_toTopOf="@+id/stv_guide_level_3_time"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:textColor4Night="@color/guide_level_text_color_night"
                app:textColor4Skin="@color/guide_level_text_color_day"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_24"
                android:textStyle="bold"
                android:textColor="@color/guide_level_text_color_day"
                android:id="@+id/stv_guide_level_3_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23分钟"
                app:layout_constraintBottom_toTopOf="@+id/sll_guide_level_3_more"
                app:layout_constraintStart_toStartOf="@+id/stv_guide_level_3_title"
                app:layout_constraintTop_toBottomOf="@+id/stv_guide_level_3_title"
                app:textColor4Night="@color/guide_level_text_color_night"
                app:textColor4Skin="@color/guide_level_text_color_day"/>
            <com.autonavi.skin.view.SkinLinearLayout
                android:gravity="center_vertical"
                android:id="@+id/sll_guide_level_3_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@+id/stv_guide_level_3_title"
                app:layout_constraintTop_toBottomOf="@+id/stv_guide_level_3_time">
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_16"
                    android:textColor="@color/guide_level_text_color_day"
                    android:id="@+id/stv_guide_level_3_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60公里"
                    app:textColor4Night="@color/guide_level_text_color_night"
                    app:textColor4Skin="@color/guide_level_text_color_day"/>
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_16"
                    android:textColor="@color/guide_level_text_color_day"
                    android:id="@+id/stv_guide_level_3_cost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/auto_dimen2_8"
                    android:text="$10"
                    app:textColor4Night="@color/guide_level_text_color_night"
                    app:textColor4Skin="@color/guide_level_text_color_day"/>
                <com.autonavi.skin.view.SkinImageView
                    android:id="@+id/siv_guide_level_light_count_icon3"
                    android:background="@drawable/vector_drawable_route_traffic_light_slow_day"
                    android:layout_width="@dimen/auto_dimen2_13"
                    android:layout_height="@dimen/auto_dimen2_22"
                    android:layout_marginLeft="@dimen/auto_dimen2_8"
                    app:background4Night="@drawable/vector_drawable_route_traffic_light_slow_night"
                    app:background4Skin="@drawable/vector_drawable_route_traffic_light_slow_day"/>
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_16"
                    android:textColor="@color/guide_level_text_color_day"
                    android:id="@+id/stv_guide_level_3_light_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10"
                    app:textColor4Night="@color/guide_level_text_color_night"
                    app:textColor4Skin="@color/guide_level_text_color_day"/>
            </com.autonavi.skin.view.SkinLinearLayout>
        </com.autonavi.skin.view.SkinConstraintLayout>
    </com.autonavi.skin.view.SkinLinearLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
