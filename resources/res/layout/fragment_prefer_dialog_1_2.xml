<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_dialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_center"
        android:background="@drawable/custom_dialog_prefer_normal_day"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/auto_dimen2_620"
        android:layout_height="@dimen/auto_dimen2_440"
        app:background4Night="@drawable/custom_dialog_prefer_normal_night"
        app:background4Skin="@drawable/custom_dialog_prefer_normal_day"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shadowColor="@color/dialog_all_shadow_day_bg"
        app:shadowColorNight="@color/dialog_all_shadow_night_bg"
        app:shadowCorner="@dimen/auto_dimen2_0"
        app:shadowCornerBottomLeft="@dimen/auto_dimen2_0"
        app:shadowCornerBottomRight="@dimen/auto_dimen2_0"
        app:shadowCornerTopLeft="@dimen/auto_dimen2_0"
        app:shadowCornerTopRight="@dimen/auto_dimen2_0"
        app:shadowDx="@dimen/auto_dimen2_0"
        app:shadowDy="@dimen/auto_dimen2_16"
        app:shadowRadius="@dimen/auto_dimen2_6"
        app:shadowShapeType="rectangle"
        app:shadowSide="all"
        app:shadowVisibility="true">
        <com.autonavi.view.custom.CustomDialogLineView
            android:id="@+id/cll_horizntol_line"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/auto_dimen2_1"
            app:layout_constraintBottom_toTopOf="@+id/cl_buttons"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/cl_buttons"
            android:layout_width="@dimen/auto_dimen2_0"
            android:layout_height="@dimen/auto_dimen2_48"
            android:layout_marginBottom="@dimen/auto_dimen2_28"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/cbm_left_btn_bg"
                android:background="@drawable/byd_custom_dialog_main_btn_bg_selector_day"
                android:layout_width="@dimen/auto_dimen2_176"
                android:layout_height="match_parent"
                android:layout_marginRight="@dimen/auto_dimen2_24"
                app:background4Night="@drawable/byd_custom_dialog_main_btn_bg_selector_night"
                app:background4Skin="@drawable/byd_custom_dialog_main_btn_bg_selector_day"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/cll_line"
                app:layout_constraintTop_toTopOf="parent"
                app:shadowColor="@color/dialog_confirm_shadow_day_bg"
                app:shadowColorNight="@color/dialog_confirm_shadow_night_bg"
                app:shadowCorner="@dimen/auto_dimen2_0"
                app:shadowCornerBottomLeft="@dimen/auto_dimen2_0"
                app:shadowCornerBottomRight="@dimen/auto_dimen2_0"
                app:shadowCornerTopLeft="@dimen/auto_dimen2_0"
                app:shadowCornerTopRight="@dimen/auto_dimen2_0"
                app:shadowDx="@dimen/auto_dimen2_0"
                app:shadowDy="@dimen/auto_dimen2_3"
                app:shadowRadius="@dimen/auto_dimen2_26"
                app:shadowShapeType="rectangle"
                app:shadowSide="all"
                app:shadowVisibility="true"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/byd_custom_dialog_main_btn_text_color_selector_day"
                android:gravity="left"
                android:id="@+id/stv_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_left"
                android:lineSpacingExtra="@dimen/auto_dimen2_4"
                app:layout_constraintBottom_toBottomOf="@+id/cbm_left_btn_bg"
                app:layout_constraintEnd_toEndOf="@+id/cbm_left_btn_bg"
                app:layout_constraintStart_toStartOf="@+id/cbm_left_btn_bg"
                app:layout_constraintTop_toTopOf="@+id/cbm_left_btn_bg"
                app:textColor4Night="@color/byd_custom_dialog_main_btn_text_color_selector_night"
                app:textColor4Skin="@color/byd_custom_dialog_main_btn_text_color_selector_day"/>
            <com.autonavi.view.custom.CustomDialogLineView
                android:id="@+id/cll_line"
                android:visibility="gone"
                android:layout_width="@dimen/auto_dimen2_1"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/cbw_right_btn_bg"
                android:background="@drawable/byd_custom_dialog_secondary_btn_bg_selector_day"
                android:layout_width="@dimen/auto_dimen2_176"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/auto_dimen2_24"
                app:background4Night="@drawable/byd_custom_dialog_secondary_btn_bg_selector_night"
                app:background4Skin="@drawable/byd_custom_dialog_secondary_btn_bg_selector_day"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/cll_line"
                app:layout_constraintTop_toTopOf="parent"
                app:shadowColor="@color/dialog_cancel_shadow_day_bg"
                app:shadowColorNight="@color/dialog_cancel_shadow_night_bg"
                app:shadowCorner="@dimen/auto_dimen2_0"
                app:shadowCornerBottomLeft="@dimen/auto_dimen2_0"
                app:shadowCornerBottomRight="@dimen/auto_dimen2_0"
                app:shadowCornerTopLeft="@dimen/auto_dimen2_0"
                app:shadowCornerTopRight="@dimen/auto_dimen2_0"
                app:shadowDx="@dimen/auto_dimen2_0"
                app:shadowDy="@dimen/auto_dimen2_3"
                app:shadowRadius="@dimen/auto_dimen2_26"
                app:shadowShapeType="rectangle"
                app:shadowSide="all"
                app:shadowVisibility="true"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/byd_custom_dialog_secondary_btn_text_color_selector_day"
                android:gravity="left"
                android:id="@+id/stv_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_right"
                android:lineSpacingExtra="@dimen/auto_dimen2_4"
                app:layout_constraintBottom_toBottomOf="@+id/cbw_right_btn_bg"
                app:layout_constraintEnd_toEndOf="@+id/cbw_right_btn_bg"
                app:layout_constraintStart_toStartOf="@+id/cbw_right_btn_bg"
                app:layout_constraintTop_toTopOf="@+id/cbw_right_btn_bg"
                app:textColor4Night="@color/byd_custom_dialog_secondary_btn_text_color_selector_night"
                app:textColor4Skin="@color/byd_custom_dialog_secondary_btn_text_color_selector_day"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/cl_content"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginLeft="@dimen/auto_dimen2_16"
            android:layout_marginRight="@dimen/auto_dimen2_16"
            app:layout_constraintBottom_toTopOf="@+id/cl_buttons"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ct_layout"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cl_title_and_message"/>
            <com.autonavi.skin.view.SkinConstraintLayout
                android:id="@+id/cl_title_and_message"
                android:layout_width="0dp"
                android:layout_height="@dimen/auto_dimen2_71"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.autonavi.auto.common.view.BaseScrollView
                    android:id="@+id/sv_text_content"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auto_dimen2_30"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/stv_titletext">
                    <com.autonavi.skin.view.SkinConstraintLayout
                        android:id="@+id/cl_text_content"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <com.autonavi.skin.view.SkinTextView
                            android:textSize="@dimen/auto_font_size_20"
                            android:textColor="@color/text_450_2_textcolor_day_selector"
                            android:gravity="center"
                            android:id="@+id/stv_subtitletext"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/auto_dimen2_2"
                            android:text="@string/dialog_subtitletext"
                            android:lineSpacingExtra="@dimen/auto_dimen2_21"
                            app:layout_constraintEnd_toEndOf="@+id/cl_text_content"
                            app:layout_constraintStart_toStartOf="@+id/cl_text_content"
                            app:layout_constraintTop_toTopOf="@+id/cl_text_content"
                            app:textColor4Night="@color/text_450_2_textcolor_night_selector"
                            app:textColor4Skin="@color/text_450_2_textcolor_day_selector"/>
                    </com.autonavi.skin.view.SkinConstraintLayout>
                </com.autonavi.auto.common.view.BaseScrollView>
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_20"
                    android:textColor="@color/text_450_11_textcolor_day_selector"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/stv_titletext"
                    android:paddingTop="@dimen/auto_dimen2_8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auto_dimen2_18"
                    android:text="@string/dialog_titletext"
                    android:maxLines="1"
                    android:lineSpacingExtra="@dimen/auto_dimen2_1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:textColor4Night="@color/dialog_title_textcolor_night_selector"
                    app:textColor4Skin="@color/text_450_11_textcolor_day_selector"/>
            </com.autonavi.skin.view.SkinConstraintLayout>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinView
            android:background="@drawable/custom_prefer_dialog_line_normal_day"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auto_dimen2_1"
            android:layout_marginTop="@dimen/auto_dimen2_71"
            app:background4Night="@drawable/custom_prefer_dialog_line_normal_night"
            app:background4Skin="@drawable/custom_prefer_dialog_line_normal_day"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
