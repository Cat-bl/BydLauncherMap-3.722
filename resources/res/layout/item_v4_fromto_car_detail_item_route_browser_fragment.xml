<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_v4_fromto_car_detail_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:designHeight="600"
    app:designWidth="1024"
    app:tag="DisableAtRunTime">
    <com.autonavi.view.custom.CustomListBgPressedView
        android:id="@+id/clp_"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_actionicon3"
        android:background="@drawable/global_image_action_group2_day"
        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_48"
        android:layout_marginLeft="@dimen/auto_dimen2_60"
        android:scaleType="centerInside"
        app:background4Night="@drawable/global_image_action_group2"
        app:background4Skin="@drawable/global_image_action_group2_day"
        app:layout_constraintBottom_toBottomOf="@+id/clp_"
        app:layout_constraintStart_toStartOf="@+id/clp_"
        app:layout_constraintTop_toTopOf="@+id/clp_"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_14"
        android:textColor="@color/custom_route_textcolor_routetittle"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/stv_text_distance_des"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_20"
        android:layout_marginRight="@dimen/auto_dimen2_15"
        android:layout_marginBottom="@dimen/auto_dimen2_20"
        android:minHeight="@dimen/auto_dimen2_20"
        android:text="@string/route_browser_fragment_text_distance_des"
        android:maxLines="2"
        android:lineSpacingExtra="@dimen/auto_dimen2_5"
        app:layout_constraintBottom_toBottomOf="@+id/clp_"
        app:layout_constraintEnd_toEndOf="@+id/clp_"
        app:layout_constraintStart_toEndOf="@+id/siv_actionicon3"
        app:layout_constraintTop_toTopOf="@+id/clp_"
        app:textColor4Night="@color/route_sub_title_normal_night"
        app:textColor4Skin="@color/custom_route_textcolor_routetittle"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/cvl_line_a"
        android:background="@drawable/custom_double_dash_vertical_day"
        android:layout_width="@dimen/auto_dimen2_1"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/auto_dimen2_40"
        android:layout_marginTop="@dimen/auto_dimen2_4"
        app:background4Night="@drawable/custom_double_dash_vertical_night"
        app:background4Skin="@drawable/custom_double_dash_vertical_day"
        app:layout_constraintBottom_toTopOf="@+id/cvl_line_b"
        app:layout_constraintStart_toStartOf="@+id/clp_"
        app:layout_constraintTop_toTopOf="@+id/clp_"
        app:layout_constraintVertical_weight="1"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/cvl_line_b"
        android:background="@drawable/custom_double_dash_vertical_day"
        android:layout_width="@dimen/auto_dimen2_1"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/auto_dimen2_40"
        android:layout_marginTop="@dimen/auto_dimen2_4"
        app:background4Night="@drawable/custom_double_dash_vertical_night"
        app:background4Skin="@drawable/custom_double_dash_vertical_day"
        app:layout_constraintBottom_toBottomOf="@+id/clp_"
        app:layout_constraintStart_toStartOf="@+id/clp_"
        app:layout_constraintTop_toBottomOf="@+id/cvl_line_a"
        app:layout_constraintVertical_weight="1"/>
</com.autonavi.skin.view.SkinConstraintLayout>
