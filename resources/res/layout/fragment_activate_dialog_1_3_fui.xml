<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_dialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_center"
        android:background="@drawable/byd_custom_dialog_dialog_m_day_bg_selector"
        android:layout_width="@dimen/auto_dimen2_432"
        android:layout_height="@dimen/auto_dimen2_198"
        app:background4Night="@drawable/byd_custom_dialog_dialog_m_day_bg_selector"
        app:background4Skin="@drawable/byd_custom_dialog_dialog_m_day_bg_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.skin.view.SkinLinearLayout
            android:id="@+id/cl_buttons"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auto_dimen2_53"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_20"
                android:textColor="@color/byd_text_450_5_textcolor_day_selector"
                android:gravity="center"
                android:id="@+id/stv_left"
                android:background="@drawable/byd_custom_dialog_dialog_m_day_bg_left_button_selector"
                android:layout_width="@dimen/auto_dimen2_0"
                android:layout_height="match_parent"
                android:text="@string/dialog_left"
                android:layout_weight="1"
                app:background4Night="@drawable/byd_custom_dialog_dialog_m_day_bg_left_button_selector"
                app:background4Skin="@drawable/byd_custom_dialog_dialog_m_day_bg_left_button_selector"
                app:textColor4Night="@color/byd_text_450_5_textcolor_day_selector"
                app:textColor4Skin="@color/byd_text_450_5_textcolor_day_selector"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_20"
                android:textColor="@color/byd_text_450_1_textcolor_day_selector"
                android:gravity="center"
                android:id="@+id/stv_right"
                android:background="@drawable/byd_custom_dialog_dialog_m_day_bg_right_button_selector"
                android:layout_width="@dimen/auto_dimen2_0"
                android:layout_height="match_parent"
                android:text="@string/dialog_right"
                android:layout_weight="1"
                app:background4Night="@drawable/byd_custom_dialog_dialog_m_day_bg_right_button_selector"
                app:background4Skin="@drawable/byd_custom_dialog_dialog_m_day_bg_right_button_selector"
                app:textColor4Night="@color/byd_text_450_1_textcolor_day_selector"
                app:textColor4Skin="@color/byd_text_450_1_textcolor_day_selector"/>
        </com.autonavi.skin.view.SkinLinearLayout>
        <com.autonavi.skin.view.SkinLinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="@dimen/auto_dimen2_28"
            android:paddingRight="@dimen/auto_dimen2_28"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auto_dimen2_0"
            app:layout_constraintBottom_toTopOf="@+id/cl_buttons"
            app:layout_constraintTop_toTopOf="parent">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_20"
                android:textColor="@color/byd_text_450_1_textcolor_day_selector"
                android:gravity="center"
                android:id="@+id/stv_titletext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_navi_traffic_mode"
                app:textColor4Night="@color/byd_text_450_1_textcolor_day_selector"
                app:textColor4Skin="@color/byd_text_450_1_textcolor_day_selector"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_16"
                android:textColor="@color/byd_text_450_1_textcolor_day_selector"
                android:gravity="center"
                android:id="@+id/stv_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auto_dimen2_21"
                android:text="@string/settings_navi_traffic_mode"
                app:textColor4Night="@color/byd_text_450_1_textcolor_day_selector"
                app:textColor4Skin="@color/byd_text_450_1_textcolor_day_selector"/>
        </com.autonavi.skin.view.SkinLinearLayout>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
