<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/search_result_gridview_color_text_day"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/stv_four_filter_child_text"
        android:background="@drawable/search_checkbox_filter_day_bg_selector"
        android:layout_width="@dimen/auto_dimen2_108"
        android:layout_height="@dimen/auto_dimen2_32"
        android:text="@string/auto_search_result_map_text_item"
        android:singleLine="true"
        android:paddingStart="@dimen/auto_dimen2_4"
        android:paddingEnd="@dimen/auto_dimen2_4"
        app:background4Night="@drawable/search_checkbox_filter_night_bg_selector"
        app:background4Skin="@drawable/search_checkbox_filter_day_bg_selector"
        app:textColor4Night="@color/search_result_gridview_color_text_night"
        app:textColor4Skin="@color/search_result_gridview_color_text_day"/>
</com.autonavi.skin.view.SkinConstraintLayout>
