<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_v4_fromto_car_detail_item_start"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:tag="DisableAtRunTime">
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_search_edit_parent"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_54"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_start_icon"
        android:background="@drawable/route_browser_fragment_icon_start_day_small"
        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_48"
        android:layout_marginStart="@dimen/auto_dimen2_12"
        app:background4Night="@drawable/route_browser_fragment_icon_start_night_small"
        app:background4Skin="@drawable/route_browser_fragment_icon_start_day_small"
        app:layout_constraintBottom_toBottomOf="@+id/cl_search_edit_parent"
        app:layout_constraintStart_toStartOf="@+id/cl_search_edit_parent"
        app:layout_constraintTop_toTopOf="@+id/cl_search_edit_parent"/>
    <com.autonavi.skin.view.SkinEditText
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/byd_search_home_common_tip_day"
        android:textColorHint="@color/byd_search_text_day_55"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/set_search_around"
        android:background="@color/auto_ui_000000_00"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/auto_dimen2_11"
        android:layout_marginBottom="@dimen/auto_dimen2_11"
        android:text="@string/null_text"
        android:hint="@string/search_enter_star_tips"
        android:singleLine="true"
        android:selectAllOnFocus="true"
        android:maxLength="50"
        android:lineSpacingExtra="@dimen/auto_dimen2_4"
        android:textCursorDrawable="@drawable/auto_search_around_search_around_cursor_drawable"
        app:background4Night="@color/auto_ui_000000_00"
        app:background4Skin="@color/auto_ui_000000_00"
        app:layout_constraintBottom_toBottomOf="@+id/cl_search_edit_parent"
        app:layout_constraintEnd_toEndOf="@+id/cl_search_edit_parent"
        app:layout_constraintStart_toEndOf="@+id/siv_start_icon"
        app:layout_constraintTop_toTopOf="@+id/cl_search_edit_parent"
        app:textColor4Night="@color/byd_search_home_common_tip_night"
        app:textColor4Skin="@color/byd_search_home_common_tip_day"
        app:textColorHint4Night="@color/custom_route_textcolor_btn_text_night"
        app:textColorHint4Skin="@color/byd_search_text_day_55"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_bottom_line"
        android:background="@color/custom_route_line_day"
        android:layout_width="@dimen/auto_dimen2_0"
        android:layout_height="@dimen/auto_dimen2_1"
        app:background4Night="@color/custom_route_line_night"
        app:background4Skin="@color/custom_route_line_day"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/siv_start_icon"/>
</com.autonavi.skin.view.SkinConstraintLayout>
