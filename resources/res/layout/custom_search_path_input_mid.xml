<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/auto_dimen2_50">
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/img_status"
        android:layout_width="@dimen/auto_dimen2_12"
        android:layout_height="@dimen/auto_dimen2_12"
        android:layout_marginStart="@dimen/auto_dimen2_28"
        android:layout_marginEnd="@dimen/auto_dimen2_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/txt_point"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/img_point"
        android:background="@drawable/path_search_delete_day"
        android:layout_width="@dimen/auto_dimen2_24"
        android:layout_height="@dimen/auto_dimen2_24"
        android:layout_marginStart="@dimen/auto_dimen2_22"
        android:layout_marginEnd="@dimen/auto_dimen2_14"
        app:background4Night="@drawable/path_search_delete_night"
        app:background4Skin="@drawable/path_search_delete_day"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/txt_point"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinEditText
        android:textSize="@dimen/auto_font_size_22"
        android:textColor="@color/auto_color_24313F"
        android:textColorHint="@color/auto_color_C7CDD4"
        android:gravity="center_vertical"
        android:id="@+id/txt_point"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:maxLines="1"
        android:selectAllOnFocus="true"
        android:inputType="text"
        android:imeOptions="actionSearch"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/img_status"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/auto_color_EBF4FE"
        app:textColor4Skin="@color/auto_color_24313F"
        app:textColorHint4Night="@color/auto_color_86909B"
        app:textColorHint4Skin="@color/auto_color_C7CDD4"/>
    <com.autonavi.skin.view.SkinImageView
        android:background="@color/byd_search_home_title_inner_stroke_day"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_1"
        app:background4Night="@color/byd_search_home_title_inner_stroke_night"
        app:background4Skin="@color/byd_search_home_title_inner_stroke_day"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/txt_point"
        app:layout_constraintStart_toStartOf="@+id/txt_point"/>
</com.autonavi.skin.view.SkinConstraintLayout>
