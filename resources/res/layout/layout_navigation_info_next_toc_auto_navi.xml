<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_navigation_info_next_toc"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/ccn_navi_tbt"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shadowColor="@color/auto_ui_000000_33"
        app:shadowColorNight="@color/auto_ui_000000_33"
        app:shadowCorner="@dimen/auto_dimen2_0"
        app:shadowCornerBottomLeft="@dimen/auto_dimen2_0"
        app:shadowCornerBottomRight="@dimen/auto_dimen2_0"
        app:shadowCornerTopLeft="@dimen/auto_dimen2_4"
        app:shadowCornerTopRight="@dimen/auto_dimen2_4"
        app:shadowDx="@dimen/auto_dimen2_0"
        app:shadowDy="@dimen/auto_dimen2_2"
        app:shadowRadius="@dimen/auto_dimen2_8"
        app:shadowShapeType="rectangle"
        app:shadowSide="all"
        app:shadowVisibility="true"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_text_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/auto_dimen2_121"
        android:layout_marginTop="@dimen/auto_dimen2_9"
        app:layout_constraintStart_toStartOf="@+id/ccn_navi_tbt"
        app:layout_constraintTop_toTopOf="@+id/ccn_navi_tbt">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_64"
            android:textColor="@color/auto_color_white"
            android:gravity="left"
            android:id="@+id/stv_text_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_navi_text_distance"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/navi_card_title_color_night"
            app:textColor4Skin="@color/auto_color_white"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_64"
            android:textColor="@color/auto_color_white"
            android:gravity="left"
            android:id="@+id/stv_text_distance_cn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_8"
            android:text="@string/auto_navi_text_distance_cn"
            android:lineSpacingExtra="@dimen/auto_dimen2_11"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/navi_card_title_color_night"
            app:textColor4Skin="@color/auto_color_white"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_28"
        android:textColor="@color/auto_color_white"
        android:gravity="left"
        android:id="@+id/stv_text_meter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/auto_dimen2_12"
        android:layout_marginTop="@dimen/auto_dimen2_53"
        android:text="@string/auto_navi_text_meter"
        android:lineSpacingExtra="@dimen/auto_dimen2_4"
        app:layout_constraintStart_toEndOf="@+id/cl_text_distance"
        app:layout_constraintTop_toTopOf="@+id/ccn_navi_tbt"
        app:textColor4Night="@color/navi_card_title_color_night"
        app:textColor4Skin="@color/auto_color_white"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_28"
        android:textColor="@color/auto_color_86909B"
        android:gravity="left"
        android:id="@+id/stv_text_enter_into"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/auto_dimen2_12"
        android:text="@string/auto_navi_text_enter_into"
        android:lineSpacingExtra="@dimen/auto_dimen2_4"
        app:layout_constraintStart_toEndOf="@+id/stv_text_meter"
        app:layout_constraintTop_toTopOf="@+id/stv_text_meter"
        app:textColor4Night="@color/auto_color_86909B"
        app:textColor4Skin="@color/auto_color_86909B"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_28"
        android:textColor="@color/auto_color_white"
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/stv_text_exit_location"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_96"
        android:layout_marginRight="@dimen/auto_dimen2_16"
        android:text="@string/auto_navi_text_exit_location"
        android:lines="1"
        android:singleLine="true"
        android:lineSpacingExtra="@dimen/auto_dimen2_4"
        app:layout_constraintEnd_toEndOf="@+id/ccn_navi_tbt"
        app:layout_constraintStart_toStartOf="@+id/cl_text_distance"
        app:layout_constraintTop_toTopOf="@+id/ccn_navi_tbt"
        app:textColor4Night="@color/navi_card_title_color_night"
        app:textColor4Skin="@color/auto_color_white"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_28"
        android:textColor="@color/auto_color_white"
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/stv_text_next_location"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_96"
        android:layout_marginRight="@dimen/auto_dimen2_16"
        android:text="@string/auto_navi_text_next_location"
        android:lines="1"
        android:singleLine="true"
        android:lineSpacingExtra="@dimen/auto_dimen2_4"
        app:layout_constraintEnd_toEndOf="@+id/ccn_navi_tbt"
        app:layout_constraintStart_toStartOf="@+id/cl_text_distance"
        app:layout_constraintTop_toTopOf="@+id/ccn_navi_tbt"
        app:textColor4Night="@color/navi_card_title_color_night"
        app:textColor4Skin="@color/auto_color_white"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_28"
        android:textColor="@color/auto_color_white"
        android:gravity="left"
        android:id="@+id/stv_text_next_tbt_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="@dimen/auto_dimen2_4"
        app:layout_constraintBottom_toBottomOf="@+id/siv_turn_icon"
        app:layout_constraintStart_toStartOf="@+id/cl_text_distance"
        app:layout_constraintTop_toTopOf="@+id/siv_turn_icon"
        app:textColor4Night="@color/navi_card_title_color_night"
        app:textColor4Skin="@color/auto_color_white"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_28"
        android:textColor="@color/auto_color_white"
        android:gravity="left"
        android:id="@+id/stv_text_next_tbt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/auto_dimen2_16"
        android:lineSpacingExtra="@dimen/auto_dimen2_4"
        app:layout_constraintBottom_toBottomOf="@+id/siv_turn_icon"
        app:layout_constraintStart_toEndOf="@+id/stv_text_next_tbt_distance"
        app:layout_constraintTop_toTopOf="@+id/siv_turn_icon"
        app:textColor4Night="@color/navi_card_title_color_night"
        app:textColor4Skin="@color/auto_color_white"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_turn_icon"
        android:layout_width="@dimen/auto_dimen2_35"
        android:layout_height="@dimen/auto_dimen2_35"
        app:layout_constraintBottom_toBottomOf="@+id/ccn_navi_tbt"
        app:layout_constraintEnd_toEndOf="@+id/siv_turn_by_turn_arrow72"
        app:layout_constraintStart_toStartOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintTop_toBottomOf="@+id/cll_diving_line_tbt"/>
    <com.autonavi.skin.view.SkinView
        android:id="@+id/cll_diving_line_tbt"
        android:background="@color/auto_color_D2DFE8"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:layout_marginLeft="@dimen/auto_dimen2_16"
        android:layout_marginTop="@dimen/auto_dimen2_153"
        android:layout_marginRight="@dimen/auto_dimen2_16"
        app:background4Night="@color/auto_color_D2DFE8"
        app:background4Skin="@color/auto_color_D2DFE8"
        app:layout_constraintEnd_toEndOf="@+id/ccn_navi_tbt"
        app:layout_constraintStart_toStartOf="@+id/ccn_navi_tbt"
        app:layout_constraintTop_toTopOf="@+id/ccn_navi_tbt"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_22"
        android:textColor="@color/navi_card_exit_text_color_day"
        android:gravity="center"
        android:id="@+id/stv_exit"
        android:background="@drawable/navi_exit_bg_new"
        android:paddingLeft="@dimen/auto_dimen2_4"
        android:paddingRight="@dimen/auto_dimen2_4"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/auto_dimen2_22"
        android:layout_marginTop="@dimen/auto_dimen2_98"
        android:maxHeight="@dimen/auto_dimen2_22"
        android:text="@string/auto_navi_exit"
        android:singleLine="true"
        android:lineSpacingExtra="@dimen/auto_dimen2_10"
        app:background4Night="@drawable/navi_exit_bg_new_night"
        app:background4Skin="@drawable/navi_exit_bg_new"
        app:layout_constraintEnd_toEndOf="@+id/siv_turn_by_turn_arrow72"
        app:layout_constraintStart_toStartOf="@+id/siv_turn_by_turn_arrow72"
        app:layout_constraintTop_toTopOf="@+id/ccn_navi_tbt"
        app:textColor4Night="@color/navi_card_exit_text_color_day"
        app:textColor4Skin="@color/navi_card_exit_text_color_day"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_turn_by_turn_arrow72"
        android:layout_width="@dimen/auto_dimen2_72"
        android:layout_height="@dimen/auto_dimen2_72"
        android:layout_marginLeft="@dimen/auto_dimen2_24"
        android:layout_marginTop="@dimen/auto_dimen2_16"
        app:layout_constraintStart_toStartOf="@+id/ccn_navi_tbt"
        app:layout_constraintTop_toTopOf="@+id/ccn_navi_tbt"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_turn_by_turn_arrow"
        android:layout_width="@dimen/auto_dimen2_88"
        android:layout_height="@dimen/auto_dimen2_88"
        android:layout_marginLeft="@dimen/auto_dimen2_16"
        android:layout_marginTop="@dimen/auto_dimen2_35"
        app:layout_constraintStart_toStartOf="@+id/ccn_navi_tbt"
        app:layout_constraintTop_toTopOf="@+id/ccn_navi_tbt"/>
</com.autonavi.skin.view.SkinConstraintLayout>
