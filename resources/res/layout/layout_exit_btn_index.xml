<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_exit_btn"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.view.custom.CustomBtnCircular1View
        android:id="@+id/cbc_home"
        android:layout_width="@dimen/auto_dimen2_72"
        android:layout_height="@dimen/auto_dimen2_72"
        android:layout_marginLeft="@dimen/auto_dimen2_8"
        android:layout_marginTop="@dimen/auto_dimen2_3"
        android:layout_marginRight="@dimen/auto_dimen2_8"
        android:layout_marginBottom="@dimen/auto_dimen2_9"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shadowColor="@color/auto_ui_000000_33"
        app:shadowColorNight="@color/auto_ui_000000_33"
        app:shadowCorner="@dimen/auto_dimen2_6"
        app:shadowCornerBottomLeft="@dimen/auto_dimen2_0"
        app:shadowCornerBottomRight="@dimen/auto_dimen2_0"
        app:shadowCornerTopLeft="@dimen/auto_dimen2_0"
        app:shadowCornerTopRight="@dimen/auto_dimen2_0"
        app:shadowDx="@dimen/auto_dimen2_0"
        app:shadowDy="@dimen/auto_dimen2_3"
        app:shadowRadius="@dimen/auto_dimen2_6"
        app:shadowShapeType="rectangle"
        app:shadowSide="all"
        app:shadowVisibility="true"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_exit_icon"
        android:background="@drawable/index_exit_icon_day"
        android:layout_width="@dimen/auto_dimen2_32"
        android:layout_height="@dimen/auto_dimen2_32"
        android:layout_marginTop="@dimen/auto_dimen2_9"
        app:background4Night="@drawable/index_exit_icon_night"
        app:background4Skin="@drawable/index_exit_icon_day"
        app:layout_constraintEnd_toEndOf="@+id/cbc_home"
        app:layout_constraintStart_toStartOf="@+id/cbc_home"
        app:layout_constraintTop_toTopOf="@+id/cbc_home"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_20"
        android:textColor="@color/text_450_4_textcolor_day_selector"
        android:gravity="left"
        android:id="@+id/stv_text_exit_app_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_41"
        android:text="@string/index_text_exit_app_left"
        android:lineSpacingExtra="@dimen/auto_dimen2_10"
        app:layout_constraintEnd_toEndOf="@+id/cbc_home"
        app:layout_constraintStart_toStartOf="@+id/cbc_home"
        app:layout_constraintTop_toTopOf="@+id/cbc_home"
        app:textColor4Night="@color/text_450_4_textcolor_night_selector"
        app:textColor4Skin="@color/text_450_4_textcolor_day_selector"/>
</com.autonavi.skin.view.SkinConstraintLayout>
