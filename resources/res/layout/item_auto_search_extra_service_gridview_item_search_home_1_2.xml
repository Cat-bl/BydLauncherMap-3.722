<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/cl_auto_search_switch_child_gridview_item"
    android:background="@drawable/search_more_child_image_item_bg_day_selector"
    android:paddingTop="@dimen/auto_dimen2_8"
    android:paddingBottom="@dimen/auto_dimen2_8"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:background4Night="@drawable/search_more_child_image_item_bg_night_selector"
    app:background4Skin="@drawable/search_more_child_image_item_bg_day_selector"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinImageView
        android:background="@drawable/global_bg_radius_circle_bg_day"
        android:layout_width="@dimen/auto_dimen2_64"
        android:layout_height="@dimen/auto_dimen2_64"
        app:background4Night="@color/transparent_color"
        app:background4Skin="@drawable/global_bg_radius_circle_bg_day"
        app:layout_constraintBottom_toBottomOf="@+id/siv_extra_inner"
        app:layout_constraintEnd_toEndOf="@+id/siv_extra_inner"
        app:layout_constraintStart_toStartOf="@+id/siv_extra_inner"
        app:layout_constraintTop_toTopOf="@+id/siv_extra_inner"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_extra_inner"
        android:padding="@dimen/auto_dimen2_4"
        android:layout_width="@dimen/auto_dimen2_60"
        android:layout_height="@dimen/auto_dimen2_60"
        android:src="@drawable/global_image_icon_gas_station"
        app:background4Night="@drawable/global_bg_radius_circle_night"
        app:background4Skin="@drawable/global_bg_radius_circle_day"
        app:layout_constraintBottom_toTopOf="@+id/stv_extra_tip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/byd_search_text_day"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/stv_extra_tip"
        android:layout_width="@dimen/auto_dimen2_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_8"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siv_extra_inner"
        app:textColor4Night="@color/byd_search_text_night"
        app:textColor4Skin="@color/byd_search_text_day"/>
</com.autonavi.skin.view.SkinConstraintLayout>
