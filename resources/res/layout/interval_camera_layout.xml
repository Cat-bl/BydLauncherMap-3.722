<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:id="@+id/interval_camera_info_img"
        android:background="@drawable/global_image_navi_interval_camera_bg_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/auto_font_size_16"
            android:textStyle="bold"
            android:textColor="@color/auto_ui_111111"
            android:layout_gravity="center"
            android:id="@+id/interval_camera_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
