<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_data_home"
    android:background="@drawable/byd_user_bg_day"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:background4Night="@drawable/byd_data_bg_night"
    app:background4Skin="@drawable/byd_user_bg_day"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinTextView
        android:id="@+id/cc_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:background="@drawable/setting_back_day"
        android:layout_width="@dimen/auto_dimen2_40"
        android:layout_height="@dimen/auto_dimen2_40"
        android:layout_marginTop="@dimen/auto_dimen2_22"
        android:layout_marginStart="@dimen/auto_dimen2_32"
        app:background4Skin="@drawable/setting_back_day"
        app:layout_constraintStart_toStartOf="@+id/cc_bg"
        app:layout_constraintTop_toTopOf="@+id/cc_bg"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_28"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_24"
        android:text="@string/u_update"
        app:layout_constraintEnd_toEndOf="@+id/cc_bg"
        app:layout_constraintStart_toStartOf="@+id/cc_bg"
        app:layout_constraintTop_toTopOf="@+id/cc_bg"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_22"
        android:id="@+id/check"
        android:paddingLeft="@dimen/auto_dimen2_20"
        android:paddingTop="@dimen/auto_dimen2_10"
        android:paddingRight="@dimen/auto_dimen2_20"
        android:paddingBottom="@dimen/auto_dimen2_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/check_help"
        android:layout_marginEnd="@dimen/auto_dimen2_40"
        android:paddingHorizontal="@dimen/auto_dimen2_20"
        android:paddingVertical="@dimen/auto_dimen2_10"
        app:layout_constraintBaseline_toBaselineOf="@+id/title"
        app:layout_constraintEnd_toEndOf="@+id/cc_bg"/>
    <com.autonavi.skin.view.SkinListView
        android:id="@+id/cities"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/auto_dimen2_20"
        android:layout_marginTop="@dimen/auto_dimen2_10"
        android:layout_marginRight="@dimen/auto_dimen2_20"
        android:layout_marginBottom="@dimen/auto_dimen2_10"
        android:layout_marginHorizontal="@dimen/auto_dimen2_20"
        android:layout_marginVertical="@dimen/auto_dimen2_10"
        app:layout_constraintBottom_toBottomOf="@+id/cc_bg"
        app:layout_constraintEnd_toEndOf="@+id/cc_bg"
        app:layout_constraintStart_toStartOf="@+id/cc_bg"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_28"
        android:id="@+id/tip1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_usb_detect_check"
        app:layout_constraintBottom_toTopOf="@+id/tip2"
        app:layout_constraintEnd_toEndOf="@+id/cc_bg"
        app:layout_constraintStart_toStartOf="@+id/cc_bg"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_22"
        android:id="@+id/tip2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/go_download_gd"
        app:layout_constraintBottom_toBottomOf="@+id/reusb"
        app:layout_constraintEnd_toEndOf="@+id/cc_bg"
        app:layout_constraintStart_toStartOf="@+id/cc_bg"
        app:layout_constraintTop_toBottomOf="@+id/tip1"/>
    <com.autonavi.skin.view.SkinButton
        android:textSize="@dimen/auto_font_size_28"
        android:id="@+id/reusb"
        android:paddingLeft="@dimen/auto_dimen2_23"
        android:paddingTop="@dimen/auto_dimen2_14"
        android:paddingRight="@dimen/auto_dimen2_23"
        android:paddingBottom="@dimen/auto_dimen2_14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reusb"
        android:paddingHorizontal="@dimen/auto_dimen2_23"
        android:paddingVertical="@dimen/auto_dimen2_14"
        app:layout_constraintBottom_toBottomOf="@+id/cc_bg"
        app:layout_constraintEnd_toEndOf="@+id/cc_bg"
        app:layout_constraintStart_toStartOf="@+id/cc_bg"
        app:layout_constraintTop_toBottomOf="@+id/tip2"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="tip1,tip2,reusb"/>
</com.autonavi.skin.view.SkinConstraintLayout>
