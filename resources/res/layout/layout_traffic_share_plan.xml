<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_traffic_share_plan"
    android:background="@drawable/byd_setting_bg_day"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:background4Night="@drawable/byd_setting_bg_night"
    app:background4Skin="@drawable/byd_setting_bg_day"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.auto.common.view.AutoGuideLine
        android:orientation="vertical"
        android:id="@+id/map_use_tips_gl_around_pstart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.08"/>
    <com.autonavi.auto.common.view.AutoGuideLine
        android:orientation="vertical"
        android:id="@+id/map_use_tips_gl_around_pend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.92"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_28"
        android:textColor="@color/byd_text_450_1_textcolor_day_selector"
        android:gravity="center"
        android:id="@+id/traffic_share_plan_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/auto_dimen2_56"
        android:layout_marginTop="@dimen/auto_dimen2_64"
        android:text="@string/traffic_share_plan_title"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/byd_text_450_1_textcolor_night_selector"
        app:textColor4Skin="@color/byd_text_450_1_textcolor_day_selector"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_22"
        android:textColor="@color/byd_text_450_1_textcolor_day_selector"
        android:id="@+id/traffic_share_plan_tv_content"
        android:layout_width="@dimen/auto_dimen2_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_96"
        android:text="@string/traffic_share_plan_content"
        android:lineSpacingExtra="@dimen/auto_dimen2_8"
        app:layout_constraintEnd_toEndOf="@+id/map_use_tips_gl_around_pend"
        app:layout_constraintStart_toStartOf="@+id/map_use_tips_gl_around_pstart"
        app:layout_constraintTop_toBottomOf="@+id/traffic_share_plan_title"
        app:textColor4Night="@color/byd_text_450_1_textcolor_night_selector"
        app:textColor4Skin="@color/byd_text_450_1_textcolor_day_selector"/>
    <com.autonavi.skin.view.SkinLinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/traffic_share_plan_ll_bt"
        android:layout_width="@dimen/auto_dimen2_0"
        android:layout_height="@dimen/auto_dimen2_56"
        android:layout_marginBottom="@dimen/auto_dimen2_388"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/map_use_tips_gl_around_pend"
        app:layout_constraintStart_toStartOf="@+id/map_use_tips_gl_around_pstart">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_28"
            android:textColor="@color/byd_text_450_1_btn_textcolor_day_selector"
            android:gravity="center"
            android:id="@+id/traffic_share_plan_bt_agree"
            android:background="@drawable/byd_custom_btn_function1_btn_function1_day_bg_selector"
            android:layout_width="@dimen/auto_dimen2_0"
            android:layout_height="match_parent"
            android:text="@string/traffic_share_plan_agreen"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/auto_dimen2_20"
            app:background4Night="@drawable/byd_custom_btn_function1_btn_function1_night_bg_selector"
            app:background4Skin="@drawable/custom_btn_function1_btn_function1_day_bg_selector"
            app:textColor4Night="@color/byd_text_450_1_btn_textcolor_night_selector"
            app:textColor4Skin="@color/byd_text_450_1_btn_textcolor_day_selector"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_28"
            android:textColor="@color/byd_text_450_1_textcolor_day_selected"
            android:gravity="center"
            android:id="@+id/traffic_share_plan_bt_quit"
            android:background="@drawable/byd_custom_btn_function2_day_bg_selector"
            android:layout_width="@dimen/auto_dimen2_0"
            android:layout_height="match_parent"
            android:text="@string/traffic_share_plan_quit"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/auto_dimen2_20"
            app:background4Night="@drawable/byd_custom_btn_function2_night_bg_selector"
            app:background4Skin="@drawable/byd_custom_btn_function2_day_bg_selector"
            app:textColor4Night="@color/byd_text_450_1_textcolor_day_selected"
            app:textColor4Skin="@color/byd_text_450_1_textcolor_day_selected"/>
    </com.autonavi.skin.view.SkinLinearLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
