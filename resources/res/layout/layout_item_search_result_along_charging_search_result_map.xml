<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_search_result"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/byd_search_text_day"
        android:gravity="center"
        android:id="@+id/siv_icon"
        android:layout_width="@dimen/auto_dimen2_22"
        android:layout_height="@dimen/auto_dimen2_16"
        android:layout_marginStart="@dimen/auto_dimen2_12"
        app:layout_constraintBaseline_toBaselineOf="@+id/stv_text_title_search_result"
        app:layout_constraintStart_toStartOf="parent"
        app:textColor4Night="@color/byd_search_text_night"
        app:textColor4Skin="@color/byd_search_text_day"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_20"
        android:textColor="@color/byd_search_text_day"
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/stv_text_title_search_result"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_10"
        android:text="沿途搜充电站名"
        android:maxLines="1"
        android:lineSpacingExtra="@dimen/auto_dimen2_5"
        android:layout_marginStart="@dimen/auto_dimen2_8"
        android:layout_marginEnd="@dimen/auto_dimen2_4"
        app:layout_constraintEnd_toStartOf="@+id/stv_search_switch_result_btn"
        app:layout_constraintStart_toEndOf="@+id/siv_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/byd_search_text_night"
        app:textColor4Skin="@color/byd_search_text_day"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/byd_custom_normal_btn_text_color_selector_day"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/stv_search_switch_result_btn"
        android:background="@drawable/byd_custom_normal_btn_bg_selector_day"
        android:paddingLeft="@dimen/auto_dimen2_6"
        android:paddingRight="@dimen/auto_dimen2_6"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/auto_dimen2_6"
        android:maxWidth="@dimen/auto_dimen2_102"
        android:minWidth="@dimen/auto_dimen2_86"
        android:minHeight="@dimen/auto_dimen2_30"
        android:text="@string/auto_search_result_map_set_via_btn"
        android:maxLines="1"
        android:layout_marginStart="@dimen/auto_dimen2_6"
        android:layout_marginEnd="@dimen/auto_dimen2_24"
        app:background4Night="@drawable/byd_custom_normal_btn_bg_selector_night"
        app:background4Skin="@drawable/byd_custom_normal_btn_bg_selector_day"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/stv_text_title_search_result"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/byd_custom_normal_btn_text_color_selector_night"
        app:textColor4Skin="@color/byd_custom_normal_btn_text_color_selector_day"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/byd_search_text_day_55"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/stv_distance_search_result_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/auto_dimen2_80"
        android:text="1299.3公里"
        android:singleLine="true"
        android:lineSpacingExtra="@dimen/auto_dimen2_4"
        app:layout_constraintBottom_toBottomOf="@+id/cl_charging_detail"
        app:layout_constraintStart_toStartOf="@+id/stv_text_title_search_result"
        app:layout_constraintTop_toBottomOf="@+id/stv_text_title_search_result"
        app:layout_constraintTop_toTopOf="@+id/cl_charging_detail"
        app:layout_goneMarginTop="@dimen/auto_dimen2_10"
        app:textColor4Night="@color/byd_search_text_night_55"
        app:textColor4Skin="@color/byd_search_text_day_55"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_charging_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_10"
        android:layout_marginStart="@dimen/auto_dimen2_12"
        app:layout_constraintStart_toEndOf="@+id/stv_distance_search_result_textview"
        app:layout_constraintTop_toBottomOf="@+id/stv_text_title_search_result">
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/cl_money_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_16"
                android:textColor="@color/byd_search_text_day"
                android:gravity="end|center_vertical"
                android:id="@+id/stv_text_money"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/auto_dimen2_30"
                android:text="@string/auto_search_result_map_text_money"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:textColor4Night="@color/byd_search_text_night"
                app:textColor4Skin="@color/byd_search_text_day"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_16"
                android:textColor="@color/byd_search_text_day"
                android:gravity="start|center_vertical"
                android:id="@+id/stv_text_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_search_result_map_text_unit"
                android:lineSpacingExtra="@dimen/auto_dimen2_4"
                app:layout_constraintBottom_toBottomOf="@+id/stv_text_money"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/stv_text_money"
                app:layout_constraintTop_toTopOf="@+id/stv_text_money"
                app:textColor4Night="@color/byd_search_text_night"
                app:textColor4Skin="@color/byd_search_text_day"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.adapter.container.ACAlongSearchChargingInfoIndexView
            android:id="@+id/ac_charging_info"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/auto_dimen2_28"
            android:layout_marginStart="@dimen/auto_dimen2_16"
            app:interface_key="charging_info"
            app:layout_constraintBottom_toBottomOf="@+id/cl_money_unit"
            app:layout_constraintStart_toEndOf="@+id/cl_money_unit"
            app:layout_constraintTop_toTopOf="@+id/cl_money_unit"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ct_search_child_station"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/auto_dimen2_66"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/stv_text_title_search_result"
        app:layout_constraintTop_toBottomOf="@+id/ct_search_roadstat"/>
    <com.autonavi.view.custom.CustomListLineView
        android:id="@+id/cll_item_bottom_line"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_0_1"
        android:layout_marginTop="@dimen/auto_dimen2_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/siv_icon"
        app:layout_constraintTop_toBottomOf="@+id/cl_charging_detail"/>
</com.autonavi.skin.view.SkinConstraintLayout>
