<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_active_guide_light"
        android:background="@drawable/icon_light_yellow"
        android:layout_width="@dimen/auto_dimen2_42"
        android:layout_height="@dimen/auto_dimen2_42"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_active_guide_light_direction"
        android:background="@drawable/icon_light_arrow_straight"
        android:layout_width="@dimen/auto_dimen2_30"
        android:layout_height="@dimen/auto_dimen2_30"
        app:layout_constraintBottom_toBottomOf="@+id/siv_active_guide_light"
        app:layout_constraintEnd_toEndOf="@+id/siv_active_guide_light"
        app:layout_constraintStart_toStartOf="@+id/siv_active_guide_light"
        app:layout_constraintTop_toTopOf="@+id/siv_active_guide_light"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_24"
        android:textColor="#ffffffff"
        android:gravity="center"
        android:id="@+id/stv_active_guide_light_time"
        android:visibility="visible"
        android:layout_width="@dimen/auto_dimen2_50"
        android:layout_height="wrap_content"
        android:text="99"
        android:maxLines="1"
        android:fontFamily="@font/sdk_font_bold"
        app:layout_constraintBottom_toBottomOf="@+id/siv_active_guide_light"
        app:layout_constraintStart_toEndOf="@+id/siv_active_guide_light"
        app:layout_constraintTop_toTopOf="@+id/siv_active_guide_light"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_20"
        android:textStyle="bold"
        android:textColor="#ffffffff"
        android:id="@+id/stv_active_guide_light_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="注意"
        android:layout_marginStart="@dimen/auto_dimen2_6"
        android:layout_marginEnd="@dimen/auto_dimen2_6"
        app:layout_constraintBottom_toBottomOf="@+id/siv_active_guide_light"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/siv_active_guide_light"
        app:layout_constraintTop_toTopOf="@+id/siv_active_guide_light"/>
</com.autonavi.skin.view.SkinConstraintLayout>
