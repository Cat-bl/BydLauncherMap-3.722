            android:textSize="@dimen/auto_font_size_28"
            android:textColor="@color/text_450_1_textcolor_day_selector"
            android:gravity="left"
            android:id="@+id/stv_text_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_14"
            android:layout_marginBottom="@dimen/auto_dimen2_10"
            android:text="@string/auto_navi_text_switch"
            android:lineSpacingExtra="@dimen/auto_dimen2_4"
            app:layout_constraintBottom_toBottomOf="@+id/cbm_switch"
            app:layout_constraintEnd_toEndOf="@+id/cbm_switch"
            app:layout_constraintStart_toStartOf="@+id/cbm_switch"
            app:layout_constraintTop_toTopOf="@+id/cbm_switch"
            app:textColor4Night="@color/text_450_1_textcolor_night_selector"
            app:textColor4Skin="@color/text_450_1_textcolor_day_selector"/>
