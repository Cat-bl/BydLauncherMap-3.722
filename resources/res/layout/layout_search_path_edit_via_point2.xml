<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_v4_fromto_car_detail_item_start"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:tag="DisableAtRunTime">
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/mid_point_content"
        android:background="@drawable/auto_search_mid_point_bg_day"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_48"
        android:layout_marginEnd="@dimen/auto_dimen2_8"
        app:background4Night="@drawable/auto_search_mid_point_bg_night"
        app:background4Skin="@drawable/auto_search_mid_point_bg_day"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/siv_del_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/index_root"
            android:layout_width="@dimen/auto_dimen2_32"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/siv_drag_hint"
            app:layout_constraintTop_toTopOf="parent">
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/end_icon"
                android:visibility="visible"
                android:layout_width="@dimen/auto_dimen2_32"
                android:layout_height="@dimen/auto_dimen2_32"
                android:src="@drawable/route_browser_fragment_icon_end_day_small"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:src4Night="@drawable/route_browser_fragment_icon_end_night_small"
                app:src4Skin="@drawable/route_browser_fragment_icon_end_day_small"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_dimen2_18"
                android:textColor="@color/byd_pvt_black_900_60"
                android:gravity="bottom|center_horizontal"
                android:id="@+id/mid_index"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auto_dimen2_3"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:textColor4Night="@color/byd_pvt_white_900_60"
                app:textColor4Skin="@color/byd_pvt_black_900_60"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinEditText
            android:textSize="@dimen/auto_font_size_18"
            android:textColor="@color/byd_search_home_common_tip_day"
            android:textColorHint="@color/byd_search_text_day_55"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/set_search_around"
            android:background="@color/auto_ui_000000_00"
            android:layout_width="0dp"
            android:layout_height="@dimen/auto_dimen2_30"
            android:text="@string/null_text"
            android:hint="@string/search_enter_via_tips"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:maxLength="50"
            android:lineSpacingExtra="@dimen/auto_dimen2_4"
            android:inputType="text"
            android:textCursorDrawable="@drawable/auto_search_around_search_around_cursor_drawable"
            android:layout_marginStart="@dimen/auto_dimen2_2"
            android:layout_marginEnd="@dimen/auto_dimen2_8"
            app:background4Night="@color/auto_ui_000000_00"
            app:background4Skin="@color/auto_ui_000000_00"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/index_root"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/byd_search_home_common_tip_night"
            app:textColor4Skin="@color/byd_search_home_common_tip_day"
            app:textColorHint4Night="@color/custom_route_textcolor_btn_text_night"
            app:textColorHint4Skin="@color/byd_search_text_day_55"/>
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/siv_drag_hint"
            android:layout_width="@dimen/auto_dimen2_32"
            android:layout_height="@dimen/auto_dimen2_32"
            android:src="@drawable/auto_search_sort_tip_icon_day"
            android:layout_marginStart="@dimen/auto_dimen2_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:src4Night="@drawable/auto_search_sort_tip_icon_night"
            app:src4Skin="@drawable/auto_search_sort_tip_icon_day"/>
        <com.autonavi.skin.view.SkinView
            android:id="@+id/sv_drag_mask"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:background="@drawable/auto_search_mid_point_mask_day"
            app:background4Night="@drawable/auto_search_mid_point_mask_night"
            app:background4Skin="@drawable/auto_search_mid_point_mask_day"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_del_icon"
        android:background="@drawable/ic_path_delete"
        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_48"
        android:contentDescription="删除"
        app:background4Night="@drawable/delete_via_icon"
        app:background4Skin="@drawable/ic_path_delete"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.autonavi.skin.view.SkinConstraintLayout>
