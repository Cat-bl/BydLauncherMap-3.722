<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/btn_round_normal"/>
            <stroke
                android:width="@dimen/btn_stroke_normal_selected"
                android:color="@color/btn_stroke_color_normal_selected_light"/>
            <solid android:color="@color/btn_bg_color_normal_selected_light"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/btn_round_normal"/>
            <stroke
                android:width="@dimen/btn_stroke_normal"
                android:color="@color/btn_stroke_color_normal_light"/>
            <solid android:color="@color/btn_bg_gaussian_color_normal_light"/>
        </shape>
    </item>
</selector>
