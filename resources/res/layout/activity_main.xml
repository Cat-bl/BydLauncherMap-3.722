<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.view.custom.WindowInsetsFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_main"
    android:background="@color/transparent_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/status_bar_bg"
        android:background="@drawable/main_status_bar_bg_day"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/auto_dimen2_76"
        app:background4Night="@drawable/main_status_bar_bg_night"
        app:background4Skin="@drawable/main_status_bar_bg_day"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:layout_gravity="end|top"
        android:id="@+id/layout_weather"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_28"
        android:layout_marginEnd="@dimen/auto_dimen2_24"/>
    <com.autonavi.view.custom.WindowInsetsFrameLayout
        android:id="@+id/amap_fragment_container"
        android:background="@color/transparent_color"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/fl_toast"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/auto_dimen2_160">
        <include layout="@layout/toast_layout"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/text_450_16_textcolor_day_normal"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/main_dr_param"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/auto_dimen2_60"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/text_450_16_textcolor_day_normal"
        android:layout_gravity="start|center_vertical"
        android:id="@+id/main_dr_enter_param"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/auto_dimen2_20"/>
    <com.autonavi.skin.view.SkinImageView
        android:layout_gravity="bottom"
        android:id="@+id/shape_widget_bg_gradient"
        android:background="@drawable/shape_widget_background_gradient_day"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginBottom="60dp"
        app:background4Night="@drawable/shape_widget_background_gradient_night"
        app:background4Skin="@drawable/shape_widget_background_gradient_day"/>
    <com.autonavi.view.custom.CustomOverspeedView
        android:id="@+id/co_overspeed"
        android:background="@drawable/custom_overspeed_overspeed_day"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="60dp"/>
    <com.autonavi.skin.view.SkinImageView
        android:layout_gravity="bottom"
        android:id="@+id/shape_navigation_bg_gradient"
        android:background="@drawable/shape_navigation_background_gradient_day"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:background4Night="@color/transparent_color"
        app:background4Skin="@drawable/shape_navigation_background_gradient_day"/>
    <FrameLayout
        android:id="@+id/privacy_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.autonavi.view.custom.WindowInsetsFrameLayout>
