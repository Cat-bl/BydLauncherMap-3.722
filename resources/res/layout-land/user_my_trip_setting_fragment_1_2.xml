<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_search_home"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.autonavi.skin.view.SkinRelativeLayout style="@style/style_setting_bg_half">
        <com.autonavi.skin.view.SkinLinearLayout
            android:id="@+id/top_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/user_tittle_layout_1_2"/>
        </com.autonavi.skin.view.SkinLinearLayout>
        <com.autonavi.skin.view.SkinRelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/top_bar_layout"
            android:layout_marginStart="@dimen/auto_dimen2_40"
            android:layout_marginEnd="@dimen/auto_dimen2_40">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_20"
                android:textColor="@color/custom_text_day_color_100"
                android:id="@+id/user_trip_switch_tittle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/auto_dimen2_20"
                android:text="@string/set_my_trips_switch_tittle"
                android:layout_toRightOf="@+id/user_trip_switch_button"
                android:layout_alignTop="@+id/user_trip_switch_button"
                app:textColor4Night="@color/custom_text_night_color"
                app:textColor4Skin="@color/custom_text_day_color_100"/>
            <com.autonavi.view.custom.CustomBtnSwitchView
                android:gravity="center"
                android:id="@+id/user_trip_switch_button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/auto_dimen2_48"
                android:layout_marginLeft="@dimen/auto_dimen2_15"
                android:layout_marginTop="@dimen/auto_dimen2_44"
                app:custom_content_description="自动记录行程"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_16"
                android:textColor="@color/custom_text_day_color_55"
                android:gravity="center_vertical"
                android:id="@+id/set_my_trips_switch_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/auto_dimen2_20"
                android:text="@string/set_my_trips_switch_tip_open"
                android:layout_toRightOf="@+id/user_trip_switch_button"
                android:layout_below="@+id/user_trip_switch_tittle"
                android:layout_alignBottom="@+id/user_trip_switch_button"
                app:textColor4Night="@color/custom_text_night_color_55"
                app:textColor4Skin="@color/custom_text_day_color_55"/>
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/dialog_item_bottom_line1"
                android:background="@color/auto_color_line_day"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auto_dimen2_1"
                android:layout_marginTop="@dimen/auto_dimen2_15"
                android:layout_below="@+id/set_my_trips_switch_tip"
                android:layout_alignRight="@+id/set_my_trips_delete_btn"
                app:background4Night="@color/auto_color_12FFFFFF"
                app:background4Skin="@color/auto_color_line_day"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_20"
                android:textColor="@color/custom_text_day_color_100"
                android:gravity="center"
                android:id="@+id/set_my_trips_delete_tittle"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/auto_dimen2_28"
                android:layout_marginTop="@dimen/auto_dimen2_44"
                android:text="@string/set_my_trips_delete_tittle"
                android:layout_below="@+id/user_trip_switch_button"
                android:layout_alignLeft="@+id/user_trip_switch_button"
                app:textColor4Night="@color/custom_text_night_color"
                app:textColor4Skin="@color/custom_text_day_color_100"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_16"
                android:textColor="@color/custom_text_day_color_55"
                android:gravity="center"
                android:id="@+id/set_my_trips_delete_tip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/auto_dimen2_28"
                android:text="@string/set_my_trips_delete_tittle"
                android:layout_below="@+id/set_my_trips_delete_tittle"
                android:layout_alignLeft="@+id/user_trip_switch_button"
                app:textColor4Night="@color/custom_text_night_color_55"
                app:textColor4Skin="@color/custom_text_day_color_55"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_20"
                android:textColor="@color/byd_custom_secondary_highlight_btn_text_color_selector_day"
                android:gravity="center"
                android:id="@+id/set_my_trips_delete_btn"
                android:background="@drawable/byd_custom_secondary_highlight_btn_bg_selector_day"
                android:paddingLeft="@dimen/auto_dimen2_24"
                android:paddingRight="@dimen/auto_dimen2_24"
                android:layout_width="@dimen/auto_dimen2_160"
                android:layout_height="@dimen/auto_dimen2_48"
                android:text="@string/set_my_trips_delete_btn"
                android:layout_alignTop="@+id/set_my_trips_delete_tittle"
                android:layout_alignParentRight="true"
                app:background4Night="@drawable/byd_custom_secondary_highlight_btn_bg_selector_night"
                app:background4Skin="@drawable/byd_custom_secondary_highlight_btn_bg_selector_day"
                app:textColor4Night="@color/byd_custom_secondary_highlight_btn_text_color_selector_night"
                app:textColor4Skin="@color/byd_custom_secondary_highlight_btn_text_color_selector_day"/>
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/dialog_item_bottom_line2"
                android:background="@color/auto_color_line_day"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auto_dimen2_1"
                android:layout_marginTop="@dimen/auto_dimen2_15"
                android:layout_below="@+id/set_my_trips_delete_tip"
                android:layout_alignRight="@+id/set_my_trips_delete_btn"
                app:background4Night="@color/auto_color_12FFFFFF"
                app:background4Skin="@color/auto_color_line_day"/>
        </com.autonavi.skin.view.SkinRelativeLayout>
    </com.autonavi.skin.view.SkinRelativeLayout>
</com.autonavi.skin.view.SkinRelativeLayout>
