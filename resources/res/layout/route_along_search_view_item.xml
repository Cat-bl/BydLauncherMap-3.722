<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/ctb_search_along_item_bg"
        android:background="@drawable/custom_theme_bg1_theme_bg1_day_bg_selector"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:background4Night="@drawable/custom_theme_bg1_theme_bg1_night_bg_selector"
        app:background4Skin="@drawable/custom_theme_bg1_theme_bg1_day_bg_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:orientation="vertical"
        android:id="@+id/cl_search_along_item_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_33"
        android:layout_marginBottom="@dimen/auto_dimen2_29"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.skin.view.SkinImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/siv_search_along_item_icon"
            android:background="@drawable/icon_routecarresult_gas_station_day"
            app:background4Night="@drawable/icon_routecarresult_gas_station_night"
            app:background4Skin="@drawable/icon_routecarresult_gas_station_day"
            app:layout_constraintBottom_toTopOf="@+id/stv_search_along_item_name"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/custom_more_menu_icon_style"/>
        <com.autonavi.skin.view.SkinTextView
            android:layout_gravity="center_horizontal"
            android:id="@+id/stv_search_along_item_name"
            android:text="@string/routecarresult_gas_station"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/siv_search_along_item_icon"
            style="@style/custom_more_menu_text_style"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</merge>
