<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_routearrival"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.autonavi.skin.view.SkinConstraintLayout
        android:background="@color/auto_color_000000"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/gl_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/arr_exit_view"
            android:layout_width="@dimen/auto_dimen2_60"
            android:layout_height="@dimen/auto_dimen2_60"
            android:layout_marginTop="20dp"
            android:layout_marginStart="@dimen/auto_dimen2_20"
            android:layout_marginEnd="@dimen/auto_dimen2_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.autonavi.view.custom.CustomListPressedView
                android:id="@+id/arr_exit_bg"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shadowColor="@color/auto_ui_000000_33"
                app:shadowColorNight="@color/auto_ui_000000_33"
                app:shadowCorner="@dimen/auto_dimen2_0"
                app:shadowCornerBottomLeft="@dimen/auto_dimen2_0"
                app:shadowCornerBottomRight="@dimen/auto_dimen2_0"
                app:shadowCornerTopLeft="@dimen/auto_dimen2_0"
                app:shadowCornerTopRight="@dimen/auto_dimen2_0"
                app:shadowDx="@dimen/auto_dimen2_0"
                app:shadowDy="@dimen/auto_dimen2_3"
                app:shadowRadius="@dimen/auto_dimen2_6"
                app:shadowShapeType="rectangle"
                app:shadowSide="all"
                app:shadowVisibility="true"/>
            <com.autonavi.skin.view.SkinImageView
                android:background="@drawable/index_exit_icon_night"
                android:layout_width="@dimen/auto_dimen2_42"
                android:layout_height="@dimen/auto_dimen2_42"
                android:contentDescription="关闭"
                app:background4Night="@drawable/index_exit_icon_night"
                app:background4Skin="@drawable/index_exit_icon_day"
                app:layout_constraintBottom_toBottomOf="@+id/clp_exit_bg"
                app:layout_constraintEnd_toEndOf="@+id/clp_exit_bg"
                app:layout_constraintStart_toStartOf="@+id/clp_exit_bg"
                app:layout_constraintTop_toTopOf="@+id/clp_exit_bg"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/start_point_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auto_dimen2_20"
            android:layout_marginEnd="@dimen/auto_dimen2_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/arr_exit_view">
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/img_start_point"
                android:background="@drawable/route_browser_fragment_icon_start_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:background4Night="@drawable/route_browser_fragment_icon_start_night"
                app:background4Skin="@drawable/route_browser_fragment_icon_start_day"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_20"
                android:textColor="@color/nd_1_1"
                android:id="@+id/txt_start_point"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/arr_text_start_point"
                app:layout_constraintStart_toEndOf="@+id/img_start_point"
                app:layout_constraintTop_toBottomOf="@+id/arr_exit_view"/>
        </com.autonavi.skin.view.SkinLinearLayout>
        <com.autonavi.skin.view.SkinLinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/dest_point_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auto_dimen2_20"
            android:layout_marginEnd="@dimen/auto_dimen2_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/start_point_view">
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/img_dest_point"
                android:background="@drawable/route_browser_fragment_icon_end_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:background4Night="@drawable/route_browser_fragment_icon_end_night"
                app:background4Skin="@drawable/route_browser_fragment_icon_end_day"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/img_start_point"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_20"
                android:textColor="@color/nd_1_1"
                android:id="@+id/txt_dest_point"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/arr_text_dest_point"
                app:layout_constraintStart_toEndOf="@+id/img_dest_point"
                app:layout_constraintTop_toBottomOf="@+id/img_start_point"/>
        </com.autonavi.skin.view.SkinLinearLayout>
        <View
            android:id="@+id/arr_diving_line"
            android:background="@color/ad_1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/auto_dimen2_20"
            android:layout_marginStart="@dimen/auto_dimen2_20"
            android:layout_marginEnd="@dimen/auto_dimen2_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dest_point_view"/>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/arr_view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/arr_view_footer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/arr_diving_line"/>
        <com.autonavi.skin.view.SkinLinearLayout
            android:gravity="center_vertical"
            android:id="@+id/arr_view_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <com.autonavi.skin.view.SkinLinearLayout
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.autonavi.skin.view.SkinButton
                    android:textSize="@dimen/auto_font_size_20"
                    android:textColor="@color/nd_1_1"
                    android:id="@+id/arr_return"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/arr_btn_return"
                    android:drawableStart="@drawable/routecarresult_setting_night"/>
            </com.autonavi.skin.view.SkinLinearLayout>
            <View
                android:background="@color/ad_1"
                android:layout_width="1dp"
                android:layout_height="@dimen/auto_dimen2_40"/>
            <com.autonavi.skin.view.SkinLinearLayout
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.autonavi.skin.view.SkinButton
                    android:textSize="@dimen/auto_font_size_20"
                    android:textColor="@color/nd_1_1"
                    android:id="@+id/arr_feedback"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/arr_btn_feedback"
                    android:drawableStart="@drawable/routecarresult_setting_night"/>
            </com.autonavi.skin.view.SkinLinearLayout>
            <View
                android:background="@color/ad_1"
                android:layout_width="1dp"
                android:layout_height="@dimen/auto_dimen2_40"/>
            <com.autonavi.skin.view.SkinLinearLayout
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.autonavi.skin.view.SkinButton
                    android:textSize="@dimen/auto_font_size_20"
                    android:textColor="@color/nd_1_1"
                    android:id="@+id/arr_score"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/arr_btn_score"
                    android:drawableStart="@drawable/routecarresult_setting_night"/>
            </com.autonavi.skin.view.SkinLinearLayout>
        </com.autonavi.skin.view.SkinLinearLayout>
    </com.autonavi.skin.view.SkinConstraintLayout>
    <com.autonavi.auto.common.view.AutoGuideLine
        android:orientation="vertical"
        android:id="@+id/gl_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/auto_dimen2_424"/>
    <com.autonavi.view.custom.CustomAutologoView
        android:id="@+id/ca_autologo"
        android:background="@color/auto_map_light_logo_bg"
        android:visibility="gone"
        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_12"
        android:layout_marginBottom="@dimen/auto_dimen2_24"
        android:layout_marginStart="@dimen/auto_dimen2_24"
        app:background4Night="@color/auto_map_dark_logo_bg"
        app:background4Skin="@color/auto_map_light_logo_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.autonavi.view.custom.CustomAutoScaleLineView
        android:id="@+id/casl_scale"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/auto_dimen2_1"
        android:layout_marginBottom="@dimen/auto_dimen2_6"
        app:layout_constraintBottom_toTopOf="@+id/ca_autologo"
        app:layout_constraintStart_toStartOf="@+id/ca_autologo"/>
    <com.autonavi.view.custom.CustomBtnCircular3View
        android:id="@+id/cbc_zoom_btn"
        android:visibility="gone"
        android:layout_width="@dimen/auto_dimen2_64"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/auto_dimen2_24"
        android:layout_marginBottom="@dimen/auto_dimen2_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:shadowColor="@color/auto_ui_000000_33"
        app:shadowColorNight="@color/auto_ui_000000_33"
        app:shadowCorner="@dimen/auto_dimen2_6"
        app:shadowCornerBottomLeft="@dimen/auto_dimen2_0"
        app:shadowCornerBottomRight="@dimen/auto_dimen2_0"
        app:shadowCornerTopLeft="@dimen/auto_dimen2_0"
        app:shadowCornerTopRight="@dimen/auto_dimen2_0"
        app:shadowDx="@dimen/auto_dimen2_0"
        app:shadowDy="@dimen/auto_dimen2_2"
        app:shadowRadius="@dimen/auto_dimen2_8"
        app:shadowShapeType="rectangle"
        app:shadowSide="all"
        app:shadowVisibility="true"/>
</com.autonavi.skin.view.SkinConstraintLayout>
