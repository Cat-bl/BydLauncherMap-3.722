<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_top_status_ar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.view.custom.CustomBarStatusBgArView
        android:id="@+id/cbsba_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_left_margin"
        android:layout_width="@dimen/auto_dimen2_14"
        android:layout_height="@dimen/auto_dimen2_1"
        android:layout_marginTop="@dimen/auto_dimen2_36"
        android:layout_marginRight="@dimen/auto_dimen2_2"
        android:layout_marginBottom="@dimen/auto_dimen2_35"
        app:layout_constraintBottom_toBottomOf="@+id/cbsba_bg"
        app:layout_constraintEnd_toStartOf="@+id/siv_phone"
        app:layout_constraintTop_toTopOf="@+id/cbsba_bg"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_right_margin"
        android:layout_width="@dimen/auto_dimen2_2"
        android:layout_height="@dimen/auto_dimen2_1"
        android:layout_marginTop="@dimen/auto_dimen2_36"
        android:layout_marginBottom="@dimen/auto_dimen2_35"
        app:layout_constraintBottom_toBottomOf="@+id/cbsba_bg"
        app:layout_constraintEnd_toEndOf="@+id/cbsba_bg"
        app:layout_constraintTop_toTopOf="@+id/cbsba_bg"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_phone"
        android:background="@drawable/custom_ac_layout_phone"
        android:layout_width="@dimen/auto_dimen2_28"
        android:layout_height="@dimen/auto_dimen2_28"
        android:layout_marginTop="@dimen/auto_dimen2_22"
        android:layout_marginRight="@dimen/auto_dimen2_10"
        android:layout_marginBottom="@dimen/auto_dimen2_22"
        app:background4Skin="@drawable/custom_ac_layout_phone"
        app:layout_constraintBottom_toBottomOf="@+id/cbsba_bg"
        app:layout_constraintEnd_toStartOf="@+id/siv_wifi"
        app:layout_constraintTop_toTopOf="@+id/cbsba_bg"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_wifi"
        android:background="@drawable/custom_ac_layout_wifi"
        android:layout_width="@dimen/auto_dimen2_32"
        android:layout_height="@dimen/auto_dimen2_32"
        android:layout_marginTop="@dimen/auto_dimen2_20"
        android:layout_marginRight="@dimen/auto_dimen2_15"
        android:layout_marginBottom="@dimen/auto_dimen2_20"
        app:background4Skin="@drawable/custom_ac_layout_wifi"
        app:layout_constraintBottom_toBottomOf="@+id/cbsba_bg"
        app:layout_constraintEnd_toStartOf="@+id/siv_volumn"
        app:layout_constraintTop_toTopOf="@+id/cbsba_bg"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_gps"
        android:background="@drawable/custom_ac_layout_gps"
        android:layout_width="@dimen/auto_dimen2_24"
        android:layout_height="@dimen/auto_dimen2_24"
        android:layout_marginTop="@dimen/auto_dimen2_24"
        android:layout_marginRight="@dimen/auto_dimen2_14"
        android:layout_marginBottom="@dimen/auto_dimen2_24"
        app:background4Skin="@drawable/custom_ac_layout_gps"
        app:layout_constraintBottom_toBottomOf="@+id/cbsba_bg"
        app:layout_constraintEnd_toStartOf="@+id/stv_time"
        app:layout_constraintTop_toTopOf="@+id/cbsba_bg"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_volumn"
        android:background="@drawable/custom_ac_layout_volumn"
        android:layout_width="@dimen/auto_dimen2_28"
        android:layout_height="@dimen/auto_dimen2_28"
        android:layout_marginTop="@dimen/auto_dimen2_22"
        android:layout_marginRight="@dimen/auto_dimen2_15"
        android:layout_marginBottom="@dimen/auto_dimen2_22"
        app:background4Skin="@drawable/custom_ac_layout_volumn"
        app:layout_constraintBottom_toBottomOf="@+id/cbsba_bg"
        app:layout_constraintEnd_toStartOf="@+id/siv_gps"
        app:layout_constraintTop_toTopOf="@+id/cbsba_bg"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_28"
        android:textColor="@color/auto_ui_bdcade"
        android:gravity="left"
        android:id="@+id/stv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_18"
        android:layout_marginRight="@dimen/auto_dimen2_14"
        android:layout_marginBottom="@dimen/auto_dimen2_18"
        android:lineSpacingExtra="@dimen/auto_dimen2_8"
        app:layout_constraintBottom_toBottomOf="@+id/cbsba_bg"
        app:layout_constraintEnd_toStartOf="@+id/siv_right_margin"
        app:layout_constraintTop_toTopOf="@+id/cbsba_bg"
        app:textColor4Skin="@color/auto_ui_bdcade"/>
</merge>
