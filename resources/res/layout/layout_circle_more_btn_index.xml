<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_circle_more_btn"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024"
    app:tag="DisableAtRunTime">
    <com.autonavi.view.custom.CustomBtnMoreView
        android:id="@+id/cbm_more"
        android:layout_width="@dimen/auto_dimen2_80"
        android:layout_height="@dimen/auto_dimen2_80"
        android:layout_marginLeft="@dimen/auto_dimen2_6"
        android:layout_marginTop="@dimen/auto_dimen2_3"
        android:layout_marginRight="@dimen/auto_dimen2_6"
        android:layout_marginBottom="@dimen/auto_dimen2_9"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shadowColor="@color/auto_ui_000000_33"
        app:shadowColorNight="@color/auto_ui_000000_33"
        app:shadowCorner="@dimen/auto_dimen2_40"
        app:shadowCornerBottomLeft="@dimen/auto_dimen2_0"
        app:shadowCornerBottomRight="@dimen/auto_dimen2_0"
        app:shadowCornerTopLeft="@dimen/auto_dimen2_0"
        app:shadowCornerTopRight="@dimen/auto_dimen2_0"
        app:shadowDx="@dimen/auto_dimen2_0"
        app:shadowDy="@dimen/auto_dimen2_3"
        app:shadowRadius="@dimen/auto_dimen2_6"
        app:shadowShapeType="rectangle"
        app:shadowSide="all"
        app:shadowVisibility="true"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_more_icon"
        android:background="@drawable/index_more_icon_day_bg_selector"
        android:layout_width="@dimen/auto_dimen2_40"
        android:layout_height="@dimen/auto_dimen2_40"
        app:background4Night="@drawable/index_more_icon_night_bg_selector"
        app:background4Skin="@drawable/index_more_icon_day_bg_selector"
        app:layout_constraintBottom_toBottomOf="@+id/cbm_more"
        app:layout_constraintEnd_toEndOf="@+id/cbm_more"
        app:layout_constraintStart_toStartOf="@+id/cbm_more"
        app:layout_constraintTop_toTopOf="@+id/cbm_more"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_more_head"
        android:layout_width="@dimen/auto_dimen2_80"
        android:layout_height="@dimen/auto_dimen2_80"
        android:layout_marginLeft="@dimen/auto_dimen2_6"
        android:layout_marginTop="@dimen/auto_dimen2_3"
        android:layout_marginRight="@dimen/auto_dimen2_6"
        android:layout_marginBottom="@dimen/auto_dimen2_9"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/siv_more_head_circle_bg"
            android:background="@drawable/index_more_head_circle_bg_day"
            android:layout_width="@dimen/auto_dimen2_80"
            android:layout_height="@dimen/auto_dimen2_80"
            app:background4Night="@drawable/index_more_head_circle_bg_night"
            app:background4Skin="@drawable/index_more_head_circle_bg_day"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
    <com.autonavi.view.custom.CustomHeadView
        android:id="@+id/ch_more_head"
        android:visibility="gone"
        android:layout_width="@dimen/auto_dimen2_80"
        android:layout_height="@dimen/auto_dimen2_80"
        android:layout_marginLeft="@dimen/auto_dimen2_6"
        android:layout_marginTop="@dimen/auto_dimen2_3"
        android:layout_marginRight="@dimen/auto_dimen2_6"
        android:layout_marginBottom="@dimen/auto_dimen2_9"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.view.custom.CustomRedPointSmallView
        android:id="@+id/crps_more"
        android:layout_width="@dimen/auto_dimen2_12"
        android:layout_height="@dimen/auto_dimen2_12"
        android:layout_marginTop="@dimen/auto_dimen2_11"
        android:layout_marginRight="@dimen/auto_dimen2_2"
        app:layout_constraintEnd_toEndOf="@+id/cbm_more"
        app:layout_constraintTop_toTopOf="@+id/cbm_more"/>
</com.autonavi.skin.view.SkinConstraintLayout>
