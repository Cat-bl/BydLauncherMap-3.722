<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center_horizontal"
    android:id="@+id/search_home_have_history_login_tip_layout"
    android:layout_width="match_parent"
    android:layout_height="@dimen/auto_dimen2_56">
    <com.autonavi.view.custom.CustomListPressedView
        android:id="@+id/search_home_login_tip_layout_delete"
        android:layout_width="@dimen/auto_dimen2_32"
        android:layout_height="@dimen/auto_dimen2_32"
        android:layout_marginEnd="@dimen/auto_dimen2_32"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:background="@drawable/icon_public_close_day"
        android:layout_width="@dimen/auto_dimen2_32"
        android:layout_height="@dimen/auto_dimen2_32"
        app:background4Night="@drawable/icon_public_close_night"
        app:background4Skin="@drawable/icon_public_close_day"
        app:layout_constraintBottom_toBottomOf="@+id/search_home_login_tip_layout_delete"
        app:layout_constraintEnd_toEndOf="@+id/search_home_login_tip_layout_delete"
        app:layout_constraintStart_toStartOf="@+id/search_home_login_tip_layout_delete"
        app:layout_constraintTop_toTopOf="@+id/search_home_login_tip_layout_delete"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/auto_dimen2_40"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_16"
            android:textColor="@color/sys_inverseColor_default_dark"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/search_home_have_history_login_tip_stv"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/auto_dimen2_40"
            android:text="@string/search_home_have_history_login_tip"
            android:singleLine="true"
            app:textColor4Night="@color/sys_color_default"
            app:textColor4Skin="@color/sys_inverseColor_default_dark"/>
        <com.autonavi.skin.view.SkinTextView
            android:enabled="true"
            android:textSize="@dimen/auto_font_size_14"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/search_home_have_history_login_stv"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/auto_dimen2_32"
            android:minWidth="@dimen/auto_dimen2_112"
            android:text="@string/search_home_have_history_login_btn_text"
            android:singleLine="true"
            android:paddingStart="@dimen/sys_padding_l"
            android:paddingEnd="@dimen/sys_padding_l"
            android:layout_marginStart="@dimen/auto_dimen2_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/search_home_have_history_login_tip_stv"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/SysBtnSmallPrimary"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
