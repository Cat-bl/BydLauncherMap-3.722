<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_scl_home_login"
    android:background="@drawable/custom_card_view_bg_day"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:background4Night="@drawable/custom_home_card_bg_night"
    app:background4Skin="@drawable/custom_card_view_bg_day">
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/scl_home_login"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/siv_login_card_close"
            android:layout_width="@dimen/sys_padding_xxl"
            android:layout_height="@dimen/sys_padding_xxl"
            android:layout_marginTop="@dimen/sys_padding_l"
            android:layout_marginStart="@dimen/sys_padding_l"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_18"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/stv_login_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_login_card_tip"
            android:maxLines="2"
            android:paddingStart="@dimen/auto_dimen2_56"
            android:paddingEnd="@dimen/auto_dimen2_56"
            app:layout_constraintBottom_toBottomOf="@+id/siv_login_card_close"
            app:layout_constraintTop_toTopOf="@+id/siv_login_card_close"
            app:textColor4Night="@color/sys_color_default"/>
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/siv_login_picture"
            android:layout_width="0dp"
            android:layout_height="@dimen/auto_dimen2_106"
            android:layout_marginTop="@dimen/auto_dimen2_22"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/siv_login_card_close"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_14"
            android:gravity="center"
            android:id="@+id/stv_login_btn"
            android:layout_width="@dimen/auto_dimen2_160"
            android:layout_height="@dimen/auto_dimen2_32"
            android:layout_marginTop="@dimen/sys_padding_xl"
            android:layout_marginBottom="@dimen/auto_dimen2_24"
            android:text="@string/home_login_card_button_text"
            android:paddingStart="@dimen/auto_dimen2_22"
            android:paddingEnd="@dimen/auto_dimen2_22"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/siv_login_picture"
            style="@style/SysBtnMediumPrimary"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/scl_home_login_scan_code"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/siv_login_scan_code_close"
            android:layout_width="@dimen/sys_padding_xxl"
            android:layout_height="@dimen/sys_padding_xxl"
            android:layout_marginTop="@dimen/sys_padding_l"
            android:layout_marginStart="@dimen/sys_padding_l"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_18"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/stv_login_scan_code_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_login_scan_code_card_tip"
            android:maxLines="2"
            android:paddingStart="@dimen/auto_dimen2_63"
            android:paddingEnd="@dimen/auto_dimen2_63"
            app:layout_constraintBottom_toBottomOf="@+id/siv_login_scan_code_close"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/siv_login_scan_code_close"
            app:textColor4Night="@color/sys_color_default"/>
        <com.autonavi.skin.view.SkinRelativeLayout
            android:id="@+id/qr_layout"
            android:background="@drawable/refresh_code_bg_day"
            android:layout_width="@dimen/auto_dimen2_160"
            android:layout_height="@dimen/auto_dimen2_160"
            android:layout_marginTop="@dimen/auto_dimen2_18"
            android:layout_marginBottom="@dimen/auto_dimen2_24"
            android:layout_centerHorizontal="true"
            app:background4Night="@drawable/refresh_code_bg"
            app:background4Skin="@drawable/refresh_code_bg_day"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/siv_login_scan_code_close">
            <com.autonavi.skin.view.SkinRelativeLayout
                android:gravity="center"
                android:id="@+id/clsv_qr_loading_"
                android:background="@drawable/byd_custom_qrcode_background_day"
                android:visibility="visible"
                android:layout_width="@dimen/auto_dimen2_160"
                android:layout_height="@dimen/auto_dimen2_160"
                android:layout_centerInParent="true"
                app:background4Night="@drawable/byd_custom_qrcode_background_night"
                app:background4Skin="@drawable/byd_custom_qrcode_background_day">
                <com.autonavi.view.custom.CustomLoadingSmallView
                    android:id="@+id/clsv_qr_loading"
                    android:visibility="invisible"
                    android:layout_width="@dimen/auto_dimen2_32"
                    android:layout_height="@dimen/auto_dimen2_32"
                    android:layout_centerInParent="true"/>
            </com.autonavi.skin.view.SkinRelativeLayout>
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/img_code"
                android:layout_width="@dimen/auto_dimen2_160"
                android:layout_height="@dimen/auto_dimen2_160"
                android:scaleType="fitXY"
                android:layout_centerHorizontal="true"/>
            <com.autonavi.skin.view.SkinRelativeLayout
                android:gravity="center"
                android:id="@+id/img_code_time_out"
                android:background="@drawable/byd_custom_qrcode_background_day"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="刷新"
                app:background4Night="@drawable/byd_custom_qrcode_background_night"
                app:background4Skin="@drawable/byd_custom_qrcode_background_day">
                <com.autonavi.skin.view.SkinImageView
                    android:id="@+id/img_code_refresh"
                    android:layout_width="@dimen/auto_dimen2_32"
                    android:layout_height="@dimen/auto_dimen2_32"
                    android:src="@drawable/refresh_code_day_r"
                    android:scaleType="fitXY"
                    android:layout_centerHorizontal="true"
                    app:src4Night="@drawable/refresh_code_night_r"
                    app:src4Skin="@drawable/refresh_code_day_r"/>
            </com.autonavi.skin.view.SkinRelativeLayout>
        </com.autonavi.skin.view.SkinRelativeLayout>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
