<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_auto_search_result_map"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.view.custom.CustomBtnCircular3View
        android:id="@+id/cbc_zoom"
        android:layout_width="@dimen/auto_dimen2_56"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/auto_dimen2_15"
        android:layout_marginEnd="@dimen/auto_dimen2_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:shadowColor="@color/auto_ui_000000_33"
        app:shadowColorNight="@color/auto_ui_000000_33"
        app:shadowCorner="@dimen/auto_dimen2_6"
        app:shadowCornerBottomLeft="@dimen/auto_dimen2_0"
        app:shadowCornerBottomRight="@dimen/auto_dimen2_0"
        app:shadowCornerTopLeft="@dimen/auto_dimen2_0"
        app:shadowCornerTopRight="@dimen/auto_dimen2_0"
        app:shadowDx="@dimen/auto_dimen2_0"
        app:shadowDy="@dimen/auto_dimen2_2"
        app:shadowRadius="@dimen/auto_dimen2_8"
        app:shadowShapeType="rectangle"
        app:shadowSide="all"
        app:shadowVisibility="true"/>
    <com.autonavi.view.custom.CustomAutoScaleLineView
        android:id="@+id/casl_scale_line"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/auto_dimen2_32"
        android:layout_marginRight="@dimen/auto_dimen2_24"
        android:layout_marginBottom="@dimen/auto_dimen2_6"
        app:layout_constraintBottom_toTopOf="@+id/ca_autologo"
        app:layout_constraintEnd_toStartOf="@+id/cbc_zoom"/>
    <com.autonavi.view.custom.CustomAutologoView
        android:id="@+id/ca_autologo"
        android:background="@color/auto_map_light_logo_bg"
        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_12"
        android:layout_marginBottom="@dimen/auto_dimen2_2"
        app:background4Night="@color/auto_map_dark_logo_bg"
        app:background4Skin="@color/auto_map_light_logo_bg"
        app:layout_constraintBottom_toBottomOf="@+id/cbc_zoom"
        app:layout_constraintEnd_toEndOf="@+id/casl_scale_line"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_back_to_car"
        android:background="@drawable/index_light_home_go_car_bg"
        android:visibility="gone"
        android:layout_width="@dimen/auto_dimen2_160"
        android:layout_height="@dimen/auto_dimen2_48"
        android:layout_marginBottom="@dimen/auto_dimen2_28"
        app:background4Night="@drawable/index_dark_home_go_car_bg"
        app:background4Skin="@drawable/index_light_home_go_car_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_18"
            android:textColor="@color/auto_color_ffffff"
            android:gravity="center"
            android:id="@+id/stv_text_back_toccp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/index_text_back_toccp"
            android:lineSpacingExtra="@dimen/auto_dimen2_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_search_result_all"
        android:layout_width="@dimen/auto_dimen2_400"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/style_card_bg">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_20"
            android:textColor="@color/byd_search_text_day"
            android:id="@+id/stv_map_select_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_16"
            android:text="@string/search_map_select_tip"
            android:lineSpacingExtra="@dimen/auto_dimen2_4"
            android:layout_marginStart="@dimen/auto_dimen2_24"
            android:layout_marginEnd="@dimen/auto_dimen2_8"
            app:layout_constraintEnd_toStartOf="@+id/siv_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/byd_search_text_night"
            app:textColor4Skin="@color/byd_search_text_day"/>
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/siv_back"
            android:background="@drawable/custom_close_btn_selector_day"
            android:layout_width="@dimen/auto_dimen2_48"
            android:layout_height="@dimen/auto_dimen2_48"
            android:layout_margin="@dimen/auto_dimen2_8"
            android:contentDescription="关闭"
            app:background4Night="@drawable/custom_close_btn_selector_night"
            app:background4Skin="@drawable/custom_close_btn_selector_day"
            app:layout_constraintBottom_toBottomOf="@+id/stv_map_select_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/stv_map_select_name"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_18"
            android:textColor="@color/byd_search_text_day_70"
            android:id="@+id/stv_map_select_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_12"
            android:text="@string/search_map_select_tip_around"
            android:lineSpacingExtra="@dimen/auto_dimen2_4"
            app:layout_constraintEnd_toEndOf="@+id/stv_map_select_name"
            app:layout_constraintStart_toStartOf="@+id/stv_map_select_name"
            app:layout_constraintTop_toBottomOf="@+id/stv_map_select_name"
            app:textColor4Night="@color/byd_search_text_night_70"
            app:textColor4Skin="@color/byd_search_text_day_70"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_20"
            android:textColor="@color/byd_search_text_day"
            android:id="@+id/stv_map_select_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_20"
            android:text="@string/search_map_select_move_to_chose"
            android:lineSpacingExtra="@dimen/auto_dimen2_4"
            app:layout_constraintStart_toStartOf="@+id/stv_map_select_address"
            app:layout_constraintTop_toBottomOf="@+id/stv_map_select_address"
            app:textColor4Night="@color/byd_search_text_night"
            app:textColor4Skin="@color/byd_search_text_day"/>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/scl_set_location_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/stv_map_select_tip"
            app:tag="DisableAtRunTime">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/byd_custom_highlight_btn_text_color_selector_day"
                android:gravity="center"
                android:id="@+id/stv_set_location"
                android:background="@drawable/byd_custom_highlight_btn_bg_selector_day"
                android:layout_width="@dimen/auto_dimen2_280"
                android:layout_height="@dimen/auto_dimen2_40"
                android:layout_marginTop="@dimen/auto_dimen2_24"
                android:layout_marginBottom="@dimen/auto_dimen2_24"
                android:text="@string/index_set_here"
                android:lineSpacingExtra="@dimen/auto_dimen2_4"
                app:background4Night="@drawable/byd_custom_highlight_btn_bg_selector_night"
                app:background4Skin="@drawable/byd_custom_highlight_btn_bg_selector_day"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:textColor4Night="@color/byd_custom_highlight_btn_text_color_selector_night"
                app:textColor4Skin="@color/byd_custom_highlight_btn_text_color_selector_day"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
