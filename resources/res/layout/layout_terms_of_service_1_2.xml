<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_setting_content"
    android:background="@drawable/icon_setting_day_app_bg_h"
    android:paddingTop="@dimen/auto_dimen2_60"
    android:paddingBottom="@dimen/auto_dimen2_60"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:background4Night="@drawable/icon_setting_dark_app_bg_h"
    app:background4Skin="@drawable/icon_setting_day_app_bg_h"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.auto.common.view.AutoGuideLine
        android:orientation="vertical"
        android:id="@+id/gl_around"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="1"
        app:layout_constraintGuide_percent4Landscape="1"
        app:layout_constraintGuide_percent4LandscapeWide="0.8"/>
    <com.autonavi.auto.common.view.AutoGuideLine
        android:orientation="vertical"
        android:id="@+id/gl_around_v_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.03"/>
    <com.autonavi.auto.common.view.AutoGuideLine
        android:orientation="vertical"
        android:id="@+id/gl_around_v_97"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.97"/>
    <com.autonavi.skin.view.SkinTextView
        android:id="@+id/setting_about_content_back_hotspot"
        android:background="@drawable/custom_list_pressed_list_day_bg_selector"
        android:layout_width="@dimen/auto_dimen2_60"
        android:layout_height="@dimen/auto_dimen2_60"
        android:layout_marginTop="@dimen/auto_dimen2_12"
        android:layout_marginStart="@dimen/auto_dimen2_35"
        app:background4Night="@drawable/custom_list_pressed_list_night_bg_selector"
        app:background4Skin="@drawable/custom_list_pressed_list_day_bg_selector"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/setting_about_content_back"
        android:background="@drawable/icon_setting_back_land_day"
        android:layout_width="@dimen/auto_dimen2_60"
        android:layout_height="@dimen/auto_dimen2_60"
        android:layout_marginTop="@dimen/auto_dimen2_12"
        android:contentDescription="返回"
        android:layout_marginStart="@dimen/auto_dimen2_35"
        app:background4Night="@drawable/icon_setting_back_land_night"
        app:background4Skin="@drawable/icon_setting_back_land_day"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_25"
        android:textColor="@color/custom_text_day_color_85"
        android:gravity="center_vertical"
        android:id="@+id/setting_about_content_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_other_about"
        android:layout_marginEnd="@dimen/auto_dimen2_40"
        app:layout_constraintBottom_toBottomOf="@+id/setting_about_content_back"
        app:layout_constraintStart_toEndOf="@+id/setting_about_content_back"
        app:layout_constraintTop_toTopOf="@+id/setting_about_content_back"
        app:textColor4Night="@color/custom_text_night_color_85"
        app:textColor4Skin="@color/custom_text_day_color_85"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/setting_about_content_refreash_bg"
        android:background="@drawable/custom_list_pressed_list_day_bg_selector"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/auto_dimen2_60"
        android:layout_marginTop="@dimen/auto_dimen2_12"
        android:contentDescription="更新"
        android:layout_marginEnd="@dimen/auto_dimen2_29"
        app:background4Night="@drawable/custom_list_pressed_list_night_bg_selector"
        app:background4Skin="@drawable/custom_list_pressed_list_day_bg_selector"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/setting_about_content_refreash"
            android:background="@drawable/icon_setting_img_about_content_refresh_day"
            android:layout_width="@dimen/auto_dimen2_60"
            android:layout_height="@dimen/auto_dimen2_60"
            android:layout_marginTop="@dimen/auto_dimen2_12"
            android:layout_marginEnd="@dimen/auto_dimen2_100"
            app:background4Night="@drawable/icon_setting_img_about_content_refresh1_land_night"
            app:background4Skin="@drawable/icon_setting_img_about_content_refresh_day"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_22"
            android:textColor="@color/custom_text_day_color_85"
            android:gravity="center"
            android:id="@+id/setting_about_content_refreash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_other_refash"
            app:layout_constraintBottom_toBottomOf="@+id/setting_about_content_refreash"
            app:layout_constraintStart_toEndOf="@+id/setting_about_content_refreash"
            app:layout_constraintTop_toTopOf="@+id/setting_about_content_refreash"
            app:textColor4Night="@color/custom_text_night_color_85"
            app:textColor4Skin="@color/custom_text_day_color_85"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/setting_about_img_no_wifi"
        android:background="@drawable/icon_setting_img_other_about_img_no_network_land_day"
        android:layout_width="@dimen/auto_dimen2_120"
        android:layout_height="@dimen/auto_dimen2_120"
        android:layout_marginTop="@dimen/auto_dimen2_120"
        app:background4Night="@drawable/icon_setting_img_other_about_img_no_network_land_night"
        app:background4Skin="@drawable/icon_setting_img_other_about_img_no_network_land_day"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/setting_about_content_title"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_20"
        android:textColor="@color/custom_text_day_color_70"
        android:gravity="center"
        android:id="@+id/setting_about_tv_no_wifi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_10"
        android:text="@string/setting_about_no_wifi"
        android:lineSpacingExtra="@dimen/auto_dimen2_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/setting_about_img_no_wifi"
        app:textColor4Night="@color/custom_text_night_color_70"
        app:textColor4Skin="@color/custom_text_day_color_70"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/custom_text_day_color_55"
        android:gravity="center"
        android:id="@+id/setting_about_tv_no_wifi_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_10"
        android:text="@string/setting_about_no_wifi_retry"
        android:lineSpacingExtra="@dimen/auto_dimen2_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/setting_about_tv_no_wifi"
        app:textColor4Night="@color/custom_text_night_color_55"
        app:textColor4Skin="@color/custom_text_day_color_55"/>
    <com.autonavi.view.custom.CustomLoadingSmallView
        android:id="@+id/setting_about_content_loading"
        android:layout_width="@dimen/auto_dimen2_40"
        android:layout_height="@dimen/auto_dimen2_40"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/setting_about_content_title"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_22"
        android:textColor="@color/custom_text_day_color_70"
        android:gravity="center"
        android:id="@+id/setting_about_content_loading_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_10"
        android:text="@string/loading"
        android:lineSpacingExtra="@dimen/auto_dimen2_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/setting_about_content_loading"
        app:textColor4Night="@color/custom_text_night_color_70"
        app:textColor4Skin="@color/custom_text_day_color_70"/>
    <ScrollView
        android:scrollbarThumbVertical="@color/byd_scrollview_bar_color"
        android:scrollbarStyle="outsideInset"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/auto_dimen2_25"
        android:layout_marginBottom="@dimen/auto_dimen2_28"
        android:contentDescription="服务协议内容|纵向"
        android:fadeScrollbars="false"
        android:layout_marginStart="@dimen/auto_dimen2_60"
        android:layout_marginEnd="@dimen/auto_dimen2_60"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/setting_about_content_title">
        <com.autonavi.skin.view.SkinTextViewTwo
            android:textSize="@dimen/auto_font_size_25"
            android:textColor="@color/custom_text_day_color_85"
            android:textColorLink="@color/auto_color_00ACEB"
            android:id="@+id/setting_about_content_tv"
            android:background="#00000000"
            android:visibility="visible"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:layout_marginEnd="@dimen/auto_dimen2_15"
            app:textColor4Night="@color/auto_color_D9DAE1EB"
            app:textColor4Skin="@color/custom_text_day_color_85"/>
    </ScrollView>
    <com.autonavi.skin.view.byd.SkinBydButton
        android:id="@+id/setting_about_content_btn_got_it"
        android:visibility="gone"
        android:layout_width="@dimen/auto_dimen2_176"
        android:layout_height="@dimen/auto_dimen2_48"
        android:layout_marginBottom="@dimen/auto_dimen2_32"
        android:text="@string/main_map_version_tip_btn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/SysBtnMediumSecondary"/>
</com.autonavi.skin.view.SkinConstraintLayout>
