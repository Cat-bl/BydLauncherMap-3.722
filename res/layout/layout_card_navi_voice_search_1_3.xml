<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout
    android:id="@id/cl_navigation_info"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 1/3 模式沿用 722 的导航信息控件，仅调整为纵向窄窗结构。 -->
    <include
        android:id="@id/ac_navigation_info"
        android:layout_width="match_parent"
        android:layout_height="@dimen/auto_dimen2_72"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_voice_search_tbt_view" />

    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@id/cc_bg"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:layout_marginTop="@dimen/auto_dimen2_12"
        android:background="@drawable/custom_normal_card_bg_day"
        app:background4Night="@drawable/custom_normal_card_bg_night"
        app:background4Skin="@drawable/custom_normal_card_bg_day"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ac_navigation_info"
        style="@style/custom_card_shadow_style">

        <com.autonavi.skin.view.SkinImageView
            android:id="@id/siv_back"
            android:layout_marginStart="@dimen/auto_dimen2_16"
            android:layout_marginTop="@dimen/auto_dimen2_8"
            android:contentDescription="返回"
            android:src="@drawable/icon_public_back"
            app:layout_constraintStart_toStartOf="@id/cc_bg"
            app:layout_constraintTop_toTopOf="@id/cc_bg"
            style="@style/SysIconBtn" />

        <com.autonavi.skin.view.SkinTextView
            android:id="@id/stv_panel_title"
            android:layout_width="0.0dp"
            android:layout_height="@dimen/auto_dimen2_48"
            android:layout_marginEnd="@dimen/auto_dimen2_16"
            android:ellipsize="end"
            android:gravity="center"
            android:paddingLeft="@dimen/auto_dimen2_32"
            android:singleLine="true"
            android:text="@string/tv_title_select_passing_point"
            android:textSize="@dimen/text_size_head_2"
            app:layout_constraintBottom_toBottomOf="@id/siv_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/siv_back"
            app:layout_constraintTop_toTopOf="@id/siv_back"
            style="@style/SysDefaultColorTextColor" />

        <com.autonavi.demo.view.fragment.framework.widget.pullToRefresh.PullToRefreshListView
            android:id="@id/slv_search_result"
            android:layout_width="0.0dp"
            android:layout_height="0.0dp"
            android:layout_marginBottom="@dimen/auto_dimen2_10"
            android:layout_marginEnd="@dimen/auto_dimen2_8"
            android:cacheColorHint="@color/auto_ui_000000_00"
            android:contentDescription="导航记录列表|纵向"
            android:divider="@null"
            android:dividerHeight="0.0dp"
            android:fastScrollEnabled="false"
            android:footerDividersEnabled="false"
            android:headerDividersEnabled="false"
            android:listSelector="@color/auto_ui_000000_00"
            android:paddingBottom="@dimen/auto_dimen2_10"
            android:scrollbarThumbVertical="@drawable/byd_custom_scrollbar_thumb_day"
            app:layout_constraintBottom_toBottomOf="@id/cc_bg"
            app:layout_constraintEnd_toEndOf="@id/cc_bg"
            app:layout_constraintStart_toStartOf="@id/cc_bg"
            app:layout_constraintTop_toBottomOf="@id/stv_panel_title"
            app:scrollbarThumbVertical4Night="@drawable/byd_custom_scrollbar_thumb_night"
            app:scrollbarThumbVertical4Skin="@drawable/byd_custom_scrollbar_thumb_day" />

        <com.autonavi.skin.view.SkinView
            android:layout_width="0.0dp"
            android:layout_height="@dimen/navi_voice_search_list_bottom_fade_height"
            android:layout_alignParentBottom="true"
            android:background="@drawable/shape_voice_listview_edge_gradient_day"
            android:visibility="invisible"
            app:background4Night="@drawable/shape_voice_listview_edge_gradient_night"
            app:background4Skin="@drawable/shape_voice_listview_edge_gradient_day"
            app:layout_constraintBottom_toBottomOf="@id/cc_bg"
            app:layout_constraintEnd_toEndOf="@id/slv_search_result"
            app:layout_constraintStart_toStartOf="@id/slv_search_result" />

        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@id/cl_no_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_88"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/cc_bg"
            app:layout_constraintStart_toStartOf="@id/cc_bg"
            app:layout_constraintTop_toBottomOf="@id/stv_panel_title"
            app:layout_constraintVertical_bias="0.1">

            <com.autonavi.skin.view.SkinConstraintLayout
                android:id="@id/cdw_default_wrong"
                android:layout_width="@dimen/auto_dimen2_208"
                android:layout_height="@dimen/auto_dimen2_208"
                android:background="@drawable/auto_search_bg_no_data"
                app:background4Night="@drawable/auto_search_bg_no_data"
                app:background4Skin="@drawable/auto_search_bg_no_data"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.autonavi.skin.view.SkinTextView
                android:id="@id/stv_text_describe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/auto_dimen2_4"
                android:text="@string/tv_no_find_result"
                android:textColor="@color/byd_search_text_day_70"
                android:textSize="@dimen/auto_font_size_16"
                app:layout_constraintEnd_toEndOf="@id/cdw_default_wrong"
                app:layout_constraintStart_toStartOf="@id/cdw_default_wrong"
                app:layout_constraintTop_toBottomOf="@id/cdw_default_wrong"
                app:textColor4Night="@color/byd_search_text_night_70"
                app:textColor4Skin="@color/byd_search_text_day_70" />
        </com.autonavi.skin.view.SkinConstraintLayout>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
