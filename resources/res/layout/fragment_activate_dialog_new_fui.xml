<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_dialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_center"
        android:background="@drawable/byd_custom_dialog_dialog_m_day_bg_selector"
        android:layout_width="@dimen/auto_dimen2_560"
        android:layout_height="@dimen/auto_dimen2_312"
        app:background4Night="@drawable/byd_custom_dialog_dialog_m_day_bg_selector"
        app:background4Skin="@drawable/byd_custom_dialog_dialog_m_day_bg_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.skin.view.SkinLinearLayout
            android:gravity="center_horizontal"
            android:id="@+id/cl_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/auto_dimen2_28"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/byd_text_450_5_textcolor_day_setting_selector"
                android:gravity="center"
                android:id="@+id/stv_left"
                android:background="@drawable/byd_custom_bar_downloading1_loading2_progress_presses_night"
                android:layout_width="@dimen/auto_dimen2_176"
                android:layout_height="@dimen/auto_dimen2_48"
                android:text="@string/dialog_left"
                app:background4Night="@drawable/byd_custom_bar_downloading1_loading2_progress_presses_night"
                app:background4Skin="@drawable/byd_custom_bar_downloading1_loading2_progress_presses_night"
                app:textColor4Night="@color/byd_text_450_5_textcolor_day_setting_selector"
                app:textColor4Skin="@color/byd_text_450_5_textcolor_day_setting_selector"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/byd_text_450_1_textcolor_day_selector"
                android:gravity="center"
                android:id="@+id/stv_right"
                android:background="@drawable/byd_custom_btn_function_btn_function1_day_bg_selector"
                android:layout_width="@dimen/auto_dimen2_176"
                android:layout_height="@dimen/auto_dimen2_48"
                android:text="@string/dialog_right"
                android:layout_marginStart="@dimen/auto_dimen2_48"
                app:background4Night="@drawable/byd_custom_btn_function_btn_function1_day_bg_selector"
                app:background4Skin="@drawable/byd_custom_btn_function_btn_function1_day_bg_selector"
                app:shadowColor="@color/auto_ui_000000_b3"
                app:shadowCorner="@dimen/auto_dimen2_6"
                app:shadowCornerBottomLeft="@dimen/auto_dimen2_0"
                app:shadowCornerBottomRight="@dimen/auto_dimen2_0"
                app:shadowCornerTopLeft="@dimen/auto_dimen2_0"
                app:shadowCornerTopRight="@dimen/auto_dimen2_0"
                app:shadowDx="@dimen/auto_dimen2_0"
                app:shadowRadius="@dimen/auto_dimen2_8"
                app:shadowShapeType="rectangle"
                app:shadowSide="all"
                app:shadowVisibility="true"
                app:textColor4Night="@color/byd_text_450_1_textcolor_day_selector"
                app:textColor4Skin="@color/byd_text_450_1_textcolor_day_selector"/>
        </com.autonavi.skin.view.SkinLinearLayout>
        <com.autonavi.skin.view.SkinLinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auto_dimen2_0"
            android:layout_marginTop="@dimen/auto_dimen2_22"
            app:layout_constraintBottom_toTopOf="@+id/cl_buttons"
            app:layout_constraintTop_toTopOf="parent">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_20"
                android:textColor="@color/byd_text_FF262D33"
                android:gravity="center"
                android:id="@+id/stv_titletext"
                android:paddingLeft="@dimen/auto_dimen2_28"
                android:paddingRight="@dimen/auto_dimen2_28"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_navi_traffic_mode"
                app:textColor4Night="@color/byd_text_FF262D33"
                app:textColor4Skin="@color/byd_text_FF262D33"/>
            <com.autonavi.skin.view.SkinTextView
                android:background="@color/byd_text_301F2326"
                android:layout_width="@dimen/auto_dimen2_560"
                android:layout_height="@dimen/auto_dimen2_1"
                android:layout_marginTop="@dimen/auto_dimen2_20"
                app:background4Night="@color/byd_text_301F2326"
                app:background4Skin="@color/byd_text_301F2326"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/byd_text_FF262D33"
                android:gravity="center"
                android:id="@+id/stv_content"
                android:paddingLeft="@dimen/auto_dimen2_28"
                android:paddingRight="@dimen/auto_dimen2_28"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auto_dimen2_35"
                android:text="@string/settings_navi_traffic_mode"
                app:textColor4Night="@color/byd_text_FF262D33"
                app:textColor4Skin="@color/byd_text_FF262D33"/>
        </com.autonavi.skin.view.SkinLinearLayout>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
