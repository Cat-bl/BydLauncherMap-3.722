                android:textSize="@dimen/auto_font_size_20"
                android:textColor="@color/byd_pvt_black_900_90"
                android:gravity="center"
                android:id="@+id/tv_time_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/auto_dimen2_160"
                android:maxHeight="@dimen/auto_dimen2_24"
                android:text="00:09:37"
                android:singleLine="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:textColor4Night="@color/byd_pvt_white_900_90"
                app:textColor4Skin="@color/byd_pvt_black_900_90"/>
            <com.autonavi.skin.view.SkinConstraintLayout
