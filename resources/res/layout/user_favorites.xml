<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scl_favorite_land_layout"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="720"
    app:designWidth="1280">
    <com.autonavi.skin.view.SkinConstraintLayout
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/style_setting_bg">
        <com.autonavi.skin.view.SkinLinearLayout
            android:id="@+id/top_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/user_tittle_layout"/>
        </com.autonavi.skin.view.SkinLinearLayout>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_16"
            android:textColor="@color/custom_text_day_color_55"
            android:gravity="center"
            android:id="@+id/stv_sync_time"
            android:background="@drawable/user_favorite_bg_view_day_land"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auto_dimen2_48"
            android:text="@string/favorites_list_not_sync"
            android:layout_marginStart="@dimen/auto_dimen2_92"
            android:layout_marginEnd="@dimen/auto_dimen2_92"
            app:background4Night="@drawable/user_favorite_bg_view_night_land"
            app:background4Skin="@drawable/user_favorite_bg_view_day_land"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_bar_layout"
            app:textColor4Night="@color/custom_text_night_color_55"
            app:textColor4Skin="@color/custom_text_day_color_55"/>
        <com.autonavi.skin.view.SkinLinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/favorite_login_sll"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toBottomOf="@+id/favorite_listView_itemView">
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/siv_no_history"
                android:background="@drawable/search_no_history_day"
                android:layout_width="@dimen/auto_dimen2_160"
                android:layout_height="@dimen/auto_dimen2_160"
                android:layout_marginBottom="@dimen/sys_padding_xxl"
                app:background4Night="@drawable/search_no_history_night"
                app:background4Skin="@drawable/search_no_history_day"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/sys_inverseColor_default_dark"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/favorite_login_tip_tv"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/auto_dimen2_64"
                android:text="@string/favorites_login_tip"
                android:maxLines="2"
                app:textColor4Night="@color/sys_color_default"
                app:textColor4Skin="@color/sys_inverseColor_default_dark"/>
            <com.autonavi.skin.view.SkinTextView
                android:enabled="true"
                android:textSize="@dimen/auto_font_size_18"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/favorite_login_tv"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/auto_dimen2_48"
                android:text="@string/avatar_login"
                android:singleLine="true"
                android:layout_below="@+id/favorite_login_tip_tv"
                android:paddingStart="@dimen/auto_dimen2_22"
                android:paddingEnd="@dimen/auto_dimen2_22"
                style="@style/SysBtnMediumPrimary"/>
        </com.autonavi.skin.view.SkinLinearLayout>
        <com.autonavi.skin.view.SkinListView
            android:scrollbarSize="@dimen/auto_dimen2_4"
            android:scrollbarThumbVertical="@drawable/byd_custom_scrollbar_thumb_day"
            android:id="@+id/slv_favorite_list"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/auto_dimen2_24"
            android:layout_marginBottom="@dimen/auto_dimen2_16"
            android:listSelector="@color/auto_ui_000000_00"
            android:cacheColorHint="@color/auto_ui_000000_00"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:fastScrollEnabled="false"
            android:headerDividersEnabled="false"
            android:footerDividersEnabled="false"
            android:contentDescription="收藏列表|纵向"
            android:layout_marginStart="@dimen/auto_dimen2_32"
            android:layout_marginEnd="@dimen/auto_dimen2_32"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/stv_sync_time"
            app:scrollbarThumbVertical4Night="@drawable/byd_custom_scrollbar_thumb_night"
            app:scrollbarThumbVertical4Skin="@drawable/byd_custom_scrollbar_thumb_day"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
