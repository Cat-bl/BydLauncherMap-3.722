<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_navigation_info_landscape_changanmca"
    android:layout_width="match_parent"
    android:layout_height="@dimen/auto_dimen2_138"
    android:paddingEnd="@dimen/auto_dimen2_18">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_exit_views"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="stv_exit,mLin_exit,stv_text_exit_location"/>
    <LinearLayout
        android:gravity="top"
        android:orientation="horizontal"
        android:id="@+id/mLin_exit"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/auto_dimen2_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintTop_toBottomOf="@+id/guidelineHorizontal">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_18"
            android:textColor="@color/auto_color_ffffff_ff"
            android:gravity="center"
            android:id="@+id/stv_exit"
            android:background="@drawable/ic_exit_bg_fui"
            android:paddingLeft="@dimen/auto_dimen2_4"
            android:paddingRight="@dimen/auto_dimen2_4"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/auto_dimen2_34"
            android:maxHeight="@dimen/auto_dimen2_34"
            android:singleLine="true"
            app:textColor4Night="@color/auto_color_ffffff_ff"
            app:textColor4Skin="@color/auto_color_ffffff_ff"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_28"
            android:textColor="@color/custom_text_night_color_white_100_fui"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/stv_text_exit_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_3"
            android:maxLines="1"
            android:layout_marginStart="@dimen/auto_dimen2_4"
            app:textColor4Night="@color/custom_text_night_color_white_100_fui"
            app:textColor4Skin="@color/custom_text_night_color_white_100_fui"/>
    </LinearLayout>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_turn_by_turn_arrow"
        android:layout_width="@dimen/auto_dimen2_72"
        android:layout_height="@dimen/auto_dimen2_72"
        android:layout_marginLeft="@dimen/auto_dimen2_18"
        android:layout_marginTop="@dimen/auto_dimen2_30"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_exit_toll_gate"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/auto_navi_drive_toll_gate"
        app:layout_constraintBottom_toBottomOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintEnd_toEndOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintStart_toStartOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintTop_toTopOf="@+id/siv_turn_by_turn_arrow"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_60"
        android:textColor="@color/custom_text_night_color_white_100_fui"
        android:gravity="bottom"
        android:id="@+id/stv_text_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/auto_dimen2_16"
        app:layout_constraintBottom_toBottomOf="@+id/guidelineHorizontal"
        app:layout_constraintStart_toEndOf="@+id/siv_turn_by_turn_arrow"
        app:shadowDayNightStyle="1"
        app:skinDayNightExtraStyle="true"
        app:textColor4Night="@color/custom_text_night_color_white_100_fui"
        app:textColor4Skin="@color/custom_text_night_color_white_100_fui"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_60"
        android:textColor="@color/custom_text_night_color_white_100_fui"
        android:gravity="bottom"
        android:id="@+id/stv_text_distance_cn"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/auto_dimen2_16"
        app:layout_constraintBottom_toBottomOf="@+id/guidelineHorizontal"
        app:layout_constraintStart_toEndOf="@+id/siv_turn_by_turn_arrow"
        app:shadowDayNightStyle="1"
        app:skinDayNightExtraStyle="true"
        app:textColor4Night="@color/custom_text_night_color_white_100_fui"
        app:textColor4Skin="@color/custom_text_night_color_white_100_fui"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_28"
        android:textColor="@color/custom_text_night_color_white_100_fui"
        android:gravity="bottom"
        android:id="@+id/stv_text_meter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/auto_dimen2_8"
        app:layout_constraintBaseline_toBaselineOf="@+id/stv_text_distance"
        app:layout_constraintStart_toEndOf="@+id/stv_text_distance"
        app:shadowDayNightStyle="1"
        app:skinDayNightExtraStyle="true"
        app:textColor4Night="@color/custom_text_night_color_white_100_fui"
        app:textColor4Skin="@color/custom_text_night_color_white_100_fui"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_28"
        android:textColor="@color/custom_text_night_color_white_70_fui"
        android:gravity="bottom"
        android:id="@+id/stv_text_enter_into"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/auto_dimen2_4"
        app:layout_constraintBottom_toBottomOf="@+id/stv_text_meter"
        app:layout_constraintStart_toEndOf="@+id/stv_text_meter"
        app:layout_constraintTop_toTopOf="@+id/stv_text_meter"
        app:shadowDayNightStyle="1"
        app:skinDayNightExtraStyle="true"
        app:textColor4Night="@color/custom_text_night_color_white_70_fui"
        app:textColor4Skin="@color/custom_text_night_color_white_70_fui"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_28"
        android:textColor="@color/custom_text_night_color_white_100_fui"
        android:ellipsize="end"
        android:gravity="bottom"
        android:id="@+id/stv_text_next_location"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/auto_dimen2_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/stv_text_distance"
        app:layout_constraintTop_toBottomOf="@+id/stv_text_distance"
        app:shadowDayNightStyle="1"
        app:skinDayNightExtraStyle="true"
        app:textColor4Night="@color/custom_text_night_color_white_100_fui"
        app:textColor4Skin="@color/custom_text_night_color_white_100_fui"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guidelineHorizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.64"/>
</com.autonavi.skin.view.SkinConstraintLayout>
