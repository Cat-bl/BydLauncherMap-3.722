<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/byd_custom_secondary_btn_text_color_selector_day"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/stv_text_location"
        android:background="@drawable/search_home_clear_history_bg_day_selector"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_40"
        android:text="@string/auto_search_result_map_text_location"
        android:singleLine="true"
        android:paddingStart="@dimen/auto_dimen2_12"
        android:paddingEnd="@dimen/auto_dimen2_12"
        app:background4Night="@drawable/search_item2_classify_normal_background_night"
        app:background4Skin="@drawable/search_home_clear_history_bg_day_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/byd_custom_secondary_btn_text_color_selector_night"
        app:textColor4Skin="@color/byd_custom_secondary_btn_text_color_selector_day"/>
</com.autonavi.skin.view.SkinConstraintLayout>
