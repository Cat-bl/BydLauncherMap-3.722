<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_setting_about_help"
    android:fitsSystemWindows="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinConstraintLayout
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/style_setting_bg">
        <com.autonavi.skin.view.SkinTextView
            android:id="@+id/setting_about_help_back_hotspot"
            android:background="@drawable/custom_list_pressed_list_day_bg_selector"
            android:layout_width="@dimen/auto_dimen2_48"
            android:layout_height="@dimen/auto_dimen2_48"
            android:layout_marginTop="@dimen/auto_dimen2_12"
            android:contentDescription="返回"
            android:layout_marginStart="@dimen/auto_dimen2_28"
            app:background4Night="@drawable/custom_list_pressed_list_night_bg_selector"
            app:background4Skin="@drawable/custom_list_pressed_list_day_bg_selector"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/setting_about_help_back"
            android:background="@drawable/icon_setting_back_land_day"
            android:layout_width="@dimen/auto_dimen2_48"
            android:layout_height="@dimen/auto_dimen2_48"
            android:layout_marginTop="@dimen/auto_dimen2_12"
            android:layout_marginStart="@dimen/auto_dimen2_28"
            app:background4Night="@drawable/icon_setting_back_land_night"
            app:background4Skin="@drawable/icon_setting_back_land_day"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_20"
            android:textColor="@color/byd_text_450_1_textcolor_day_selector"
            android:gravity="center_vertical"
            android:id="@+id/setting_about_help_title"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/auto_dimen2_0"
            android:text="@string/settings_about_help_title"
            app:layout_constraintBottom_toBottomOf="@+id/setting_about_help_back"
            app:layout_constraintStart_toEndOf="@+id/setting_about_help_back"
            app:layout_constraintTop_toTopOf="@+id/setting_about_help_back"
            app:textColor4Night="@color/custom_text_night_color_85"
            app:textColor4Skin="@color/byd_text_450_1_textcolor_day_selector"/>
        <com.autonavi.skin.view.SkinTextView
            android:id="@+id/setting_about_help_tab_bg_ll"
            android:visibility="gone"
            android:layout_width="@dimen/auto_dimen2_294"
            android:layout_height="@dimen/auto_dimen2_0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/setting_about_help_back_hotspot"/>
        <com.autonavi.skin.view.SkinLinearLayout
            android:orientation="vertical"
            android:id="@+id/setting_about_help_tab_ll"
            android:layout_width="@dimen/auto_dimen2_232"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_62"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.autonavi.skin.view.SkinLinearLayout
                android:gravity="center_vertical"
                android:id="@+id/setting_about_help_tab_st_hot"
                android:background="@drawable/byd_custom_setting_tab_bg_day_bg_selector_new"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auto_dimen2_64"
                android:paddingStart="@dimen/auto_dimen2_28"
                app:background4Night="@drawable/byd_custom_setting_tab_bg_night_bg_selector_new"
                app:background4Skin="@drawable/byd_custom_setting_tab_bg_day_bg_selector_new">
                <com.autonavi.skin.view.SkinLottieAnimationView
                    android:id="@+id/setting_about_help_tab_sv_hot"
                    android:layout_width="@dimen/auto_dimen2_48"
                    android:layout_height="@dimen/auto_dimen2_48"
                    android:src="@drawable/byd_setting_help_img_night_wt_selector"/>
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_20"
                    android:textColor="@color/byd_text_450_tab_textcolor_day_selector"
                    android:gravity="center_vertical"
                    android:id="@+id/setting_about_help_tab_tv_hot"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/auto_dimen2_80"
                    android:text="@string/settings_other_hot_message"
                    app:textColor4Night="@color/byd_text_450_tab_textcolor_day_selector_new"
                    app:textColor4Skin="@color/byd_text_450_tab_textcolor_day_selector"/>
            </com.autonavi.skin.view.SkinLinearLayout>
            <com.autonavi.skin.view.SkinLinearLayout
                android:gravity="center_vertical"
                android:id="@+id/setting_about_help_tab_st_mapshow"
                android:background="@drawable/byd_custom_setting_tab_bg_day_bg_selector_new"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auto_dimen2_64"
                android:paddingStart="@dimen/auto_dimen2_28"
                app:background4Night="@drawable/byd_custom_setting_tab_bg_night_bg_selector_new"
                app:background4Skin="@drawable/byd_custom_setting_tab_bg_day_bg_selector_new">
                <com.autonavi.skin.view.SkinLottieAnimationView
                    android:id="@+id/setting_about_help_tab_sv_mapshow"
                    android:layout_width="@dimen/auto_dimen2_48"
                    android:layout_height="@dimen/auto_dimen2_48"
                    android:src="@drawable/byd_setting_help_img_night_wt_selector"/>
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_20"
                    android:textColor="@color/byd_text_450_tab_textcolor_day_selector"
                    android:gravity="center_vertical"
                    android:id="@+id/setting_about_help_tab_tv_mapshow"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/auto_dimen2_80"
                    android:text="@string/settings_other_map_display"
                    app:textColor4Night="@color/byd_text_450_tab_textcolor_day_selector_new"
                    app:textColor4Skin="@color/byd_text_450_tab_textcolor_day_selector"/>
            </com.autonavi.skin.view.SkinLinearLayout>
            <com.autonavi.skin.view.SkinLinearLayout
                android:gravity="center_vertical"
                android:id="@+id/setting_about_help_tab_st_route"
                android:background="@drawable/byd_custom_setting_tab_bg_day_bg_selector_new"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auto_dimen2_64"
                android:paddingStart="@dimen/auto_dimen2_28"
                app:background4Night="@drawable/byd_custom_setting_tab_bg_night_bg_selector_new"
                app:background4Skin="@drawable/byd_custom_setting_tab_bg_day_bg_selector_new">
                <com.autonavi.skin.view.SkinLottieAnimationView
                    android:id="@+id/setting_about_help_tab_sv_route"
                    android:layout_width="@dimen/auto_dimen2_48"
                    android:layout_height="@dimen/auto_dimen2_48"
                    android:src="@drawable/byd_setting_help_img_night_wt_selector"/>
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_20"
                    android:textColor="@color/byd_text_450_tab_textcolor_day_selector"
                    android:gravity="center_vertical"
                    android:id="@+id/setting_about_help_tab_tv_route"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/auto_dimen2_80"
                    android:text="@string/settings_other_map_route"
                    app:textColor4Night="@color/byd_text_450_tab_textcolor_day_selector_new"
                    app:textColor4Skin="@color/byd_text_450_tab_textcolor_day_selector"/>
            </com.autonavi.skin.view.SkinLinearLayout>
            <com.autonavi.skin.view.SkinLinearLayout
                android:gravity="center_vertical"
                android:id="@+id/setting_about_help_tab_st_search"
                android:background="@drawable/byd_custom_setting_tab_bg_day_bg_selector_new"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auto_dimen2_64"
                android:paddingStart="@dimen/auto_dimen2_28"
                app:background4Night="@drawable/byd_custom_setting_tab_bg_night_bg_selector_new"
                app:background4Skin="@drawable/byd_custom_setting_tab_bg_day_bg_selector_new">
                <com.autonavi.skin.view.SkinLottieAnimationView
                    android:id="@+id/setting_about_help_tab_sv_search"
                    android:layout_width="@dimen/auto_dimen2_48"
                    android:layout_height="@dimen/auto_dimen2_48"
                    android:src="@drawable/byd_setting_help_img_night_wt_selector"/>
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_20"
                    android:textColor="@color/byd_text_450_tab_textcolor_day_selector"
                    android:gravity="center_vertical"
                    android:id="@+id/setting_about_help_tab_tv_search"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/auto_dimen2_80"
                    android:text="@string/settings_other_map_search"
                    app:textColor4Night="@color/byd_text_450_tab_textcolor_day_selector_new"
                    app:textColor4Skin="@color/byd_text_450_tab_textcolor_day_selector"/>
            </com.autonavi.skin.view.SkinLinearLayout>
            <com.autonavi.skin.view.SkinLinearLayout
                android:gravity="center_vertical"
                android:id="@+id/setting_about_help_tab_st_broadcast"
                android:background="@drawable/byd_custom_setting_tab_bg_day_bg_selector_new"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auto_dimen2_64"
                android:paddingStart="@dimen/auto_dimen2_28"
                app:background4Night="@drawable/byd_custom_setting_tab_bg_night_bg_selector_new"
                app:background4Skin="@drawable/byd_custom_setting_tab_bg_day_bg_selector_new">
                <com.autonavi.skin.view.SkinLottieAnimationView
                    android:id="@+id/setting_about_help_tab_sv_broadcast"
                    android:layout_width="@dimen/auto_dimen2_48"
                    android:layout_height="@dimen/auto_dimen2_48"
                    android:src="@drawable/byd_setting_help_img_night_wt_selector"/>
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_20"
                    android:textColor="@color/byd_text_450_tab_textcolor_day_selector"
                    android:gravity="center_vertical"
                    android:id="@+id/setting_about_help_tab_tv_broadcast"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/auto_dimen2_80"
                    android:text="@string/settings_other_map_sound"
                    app:textColor4Night="@color/byd_text_450_tab_textcolor_day_selector_new"
                    app:textColor4Skin="@color/byd_text_450_tab_textcolor_day_selector"/>
            </com.autonavi.skin.view.SkinLinearLayout>
            <com.autonavi.skin.view.SkinLinearLayout
                android:gravity="center_vertical"
                android:id="@+id/setting_about_help_tab_st_mapdata"
                android:background="@drawable/byd_custom_setting_tab_bg_day_bg_selector_new"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auto_dimen2_64"
                android:paddingStart="@dimen/auto_dimen2_28"
                app:background4Night="@drawable/byd_custom_setting_tab_bg_night_bg_selector_new"
                app:background4Skin="@drawable/byd_custom_setting_tab_bg_day_bg_selector_new">
                <com.autonavi.skin.view.SkinLottieAnimationView
                    android:id="@+id/setting_about_help_tab_sv_mapdata"
                    android:layout_width="@dimen/auto_dimen2_48"
                    android:layout_height="@dimen/auto_dimen2_48"
                    android:src="@drawable/byd_setting_help_img_night_wt_selector"/>
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_20"
                    android:textColor="@color/byd_text_450_tab_textcolor_day_selector"
                    android:gravity="center_vertical"
                    android:id="@+id/setting_about_help_tab_tv_mapdata"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/auto_dimen2_80"
                    android:text="@string/settings_other_map_data"
                    app:textColor4Night="@color/byd_text_450_tab_textcolor_day_selector_new"
                    app:textColor4Skin="@color/byd_text_450_tab_textcolor_day_selector"/>
            </com.autonavi.skin.view.SkinLinearLayout>
        </com.autonavi.skin.view.SkinLinearLayout>
        <com.autonavi.skin.view.SkinTextView
            android:id="@+id/setting_about_help_tab_bg_shadow"
            android:background="@drawable/icon_setting_bg_1_shadow_land_day"
            android:visibility="gone"
            android:layout_width="@dimen/auto_dimen2_120"
            android:layout_height="@dimen/auto_dimen2_0"
            app:background4Night="@drawable/icon_setting_bg_1_shadow_land_night"
            app:background4Skin="@drawable/icon_setting_bg_1_shadow_land_day"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/setting_about_help_tab_bg_ll"
            app:layout_constraintTop_toBottomOf="@+id/setting_about_help_title"/>
        <ScrollView
            android:id="@+id/setting_about_help_scrollView"
            android:scrollbars="none"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/auto_dimen2_40"
            android:layout_marginBottom="@dimen/auto_dimen2_24"
            android:layout_marginStart="@dimen/auto_dimen2_40"
            android:layout_marginEnd="@dimen/auto_dimen2_40"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/setting_about_help_tab_ll"
            app:layout_constraintTop_toTopOf="@+id/setting_about_help_tab_ll">
            <com.autonavi.skin.view.SkinTextViewTwo
                android:textSize="@dimen/auto_font_size_20"
                android:textColor="@color/custom_text_day_color_85"
                android:textColorLink="@color/auto_color_00ACEB"
                android:id="@+id/setting_about_help_textview"
                android:background="#00000000"
                android:visibility="visible"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                app:textColor4Night="@color/auto_color_D9DAE1EB"
                app:textColor4Skin="@color/custom_text_day_color_85"/>
        </ScrollView>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/setting_about_help_no_network"
            android:background="#00000000"
            android:layout_width="@dimen/auto_dimen2_0"
            android:layout_height="@dimen/auto_dimen2_0"
            android:layout_marginTop="@dimen/auto_dimen2_70"
            android:layout_marginBottom="@dimen/auto_dimen2_88"
            app:layout_constraintBottom_toBottomOf="@+id/setting_about_help_textview"
            app:layout_constraintEnd_toEndOf="@+id/setting_about_help_textview"
            app:layout_constraintStart_toStartOf="@+id/setting_about_help_textview"
            app:layout_constraintTop_toTopOf="@+id/setting_about_help_textview">
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/setting_about_help_img_no_wifi"
                android:layout_width="@dimen/auto_dimen2_120"
                android:layout_height="@dimen/auto_dimen2_120"
                android:layout_marginTop="@dimen/auto_dimen2_150"
                android:src="@drawable/icon_setting_img_other_about_img_no_network_land_day"
                android:scaleType="fitXY"
                app:layout_constraintBottom_toTopOf="@+id/setting_about_help_tv_no_wifi"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:src4Night="@drawable/icon_setting_img_other_about_img_no_network_land_night"
                app:src4Skin="@drawable/icon_setting_img_other_about_img_no_network_land_day"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_20"
                android:textColor="@color/byd_text_450_1_textcolor_day_selector"
                android:gravity="center"
                android:id="@+id/setting_about_help_tv_no_wifi"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/auto_dimen2_34"
                android:layout_marginTop="@dimen/auto_dimen2_20"
                android:text="@string/settings_about_help_no_wifi_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/setting_about_help_img_no_wifi"
                app:textColor4Night="@color/byd_text_450_1_textcolor_night_selector"
                app:textColor4Skin="@color/byd_text_450_1_textcolor_day_selector"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/auto_color_86909B"
                android:gravity="center_vertical"
                android:id="@+id/setting_about_help_tv_2_no_wifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auto_dimen2_20"
                android:text="@string/settings_about_help_no_wifi_text2"
                android:lineSpacingExtra="@dimen/auto_dimen2_6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/setting_about_help_tv_no_wifi"
                app:textColor4Night="@color/auto_color_86909B"
                app:textColor4Skin="@color/auto_color_86909B"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_20"
                android:textColor="@color/byd_text_450_1_btn_textcolor_day_selector"
                android:gravity="center"
                android:id="@+id/setting_about_help_btn_retry_no_wifi"
                android:background="@drawable/byd_custom_btn_function1_btn_function1_day_bg_selector"
                android:layout_width="@dimen/auto_dimen2_240"
                android:layout_height="@dimen/auto_dimen2_56"
                android:layout_marginTop="@dimen/auto_dimen2_40"
                android:text="@string/settings_about_help_no_wifi_btn_retry"
                app:background4Night="@drawable/byd_custom_btn_function1_btn_function1_night_bg_selector"
                app:background4Skin="@drawable/byd_custom_btn_function1_btn_function1_day_bg_selector"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/setting_about_help_tv_2_no_wifi"
                app:textColor4Night="@color/byd_text_450_1_btn_textcolor_night_selector"
                app:textColor4Skin="@color/byd_text_450_1_btn_textcolor_day_selector"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/setting_about_help_ll_loading"
            android:background="#00000000"
            android:layout_width="@dimen/auto_dimen2_0"
            android:layout_height="@dimen/auto_dimen2_0"
            android:layout_marginTop="@dimen/auto_dimen2_100"
            android:layout_marginBottom="@dimen/auto_dimen2_88"
            app:layout_constraintBottom_toBottomOf="@+id/setting_about_help_textview"
            app:layout_constraintEnd_toEndOf="@+id/setting_about_help_textview"
            app:layout_constraintStart_toStartOf="@+id/setting_about_help_textview"
            app:layout_constraintTop_toTopOf="@+id/setting_about_help_textview">
            <com.autonavi.view.custom.CustomLoadingSmallView
                android:id="@+id/setting_about_help_loading"
                android:layout_width="@dimen/auto_dimen2_40"
                android:layout_height="@dimen/auto_dimen2_40"
                android:scaleType="fitXY"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_20"
                android:textColor="@color/byd_text_450_1_textcolor_day_selector"
                android:gravity="center"
                android:id="@+id/setting_about_help_loading_tv"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/auto_dimen2_34"
                android:layout_marginTop="@dimen/auto_dimen2_20"
                android:text="@string/loading"
                android:lineSpacingExtra="@dimen/auto_dimen2_4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/setting_about_help_loading"
                app:textColor4Night="@color/byd_text_450_1_textcolor_night_selector"
                app:textColor4Skin="@color/byd_text_450_1_textcolor_day_selector"/>
