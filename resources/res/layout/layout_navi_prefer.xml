        android:id="@+id/setting_navi_bcv_big_road"
        android:layout_width="@dimen/auto_dimen2_0"
        android:layout_height="@dimen/auto_dimen2_78"
        android:layout_marginTop="@dimen/auto_dimen2_4"
        android:layout_marginStart="@dimen/auto_dimen2_4"
        app:custom_card_backgroud="@drawable/byd_custom_setting_bg_item_prot_night_select"
        app:custom_card_portrait="true"
        app:layout_constraintEnd_toEndOf="@+id/setting_navi_bcv_avoid_charge"
        app:layout_constraintStart_toEndOf="@+id/setting_navi_recommond_route"
        app:layout_constraintTop_toBottomOf="@+id/setting_navi_bcv_avoid_charge"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_20"
        android:textColor="@color/byd_custom_setting_station_color_day"
        android:id="@+id/setting_navi_big_road_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/autorouteplansetting_text_big_road_port"
        android:layout_marginStart="@dimen/auto_dimen2_24"
        app:layout_constraintBottom_toBottomOf="@+id/setting_navi_big_road_image"
        app:layout_constraintStart_toStartOf="@+id/setting_navi_bcv_big_road"
        app:layout_constraintTop_toTopOf="@+id/setting_navi_big_road_image"
        app:textColor4Night="@color/byd_custom_setting_station_color"
        app:textColor4Skin="@color/byd_custom_setting_station_color_day"/>
