        android:background="@drawable/byd_setting_day_navigation_bigroad_select"
        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_48"
        android:layout_marginTop="@dimen/auto_dimen2_10"
        android:layout_marginEnd="@dimen/auto_dimen2_8"
        app:background4Night="@drawable/byd_setting_dark_navigation_bigroad_select"
        app:background4Skin="@drawable/byd_setting_day_navigation_bigroad_select"
        app:layout_constraintEnd_toEndOf="@+id/setting_navi_bcv_big_road"
        app:layout_constraintTop_toTopOf="@+id/setting_navi_bcv_big_road"/>
