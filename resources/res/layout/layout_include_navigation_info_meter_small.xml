<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_navigation_info_landscape_changanmca"
    android:layout_width="match_parent"
    android:layout_height="@dimen/auto_dimen2_44">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_exit_views"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="stv_exit,stv_text_exit_location"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_turn_by_turn_arrow"
        android:layout_width="@dimen/auto_dimen2_28"
        android:layout_height="@dimen/auto_dimen2_28"
        android:layout_marginStart="@dimen/auto_dimen2_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="@dimen/auto_dimen2_3"
        app:layout_goneMarginTop="@dimen/auto_dimen2_3"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_exit_toll_gate"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/auto_navi_drive_toll_gate"
        app:layout_constraintBottom_toBottomOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintEnd_toEndOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintStart_toStartOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintTop_toTopOf="@+id/siv_turn_by_turn_arrow"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_24"
        android:textStyle="bold"
        android:textColor="@color/custom_text_night_color_EEF5FF"
        android:gravity="bottom"
        android:id="@+id/stv_text_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/auto_dimen2_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintTop_toTopOf="parent"
        app:shadowDayNightStyle="1"
        app:skinDayNightExtraStyle="true"
        app:textColor4Night="@color/custom_user_white_text_color_100"
        app:textColor4Skin="@color/custom_user_white_text_color_100"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/custom_user_white_text_color_70"
        android:gravity="bottom"
        android:id="@+id/stv_text_meter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/auto_dimen2_4"
        app:layout_constraintBaseline_toBaselineOf="@+id/stv_text_distance"
        app:layout_constraintStart_toEndOf="@+id/stv_text_distance"
        app:shadowDayNightStyle="1"
        app:skinDayNightExtraStyle="true"
        app:textColor4Night="@color/custom_user_white_text_color_70"
        app:textColor4Skin="@color/custom_user_white_text_color_70"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/custom_text_night_color_EEF5FF_60"
        android:gravity="bottom"
        android:id="@+id/stv_text_enter_into"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/auto_dimen2_4"
        app:layout_constraintBaseline_toBaselineOf="@+id/stv_text_distance"
        app:layout_constraintStart_toEndOf="@+id/stv_text_meter"
        app:layout_constraintTop_toTopOf="@+id/stv_text_meter"
        app:shadowDayNightStyle="1"
        app:skinDayNightExtraStyle="true"
        app:textColor4Night="@color/custom_text_night_color_EEF5FF_60"
        app:textColor4Skin="@color/custom_text_night_color_EEF5FF_60"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_15"
        android:textColor="@color/auto_color_ffffff_ff"
        android:gravity="center"
        android:id="@+id/stv_exit"
        android:background="@drawable/ic_exit_bg"
        android:paddingTop="@dimen/auto_dimen2_1"
        android:paddingBottom="@dimen/auto_dimen2_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:maxLength="18"
        android:paddingStart="@dimen/auto_dimen2_1"
        android:paddingEnd="@dimen/auto_dimen2_1"
        android:layout_marginStart="@dimen/auto_dimen2_10"
        app:layout_constraintBaseline_toBaselineOf="@+id/stv_text_distance"
        app:layout_constraintStart_toEndOf="@+id/stv_text_enter_into"
        app:shadowDayNightStyle="1"
        app:skinDayNightExtraStyle="true"
        app:textColor4Night="@color/auto_color_ffffff_ff"
        app:textColor4Skin="@color/auto_color_ffffff_ff"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/custom_user_white_text_color_80"
        android:ellipsize="end"
        android:id="@+id/stv_text_exit_location"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/auto_dimen2_4"
        android:layout_marginEnd="@dimen/auto_dimen2_4"
        app:layout_constraintBaseline_toBaselineOf="@+id/stv_exit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/stv_exit"
        app:layout_constraintTop_toTopOf="@+id/stv_exit"
        app:shadowDayNightStyle="1"
        app:skinDayNightExtraStyle="true"
        app:textColor4Night="@color/custom_user_white_text_color_80"
        app:textColor4Skin="@color/custom_user_white_text_color_80"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/custom_user_white_text_color_80"
        android:ellipsize="end"
        android:id="@+id/stv_text_next_location"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/auto_dimen2_10"
        android:layout_marginEnd="@dimen/auto_dimen2_4"
        app:layout_constraintBaseline_toBaselineOf="@+id/stv_text_distance"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/stv_text_enter_into"
        app:layout_constraintTop_toTopOf="@+id/stv_text_enter_into"
        app:shadowDayNightStyle="1"
        app:skinDayNightExtraStyle="true"
        app:textColor4Night="@color/custom_user_white_text_color_80"
        app:textColor4Skin="@color/custom_user_white_text_color_80"/>
</com.autonavi.skin.view.SkinConstraintLayout>
