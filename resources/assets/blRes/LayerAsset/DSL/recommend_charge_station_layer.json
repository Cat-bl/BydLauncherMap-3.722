{
  "data": {
    "type": "adaptor_point",
    "brief": "推荐充电站图元数据",
    "value": [],
    "rule": [
      {
        "brief": "填充",
        "type": "data_user_if",
        "value": {
          "biz_data": "user_padding",
          "condition": {
            "fact": true,
            "operator": "equal",
            "value": true
          },
          "case": {
            "true": "/"
          }
        }
      },
      {
        "brief": "空余",
        "type": "data_user_if",
        "value": {
          "biz_data": "user_idle",
          "condition": {
            "fact": true,
            "operator": "equal",
            "value": true
          },
          "case": {
            "true": "空"
          }
        }
      },
      {
        "type": "data_duplicate",
        "brief": "数据去重",
        "value": [
          "$item_data.position.lon",
          "$item_data.position.lat"
        ]
      }
    ]
  },
  "biz": [
    {
      "brief": "设置图元优先级是否升序",
      "type": "biz_item_priority_asc",
      "value": false
    },
    {
      "brief": "设置多飘向图层避让算法",
      "type": "biz_set_avoid_algorithm",
      "value": 2
    },
    {
      "brief": "设置是否可点击",
      "type": "biz_set_clickable",
      "value": true
    },
    {
      "brief": "设置图层优先级",
      "type": "biz_set_priority",
      "value": {
        "draw_priority": 140,
        "sub_priority": 3630
      }
    },
    {
      "brief": "设置是否开启底图避让",
      "type": "biz_is_poi_filter",
      "value": {
        "enable": true,
        "type": 4294967295
      }
    },
    {
      "brief": "设置是否是多象限图层",
      "type": "biz_is_quadrant_layer",
      "value": {
        "type": 26,
        "area_threshold": 0.3
      }
    },
    {
      "brief": "设置是否图层内碰撞",
      "type": "biz_is_collision",
      "value": true
    }
  ],
  "style": {
    "style_name": {
      "prefix_name": "",
