<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/cbtn_round"/>
            <stroke
                android:width="@dimen/cbtn_stroke_selected"
                android:color="@color/cbtn_stroke_color_selected_dark"/>
            <solid android:color="@color/cbtn_bg_color_dark"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/cbtn_round"/>
            <stroke
                android:width="@dimen/cbtn_stroke"
                android:color="@color/cbtn_stroke_color_dark"/>
            <solid android:color="@color/cbtn_bg_color_dark"/>
        </shape>
    </item>
</selector>
