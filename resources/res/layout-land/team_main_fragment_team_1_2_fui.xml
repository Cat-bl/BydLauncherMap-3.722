<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_auto_search_result_map"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.autonavi.skin.view.SkinRelativeLayout
        android:orientation="vertical"
        android:id="@+id/setting_container_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/scl_main_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/auto_dimen2_18"
        android:layout_marginTop="@dimen/auto_dimen2_9"
        android:layout_marginRight="@dimen/auto_dimen2_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.view.custom.CustomBtnCircular3View
            android:id="@+id/cbc_zoom"
            android:layout_width="@dimen/auto_dimen2_56"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/auto_dimen2_15"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:shadowColor="@color/auto_ui_000000_33"
            app:shadowColorNight="@color/auto_ui_000000_33"
            app:shadowCorner="@dimen/auto_dimen2_6"
            app:shadowCornerBottomLeft="@dimen/auto_dimen2_0"
            app:shadowCornerBottomRight="@dimen/auto_dimen2_0"
            app:shadowCornerTopLeft="@dimen/auto_dimen2_0"
            app:shadowCornerTopRight="@dimen/auto_dimen2_0"
            app:shadowDx="@dimen/auto_dimen2_0"
            app:shadowDy="@dimen/auto_dimen2_3"
            app:shadowRadius="@dimen/auto_dimen2_6"
            app:shadowShapeType="rectangle"
            app:shadowSide="all"
            app:shadowVisibility="true"/>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/cl_full_btn"
            android:background="@drawable/custom_card_round_bg_day_selector_fui"
            android:layout_width="@dimen/auto_dimen2_56"
            android:layout_height="@dimen/auto_dimen2_56"
            android:layout_marginBottom="@dimen/auto_dimen2_3"
            app:background4Night="@drawable/custom_card_round_bg_night_selector_fui"
            app:background4Skin="@drawable/custom_card_round_bg_day_selector_fui"
            app:layout_constraintBottom_toTopOf="@+id/cbc_zoom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_goneMarginBottom="@dimen/auto_dimen2_25">
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/siv_full_btn"
                android:background="@drawable/auto_navi_theviewof_day"
                android:layout_width="@dimen/auto_dimen2_40"
                android:layout_height="@dimen/auto_dimen2_40"
                app:background4Night="@drawable/auto_navi_theviewof_night"
                app:background4Skin="@drawable/auto_navi_theviewof_day"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_11"
                android:textColor="@color/route_result_btn_text_color_day"
                android:gravity="center"
                android:id="@+id/stv_overview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/auto_dimen2_3"
                android:text="@string/tv_home_button_quanlan"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:textColor4Night="@color/route_result_btn_text_color_night"
                app:textColor4Skin="@color/route_result_btn_text_color_day"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.view.custom.CustomAutoScaleLineView
            android:id="@+id/ca_scale_line"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/auto_dimen2_32"
            android:layout_marginRight="@dimen/auto_dimen2_24"
            android:layout_marginBottom="@dimen/auto_dimen2_6"
            app:layout_constraintBottom_toTopOf="@+id/ca_auto_logo"
            app:layout_constraintEnd_toStartOf="@+id/cl_full_btn"/>
        <com.autonavi.view.custom.CustomAutologoView
            android:id="@+id/ca_auto_logo"
            android:background="@color/auto_map_light_logo_bg"
            android:layout_width="@dimen/auto_dimen2_48"
            android:layout_height="@dimen/auto_dimen2_12"
            android:layout_marginBottom="@dimen/auto_dimen2_30"
            android:layout_marginEnd="@dimen/auto_dimen2_24"
            app:background4Night="@color/auto_map_dark_logo_bg"
            app:background4Skin="@color/auto_map_light_logo_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/cl_full_btn"/>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/scl_top_panel_layout"
            android:background="@drawable/custom_card_view_team__m_bg_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:background4Night="@drawable/custom_card_view_team__m_bg_night"
            app:background4Skin="@drawable/custom_card_view_team__m_bg_day">
            <com.autonavi.skin.view.SkinConstraintLayout
                android:id="@+id/top_bar_layout"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="@dimen/auto_dimen2_74"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.autonavi.skin.view.SkinTextView
                    android:id="@+id/stv__back_hotspot"
                    android:background="@drawable/custom_list_pressed_list_day_bg_selector"
                    android:layout_width="@dimen/auto_dimen2_48"
                    android:layout_height="@dimen/auto_dimen2_48"
                    android:contentDescription="返回"
                    android:layout_marginStart="@dimen/auto_dimen2_20"
                    app:background4Night="@drawable/custom_list_pressed_list_night_bg_selector"
                    app:background4Skin="@drawable/custom_list_pressed_list_day_bg_selector"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.autonavi.skin.view.SkinImageView
                    android:id="@+id/favorite_back"
                    android:background="@drawable/icon_setting_back_land_day"
                    android:layout_width="@dimen/auto_dimen2_48"
                    android:layout_height="@dimen/auto_dimen2_48"
                    app:background4Night="@drawable/icon_setting_back_land_night"
                    app:background4Skin="@drawable/icon_setting_back_land_day"
                    app:layout_constraintBottom_toBottomOf="@+id/stv__back_hotspot"
                    app:layout_constraintEnd_toEndOf="@+id/stv__back_hotspot"
                    app:layout_constraintStart_toStartOf="@+id/stv__back_hotspot"
                    app:layout_constraintTop_toTopOf="@+id/stv__back_hotspot"/>
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_20"
                    android:textColor="@color/custom_text_day_color"
                    android:gravity="center_vertical"
                    android:id="@+id/stv_title_team"
                    android:paddingLeft="@dimen/auto_dimen2_8"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/auto_dimen2_32"
                    android:text="@string/user_team_my_team_title"
                    android:singleLine="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/team_setting_hotspot"
                    app:layout_constraintStart_toEndOf="@+id/stv__back_hotspot"
                    app:layout_constraintTop_toTopOf="parent"
                    app:textColor4Night="@color/custom_text_night_color_100"
                    app:textColor4Skin="@color/custom_text_day_color"/>
                <com.autonavi.skin.view.SkinTextView
                    android:id="@+id/team_setting_hotspot"
                    android:background="@drawable/custom_list_pressed_list_day_bg_selector"
                    android:layout_width="@dimen/auto_dimen2_48"
                    android:layout_height="@dimen/auto_dimen2_48"
                    android:layout_marginEnd="@dimen/auto_dimen2_24"
                    app:background4Night="@drawable/custom_list_pressed_list_night_bg_selector"
                    app:background4Skin="@drawable/custom_list_pressed_list_day_bg_selector"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.autonavi.skin.view.SkinImageView
                    android:id="@+id/team_setting_img"
                    android:background="@drawable/user_team_setting_img"
                    android:layout_width="@dimen/auto_dimen2_32"
                    android:layout_height="@dimen/auto_dimen2_32"
                    android:contentDescription="组队设置"
                    app:background4Night="@drawable/user_team_setting_img_night"
                    app:background4Skin="@drawable/user_team_setting_img"
                    app:layout_constraintBottom_toBottomOf="@+id/team_setting_hotspot"
                    app:layout_constraintEnd_toEndOf="@+id/team_setting_hotspot"
                    app:layout_constraintStart_toStartOf="@+id/team_setting_hotspot"
                    app:layout_constraintTop_toTopOf="@+id/team_setting_hotspot"/>
            </com.autonavi.skin.view.SkinConstraintLayout>
            <com.autonavi.skin.view.SkinLinearLayout
                android:id="@+id/sll_team_number"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auto_dimen2_48"
                app:layout_constraintTop_toBottomOf="@+id/top_bar_layout">
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_16"
                    android:textColor="@color/custom_text_day_color"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/stv_team_number"
                    android:background="@drawable/team_command_view_bg_day_new"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/user_team_my_team_number"
                    app:background4Night="@drawable/team_command_view_bg_night_new"
                    app:background4Skin="@drawable/team_command_view_bg_day_new"
                    app:textColor4Night="@color/custom_text_night_color_100"
                    app:textColor4Skin="@color/custom_text_day_color"/>
            </com.autonavi.skin.view.SkinLinearLayout>
            <com.autonavi.skin.view.SkinRelativeLayout
                android:id="@+id/srl_team_member"
                android:paddingBottom="@dimen/auto_dimen2_26"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/auto_dimen2_22"
                android:paddingEnd="@dimen/auto_dimen2_22"
                app:layout_constraintHeight_max="@dimen/auto_dimen2_255"
                app:layout_constraintTop_toBottomOf="@+id/sll_team_number">
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="horizontal"
                    android:id="@+id/rv_team_member"
                    android:paddingTop="@dimen/auto_dimen2_24"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="我的队伍列表|纵向"/>
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_18"
                    android:textColor="@color/custom_text_day_color"
                    android:gravity="start|center_vertical"
                    android:id="@+id/stv_invite_member_tip"
                    android:background="@drawable/team_invite_member_tip_day_bg"
                    android:paddingTop="@dimen/auto_dimen2_11"
                    android:paddingBottom="@dimen/auto_dimen2_6"
                    android:visibility="gone"
                    android:layout_width="@dimen/auto_dimen2_240"
                    android:layout_height="@dimen/auto_dimen2_81"
                    android:layout_marginTop="@dimen/auto_dimen2_148"
                    android:text="@string/user_team_invite_member_tip"
                    android:lineSpacingExtra="@dimen/auto_dimen2_5"
                    android:paddingStart="@dimen/auto_dimen2_12"
                    android:paddingEnd="@dimen/auto_dimen2_4"
                    android:layout_marginStart="@dimen/auto_dimen2_42"
                    app:background4Night="@drawable/team_invite_member_tip_night_bg"
                    app:background4Skin="@drawable/team_invite_member_tip_day_bg"
                    app:textColor4Night="@color/custom_text_night_color_85"
                    app:textColor4Skin="@color/custom_text_day_color"/>
            </com.autonavi.skin.view.SkinRelativeLayout>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/cl_set_destination"
            android:background="@drawable/custom_btn_circular3_bg_normal_day"
            android:focusable="true"
            android:visibility="visible"
            android:clickable="true"
            android:layout_width="@dimen/auto_dimen2_0"
            android:layout_height="@dimen/auto_dimen2_58"
            android:layout_marginLeft="@dimen/auto_dimen2_2"
            android:layout_marginTop="@dimen/auto_dimen2_14"
            app:background4Night="@drawable/custom_btn_circular3_bg_des_night"
            app:background4Skin="@drawable/custom_btn_circular3_bg_normal_day"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/scl_top_panel_layout">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/custom_text_day_color_85"
                android:gravity="start|center_vertical"
                android:id="@+id/stv_set_destination"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/auto_dimen2_9"
                android:text="@string/user_team_my_team_set_destination"
                android:singleLine="true"
                android:layout_marginStart="@dimen/auto_dimen2_28"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/siv_set_destination"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:textColor4Night="@color/custom_text_night_color_85"
                app:textColor4Skin="@color/custom_text_day_color_85"/>
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/siv_set_destination"
                android:background="@drawable/item_next_indicate_img_day_small"
                android:layout_width="@dimen/auto_dimen2_48"
                android:layout_height="@dimen/auto_dimen2_48"
                android:layout_marginTop="@dimen/auto_dimen2_6"
                app:background4Night="@drawable/item_next_indicate_img_small"
                app:background4Skin="@drawable/item_next_indicate_img_day_small"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/stv_set_destination"
                app:layout_constraintTop_toTopOf="parent"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/cl_edit_destination"
            android:background="@drawable/custom_btn_circular3_bg_normal_day"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="@dimen/auto_dimen2_58"
            android:layout_marginLeft="@dimen/auto_dimen2_2"
            android:layout_marginTop="@dimen/auto_dimen2_14"
            app:background4Night="@drawable/custom_btn_circular3_bg_des_night"
            app:background4Skin="@drawable/custom_btn_circular3_bg_normal_day"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/scl_top_panel_layout">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/custom_text_day_color_85"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/stv_destination"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/auto_dimen2_7"
                android:maxLines="1"
                android:lineSpacingExtra="@dimen/auto_dimen2_5"
                android:layout_marginEnd="@dimen/auto_dimen2_52"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/stv_go_here"
                app:layout_constraintStart_toEndOf="@+id/siv_edit_destination"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/auto_dimen2_535"
                app:textColor4Night="@color/custom_text_night_color_85"
                app:textColor4Skin="@color/custom_text_day_color_85"/>
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/siv_edit_destination"
                android:background="@drawable/team_edit_destination_day"
                android:layout_width="@dimen/auto_dimen2_48"
                android:layout_height="@dimen/auto_dimen2_48"
                android:contentDescription="编辑"
                android:layout_marginStart="@dimen/auto_dimen2_8"
                app:background4Night="@drawable/team_edit_destination_night"
                app:background4Skin="@drawable/team_edit_destination_day"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/stv_destination"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/go_here_day_color_fui"
                android:gravity="center"
                android:id="@+id/stv_go_here"
                android:layout_width="@dimen/auto_dimen2_64"
                android:layout_height="@dimen/auto_dimen2_26"
                android:layout_marginTop="@dimen/auto_dimen2_7"
                android:text="@string/auto_navi_text_go_here"
                android:layout_marginEnd="@dimen/auto_dimen2_25"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:textColor4Night="@color/go_here_night_color_fui"
                app:textColor4Skin="@color/go_here_day_color_fui"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/message_more_img"
            android:background="@drawable/message_more_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/auto_dimen2_87"
            android:layout_centerHorizontal="true"
            app:background4Night="@drawable/message_more_night"
            app:background4Skin="@drawable/message_more_day"
            app:layout_constraintBottom_toTopOf="@+id/srl_message"
            app:layout_constraintStart_toStartOf="@+id/scl_main_view"/>
        <com.autonavi.skin.view.SkinRelativeLayout
            android:id="@+id/srl_message"
            android:paddingTop="@dimen/auto_dimen2_5"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/auto_dimen2_22"
            android:maxHeight="@dimen/auto_dimen2_190"
            android:alpha="1"
            android:paddingEnd="@dimen/auto_dimen2_5"
            app:layout_constraintBottom_toBottomOf="@+id/scl_main_view"
            app:layout_constraintStart_toStartOf="parent">
            <com.autonavi.pullview.MRecyclerView
                android:orientation="vertical"
                android:id="@+id/rv_message_view"
                android:fadingEdge="none"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/auto_dimen2_280"/>
        </com.autonavi.skin.view.SkinRelativeLayout>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/cl_top_panel_layout_message"
            android:paddingTop="@dimen/auto_dimen2_10"
            android:paddingBottom="@dimen/auto_dimen2_8"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/auto_dimen2_373"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/scl_main_view"
            app:layout_constraintTop_toBottomOf="@+id/srl_team_member">
            <com.autonavi.skin.view.SkinConstraintLayout
                android:orientation="vertical"
                android:id="@+id/scl_top_panel_layout_right"
                android:background="@drawable/custom_card_view_team__m_bg_day"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:background4Night="@drawable/custom_card_view_team__m_bg_night"
                app:background4Skin="@drawable/custom_card_view_team__m_bg_day">
                <com.autonavi.pullview.MRecyclerView
                    android:orientation="vertical"
                    android:id="@+id/more_msg_recycler_view"
                    android:fadingEdge="none"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/auto_dimen2_20"
                    android:layout_marginBottom="@dimen/auto_dimen2_28"
                    app:layout_constraintBottom_toTopOf="@+id/skinConstraintLayout"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.autonavi.skin.view.SkinConstraintLayout
                    android:id="@+id/skinConstraintLayout"
                    android:paddingBottom="@dimen/auto_dimen2_5"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/auto_dimen2_48"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <com.autonavi.skin.view.SkinImageView
                        android:id="@+id/bt_take_back"
                        android:background="@drawable/change_small_day"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_centerHorizontal="true"
                        app:background4Night="@drawable/change_small_night"
                        app:background4Skin="@drawable/change_small_day"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </com.autonavi.skin.view.SkinConstraintLayout>
            </com.autonavi.skin.view.SkinConstraintLayout>
        </com.autonavi.skin.view.SkinConstraintLayout>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
