<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:autoSkin="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_alignParentRight="true">
    <com.autonavi.skin.view.SkinRelativeLayout
        android:id="@+id/tmc_bar_bady"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/auto_font_size_24"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="@dimen/auto_font_size_24">
        <com.autonavi.skin.view.SkinLinearLayout
            android:orientation="vertical"
            android:id="@+id/tmc_bar_container"
            android:background="@drawable/auto_tmcbar_bg_day"
            android:layout_width="@dimen/auto_dimen2_22"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/auto_dimen2_13"
            android:layout_marginBottom="@dimen/auto_dimen2_13"
            android:layout_centerHorizontal="true"
            autoSkin:background4Night="@drawable/auto_tmcbar_bg_night"
            autoSkin:background4Skin="@drawable/auto_tmcbar_bg_day">
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/navi_tmc_top"
                android:background="@drawable/global_image_restdistance"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auto_dimen2_9"
                android:layout_marginLeft="@dimen/auto_dimen2_4"
                android:layout_marginTop="@dimen/auto_dimen2_4"
                android:layout_marginRight="@dimen/auto_dimen2_4"
                autoSkin:background4Night="@drawable/global_image_restdistance"
                autoSkin:background4Skin="@drawable/global_image_restdistance"/>
            <com.autosdk.drive.navi.view.card.view.TmcBarView
                android:id="@+id/tmc_bar_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginLeft="@dimen/auto_dimen2_4"
                android:layout_marginTop="@dimen/auto_dimen2_2"
                android:layout_marginRight="@dimen/auto_dimen2_4"
                android:layout_marginBottom="@dimen/auto_dimen2_4"
                android:layout_weight="1"/>
        </com.autonavi.skin.view.SkinLinearLayout>
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/navi_tmc_cursor"
            android:background="@drawable/global_image_hawkeye_navi_car_circle_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            autoSkin:background4Night="@drawable/global_image_hawkeye_navi_car_circle_day"
            autoSkin:background4Skin="@drawable/global_image_hawkeye_navi_car_circle_day"/>
    </com.autonavi.skin.view.SkinRelativeLayout>
</com.autonavi.skin.view.SkinRelativeLayout>
