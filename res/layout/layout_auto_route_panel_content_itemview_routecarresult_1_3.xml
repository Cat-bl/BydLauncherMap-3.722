<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@id/cl_auto_route_panel_content_itemview"
    android:layout_width="@dimen/auto_dimen2_114"
    android:layout_height="wrap_content"
    app:designHeight="600"
    app:designWidth="1024">

    <com.autonavi.view.custom.CustomListLineView
        android:id="@id/cll_item_divier"
        android:layout_width="@dimen/divider_width_port"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/auto_dimen2_9"
        android:layout_marginBottom="@dimen/auto_dimen2_7"
        android:background="@color/divider_bg_color_light"
        app:background4Night="@color/divider_bg_color_dark"
        app:background4Skin="@color/divider_bg_color_light"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@id/cl_auto_route_panel_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/auto_font_size_10"
        android:layout_marginEnd="@dimen/auto_font_size_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.autonavi.skin.view.SkinImageView
            android:id="@id/ccs_item_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/custom_content_selected_bg_day_bg_selector"
            app:background4Night="@drawable/custom_content_selected_bg_night_bg_selector"
            app:background4Skin="@drawable/custom_content_selected_bg_day_bg_selector"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@id/cl_auto_route_panel_content_detail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.autonavi.skin.view.SkinTextView
                android:id="@id/stv_auto_panel_content_time_des"
                android:layout_width="0dp"
                android:layout_height="@dimen/auto_dimen2_32"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:singleLine="true"
                android:text="@string/routecarresult_auto_panel_content_time_des"
                android:textColor="@color/custom_route_textcolor_day"
                android:textSize="@dimen/auto_font_size_20"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:textColor4Night="@color/custom_route_textcolor_night"
                app:textColor4Skin="@color/custom_route_textcolor_day" />

            <com.autonavi.skin.view.SkinTextView
                android:id="@id/stv_auto_panel_content_distance_des"
                android:layout_width="0dp"
                android:layout_height="@dimen/auto_dimen2_20"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:singleLine="true"
                android:text="@string/routecarresult_auto_panel_content_distance_des"
                android:textColor="@color/custom_route_textcolor_btn_text_day"
                android:textSize="@dimen/auto_font_size_12"
                app:layout_constraintEnd_toStartOf="@id/scl_extra_info"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/stv_auto_panel_content_time_des"
                app:textColor4Night="@color/custom_route_textcolor_btn_text_night"
                app:textColor4Skin="@color/custom_route_textcolor_btn_text_day" />

            <com.autonavi.skin.view.SkinConstraintLayout
                android:id="@id/scl_extra_info"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/auto_dimen2_20"
                android:layout_marginStart="@dimen/auto_dimen2_4"
                app:layout_constraintBottom_toBottomOf="@id/stv_auto_panel_content_distance_des"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/stv_auto_panel_content_distance_des">

                <com.autonavi.skin.view.SkinImageView
                    android:id="@id/siv_icon_yuan"
                    android:layout_width="@dimen/auto_dimen2_10"
                    android:layout_height="@dimen/auto_dimen2_14"
                    android:src="@drawable/icon_route_cost_day"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:src4Night="@drawable/icon_route_cost_day_normal"
                    app:src4Skin="@drawable/icon_route_cost_day" />

                <com.autonavi.skin.view.SkinTextView
                    android:id="@id/stv_auto_panel_content_fee_des"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:singleLine="true"
                    android:text="@string/routecarresult_auto_panel_content_fee_des"
                    android:textColor="@color/custom_route_textcolor_btn_text_day"
                    android:textSize="@dimen/auto_font_size_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/siv_icon_yuan"
                    app:layout_constraintTop_toTopOf="parent"
                    app:textColor4Night="@color/custom_route_textcolor_btn_text_night"
                    app:textColor4Skin="@color/custom_route_textcolor_btn_text_day" />

                <com.autonavi.skin.view.SkinImageView
                    android:id="@id/siv_icon_traffic_light"
                    android:layout_width="@dimen/auto_dimen2_10"
                    android:layout_height="@dimen/auto_dimen2_14"
                    android:layout_marginStart="@dimen/auto_dimen2_4"
                    android:src="@drawable/icon_route_traffic_light_day"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/stv_auto_panel_content_fee_des"
                    app:layout_constraintTop_toTopOf="parent"
                    app:src4Night="@drawable/icon_route_traffic_light_night"
                    app:src4Skin="@drawable/icon_route_traffic_light_day" />

                <com.autonavi.skin.view.SkinTextView
                    android:id="@id/stv_auto_panel_content_traffic_des"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:singleLine="true"
                    android:text="@string/routecarresult_auto_panel_content_traffic_des"
                    android:textColor="@color/custom_route_textcolor_btn_text_day"
                    android:textSize="@dimen/auto_font_size_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/siv_icon_traffic_light"
                    app:layout_constraintTop_toTopOf="parent"
                    app:textColor4Night="@color/custom_route_textcolor_btn_text_night"
                    app:textColor4Skin="@color/custom_route_textcolor_btn_text_day" />
            </com.autonavi.skin.view.SkinConstraintLayout>

            <com.autonavi.skin.view.SkinTextView
                android:id="@id/stv_auto_panel_content_route_pref"
                android:layout_width="0dp"
                android:layout_height="@dimen/auto_dimen2_20"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:singleLine="true"
                android:text="@string/routecarresult_auto_panel_content_route_pref"
                android:textColor="@color/custom_route_textcolor_btn_text_day"
                android:textSize="@dimen/auto_font_size_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/stv_auto_panel_content_distance_des"
                app:textColor4Night="@color/custom_route_textcolor_btn_text_night"
                app:textColor4Skin="@color/custom_route_textcolor_btn_text_day" />
        </com.autonavi.skin.view.SkinConstraintLayout>
    </com.autonavi.skin.view.SkinConstraintLayout>

    <!-- 722 presenter still resolves these IDs even though 1/3 no longer renders the legacy detail blocks. -->
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@id/scl_remain_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <com.autonavi.skin.view.SkinImageView android:id="@id/siv_battery_icon" android:layout_width="0dp" android:layout_height="0dp" />
        <com.autonavi.skin.view.SkinTextView android:id="@id/stv_remain_energy" android:layout_width="0dp" android:layout_height="0dp" />
        <com.autonavi.skin.view.SkinImageView android:id="@id/siv_not_arrive_icon" android:layout_width="0dp" android:layout_height="0dp" />
        <com.autonavi.skin.view.SkinTextView android:id="@id/stv_not_arrive" android:layout_width="0dp" android:layout_height="0dp" />
        <com.autonavi.skin.view.SkinTextView android:id="@id/stv_elec_recommend_tip" android:layout_width="0dp" android:layout_height="0dp" />
        <androidx.constraintlayout.widget.Group android:id="@id/group_not_arrive_layout" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:constraint_referenced_ids="siv_not_arrive_icon,stv_not_arrive" />
    </com.autonavi.skin.view.SkinConstraintLayout>

    <com.autonavi.skin.view.SkinTextView android:id="@id/cl_auto_route_panel_content_detail_num" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <com.autonavi.skin.view.SkinImageView android:id="@id/siv_icon_dnp" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <com.autonavi.skin.view.SkinTextView android:id="@id/siv_text_dnp" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <androidx.constraintlayout.widget.Group android:id="@id/siv_dnp_group" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" app:constraint_referenced_ids="siv_icon_dnp,siv_text_dnp" />
    <com.autonavi.skin.view.SkinTextView android:id="@id/siv_text_dnp_max" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

    <com.autonavi.skin.view.SkinImageView
        android:id="@id/siv_auto_panel_content_detail_icon_closed"
        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_48"
        android:contentDescription="更多"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</com.autonavi.skin.view.SkinConstraintLayout>
