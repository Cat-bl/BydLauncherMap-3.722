<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/auto_dimen2_24"
    android:minWidth="@dimen/auto_dimen2_96"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_14"
        android:textColor="@drawable/search_filter_view_first_text_day_bg_selector"
        android:gravity="center_vertical"
        android:id="@+id/stv_first_filter_text"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/auto_dimen2_24"
        android:text="@string/auto_search_result_map_text_item"
        android:layout_marginStart="@dimen/auto_dimen2_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@drawable/search_filter_view_first_text_night_bg_selector"
        app:textColor4Skin="@drawable/search_filter_view_first_text_day_bg_selector"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_10"
        android:textColor="@color/recommend_item_name_text_color_night"
        android:gravity="center"
        android:id="@+id/siv_one_filter_more_num"
        android:background="@drawable/filter_more_check_num_bg_day"
        android:layout_width="@dimen/auto_dimen2_16"
        android:layout_height="@dimen/auto_dimen2_16"
        android:text="5"
        android:layout_marginStart="@dimen/auto_dimen2_2"
        app:background4Night="@drawable/filter_more_check_num_bg"
        app:background4Skin="@drawable/filter_more_check_num_bg_day"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/stv_first_filter_text"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_one_filter_right_icon"
        android:background="@drawable/search_filter_icon_public_triangle_day_selector"
        android:layout_width="@dimen/auto_dimen2_24"
        android:layout_height="@dimen/auto_dimen2_24"
        app:background4Night="@drawable/search_filter_icon_public_triangle_night_selector"
        app:background4Skin="@drawable/search_filter_icon_public_triangle_day_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/siv_one_filter_more_num"
        app:layout_constraintTop_toTopOf="parent"/>
</com.autonavi.skin.view.SkinConstraintLayout>
