<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.autonavi.skin.view.SkinView
        android:id="@+id/cc_bg"
        android:background="@drawable/track_show_photo_view_bg_day"
        android:layout_width="match_parent"
        android:layout_height="@dimen/auto_dimen2_528"
        android:layout_marginTop="@dimen/auto_dimen2_8"
        app:background4Night="@drawable/track_show_photo_view_bg_night"
        app:background4Skin="@drawable/track_show_photo_view_bg_day"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/custom_card_shadow_style"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_back"
        android:background="@drawable/custom_list_pressed_list_day_bg_selector"
        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_48"
        android:layout_marginTop="@dimen/auto_dimen2_13"
        android:layout_marginStart="@dimen/auto_dimen2_48"
        app:background4Night="@drawable/custom_list_pressed_list_night_bg_selector"
        app:background4Skin="@drawable/custom_list_pressed_list_day_bg_selector"
        app:layout_constraintStart_toStartOf="@+id/cc_bg"
        app:layout_constraintTop_toTopOf="@+id/cc_bg"
        app:src4Night="@drawable/icon_setting_back_land_night"
        app:src4Skin="@drawable/icon_setting_back_land_day"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_20"
        android:textColor="@color/byd_track_mp_text_title_day"
        android:id="@+id/stv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/track_show_photo_title"
        app:layout_constraintBottom_toBottomOf="@+id/siv_back"
        app:layout_constraintEnd_toEndOf="@+id/cc_bg"
        app:layout_constraintStart_toStartOf="@+id/cc_bg"
        app:layout_constraintTop_toTopOf="@+id/siv_back"
        app:textColor4Night="@color/byd_track_mp_text_title_night"
        app:textColor4Skin="@color/byd_track_mp_text_title_day"/>
    <com.autonavi.view.custom.CustomRoundImageView
        android:id="@+id/siv_show_photo"
        android:layout_width="@dimen/auto_dimen2_0"
        android:layout_height="@dimen/auto_dimen2_0"
        android:layout_marginTop="@dimen/auto_dimen2_29"
        android:layout_marginBottom="@dimen/auto_dimen2_32"
        android:layout_marginStart="@dimen/auto_dimen2_60"
        android:layout_marginEnd="@dimen/auto_dimen2_60"
        app:allRadius="@dimen/auto_dimen2_8"
        app:layout_constraintBottom_toBottomOf="@+id/cc_bg"
        app:layout_constraintEnd_toEndOf="@+id/cc_bg"
        app:layout_constraintStart_toStartOf="@+id/cc_bg"
        app:layout_constraintTop_toBottomOf="@+id/siv_back"/>
    <com.autonavi.view.custom.CustomMongoliaView
        android:id="@+id/cm_mongolia"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cc_bg"/>
</com.autonavi.skin.view.SkinConstraintLayout>
