<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="720"
    app:designWidth="1280">
    <com.autonavi.skin.view.SkinConstraintLayout
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/style_setting_bg">
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/scl_main_layout"
            android:layout_width="@dimen/auto_dimen2_0"
            android:layout_height="@dimen/auto_dimen2_48"
            android:layout_marginTop="@dimen/auto_dimen2_24"
            android:layout_marginStart="@dimen/auto_dimen2_28"
            android:layout_marginEnd="@dimen/auto_dimen2_32"
            app:layout_constraintEnd_toStartOf="@+id/stv_save"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/clp_back_hotspot"
            android:background="@drawable/custom_list_pressed_list_day_bg_selector"
            android:layout_width="@dimen/auto_dimen2_48"
            android:layout_height="@dimen/auto_dimen2_48"
            android:contentDescription="返回"
            android:layout_marginEnd="@dimen/auto_dimen2_16"
            app:background4Night="@drawable/custom_list_pressed_list_night_bg_selector"
            app:background4Skin="@drawable/custom_list_pressed_list_day_bg_selector"
            app:layout_constraintBottom_toBottomOf="@+id/scl_main_layout"
            app:layout_constraintEnd_toStartOf="@+id/cl_input_layout"
            app:layout_constraintStart_toStartOf="@+id/scl_main_layout"
            app:layout_constraintTop_toTopOf="@+id/scl_main_layout">
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/siv_back"
                android:background="@drawable/icon_setting_back_land_day"
                android:layout_width="@dimen/auto_dimen2_48"
                android:layout_height="@dimen/auto_dimen2_48"
                app:background4Night="@drawable/icon_setting_back_land_night"
                app:background4Skin="@drawable/icon_setting_back_land_day"
                app:layout_constraintBottom_toBottomOf="@+id/clp_back_hotspot"
                app:layout_constraintEnd_toEndOf="@+id/clp_back_hotspot"
                app:layout_constraintStart_toStartOf="@+id/clp_back_hotspot"
                app:layout_constraintTop_toTopOf="@+id/clp_back_hotspot"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinRelativeLayout
            android:id="@+id/cl_input_layout"
            android:background="@drawable/team_join_team_input_box_bg_day"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:background4Night="@drawable/team_join_team_input_box_bg_night"
            app:background4Skin="@drawable/team_join_team_input_box_bg_day"
            app:layout_constraintBottom_toBottomOf="@+id/scl_main_layout"
            app:layout_constraintEnd_toEndOf="@+id/scl_main_layout"
            app:layout_constraintStart_toEndOf="@+id/clp_back_hotspot"
            app:layout_constraintTop_toTopOf="@+id/scl_main_layout"
            app:tag="DisableAtRunTime">
            <com.autonavi.skin.view.SkinEditText
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/custom_text_day_color_100"
                android:textColorHint="@color/color_subtitle_text_day_color"
                android:gravity="start|center_vertical"
                android:id="@+id/set_input_editText"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/null_text"
                android:singleLine="true"
                android:maxLength="50"
                android:layout_toLeftOf="@+id/siv_input_delete"
                android:layout_centerVertical="true"
                android:imeOptions="flagNoExtractUi|flagNoFullscreen"
                android:textCursorDrawable="@drawable/auto_search_around_search_around_cursor_drawable"
                android:paddingStart="@dimen/auto_dimen2_28"
                android:layout_alignParentStart="true"
                app:textColor4Night="@color/custom_text_night_color"
                app:textColor4Skin="@color/custom_text_day_color_100"
                app:textColorHint4Night="@color/custom_text_night_color_55"
                app:textColorHint4Skin="@color/custom_text_day_color_55"/>
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/siv_input_delete"
                android:layout_width="@dimen/auto_dimen2_48"
                android:layout_height="@dimen/auto_dimen2_48"
                android:src="@drawable/common_clear_input_day_img"
                android:scaleType="fitCenter"
                android:layout_centerInParent="true"
                android:layout_centerVertical="true"
                android:contentDescription="删除"
                android:layout_marginStart="@dimen/auto_dimen2_20"
                android:layout_toStartOf="@+id/content_line_end"
                app:src4Night="@drawable/common_clear_input_night_img"
                app:src4Skin="@drawable/common_clear_input_day_img"/>
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/content_line_end"
                android:background="@color/auto_color_D2DFE8"
                android:layout_width="@dimen/auto_dimen2_0"
                android:layout_height="@dimen/auto_dimen2_28"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/stv_save2"
                app:background4Night="@color/auto_color_365173"
                app:background4Skin="@color/auto_color_D2DFE8"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/custom_text_day_color_85"
                android:gravity="start|center_vertical"
                android:id="@+id/stv_save2"
                android:layout_width="@dimen/auto_dimen2_0"
                android:layout_height="wrap_content"
                android:text="@string/user_team_setting_team_modify_nickname_complete"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/auto_dimen2_28"
                android:layout_alignParentEnd="true"
                app:textColorHint4Night="@color/custom_text_night_color_85"
                app:textColorHint4Skin="@color/custom_text_day_color_85"/>
        </com.autonavi.skin.view.SkinRelativeLayout>
        <com.autonavi.skin.view.SkinTextView
            android:enabled="false"
            android:textSize="@dimen/auto_font_size_18"
            android:textColor="@color/byd_custom_normal_btn_text_color_selector_day"
            android:gravity="center"
            android:id="@+id/stv_save"
            android:background="@drawable/byd_custom_normal_btn_bg_selector_day"
            android:layout_width="@dimen/auto_dimen2_160"
            android:layout_height="@dimen/auto_dimen2_48"
            android:layout_marginTop="@dimen/auto_dimen2_24"
            android:text="@string/user_car_edit_plate_complete"
            android:lineSpacingExtra="@dimen/auto_dimen2_4"
            android:layout_marginEnd="@dimen/auto_dimen2_32"
            app:background4Night="@drawable/byd_custom_normal_btn_bg_selector_night"
            app:background4Skin="@drawable/byd_custom_normal_btn_bg_selector_day"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/byd_custom_normal_btn_text_color_selector_night"
            app:textColor4Skin="@color/byd_custom_normal_btn_text_color_selector_day"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
