<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_auto_navi_info_panel_parking"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinView
        android:background="@drawable/custom_normal_card_bg_day"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:background4Night="@drawable/custom_normal_card_bg_night"
        app:background4Skin="@drawable/custom_normal_card_bg_day"
        app:layout_constraintBottom_toBottomOf="@+id/cl_auto_navi_info_panel_parking"
        app:layout_constraintEnd_toEndOf="@+id/cl_auto_navi_info_panel_parking"
        app:layout_constraintStart_toStartOf="@+id/cl_auto_navi_info_panel_parking"
        app:layout_constraintTop_toTopOf="@+id/cl_auto_navi_info_panel_parking"
        app:shadowColor="@color/auto_ui_000000_33"
        app:shadowColorNight="@color/auto_ui_000000_33"
        app:shadowCorner="@dimen/auto_dimen2_4"
        app:shadowCornerBottomLeft="@dimen/auto_dimen2_0"
        app:shadowCornerBottomRight="@dimen/auto_dimen2_0"
        app:shadowCornerTopLeft="@dimen/auto_dimen2_0"
        app:shadowCornerTopRight="@dimen/auto_dimen2_0"
        app:shadowDx="@dimen/auto_dimen2_0"
        app:shadowDy="@dimen/auto_dimen2_2"
        app:shadowRadius="@dimen/auto_dimen2_8"
        app:shadowShapeType="rectangle"
        app:shadowSide="all"
        app:shadowVisibility="true"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_dialog_parking_fold"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_64"
        android:layout_marginBottom="@dimen/auto_dimen2_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/cl_carry_out"
            android:layout_width="@dimen/auto_dimen2_28"
            android:layout_height="@dimen/auto_dimen2_28"
            android:layout_marginRight="@dimen/auto_dimen2_18"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.autonavi.view.custom.CustomListPressedView
                android:id="@+id/clp_carry_out"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/siv_carry_out"
                android:background="@drawable/icon_auto_navi_carry_out_day"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:background4Night="@drawable/icon_auto_navi_carry_out_day"
                app:background4Skin="@drawable/icon_auto_navi_carry_out_day"
                app:layout_constraintBottom_toBottomOf="@+id/clp_carry_out"
                app:layout_constraintEnd_toEndOf="@+id/clp_carry_out"
                app:layout_constraintStart_toStartOf="@+id/clp_carry_out"
                app:layout_constraintTop_toTopOf="@+id/clp_carry_out"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/cl_parking"
            android:background="@drawable/icon_auto_navi_recommend_park"
            android:layout_width="@dimen/auto_dimen2_42"
            android:layout_height="@dimen/auto_dimen2_42"
            android:layout_marginLeft="@dimen/auto_dimen2_18"
            app:background4Night="@drawable/icon_auto_navi_recommend_park"
            app:background4Skin="@drawable/icon_auto_navi_recommend_park"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_20"
            android:textColor="@color/navi_card_title_color_day"
            android:ellipsize="end"
            android:gravity="left"
            android:id="@+id/stv_text_parking_fold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/auto_dimen2_8"
            android:layout_marginRight="@dimen/auto_dimen2_8"
            android:text="@string/auto_navi_text_parking_fold"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/cl_carry_out"
            app:layout_constraintStart_toEndOf="@+id/cl_parking"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/navi_card_title_color_night"
            app:textColor4Skin="@color/navi_card_title_color_day"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_dialog_parking_unfold"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/auto_dimen2_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/cl_parking_tabs"
            android:layout_width="0dp"
            android:layout_height="@dimen/auto_dimen2_30"
            android:layout_marginLeft="@dimen/auto_dimen2_28"
            android:layout_marginTop="@dimen/auto_dimen2_12"
            android:layout_marginRight="@dimen/auto_dimen2_28"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.autonavi.view.custom.CustomBtnCheckbox3View
                android:id="@+id/cbc_tab1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginRight="@dimen/auto_dimen2_5"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/cbc_tab2"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintHorizontal_weight="96"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.autonavi.skin.view.SkinConstraintLayout
                android:id="@+id/cl_tab1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/cbc_tab1"
                app:layout_constraintEnd_toEndOf="@+id/cbc_tab1"
                app:layout_constraintStart_toStartOf="@+id/cbc_tab1"
                app:layout_constraintTop_toTopOf="@+id/cbc_tab1">
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_20"
                    android:textColor="@color/byd_custom_secondary_btn_text_color_selector_day"
                    android:gravity="left"
                    android:id="@+id/stv_text_tab1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_navi_text_tab1"
                    android:lineSpacingExtra="@dimen/auto_dimen2_4"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:textColor4Night="@color/byd_custom_secondary_btn_text_color_selector_night"
                    app:textColor4Skin="@color/byd_custom_secondary_btn_text_color_selector_day"/>
                <com.autonavi.skin.view.SkinImageView
                    android:id="@+id/siv_tab1"
                    android:background="@drawable/auto_navi_tab1_day"
                    android:visibility="gone"
                    android:layout_width="@dimen/auto_dimen2_16"
                    android:layout_height="@dimen/auto_dimen2_24"
                    android:layout_marginRight="@dimen/auto_dimen2_8"
                    android:layout_marginBottom="@dimen/auto_dimen2_6"
                    app:background4Night="@drawable/auto_navi_tab1_night"
                    app:background4Skin="@drawable/auto_navi_tab1_day"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/stv_text_tab1"/>
            </com.autonavi.skin.view.SkinConstraintLayout>
            <com.autonavi.view.custom.CustomBtnCheckbox3View
                android:id="@+id/cbc_tab3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginLeft="@dimen/auto_dimen2_5"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="96"
                app:layout_constraintStart_toEndOf="@+id/cbc_tab2"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.autonavi.skin.view.SkinConstraintLayout
                android:id="@+id/cl_tab3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/cbc_tab3"
                app:layout_constraintEnd_toEndOf="@+id/cbc_tab3"
                app:layout_constraintStart_toStartOf="@+id/cbc_tab3"
                app:layout_constraintTop_toTopOf="@+id/cbc_tab3">
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_20"
                    android:textColor="@color/byd_custom_secondary_btn_text_color_selector_day"
                    android:gravity="left"
                    android:id="@+id/stv_text_tab3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_navi_text_tab3"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:textColor4Night="@color/byd_custom_secondary_btn_text_color_selector_night"
                    app:textColor4Skin="@color/byd_custom_secondary_btn_text_color_selector_day"/>
                <com.autonavi.skin.view.SkinImageView
                    android:id="@+id/siv_tab3"
                    android:background="@drawable/auto_navi_tab3_day"
                    android:visibility="gone"
                    android:layout_width="@dimen/auto_dimen2_16"
                    android:layout_height="@dimen/auto_dimen2_24"
                    android:layout_marginRight="@dimen/auto_dimen2_8"
                    android:layout_marginBottom="@dimen/auto_dimen2_6"
                    app:background4Night="@drawable/auto_navi_tab3_night"
                    app:background4Skin="@drawable/auto_navi_tab3_day"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/stv_text_tab3"/>
            </com.autonavi.skin.view.SkinConstraintLayout>
            <com.autonavi.view.custom.CustomBtnCheckbox3View
                android:id="@+id/cbc_tab2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginLeft="@dimen/auto_dimen2_5"
                android:layout_marginRight="@dimen/auto_dimen2_5"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/cbc_tab3"
                app:layout_constraintHorizontal_weight="96"
                app:layout_constraintStart_toEndOf="@+id/cbc_tab1"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.autonavi.skin.view.SkinConstraintLayout
                android:id="@+id/cl_tab2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/cbc_tab2"
                app:layout_constraintEnd_toEndOf="@+id/cbc_tab2"
                app:layout_constraintStart_toStartOf="@+id/cbc_tab2"
                app:layout_constraintTop_toTopOf="@+id/cbc_tab2">
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_20"
                    android:textColor="@color/byd_custom_secondary_btn_text_color_selector_day"
                    android:gravity="left"
                    android:id="@+id/stv_text_tab2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_navi_text_tab2"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:textColor4Night="@color/byd_custom_secondary_btn_text_color_selector_night"
                    app:textColor4Skin="@color/byd_custom_secondary_btn_text_color_selector_day"/>
                <com.autonavi.skin.view.SkinImageView
                    android:id="@+id/siv_tab2"
                    android:background="@drawable/auto_navi_tab2_day"
                    android:visibility="gone"
                    android:layout_width="@dimen/auto_dimen2_16"
                    android:layout_height="@dimen/auto_dimen2_24"
                    android:layout_marginRight="@dimen/auto_dimen2_8"
                    android:layout_marginBottom="@dimen/auto_dimen2_6"
                    app:background4Night="@drawable/auto_navi_tab2_night"
                    app:background4Skin="@drawable/auto_navi_tab2_day"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/stv_text_tab2"/>
            </com.autonavi.skin.view.SkinConstraintLayout>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_20"
            android:textColor="@color/navi_card_title_color_day"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/stv_text_praking_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/auto_dimen2_32"
            android:layout_marginTop="@dimen/auto_dimen2_8"
            android:layout_marginRight="@dimen/auto_dimen2_32"
            android:text="@string/auto_navi_text_praking_location"
            android:singleLine="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cl_parking_tabs"
            app:textColor4Night="@color/navi_card_title_color_night"
            app:textColor4Skin="@color/navi_card_title_color_day"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_20"
            android:textColor="@color/navi_card_subtitle_color_day"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/stv_text_praking_distance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/auto_dimen2_32"
            android:layout_marginTop="@dimen/auto_dimen2_8"
            android:layout_marginRight="@dimen/auto_dimen2_32"
            android:text="@string/auto_navi_text_praking_distance"
            android:singleLine="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/stv_text_praking_location"
            app:textColor4Night="@color/navi_card_subtitle_color_night"
            app:textColor4Skin="@color/navi_card_subtitle_color_day"/>
        <com.autonavi.skin.view.SkinLinearLayout
            android:id="@+id/button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_8"
            android:layout_marginBottom="@dimen/auto_dimen2_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/stv_text_praking_distance">
            <com.autonavi.skin.view.SkinConstraintLayout
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/auto_dimen2_24"
                android:layout_marginRight="@dimen/auto_dimen2_12"
                android:layout_weight="1">
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_18"
                    android:textColor="@color/byd_custom_drive_charge_station_card_left_btn_text_color_day_selector"
                    android:gravity="center"
                    android:id="@+id/stv_text_stop"
                    android:background="@drawable/byd_custom_btn_function1_btn_function1_day_bg_selector"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/auto_dimen2_36"
                    android:maxWidth="@dimen/auto_dimen2_144"
                    android:text="@string/auto_navi_text_stop"
                    app:background4Night="@drawable/byd_custom_btn_function1_btn_function1_night_bg_selector"
                    app:background4Skin="@drawable/byd_custom_btn_function1_btn_function1_day_bg_selector"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0"
                    app:tag="DisableAtRunTime"
                    app:textColor4Night="@color/byd_custom_drive_charge_station_card_left_btn_text_color_night_selector"
                    app:textColor4Skin="@color/byd_custom_drive_charge_station_card_left_btn_text_color_day_selector"/>
            </com.autonavi.skin.view.SkinConstraintLayout>
            <com.autonavi.skin.view.SkinConstraintLayout
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/auto_dimen2_12"
                android:layout_marginRight="@dimen/auto_dimen2_24"
                android:layout_weight="1">
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_18"
                    android:textColor="@color/custom_btn_smart_modify_text_day_bg"
                    android:gravity="center"
                    android:id="@+id/stv_text_ignore"
                    android:background="@drawable/byd_custom_btn_function2_day_bg_selector_new"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/auto_dimen2_36"
                    android:maxWidth="@dimen/auto_dimen2_144"
                    android:text="@string/auto_navi_text_ignore"
                    app:background4Night="@drawable/byd_custom_btn_function2_night_bg_selector_new"
                    app:background4Skin="@drawable/byd_custom_btn_function2_day_bg_selector_new"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.3"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0"
                    app:tag="DisableAtRunTime"
                    app:textColor4Night="@color/custom_btn_smart_modify_text_night_bg"
                    app:textColor4Skin="@color/custom_btn_smart_modify_text_day_bg"/>
            </com.autonavi.skin.view.SkinConstraintLayout>
        </com.autonavi.skin.view.SkinLinearLayout>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
