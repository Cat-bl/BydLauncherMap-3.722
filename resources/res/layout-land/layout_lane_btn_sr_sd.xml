<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_dnp_sr_sd_switch"
    android:background="@drawable/custom_home_btn_left_round_bg_day_selector"
    android:visibility="gone"
    android:layout_width="@dimen/auto_dimen2_64"
    android:layout_height="@dimen/auto_dimen2_48"
    app:background4Night="@drawable/custom_home_btn_left_round_bg_night_selector"
    app:background4Skin="@drawable/custom_home_btn_left_round_bg_day_selector">
    <com.autonavi.skin.view.SkinImageView
        android:background="@drawable/ic_sr_sd_bg_day"
        android:layout_width="@dimen/auto_dimen2_36"
        android:layout_height="@dimen/auto_dimen2_36"
        android:layout_marginTop="@dimen/auto_dimen2_4"
        app:background4Night="@drawable/ic_sr_sd_bg_night"
        app:background4Skin="@drawable/ic_sr_sd_bg_day"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinLottieAnimationView
        android:id="@+id/siv_dnp_sr_sd_switch"
        android:layout_width="@dimen/auto_dimen2_36"
        android:layout_height="@dimen/auto_dimen2_36"
        android:layout_marginTop="@dimen/auto_dimen2_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="false"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_11"
        android:textColor="@color/navi_card_title_color_day"
        android:id="@+id/stv_dnp_sr_sd_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/auto_dimen2_6"
        android:text="@string/tv_sd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:textColor4Night="@color/navi_card_title_color_night"
        app:textColor4Skin="@color/navi_card_title_color_day"/>
</com.autonavi.skin.view.SkinConstraintLayout>
