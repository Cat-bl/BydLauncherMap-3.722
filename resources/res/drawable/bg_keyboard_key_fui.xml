<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/auto_dimen2_0"/>
            <solid android:color="@color/color_keyboard_key_background_night_fui"/>
            <stroke
                android:width="@dimen/auto_dimen2_0_5"
                android:color="@color/color_keyboard_key_background_stroke_night_fui"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/auto_dimen2_0"/>
            <solid android:color="@color/color_keyboard_key_background_night_pressed_fui"/>
            <stroke
                android:width="@dimen/auto_dimen2_0_5"
                android:color="@color/color_keyboard_key_background_stroke_night_pressed_fui"/>
        </shape>
    </item>
</selector>
