<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/custom_theme_bg1_theme_bg1_corner_normal_day" />
            <solid android:color="#ffffffff" />
            <stroke android:width="@dimen/auto_dimen2_1" android:color="#196a8497" />
        </shape>
    </item>
    <item android:state_selected="false" android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/custom_theme_bg1_theme_bg1_corner_normal_day" />
            <solid android:color="#ffefefef" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/custom_theme_bg1_theme_bg1_corner_normal_day" />
            <solid android:color="#ffefefef" />
            <stroke android:width="@dimen/auto_dimen2_1" android:color="#ffefefef" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/custom_theme_bg1_theme_bg1_corner_normal_day" />
            <solid android:color="#ffffffff" />
            <stroke android:width="@dimen/auto_dimen2_1" android:color="#ffffffff" />
        </shape>
    </item>
</selector>
