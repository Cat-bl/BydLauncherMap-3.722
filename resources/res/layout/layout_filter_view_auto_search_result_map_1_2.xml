<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:designHeight="600"
    app:designWidth="1024">
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/rv_filter_view_first"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_12"
        android:layout_centerHorizontal="true"
        android:overScrollMode="never"
        android:layout_marginStart="@dimen/auto_dimen2_2"
        android:layout_marginEnd="@dimen/auto_dimen2_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.auto.common.view.NoScrollListView
        android:id="@+id/slv_filter_view_second"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_8"
        android:listSelector="@color/auto_ui_000000_00"
        android:divider="@null"
        android:dividerHeight="0dp"
        app:layout_constraintStart_toStartOf="@+id/rv_filter_view_first"
        app:layout_constraintTop_toBottomOf="@+id/rv_filter_view_first"
        app:maxHeight="@dimen/auto_dimen2_270"/>
    <com.autonavi.auto.common.view.NoScrollListView
        android:id="@+id/slv_filter_view_third"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_8"
        android:listSelector="@color/auto_ui_000000_00"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:layout_marginStart="@dimen/auto_dimen2_96"
        app:layout_constraintStart_toStartOf="@+id/rv_filter_view_first"
        app:layout_constraintTop_toBottomOf="@+id/rv_filter_view_first"
        app:maxHeight="@dimen/auto_dimen2_270"/>
    <com.autonavi.skin.view.SkinExpandableListView
        android:id="@+id/elv_filter_view_four"
        android:scrollbars="none"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_1"
        android:listSelector="@android:color/transparent"
        android:groupIndicator="@null"
        android:childIndicator="@null"
        android:divider="@null"
        android:layout_marginStart="@dimen/auto_dimen2_192"
        app:layout_constraintEnd_toEndOf="@+id/rv_filter_view_first"
        app:layout_constraintStart_toStartOf="@+id/rv_filter_view_first"
        app:layout_constraintTop_toBottomOf="@+id/rv_filter_view_first"
        app:maxHeight="@dimen/auto_dimen2_270"/>
    <com.autonavi.auto.common.view.NoScrollGridView
        android:id="@+id/sgv_filter_view_base"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_8"
        android:cacheColorHint="@color/auto_ui_000000_00"
        android:horizontalSpacing="@dimen/auto_dimen2_7"
        android:verticalSpacing="@dimen/auto_dimen2_8"
        android:numColumns="4"
        android:paddingStart="@dimen/auto_dimen2_18"
        app:layout_constraintEnd_toEndOf="@+id/rv_filter_view_first"
        app:layout_constraintStart_toStartOf="@+id/rv_filter_view_first"
        app:layout_constraintTop_toBottomOf="@+id/rv_filter_view_first"
        app:maxHeight="@dimen/auto_dimen2_270"/>
</com.autonavi.skin.view.SkinConstraintLayout>
