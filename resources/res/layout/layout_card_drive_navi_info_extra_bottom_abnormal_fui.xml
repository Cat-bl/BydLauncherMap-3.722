<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_tbt_bottom"
    android:layout_width="match_parent"
    android:layout_height="@dimen/auto_dimen2_58"
    app:layout_constraintTop_toBottomOf="@+id/ac_navigation_info_land">
    <com.autonavi.skin.view.SkinView
        android:id="@+id/cnvl_time"
        android:background="@color/navi_card_separator_color_day"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/auto_dimen2_0"
        android:layout_marginEnd="@dimen/auto_dimen2_0"
        app:background4Night="@color/navi_card_separator_color_night"
        app:background4Skin="@color/navi_card_separator_color_day"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_28"
        android:textColor="@color/custom_text_night_color_white_100_fui"
        android:gravity="end|center_vertical"
        android:id="@+id/stv_text_eta"
        android:layout_width="@dimen/auto_dimen2_140"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:lineSpacingExtra="@dimen/auto_dimen2_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/cnvl_time"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/custom_text_night_color_white_100_fui"
        app:textColor4Skin="@color/custom_text_night_color_white_100_fui"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="@dimen/auto_dimen2_200"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/cnvl_time"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_28"
            android:textColor="@color/custom_text_night_color_white_100_fui"
            android:gravity="end"
            android:id="@+id/stv_text_eta_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:textColor4Night="@color/custom_text_night_color_white_100_fui"
            app:textColor4Skin="@color/custom_text_night_color_white_100_fui"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_28"
            android:textColor="@color/custom_text_night_color_white_100_fui"
            android:gravity="center"
            android:id="@+id/stv_text_eta_time_arrival_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arrival_2"
            android:singleLine="true"
            android:lineSpacingExtra="@dimen/auto_dimen2_5"
            android:layout_marginStart="@dimen/auto_dimen2_2"
            app:textColor4Night="@color/custom_text_night_color_white_100_fui"
            app:textColor4Skin="@color/custom_text_night_color_white_100_fui"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_21"
            android:textColor="@color/custom_text_night_color_white_100_fui"
            android:gravity="center_vertical"
            android:layout_gravity="top"
            android:id="@+id/stv_text_eta_daytime"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_12"
            android:singleLine="true"
            android:lineSpacingExtra="@dimen/auto_dimen2_6"
            android:layout_marginStart="@dimen/auto_dimen2_2"
            app:textColor4Night="@color/custom_text_night_color_white_100_fui"
            app:textColor4Skin="@color/custom_text_night_color_white_100_fui"/>
    </LinearLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
