<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_changan_left_home_sim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_back_home"
        android:layout_width="@dimen/auto_dimen2_88"
        android:layout_height="@dimen/auto_dimen2_88"
        android:layout_marginLeft="@dimen/auto_dimen2_20"
        android:layout_marginTop="@dimen/auto_dimen2_18"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.view.custom.CustomBtnCircular1View
            android:id="@+id/cbc_back_home"
            android:layout_width="@dimen/auto_dimen2_72"
            android:layout_height="@dimen/auto_dimen2_72"
            android:layout_marginLeft="@dimen/auto_dimen2_10"
            android:layout_marginTop="@dimen/auto_dimen2_6"
            android:layout_marginRight="@dimen/auto_dimen2_6"
            android:layout_marginBottom="@dimen/auto_dimen2_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shadowColor="@color/auto_ui_000000_33"
            app:shadowColorNight="@color/auto_ui_000000_33"
            app:shadowCorner="@dimen/auto_dimen2_6"
            app:shadowCornerBottomLeft="@dimen/auto_dimen2_0"
            app:shadowCornerBottomRight="@dimen/auto_dimen2_0"
            app:shadowCornerTopLeft="@dimen/auto_dimen2_0"
            app:shadowCornerTopRight="@dimen/auto_dimen2_0"
            app:shadowDx="@dimen/auto_dimen2_0"
            app:shadowDy="@dimen/auto_dimen2_2"
            app:shadowRadius="@dimen/auto_dimen2_8"
            app:shadowShapeType="rectangle"
            app:shadowSide="all"
            app:shadowVisibility="true"/>
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/siv_back_home"
            android:background="@drawable/auto_navi_back_home_day"
            android:layout_width="@dimen/auto_dimen2_30"
            android:layout_height="@dimen/auto_dimen2_36"
            app:background4Night="@drawable/auto_navi_back_home_night"
            app:background4Skin="@drawable/auto_navi_back_home_day"
            app:layout_constraintBottom_toBottomOf="@+id/cbc_back_home"
            app:layout_constraintEnd_toEndOf="@+id/cbc_back_home"
            app:layout_constraintStart_toStartOf="@+id/cbc_back_home"
            app:layout_constraintTop_toTopOf="@+id/cbc_back_home"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
