<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/custom_front_view_parent"
    android:background="@drawable/drive_navi_cross_bg_day"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/auto_dimen2_40">
    <com.autonavi.skin.view.SkinView
        android:background="@drawable/byd_custom_bar_drive_alarm_dnp_bg_day_border"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:background4Night="@drawable/byd_custom_bar_drive_alarm_dnp_bg_night_border"
        app:background4Skin="@drawable/byd_custom_bar_drive_alarm_dnp_bg_day_border"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/custom_front_view_icon"
        android:layout_width="@dimen/auto_dimen2_36"
        android:layout_height="@dimen/auto_dimen2_36"
        android:src="@drawable/ic_icon_navigation_accident_72_red"
        android:layout_marginStart="@dimen/auto_dimen2_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:src4Night="@drawable/ic_icon_navigation_accident_72_red"
        app:src4Skin="@drawable/ic_icon_navigation_accident_72_red"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/custom_drive_front_view_exit"
        android:layout_width="@dimen/auto_dimen2_40"
        android:layout_height="@dimen/auto_dimen2_40"
        android:src="@drawable/icon_front_alarm_exit"
        android:layout_marginEnd="@dimen/auto_dimen2_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:src4Night="@drawable/icon_front_alarm_exit"
        app:src4Skin="@drawable/icon_front_alarm_exit"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_14"
        android:textColor="@color/auto_color_0F1117"
        android:id="@+id/custom_drive_front_view_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="事故-前方3km左一车道"
        android:layout_marginStart="@dimen/auto_dimen2_4"
        android:layout_marginEnd="@dimen/auto_dimen2_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/custom_drive_front_view_exit"
        app:layout_constraintStart_toEndOf="@+id/custom_front_view_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/auto_color_0F1117"
        app:textColor4Skin="@color/auto_color_0F1117"/>
</com.autonavi.skin.view.SkinConstraintLayout>
