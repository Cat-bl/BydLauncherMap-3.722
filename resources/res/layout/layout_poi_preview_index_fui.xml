<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_poi_preview"
    android:background="@drawable/home_search_bar_bg_day"
    android:paddingTop="@dimen/auto_dimen2_4"
    android:paddingBottom="@dimen/auto_dimen2_4"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/auto_dimen2_48"
    android:paddingStart="@dimen/auto_dimen2_24"
    android:paddingEnd="@dimen/auto_dimen2_8"
    app:background4Night="@drawable/home_search_bar_bg_night"
    app:background4Skin="@drawable/home_search_bar_bg_day"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/custom_text_day_color"
        android:ellipsize="end"
        android:id="@+id/stv_text_preview_title"
        android:paddingTop="@dimen/auto_dimen2_6"
        android:paddingBottom="@dimen/auto_dimen2_6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:lineSpacingExtra="@dimen/auto_dimen2_2"
        android:layout_marginEnd="@dimen/auto_dimen2_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/stv_text_preview_go"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/custom_text_night_color"
        app:textColor4Skin="@color/custom_text_day_color"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/search_text_high_light_color"
        android:id="@+id/stv_text_preview_go"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/index_text_preview_go"
        android:lineSpacingExtra="@dimen/auto_dimen2_4"
        android:layout_marginEnd="@dimen/auto_dimen2_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/siv_preview_carry_out"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/search_text_high_light_color"
        app:textColor4Skin="@color/search_text_high_light_color"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_preview_carry_out"
        android:background="@drawable/icon_light_public_dowmarrow_s"
        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_48"
        android:contentDescription="展开"
        app:background4Night="@drawable/icon_dark_public_dowmarrow_s"
        app:background4Skin="@drawable/icon_light_public_dowmarrow_s"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.autonavi.skin.view.SkinConstraintLayout>
