<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/map_no_activated_bg_day_slipt"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:background4Night="@drawable/map_no_activated_bg_night_slipt"
    app:background4Skin="@drawable/map_no_activated_bg_day_slipt"
    app:designHeight="720"
    app:designWidth="1280">
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/sl_activated_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/auto_dimen2_664"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_18"
            android:textColor="@color/auto_color_no_activated_day"
            android:id="@+id/tv_no_activated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gaode_map_no_activated"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/auto_color_no_activated_night"
            app:textColor4Skin="@color/auto_color_no_activated_day"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_14"
            android:textColor="@color/auto_color_tip_no_activated_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_2"
            android:text="@string/please_activate_using"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_no_activated"
            app:textColor4Night="@color/auto_color_tip_no_activated_night"
            app:textColor4Skin="@color/auto_color_tip_no_activated_day"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
