<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="@dimen/sys_compact_border_radius_s" />
            <size android:height="@dimen/byd_compact_pvt_progressBar_horizontal_minHT" />
            <solid android:color="?bydPvtProgressBarBgColor" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <corners android:radius="@dimen/sys_compact_border_radius_s" />
                <size android:height="@dimen/byd_compact_pvt_progressBar_horizontal_minHT" />
                <solid android:color="@android:color/transparent" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/sys_compact_border_radius_s" />
                <size android:height="@dimen/byd_compact_pvt_progressBar_horizontal_minHT" />
                <solid android:color="?bydPvtProgressBarColor" />
            </shape>
        </clip>
    </item>
</layer-list>
