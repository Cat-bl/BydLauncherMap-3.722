<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_search_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinListView
        android:scrollbarStyle="insideInset"
        android:id="@+id/slv_search_path_history"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/auto_dimen2_4"
        android:listSelector="@color/auto_ui_000000_00"
        android:cacheColorHint="@color/auto_ui_000000_00"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:fastScrollEnabled="false"
        android:headerDividersEnabled="false"
        android:footerDividersEnabled="false"
        android:contentDescription="历史记录|纵向"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinView
        android:background="@drawable/shape_listview_edge_gradient_day"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_12"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/auto_dimen2_12"
        android:layout_marginEnd="@dimen/auto_dimen2_12"
        app:background4Night="@drawable/shape_listview_edge_gradient_night"
        app:background4Skin="@drawable/shape_listview_edge_gradient_day"
        app:layout_constraintBottom_toBottomOf="@+id/slv_search_path_history"
        app:layout_constraintEnd_toEndOf="@+id/slv_search_path_history"
        app:layout_constraintStart_toStartOf="@+id/slv_search_path_history"/>
    <include
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45"
        layout="@layout/layout_no_path_history"/>
</com.autonavi.skin.view.SkinConstraintLayout>
