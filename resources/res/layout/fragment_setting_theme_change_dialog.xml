<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_center"
    android:background="@drawable/byd_custom_dialog_dialog_m_day_bg_selector"
    android:layout_width="@dimen/auto_dimen2_500"
    android:layout_height="@dimen/auto_dimen2_200"
    app:background4Night="@drawable/byd_custom_dialog_dialog_m_night_bg_selector"
    app:background4Skin="@drawable/byd_custom_dialog_dialog_m_day_bg_selector">
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/byd_text_450_5_textcolor_day_selector"
        android:gravity="center"
        android:id="@+id/file_left"
        android:background="@drawable/byd_custom_dialog_dialog_m_day_bg_left_button_selector"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/auto_dimen2_50"
        android:text="@string/dialog_left"
        app:background4Night="@drawable/byd_custom_dialog_dialog_m_night_bg_left_button_selector"
        app:background4Skin="@drawable/byd_custom_dialog_dialog_m_day_bg_left_button_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:textColor4Night="@color/byd_text_450_5_textcolor_night_selector"
        app:textColor4Skin="@color/byd_text_450_5_textcolor_day_selector"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_22"
        android:textColor="@color/byd_text_450_1_textcolor_day_selector"
        android:gravity="center"
        android:id="@+id/file_titletext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_20"
        android:text="@string/settings_map_map_day_night"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/byd_text_450_1_textcolor_night_selector"
        app:textColor4Skin="@color/byd_text_450_1_textcolor_day_selector"/>
    <com.autonavi.view.custom.CustomBtnRadio4View
        android:id="@+id/setting_map_day_night_btn"
        android:layout_width="@dimen/auto_dimen2_450"
        android:layout_height="@dimen/auto_dimen2_40"
        android:layout_marginTop="@dimen/auto_dimen2_45"
        android:paddingStart="@dimen/auto_dimen2_25"
        app:layout_constraintBottom_toTopOf="@+id/cl_buttons"
        app:layout_constraintTop_toBottomOf="@+id/file_titletext"/>
</com.autonavi.skin.view.SkinConstraintLayout>
