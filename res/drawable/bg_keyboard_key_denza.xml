<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/auto_dimen2_8" />
            <solid android:color="@color/color_keyboard_key_background_night_denza" />
            <stroke android:width="@dimen/auto_font_size_1" android:color="@color/color_keyboard_key_background_stroke_night_denza" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/auto_dimen2_8" />
            <solid android:color="@color/color_keyboard_key_background_night_denza" />
            <stroke android:width="@dimen/auto_font_size_1" android:color="@color/color_keyboard_key_background_stroke_night_denza" />
        </shape>
    </item>
</selector>
