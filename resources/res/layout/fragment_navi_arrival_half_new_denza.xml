<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_routearrival"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.autonavi.skin.view.SkinConstraintLayout
        android:background="@drawable/custom_normal_card_bg_day"
        android:layout_width="@dimen/auto_dimen2_420"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_12"
        android:layout_marginBottom="@dimen/auto_dimen2_12"
        android:maxHeight="@dimen/auto_dimen2_650"
        android:minHeight="@dimen/auto_dimen2_204"
        android:layout_marginStart="@dimen/auto_dimen2_24"
        app:background4Night="@drawable/custom_normal_card_bg_night"
        app:background4Skin="@drawable/custom_normal_card_bg_day"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_max="@dimen/auto_dimen2_650"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0">
