<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_dialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_center"
        android:background="@drawable/byd_custom_dialog_dialog_m_day_bg_selector"
        android:layout_width="@dimen/auto_dimen2_560"
        android:layout_height="@dimen/auto_dimen2_264"
        app:background4Night="@drawable/byd_custom_dialog_dialog_m_night_bg_selector"
        app:background4Skin="@drawable/byd_custom_dialog_dialog_m_day_bg_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.skin.view.SkinRelativeLayout
            android:id="@+id/cl_buttons"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auto_dimen2_104"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/byd_dialog_btn_left_text_selector_ocean"
                android:gravity="center"
                android:id="@+id/stv_left"
                android:background="@drawable/byd_custom_btn_function1_btn_function1_day_bg_selector"
                android:layout_width="@dimen/auto_dimen2_176"
                android:layout_height="@dimen/auto_dimen2_48"
                android:layout_marginLeft="@dimen/auto_dimen2_80"
                android:text="@string/dialog_left"
                android:layout_centerVertical="true"
                app:background4Night="@drawable/byd_dialog_btn_left_selector_night_ocean"
                app:background4Skin="@drawable/byd_custom_btn_function1_btn_function1_day_bg_selector"
                app:textColor4Night="@color/byd_dialog_btn_left_text_selector_ocean"
                app:textColor4Skin="@color/byd_dialog_btn_left_text_selector_ocean"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/custom_text_day_color_white"
                android:gravity="center"
                android:id="@+id/stv_middle_confirm"
                android:background="@drawable/byd_custom_btn_function1_btn_function1_day_bg_selector"
                android:layout_width="@dimen/auto_dimen2_176"
                android:layout_height="@dimen/auto_dimen2_48"
                android:text="@string/dialog_left"
                android:layout_centerInParent="true"
                app:background4Night="@drawable/byd_custom_btn_function1_btn_function1_night_bg_selector"
                app:background4Skin="@drawable/byd_custom_btn_function1_btn_function1_day_bg_selector"
                app:textColor4Night="@color/custom_text_night_color_white"
                app:textColor4Skin="@color/custom_text_day_color_white"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/byd_custom_dialog_secondary_btn_text_color_selector_day_ocean"
                android:gravity="center"
                android:id="@+id/stv_right"
                android:background="@drawable/byd_custom_dialog_secondary_btn_bg_selector_day_ocean"
                android:layout_width="@dimen/auto_dimen2_176"
                android:layout_height="@dimen/auto_dimen2_48"
                android:layout_marginRight="@dimen/auto_dimen2_80"
                android:text="@string/dialog_right"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                app:background4Night="@drawable/byd_custom_dialog_secondary_btn_bg_selector_night_ocean"
                app:background4Skin="@drawable/byd_custom_dialog_secondary_btn_bg_selector_day_ocean"
                app:textColor4Night="@color/byd_custom_dialog_secondary_btn_text_color_selector_night_ocean"
                app:textColor4Skin="@color/byd_custom_dialog_secondary_btn_text_color_selector_day_ocean"/>
        </com.autonavi.skin.view.SkinRelativeLayout>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:orientation="vertical"
            android:id="@+id/half_top_dialog"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auto_dimen2_0"
            app:layout_constraintBottom_toTopOf="@+id/cl_buttons"
            app:layout_constraintTop_toTopOf="parent">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_20"
                android:textStyle="bold"
                android:textColor="@color/custom_text_day_color_100"
                android:gravity="center"
                android:id="@+id/stv_titletext"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auto_dimen2_62"
                android:text="@string/settings_navi_traffic_mode"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:textColor4Night="@color/custom_text_night_color_100"
                app:textColor4Skin="@color/custom_text_day_color_100"/>
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/dialog_item_bottom_line"
                android:background="@color/auto_color_line_day"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auto_dimen2_1"
                app:background4Night="@color/auto_color_12FFFFFF"
                app:background4Skin="@color/auto_color_line_day"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/stv_titletext"
                app:layout_goneMarginTop="@dimen/auto_dimen2_0"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_20"
                android:textColor="@color/custom_text_day_color_100"
                android:gravity="center"
                android:id="@+id/stv_content"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auto_dimen2_0"
                android:layout_marginLeft="@dimen/auto_dimen2_48"
                android:layout_marginRight="@dimen/auto_dimen2_48"
                android:text="@string/settings_navi_traffic_mode"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/stv_titletext"
                app:textColor4Night="@color/custom_text_night_color_100"
                app:textColor4Skin="@color/custom_text_day_color_100"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
