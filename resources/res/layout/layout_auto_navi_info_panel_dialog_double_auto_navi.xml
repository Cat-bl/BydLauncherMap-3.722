            android:textSize="@dimen/auto_font_size_28"
            android:textColor="@color/text_450_4_textcolor_day_selector"
            android:ellipsize="end"
            android:gravity="left"
            android:id="@+id/stv_traffic_heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_3"
            android:layout_marginRight="@dimen/auto_dimen2_1"
            android:text="@string/auto_navi_avoid_jam_title"
            android:singleLine="true"
            android:lineSpacingExtra="@dimen/auto_dimen2_4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/text_450_4_textcolor_night_selector"
            app:textColor4Skin="@color/text_450_4_textcolor_day_selector"/>
