
{
  "farFilter":{
    "lod1(": 0.3,
    "lod2": 0.15,
    "minlevel": 17,
    "maxlevel": 19.6,
    "filterRenderTypelod1": "5,7,13,24,26,44",
    "filterRenderTypelod2": "3,5,7,8,12,13,14,18,21,24,26,27,28,29,31,43,44",
    "minpitch": 63,
    "enable": false
  }
}


/* 注释
{
  "lod1(lod1)": 0.3,  //过滤第一级别(从天空往下的比例)
  "lod2(lod2)": 0.15, //过滤第二级别(从天空往下的比例)
  "minlevel(最小比例尺)": 17,  //功能开启的最小比例
  "maxlevel(最大比例尺)": 19.6,//功能开启的最大比例
  "filterRenderTypelod1(不渲染元素lod1)": "5,7,13,24,26,44",//第一级别过滤的类型
  "filterRenderTypelod2(不渲染元素lod2)": "3,5,7,8,12,13,14,18,21,24,26,27,28,29,31,43,44",//第二级别过滤的类型
  "minpitch(俯仰角)": 63,//功能开启的最小比例
  "enable(功能开关)": true  //功能开关
*/