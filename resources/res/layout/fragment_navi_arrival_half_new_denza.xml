            android:layout_marginEnd="@dimen/auto_dimen2_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/dest_info_icon"
                android:background="@drawable/icon_close_arrival_day"
                android:layout_width="@dimen/auto_dimen2_48"
                android:layout_height="@dimen/auto_dimen2_48"
                android:layout_marginTop="@dimen/auto_dimen2_8"
                android:layout_marginStart="@dimen/auto_dimen2_8"
                app:background4Night="@drawable/icon_close_arrival_night"
                app:background4Skin="@drawable/icon_close_arrival_day"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.autonavi.skin.view.SkinTextView
                android:id="@+id/dest_floor_no"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                app:layout_constraintBottom_toBottomOf="@+id/dest_info_icon"
                app:layout_constraintEnd_toEndOf="@+id/dest_info_icon"
                app:layout_constraintTop_toTopOf="@+id/dest_info_icon"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_24"
                android:textColor="@color/dest_arrival_text_day"
                android:gravity="center"
                android:id="@+id/navi_info_dest_arrival"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/driving_performance"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:textColor4Night="@color/dest_arrival_text_night"
                app:textColor4Skin="@color/dest_arrival_text_day"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_20"
                android:textColor="@color/dest_arrival_text_day"
                android:ellipsize="end"
                android:id="@+id/navi_info_dest_name"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:layout_marginStart="@dimen/auto_dimen2_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/dest_info_icon"
                app:layout_constraintTop_toBottomOf="@+id/navi_info_dest_arrival"
                app:textColor4Night="@color/dest_arrival_text_night"
                app:textColor4Skin="@color/dest_arrival_text_day"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinScrollView
            android:scrollbarThumbVertical="@drawable/byd_custom_scrollbar_thumb_day_denza"
            android:id="@+id/sv_arrival_card"
            android:paddingBottom="@dimen/auto_dimen2_10"
            android:scrollbars="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_max="@dimen/auto_dimen2_584"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dest_info_view"
            app:layout_constraintVertical_bias="0"
            app:scrollbarThumbVertical4Night="@drawable/byd_custom_scrollbar_thumb_night_denza"
            app:scrollbarThumbVertical4Skin="@drawable/byd_custom_scrollbar_thumb_day_denza">
