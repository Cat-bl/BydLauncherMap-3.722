<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_tbt_bottom"
    android:layout_width="match_parent"
    android:layout_height="@dimen/auto_dimen2_80">
    <com.autonavi.skin.view.SkinView
        android:id="@+id/cnvl_time"
        android:background="@drawable/meter_navi_inner_tbt_line_color_day"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/auto_dimen2_32"
        android:layout_marginEnd="@dimen/auto_dimen2_32"
        app:background4Night="@drawable/meter_navi_inner_tbt_line_color_night"
        app:background4Skin="@drawable/meter_navi_inner_tbt_line_color_day"
        app:layout_constraintTop_toBottomOf="@+id/ac_navigation_info_land"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_dimen2_28"
        android:textColor="@color/meter_navi_remain_time_pui_text_day_color"
        android:gravity="center"
        android:id="@+id/stv_text_eta"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/auto_dimen2_30"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toStartOf="@+id/stv_text_eta_needtime"
        app:textColor4Night="@color/meter_navi_remain_time_pui_text_night_color"
        app:textColor4Skin="@color/meter_navi_remain_time_pui_text_day_color"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_dimen2_28"
        android:textColor="@color/meter_navi_remain_time_pui_text_day_color"
        android:gravity="center"
        android:id="@+id/stv_text_eta_needtime"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:lineSpacingExtra="@dimen/auto_dimen2_4"
        android:layout_marginEnd="@dimen/auto_dimen2_30"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toStartOf="@+id/cnvl_line"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/meter_navi_remain_time_pui_text_night_color"
        app:textColor4Skin="@color/meter_navi_remain_time_pui_text_day_color"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="right"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/auto_dimen2_30"
        app:layout_constraintStart_toEndOf="@+id/cnvl_line">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_dimen2_28"
            android:textColor="@color/meter_navi_remain_time_pui_text_day_color"
            android:gravity="end"
            android:id="@+id/stv_text_eta_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:textColor4Night="@color/meter_navi_remain_time_pui_text_night_color"
            app:textColor4Skin="@color/meter_navi_remain_time_pui_text_day_color"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_dimen2_28"
            android:textColor="@color/meter_navi_remain_time_pui_text_day_color"
            android:gravity="center"
            android:id="@+id/stv_text_eta_time_arrival_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arrival_2"
            android:singleLine="true"
            android:lineSpacingExtra="@dimen/auto_dimen2_2"
            android:layout_marginStart="@dimen/auto_dimen2_12"
            app:textColor4Night="@color/meter_navi_remain_time_pui_text_night_color"
            app:textColor4Skin="@color/meter_navi_remain_time_pui_text_day_color"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_dimen2_18"
            android:textColor="@color/meter_navi_remain_time_pui_text_day_color"
            android:gravity="center_vertical"
            android:layout_gravity="top"
            android:id="@+id/stv_text_eta_daytime"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_22"
            android:singleLine="true"
            android:lineSpacingExtra="@dimen/auto_dimen2_3"
            android:layout_marginStart="@dimen/auto_dimen2_1"
            app:textColor4Night="@color/meter_navi_remain_time_pui_text_night_color"
            app:textColor4Skin="@color/meter_navi_remain_time_pui_text_day_color"/>
    </LinearLayout>
    <com.autonavi.skin.view.SkinView
        android:id="@+id/cnvl_line"
        android:background="@color/transparent_color"
        android:layout_width="@dimen/auto_dimen2_2"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</com.autonavi.skin.view.SkinConstraintLayout>
