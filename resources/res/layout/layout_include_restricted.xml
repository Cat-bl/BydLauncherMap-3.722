<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_route_browser_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.view.custom.CustomCardView
        android:id="@+id/cc_bg"
        android:background="@drawable/custom_card_view_bg_day"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:bg_day="@drawable/custom_card_view_bg_day"
        app:bg_night="@drawable/custom_card_view_bg_night"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/restricted_title"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_40"
        android:layout_marginTop="@dimen/auto_dimen2_13"
        app:layout_constraintEnd_toEndOf="@+id/cc_bg"
        app:layout_constraintStart_toStartOf="@+id/cc_bg"
        app:layout_constraintTop_toTopOf="@+id/cc_bg">
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/widget_set_title_back"
            android:background="@drawable/custom_close_btn_selector_day"
            android:layout_width="@dimen/auto_dimen2_48"
            android:layout_height="@dimen/auto_dimen2_48"
            android:layout_marginEnd="@dimen/auto_dimen2_24"
            app:background4Night="@drawable/icon_common_close_night"
            app:background4Skin="@drawable/custom_close_btn_selector_day"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_17"
            android:textColor="@color/custom_route_textcolor_day_normal"
            android:id="@+id/widget_set_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/routecarresult_restriction_policy"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/custom_route_textcolor_night_normal"
            app:textColor4Skin="@color/custom_route_textcolor_day_normal"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
    <com.autonavi.skin.view.SkinListView
        android:scrollbarThumbVertical="@drawable/byd_custom_scrollbar_thumb_day"
        android:id="@+id/restricted_detail_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/auto_dimen2_31"
        android:listSelector="@color/auto_ui_000000_00"
        android:cacheColorHint="@color/auto_ui_000000_00"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:fastScrollEnabled="false"
        android:headerDividersEnabled="false"
        android:footerDividersEnabled="false"
        android:layout_marginEnd="@dimen/auto_dimen2_18"
        app:layout_constraintBottom_toBottomOf="@+id/cc_bg"
        app:layout_constraintEnd_toEndOf="@+id/cc_bg"
        app:layout_constraintStart_toStartOf="@+id/cc_bg"
        app:layout_constraintTop_toBottomOf="@+id/restricted_title"
        app:scrollbarThumbVertical4Night="@drawable/byd_custom_scrollbar_thumb_night"
        app:scrollbarThumbVertical4Skin="@drawable/byd_custom_scrollbar_thumb_day"/>
</com.autonavi.skin.view.SkinConstraintLayout>
