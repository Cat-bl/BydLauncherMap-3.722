<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/phone_connect_car_help2_img"
        android:background="@drawable/user_car_phone_help1_port_day"
        android:layout_width="@dimen/auto_dimen2_360"
        android:layout_height="@dimen/auto_dimen2_320"
        app:background4Night="@drawable/user_car_phone_help1_port_night"
        app:background4Skin="@drawable/user_car_phone_help1_port_day"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_20"
        android:textColor="@color/custom_text_day_color_100"
        android:id="@+id/phone_connect_car_help2_tip1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_4"
        android:text="@string/user_txt_phone_connected_help2_tip1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/phone_connect_car_help2_img"
        app:textColor4Night="@color/custom_text_night_color_100"
        app:textColor4Skin="@color/custom_text_day_color_100"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/custom_text_day_color_55"
        android:gravity="start|center_vertical"
        android:id="@+id/phone_connect_car_help2_tip2_1"
        android:paddingTop="@dimen/auto_dimen2_5"
        android:paddingBottom="@dimen/auto_dimen2_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_16"
        android:text="@string/user_txt_phone_connected_help2_tip2_1"
        android:lineSpacingExtra="@dimen/auto_dimen2_5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/phone_connect_car_help2_tip1"
        app:textColor4Night="@color/custom_text_night_color_55"
        app:textColor4Skin="@color/custom_text_day_color_55"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/custom_text_day_color_55"
        android:gravity="start|center_vertical"
        android:id="@+id/phone_connect_car_help2_tip3"
        android:paddingTop="@dimen/auto_dimen2_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_8"
        android:text="@string/user_txt_phone_connected_help2_tip3"
        android:lineSpacingExtra="@dimen/auto_dimen2_5"
        app:layout_constraintStart_toStartOf="@+id/phone_connect_car_help2_tip2_1"
        app:layout_constraintTop_toBottomOf="@+id/phone_connect_car_help2_tip2_1"
        app:textColor4Night="@color/custom_text_night_color_55"
        app:textColor4Skin="@color/custom_text_day_color_55"/>
</com.autonavi.skin.view.SkinConstraintLayout>
