<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/scl_placement"
        android:background="@drawable/track_placemark_point_bg_day"
        android:layout_width="@dimen/auto_dimen2_63"
        android:layout_height="@dimen/auto_dimen2_49"
        app:background4Night="@drawable/track_placemark_point_bg_night"
        app:background4Skin="@drawable/track_placemark_point_bg_day"
        app:layout_constraintBottom_toTopOf="@+id/siv_button"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.view.custom.CustomRoundImageView
        android:id="@+id/siv_placement"
        android:layout_width="@dimen/auto_dimen2_0"
        android:layout_height="@dimen/auto_dimen2_30"
        android:layout_marginLeft="@dimen/auto_dimen2_6"
        android:layout_marginTop="@dimen/auto_dimen2_3"
        android:scaleType="centerCrop"
        android:layout_marginEnd="@dimen/auto_dimen2_6"
        app:allRadius="@dimen/auto_dimen2_4"
        app:layout_constraintLeft_toLeftOf="@+id/scl_placement"
        app:layout_constraintRight_toRightOf="@+id/scl_placement"
        app:layout_constraintTop_toTopOf="@+id/scl_placement"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_button"
        android:background="@drawable/global_custom_image_bubble_child_day_bg"
        android:layout_width="@dimen/auto_dimen2_32"
        android:layout_height="@dimen/auto_dimen2_32"
        app:background4Night="@drawable/global_custom_image_bubble_child_night_bg"
        app:background4Skin="@drawable/global_custom_image_bubble_child_day_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scl_placement"/>
</com.autonavi.skin.view.SkinConstraintLayout>
