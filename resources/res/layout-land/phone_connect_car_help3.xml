<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.autonavi.skin.view.SkinRelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/phone_connect_car_help2_img"
            android:background="@drawable/user_car_phone_help2_day"
            android:layout_width="@dimen/auto_dimen2_460"
            android:layout_height="@dimen/auto_dimen2_320"
            android:layout_centerHorizontal="true"
            app:background4Night="@drawable/user_car_phone_help2_night"
            app:background4Skin="@drawable/user_car_phone_help2_day"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_20"
            android:textColor="@color/custom_text_day_color_100"
            android:gravity="center_vertical"
            android:id="@+id/phone_connect_car_help2_tip1"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/auto_font_size_32"
            android:layout_marginTop="@dimen/auto_dimen2_8"
            android:text="@string/user_txt_phone_connected_help3_tip1"
            android:layout_below="@+id/phone_connect_car_help2_img"
            android:layout_centerHorizontal="true"
            app:textColor4Night="@color/custom_text_night_color_100"
            app:textColor4Skin="@color/custom_text_day_color_100"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_16"
            android:textColor="@color/custom_text_day_color_55"
            android:gravity="center_vertical"
            android:id="@+id/phone_connect_car_help1_tip2"
            android:paddingTop="@dimen/auto_dimen2_5"
            android:paddingBottom="@dimen/auto_dimen2_5"
            android:layout_width="@dimen/auto_dimen2_508"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_16"
            android:text="@string/user_txt_phone_connected_help3_tip2"
            android:layout_below="@+id/phone_connect_car_help2_tip1"
            android:layout_centerHorizontal="true"
            android:lineSpacingExtra="@dimen/auto_dimen2_5"
            app:textColor4Night="@color/custom_text_night_color_55"
            app:textColor4Skin="@color/custom_text_day_color_55"/>
    </com.autonavi.skin.view.SkinRelativeLayout>
</com.autonavi.skin.view.SkinRelativeLayout>
