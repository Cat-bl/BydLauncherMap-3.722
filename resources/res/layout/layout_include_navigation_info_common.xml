<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_navigation_info_landscape_changanmca"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/auto_dimen2_126"
    app:designHeight="600"
    app:designWidth="1024">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_exit_views"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="stv_exit,stv_text_exit_location"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_turn_by_turn_arrow"
        android:layout_width="@dimen/auto_dimen2_80"
        android:layout_height="@dimen/auto_dimen2_80"
        android:layout_marginTop="@dimen/auto_dimen2_20"
        android:layout_marginStart="@dimen/auto_dimen2_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="@dimen/auto_dimen2_24"
        app:layout_goneMarginTop="@dimen/auto_dimen2_20"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_exit_toll_gate"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/auto_navi_drive_toll_gate"
        app:layout_constraintBottom_toBottomOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintEnd_toEndOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintStart_toStartOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintTop_toTopOf="@+id/siv_turn_by_turn_arrow"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_12"
        android:textColor="@color/custom_text_night_color"
        android:gravity="center"
        android:id="@+id/stv_exit"
        android:background="@drawable/navi_exit_bg_new"
        android:paddingLeft="@dimen/auto_dimen2_4"
        android:paddingRight="@dimen/auto_dimen2_4"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/auto_dimen2_18"
        android:maxHeight="@dimen/auto_dimen2_22"
        android:text=""
        android:singleLine="true"
        app:background4Night="@drawable/navi_exit_bg_new_night"
        app:background4Skin="@drawable/navi_exit_bg_new"
        app:layout_constraintBottom_toBottomOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintStart_toStartOf="@+id/stv_text_distance"
        app:textColor4Night="@color/custom_text_night_color"
        app:textColor4Skin="@color/custom_text_night_color"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/custom_text_day_color"
        android:ellipsize="end"
        android:id="@+id/stv_text_exit_location"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/auto_dimen2_8"
        android:layout_marginEnd="@dimen/auto_dimen2_24"
        app:layout_constraintBottom_toBottomOf="@+id/stv_exit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/stv_exit"
        app:layout_constraintTop_toTopOf="@+id/stv_exit"
        app:textColor4Night="@color/custom_text_night_color"
        app:textColor4Skin="@color/custom_text_day_color"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_48"
        android:textStyle="bold"
        android:textColor="@color/custom_text_day_color"
        android:id="@+id/stv_text_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_18"
        android:layout_marginStart="@dimen/auto_dimen2_8"
        app:layout_constraintStart_toEndOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/custom_text_night_color"
        app:textColor4Skin="@color/custom_text_day_color"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_48"
        android:textStyle="bold"
        android:textColor="@color/custom_text_day_color"
        android:id="@+id/stv_text_distance_cn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/stv_text_distance"
        app:layout_constraintTop_toTopOf="@+id/stv_text_distance"
        app:textColor4Night="@color/custom_text_night_color"
        app:textColor4Skin="@color/custom_text_day_color"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/custom_text_day_color"
        android:id="@+id/stv_text_meter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/auto_dimen2_15"
        app:layout_constraintBaseline_toBaselineOf="@+id/stv_text_distance"
        app:layout_constraintStart_toEndOf="@+id/stv_text_distance"
        app:textColor4Night="@color/custom_text_night_color"
        app:textColor4Skin="@color/custom_text_day_color"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/custom_text_day_color"
        android:id="@+id/stv_text_enter_into"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/auto_dimen2_4"
        app:layout_constraintBottom_toBottomOf="@+id/stv_text_meter"
        app:layout_constraintStart_toEndOf="@+id/stv_text_meter"
        app:layout_constraintTop_toTopOf="@+id/stv_text_meter"
        app:textColor4Night="@color/custom_text_night_color"
        app:textColor4Skin="@color/custom_text_day_color"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/custom_text_day_color"
        android:ellipsize="end"
        android:id="@+id/stv_text_next_location"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_8"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/stv_text_distance"
        app:textColor4Night="@color/custom_text_night_color"
        app:textColor4Skin="@color/custom_text_day_color"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/srl_tbt"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_46"
        android:layout_marginTop="@dimen/auto_dimen2_12"
        android:layout_marginStart="@dimen/sys_padding_xxl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siv_turn_by_turn_arrow">
        <com.autonavi.skin.view.SkinView
            android:id="@+id/cll_diving_line_tbt"
            android:background="@color/color_tab_line_day"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="@dimen/auto_dimen2_1"
            android:layout_marginStart="@dimen/auto_dimen2_56"
            android:layout_marginEnd="@dimen/auto_dimen2_24"
            app:background4Night="@color/color_tab_line_night"
            app:background4Skin="@color/color_tab_line_day"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/srl_tbt"/>
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/siv_turn_icon"
            android:layout_width="@dimen/auto_dimen2_32"
            android:layout_height="@dimen/auto_dimen2_32"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.autonavi.skin.view.SkinLinearLayout
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auto_dimen2_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/siv_turn_icon"
            app:layout_constraintTop_toTopOf="parent">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/navi_card_subsequently_text_color_day"
                android:id="@+id/stv_text_next_tbt_then"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drive_cross_nav_normal_tip_then"
                android:layout_marginEnd="@dimen/auto_dimen2_6"
                app:textColor4Night="@color/navi_card_subsequently_text_color_night"
                app:textColor4Skin="@color/navi_card_subsequently_text_color_day"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/navi_card_title_color_day2"
                android:id="@+id/stv_text_next_tbt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/auto_dimen2_6"
                app:textColor4Night="@color/navi_card_title_color_night2"
                app:textColor4Skin="@color/navi_card_title_color_day2"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/navi_card_title_color_day2"
                android:ellipsize="end"
                android:id="@+id/stv_text_next_tbt_distance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginEnd="@dimen/sys_padding_l"
                app:textColor4Night="@color/navi_card_title_color_night2"
                app:textColor4Skin="@color/navi_card_title_color_day2"/>
        </com.autonavi.skin.view.SkinLinearLayout>
    </com.autonavi.skin.view.SkinConstraintLayout>
    <com.autonavi.view.custom.CustomCruiseTrafficLaneView
        android:id="@+id/cctl_traffic_lane"
        android:visibility="gone"
        android:layout_width="@dimen/auto_dimen2_352"
        android:layout_height="@dimen/auto_dimen2_48"
        android:layout_marginTop="@dimen/auto_dimen2_15"
        android:layout_marginBottom="@dimen/auto_dimen2_15"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/srl_tbt"
        app:layout_goneMarginTop="@dimen/auto_dimen2_15"/>
</com.autonavi.skin.view.SkinConstraintLayout>
