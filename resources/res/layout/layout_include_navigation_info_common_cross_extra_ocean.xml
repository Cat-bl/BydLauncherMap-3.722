<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_navigation_info_landscape_changanmca"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/auto_dimen2_80"
    app:designHeight="600"
    app:designWidth="1024">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_exit_views"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="stv_exit,stv_text_exit_location"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_turn_by_turn_arrow"
        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_48"
        android:layout_marginStart="@dimen/auto_dimen2_28"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="@dimen/auto_dimen2_8"
        app:layout_goneMarginTop="@dimen/auto_dimen2_8"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_exit_toll_gate"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/auto_navi_drive_toll_gate"
        app:layout_constraintBottom_toBottomOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintEnd_toEndOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintStart_toStartOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintTop_toTopOf="@+id/siv_turn_by_turn_arrow"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_48"
        android:textColor="@color/custom_text_day_color_100"
        android:id="@+id/stv_text_distance_cn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_6"
        android:layout_marginStart="@dimen/auto_dimen2_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/custom_text_night_color_100"
        app:textColor4Skin="@color/custom_text_day_color_100"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_32"
        android:textColor="@color/custom_text_day_color_85"
        android:id="@+id/stv_text_meter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_22"
        android:layout_marginStart="@dimen/auto_dimen2_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/stv_text_distance"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/color_offdata_background_day3"
        app:textColor4Skin="@color/custom_text_day_color_85"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_32"
        android:textColor="@color/custom_text_day_color_85"
        android:id="@+id/stv_text_enter_into"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/auto_dimen2_8"
        app:layout_constraintStart_toEndOf="@+id/stv_text_meter"
        app:layout_constraintTop_toTopOf="@+id/stv_text_meter"
        app:textColor4Night="@color/color_offdata_background_day3"
        app:textColor4Skin="@color/custom_text_day_color_85"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_24"
        android:textColor="@color/color_offdata_background_day3"
        android:gravity="center"
        android:id="@+id/stv_exit"
        android:background="@drawable/ic_exit_bg"
        android:paddingLeft="@dimen/auto_dimen2_4"
        android:paddingTop="@dimen/auto_dimen2_4"
        android:paddingRight="@dimen/auto_dimen2_4"
        android:paddingBottom="@dimen/auto_dimen2_4"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/auto_dimen2_32"
        android:layout_marginTop="@dimen/auto_dimen2_24"
        android:maxHeight="@dimen/auto_dimen2_24"
        android:singleLine="true"
        android:layout_marginStart="@dimen/auto_dimen2_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/stv_text_meter"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/color_offdata_background_day3"
        app:textColor4Skin="@color/color_offdata_background_day3"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_32"
        android:textColor="@color/custom_text_day_color_85"
        android:ellipsize="end"
        android:id="@+id/stv_text_exit_location"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/auto_dimen2_16"
        android:layout_marginEnd="@dimen/auto_dimen2_6"
        app:layout_constraintBottom_toBottomOf="@+id/stv_exit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/stv_exit"
        app:layout_constraintTop_toTopOf="@+id/stv_exit"
        app:textColor4Night="@color/color_offdata_background_day3"
        app:textColor4Skin="@color/custom_text_day_color_85"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_48"
        android:textColor="@color/custom_text_day_color_85"
        android:id="@+id/stv_text_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_6"
        android:layout_marginStart="@dimen/auto_dimen2_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/color_offdata_background_day3"
        app:textColor4Skin="@color/custom_text_day_color_85"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_32"
        android:textColor="@color/custom_text_day_color_85"
        android:ellipsize="end"
        android:id="@+id/stv_text_next_location"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_22"
        android:maxLines="1"
        android:layout_marginStart="@dimen/auto_dimen2_16"
        android:layout_marginEnd="@dimen/auto_dimen2_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/stv_text_meter"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/color_offdata_background_day3"
        app:textColor4Skin="@color/custom_text_day_color_85"/>
</com.autonavi.skin.view.SkinConstraintLayout>
