<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_navi_charging_info_volvo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_charging_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/cl_charging_num_first_right"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/auto_dimen2_40"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/siv_charging_fast_right_bg"
                android:background="@drawable/auto_navi_charging_fast_right_bg"
                android:layout_width="0dp"
                android:layout_height="@dimen/auto_dimen2_40"
                app:background4Skin="@drawable/auto_navi_charging_fast_right_bg"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.autonavi.skin.view.SkinConstraintLayout
                android:id="@+id/cl_charging_num_container_first"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/auto_dimen2_64"
                android:layout_marginTop="@dimen/auto_dimen2_8"
                android:layout_marginRight="@dimen/auto_dimen2_18"
                android:layout_marginBottom="@dimen/auto_dimen2_5"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_24"
                    android:textColor="@color/text_450_2_textcolor_day_selector"
                    android:gravity="left"
                    android:id="@+id/stv_charging_num_container_first_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_navi_charging_num_container_first_total"
                    app:layout_constraintStart_toEndOf="@+id/stv_charging_num_container_first_available"
                    app:layout_constraintTop_toTopOf="parent"
                    app:textColor4Night="@color/text_450_2_textcolor_night_selector"
                    app:textColor4Skin="@color/text_450_2_textcolor_day_selector"/>
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_24"
                    android:textColor="@color/text_450_1_textcolor_day_selector"
                    android:gravity="left"
                    android:id="@+id/stv_charging_num_container_first_available"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_navi_charging_num_container_first_available"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:textColor4Night="@color/text_450_1_textcolor_night_selector"
                    app:textColor4Skin="@color/text_450_1_textcolor_day_selector"/>
            </com.autonavi.skin.view.SkinConstraintLayout>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_24"
            android:textColor="@color/text_450_1_textcolor_day_selector"
            android:gravity="center"
            android:id="@+id/stv_charging_num_container_first_icon"
            android:background="@drawable/auto_navi_charging_num_container_first_icon"
            android:layout_width="@dimen/auto_dimen2_63"
            android:layout_height="@dimen/auto_dimen2_40"
            android:text="@string/auto_navi_charging_num_container_first_icon"
            android:lineSpacingExtra="@dimen/auto_dimen2_1"
            app:background4Skin="@drawable/auto_navi_charging_num_container_first_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/text_450_1_textcolor_night_selector"
            app:textColor4Skin="@color/text_450_1_textcolor_day_selector"/>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/cl_charging_num_second_right"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/auto_dimen2_40"
            android:layout_marginLeft="@dimen/auto_dimen2_1"
            app:layout_constraintStart_toEndOf="@+id/cl_charging_num_first_right"
            app:layout_constraintTop_toTopOf="parent">
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/siv_charging_slow_right_bg"
                android:background="@drawable/auto_navi_charging_slow_right_bg"
                android:layout_width="0dp"
                android:layout_height="@dimen/auto_dimen2_40"
                app:background4Skin="@drawable/auto_navi_charging_slow_right_bg"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.autonavi.skin.view.SkinConstraintLayout
                android:id="@+id/cl_charging_num_container_second"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/auto_dimen2_63"
                android:layout_marginTop="@dimen/auto_dimen2_8"
                android:layout_marginRight="@dimen/auto_dimen2_19"
                android:layout_marginBottom="@dimen/auto_dimen2_5"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_24"
                    android:textColor="@color/text_450_2_textcolor_day_selector"
                    android:gravity="left"
                    android:id="@+id/stv_charging_num_container_second_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_navi_charging_num_container_second_total"
                    app:layout_constraintStart_toEndOf="@+id/stv_charging_num_container_second_available"
                    app:layout_constraintTop_toTopOf="parent"
                    app:textColor4Night="@color/text_450_2_textcolor_night_selector"
                    app:textColor4Skin="@color/text_450_2_textcolor_day_selector"/>
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_24"
                    android:textColor="@color/text_450_1_textcolor_day_selector"
                    android:gravity="left"
                    android:id="@+id/stv_charging_num_container_second_available"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_navi_charging_num_container_second_available"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:textColor4Night="@color/text_450_1_textcolor_night_selector"
                    app:textColor4Skin="@color/text_450_1_textcolor_day_selector"/>
            </com.autonavi.skin.view.SkinConstraintLayout>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_24"
            android:textColor="@color/text_450_1_textcolor_day_selector"
            android:gravity="center"
            android:id="@+id/stv_charging_num_second_icon"
            android:background="@drawable/auto_navi_charging_num_second_icon"
            android:layout_width="@dimen/auto_dimen2_63"
            android:layout_height="@dimen/auto_dimen2_40"
            android:text="@string/auto_navi_charging_num_second_icon"
            android:lineSpacingExtra="@dimen/auto_dimen2_1"
            app:background4Skin="@drawable/auto_navi_charging_num_second_icon"
            app:layout_constraintStart_toEndOf="@+id/cl_charging_num_first_right"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/text_450_1_textcolor_night_selector"
            app:textColor4Skin="@color/text_450_1_textcolor_day_selector"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
