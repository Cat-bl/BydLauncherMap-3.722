<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_auto_navi_drive_item_arrow"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/siv_drive_way_arrow_anim"
        android:visibility="gone"
        android:layout_width="@dimen/auto_dimen2_36"
        android:layout_height="@dimen/auto_navi_drive_lane_bg_height"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_loop="true"
        app:lottie_rawRes="@null"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_bg"
        android:paddingBottom="@dimen/auto_dimen2_6"
        android:layout_width="@dimen/auto_dimen2_34"
        android:layout_height="@dimen/auto_navi_drive_lane_bg_height"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_right_extend_divider"
        android:paddingBottom="@dimen/auto_dimen2_6"
        android:layout_width="@dimen/auto_dimen2_8"
        android:layout_height="@dimen/auto_navi_drive_lane_bg_height"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_left_extend_divider"
        android:paddingBottom="@dimen/auto_dimen2_6"
        android:layout_width="@dimen/auto_dimen2_8"
        android:layout_height="@dimen/auto_navi_drive_lane_bg_height"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_drive_way_arrow"
        android:layout_width="@dimen/auto_dimen2_36"
        android:layout_height="@dimen/auto_navi_drive_lane_bg_height"
        android:layout_marginLeft="@dimen/auto_dimen2_2"
        android:layout_marginRight="@dimen/auto_dimen2_2"
        android:scaleType="fitCenter"
        android:layout_marginHorizontal="@dimen/auto_dimen2_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_arrow_extend"
        android:paddingBottom="@dimen/auto_dimen2_6"
        android:layout_width="@dimen/auto_dimen2_34"
        android:layout_height="@dimen/auto_navi_drive_lane_bg_height"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/highlight"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/siv_drive_way_arrow"
        app:layout_constraintEnd_toEndOf="@+id/siv_drive_way_arrow"
        app:layout_constraintStart_toStartOf="@+id/siv_drive_way_arrow"
        app:layout_constraintTop_toTopOf="@+id/siv_drive_way_arrow">
        <com.autonavi.view.custom.animation.HighlightAnimationOverlay
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.autonavi.view.custom.animation.HighlightCoverOverlay
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:alpha="0.7"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
