    "rule": [
      {
        "type": "data_quadrant_if",
        "brief": "样式飘向规则",
        "value": {
          "case": {
            "true": {
              "switch": {
                "case": {
                  "2": "512|1024",
                  "3": "512|1024",
                  "default": []
                },
                "condition": "$biz_data.straightLightInfo.showType"
              }
            },
            "false": "512|1024"
          },
          "biz_data": "##CustomRule_float_rule",
          "condition": {
            "fact": "$biz_data.lightCount",
            "value": 1,
            "operator": "le"
          }
        }
      },
      {
        "type": "data_duplicate",
        "brief": "数据去重",
        "value": [
          "$item_data.position.lon",
          "$item_data.position.lat"
        ]
      }
    ],
    "type": "adaptor_point",
    "value": []
  },
  "style": {
