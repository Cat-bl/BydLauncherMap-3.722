            "case": {
              "true": {
                "switch": {
                  "condition": "$item_data.quadrantType",
                  "case": {
                    "1": "point_recommend_charge_station_simple_left",
                    "10": "point_recommend_charge_station_mini_point",
                    "default": "point_recommend_charge_station_simple_right"
