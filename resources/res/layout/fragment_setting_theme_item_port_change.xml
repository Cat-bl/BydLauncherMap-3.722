<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_search_home"
    android:background="@drawable/byd_setting_bg_view_day"
    android:paddingTop="@dimen/auto_dimen2_16"
    android:paddingBottom="@dimen/auto_dimen2_16"
    android:layout_width="match_parent"
    android:layout_height="@dimen/auto_dimen2_164"
    android:layout_marginBottom="@dimen/auto_dimen2_10"
    app:background4Night="@drawable/byd_setting_bg_view_night"
    app:background4Skin="@drawable/byd_setting_bg_view_day"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/setting_item_map_theme_img"
        android:layout_width="@dimen/auto_dimen2_220"
        android:layout_height="@dimen/auto_dimen2_132"
        android:src="@drawable/global_image_map_theme_dark"
        android:scaleType="fitXY"
        android:layout_marginStart="@dimen/auto_dimen2_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinTextView
        android:id="@+id/setting_item_map_theme_img_bg"
        android:background="@drawable/byd_setting_theme_item_bg_day_selector"
        android:layout_width="@dimen/auto_dimen2_0"
        android:layout_height="@dimen/auto_dimen2_0"
        app:background4Night="@drawable/byd_setting_theme_item_bg_night_selector"
        app:background4Skin="@drawable/byd_setting_theme_item_bg_day_selector"
        app:layout_constraintBottom_toBottomOf="@+id/setting_item_map_theme_img"
        app:layout_constraintEnd_toEndOf="@+id/setting_item_map_theme_img"
        app:layout_constraintStart_toStartOf="@+id/setting_item_map_theme_img"
        app:layout_constraintTop_toTopOf="@+id/setting_item_map_theme_img"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_28"
        android:textColor="@color/byd_text_450_1_textcolor_day_selector"
        android:gravity="center_vertical"
        android:id="@+id/setting_item_map_theme_tv"
        android:layout_width="@dimen/auto_dimen2_0"
        android:layout_height="@dimen/auto_dimen2_34"
        android:text="经典主题"
        android:layout_marginStart="@dimen/auto_dimen2_16"
        app:layout_constraintStart_toEndOf="@+id/setting_item_map_theme_img"
        app:layout_constraintTop_toTopOf="@+id/setting_item_map_theme_img"
        app:textColor4Night="@color/byd_text_450_1_textcolor_night_selector"
        app:textColor4Skin="@color/byd_text_450_1_textcolor_day_selector"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_22"
        android:textColor="@color/text_450_2_textcolor_day_selector"
        android:gravity="center_vertical"
        android:id="@+id/setting_item_map_theme_tv_2"
        android:layout_width="@dimen/auto_dimen2_0"
        android:layout_height="@dimen/auto_dimen2_28"
        android:layout_marginTop="@dimen/auto_dimen2_6"
        android:text="5.5MB"
        app:layout_constraintStart_toStartOf="@+id/setting_item_map_theme_tv"
        app:layout_constraintTop_toBottomOf="@+id/setting_item_map_theme_tv"
        app:textColor4Night="@color/text_450_2_textcolor_night_selector"
        app:textColor4Skin="@color/text_450_2_textcolor_day_selector"/>
    <com.autonavi.view.custom.CustomDownloadPercent
        android:id="@+id/setting_itemc_bt_download"
        android:layout_width="@dimen/auto_dimen2_140"
        android:layout_height="@dimen/auto_dimen2_48"
        app:layout_constraintBottom_toBottomOf="@+id/setting_item_map_theme_img"
        app:layout_constraintStart_toStartOf="@+id/setting_item_map_theme_tv"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_22"
        android:textColor="@color/byd_text_450_1_textcolor_day_selected"
        android:gravity="center_vertical"
        android:id="@+id/setting_item_map_theme_tv_useing"
        android:visibility="gone"
        android:layout_width="@dimen/auto_dimen2_0"
        android:layout_height="@dimen/auto_dimen2_0"
        android:text="当前使用"
        app:layout_constraintBottom_toBottomOf="@+id/setting_itemc_bt_download"
        app:layout_constraintEnd_toEndOf="@+id/setting_itemc_bt_download"
        app:layout_constraintStart_toStartOf="@+id/setting_itemc_bt_download"
        app:layout_constraintTop_toTopOf="@+id/setting_itemc_bt_download"
        app:textColor4Night="@color/byd_text_450_1_textcolor_night_selected"
        app:textColor4Skin="@color/byd_text_450_1_textcolor_day_selected"/>
</com.autonavi.skin.view.SkinConstraintLayout>
