<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_navigation_info"
    android:layout_width="match_parent"
    android:layout_height="@dimen/auto_dimen2_256"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/cvn_eta"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/cl_tbt_bottom"
        app:layout_constraintEnd_toEndOf="@+id/ac_navigation_info_land"
        app:layout_constraintStart_toStartOf="@+id/ac_navigation_info_land"
        app:layout_constraintTop_toTopOf="@+id/ac_navigation_info_land"/>
    <com.autonavi.adapter.container.ACNavigationInfoLandscapeAutoNaviViewR
        android:id="@+id/ac_navigation_info_land"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:interface_key="navigation_ext_info_landscape"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinView
        android:id="@+id/cnvl_time"
        android:background="@drawable/navi_extra_card_separator_color_night"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/auto_dimen2_32"
        android:layout_marginEnd="@dimen/auto_dimen2_32"
        app:background4Night="@drawable/navi_extra_card_separator_color_night"
        app:background4Skin="@drawable/navi_extra_card_separator_color_night"
        app:layout_constraintTop_toBottomOf="@+id/ac_navigation_info_land"/>
    <include
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_80"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cnvl_time"
        layout="@layout/layout_card_drive_navi_info_extra_bottom"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_energy"
        android:background="@drawable/auto_navi_energy_background"
        android:paddingTop="@dimen/auto_dimen2_10"
        android:paddingBottom="@dimen/auto_dimen2_10"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_tbt_bottom">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_20"
            android:textColor="@color/auto_color_white"
            android:ellipsize="end"
            android:gravity="left"
            android:id="@+id/stv_text_energy_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:lineSpacingExtra="@dimen/auto_dimen2_9"
            android:layout_marginStart="@dimen/auto_dimen2_24"
            android:layout_marginEnd="@dimen/auto_dimen2_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/stv_text_energy_distance"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/auto_color_white"
            app:textColor4Skin="@color/auto_color_white"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_20"
            android:textColor="@color/auto_color_white"
            android:id="@+id/stv_text_energy_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:lineSpacingExtra="@dimen/auto_dimen2_9"
            android:layout_marginEnd="@dimen/auto_dimen2_2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/stv_text_energy_distance_unit"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/auto_color_white"
            app:textColor4Skin="@color/auto_color_white"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_20"
            android:textColor="@color/auto_color_white"
            android:id="@+id/stv_text_energy_distance_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginEnd="@dimen/auto_dimen2_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/auto_color_white"
            app:textColor4Skin="@color/auto_color_white"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
