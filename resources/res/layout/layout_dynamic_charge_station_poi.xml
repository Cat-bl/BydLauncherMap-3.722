<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.autonavi.skin.view.SkinLinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/skl_layout"
        android:background="@drawable/bg_dynamic_charging_station_poi_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/auto_dimen2_n8"
        android:layout_marginStart="@dimen/auto_dimen2_12"
        android:layout_marginEnd="@dimen/auto_dimen2_12"
        app:background4Night="@drawable/bg_dynamic_charging_station_poi_night"
        app:background4Skin="@drawable/bg_dynamic_charging_station_poi_day">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_11"
            android:textColor="@color/byd_search_charging_serial_num_color_day"
            android:gravity="center"
            android:id="@+id/siv_index"
            android:layout_width="@dimen/auto_dimen2_18"
            android:layout_height="@dimen/auto_dimen2_13"
            android:layout_marginStart="@dimen/auto_dimen2_3"
            android:layout_marginEnd="@dimen/auto_dimen2_3"
            app:textColor4Night="@color/byd_search_charging_serial_num_color_night"
            app:textColor4Skin="@color/byd_search_charging_serial_num_color_day"/>
        <com.autonavi.skin.view.SkinLinearLayout
            android:gravity="center_vertical"
            android:id="@+id/layout_fast_num"
            android:background="@drawable/custom_label_charge_fast_day_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_3"
            android:layout_marginBottom="@dimen/auto_dimen2_3"
            android:paddingStart="@dimen/auto_dimen2_8"
            android:paddingEnd="@dimen/auto_dimen2_8"
            android:layout_marginEnd="@dimen/auto_dimen2_3"
            app:background4Night="@drawable/custom_label_charge_fast_night_bg"
            app:background4Skin="@drawable/custom_label_charge_fast_day_bg">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_12"
                android:textColor="@color/charge_fast_slow_auto_color_white_day"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fast"
                android:maxLines="1"
                app:textColor4Night="@color/charge_fast_slow_auto_color_white_night"
                app:textColor4Skin="@color/charge_fast_slow_auto_color_white_day"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_19"
                android:textColor="@color/charge_fast_slow_auto_color_white_day"
                android:gravity="center"
                android:id="@+id/poi_fast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="@dimen/auto_dimen2_3"
                app:textColor4Night="@color/charge_fast_slow_auto_color_white_night"
                app:textColor4Skin="@color/charge_fast_slow_auto_color_white_day"/>
        </com.autonavi.skin.view.SkinLinearLayout>
        <com.autonavi.skin.view.SkinLinearLayout
            android:gravity="center_vertical"
            android:id="@+id/layout_slow_num"
            android:background="@drawable/custom_label_charge_slow_day_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_3"
            android:layout_marginBottom="@dimen/auto_dimen2_3"
            android:paddingStart="@dimen/auto_dimen2_8"
            android:paddingEnd="@dimen/auto_dimen2_8"
            android:layout_marginEnd="@dimen/auto_dimen2_3"
            app:background4Night="@drawable/custom_label_charge_slow_night_bg"
            app:background4Skin="@drawable/custom_label_charge_slow_day_bg">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_12"
                android:textColor="@color/charge_fast_slow_auto_color_white_day"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/slow"
                android:maxLines="1"
                app:textColor4Night="@color/charge_fast_slow_auto_color_white_night"
                app:textColor4Skin="@color/charge_fast_slow_auto_color_white_day"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_19"
                android:textColor="@color/charge_fast_slow_auto_color_white_day"
                android:gravity="center"
                android:id="@+id/poi_slow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="@dimen/auto_dimen2_3"
                app:textColor4Night="@color/charge_fast_slow_auto_color_white_night"
                app:textColor4Skin="@color/charge_fast_slow_auto_color_white_day"/>
        </com.autonavi.skin.view.SkinLinearLayout>
    </com.autonavi.skin.view.SkinLinearLayout>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/iv_icon"
        android:layout_width="@dimen/auto_dimen2_38"
        android:layout_height="@dimen/auto_dimen2_38"/>
</com.autonavi.skin.view.SkinLinearLayout>
