        app:layout_constraintHorizontal_weight="148"
        app:layout_constraintStart_toStartOf="@+id/cvv_traffic_jam"
        app:tag="DisableAtRunTime">
        <com.autonavi.view.custom.CustomBtnMajorView
            android:id="@+id/cbm_switch"
            android:layout_width="0dp"
            android:layout_height="@dimen/auto_dimen2_56"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
