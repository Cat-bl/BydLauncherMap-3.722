<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_custom_volume_bar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinSeekBar
        android:id="@+id/sb_vertical_volume_bar"
        android:background="@null"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:maxWidth="@dimen/auto_dimen2_104"
        android:max="100"
        android:progress="0"
        android:indeterminateOnly="false"
        android:progressDrawable="@drawable/custom_volume_bar_vertical_volume_bar_day_layerlist"
        android:minWidth="@dimen/auto_dimen2_104"
        android:thumb="@drawable/custom_volume_bar_vertical_volume_bar_day_thumb_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:progressDrawable4Night="@drawable/custom_volume_bar_vertical_volume_bar_night_layerlist"
        app:progressDrawable4Skin="@drawable/custom_volume_bar_vertical_volume_bar_day_layerlist"
        app:thumb4Night="@drawable/custom_volume_bar_vertical_volume_bar_night_thumb_selector"
        app:thumb4Skin="@drawable/custom_volume_bar_vertical_volume_bar_day_thumb_selector"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_start"
        android:background="@drawable/custom_volume_bar_start_day_bg_selector"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_27"
        app:background4Night="@drawable/custom_volume_bar_start_night_bg_selector"
        app:background4Skin="@drawable/custom_volume_bar_start_day_bg_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
