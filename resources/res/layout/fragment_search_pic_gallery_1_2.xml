<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_pic_gallery"
    android:background="@color/search_photo_gallery_bg_color_day"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:background4Night="@drawable/sys_bg_window"
    app:background4Skin="@color/search_photo_gallery_bg_color_day"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_top_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/auto_dimen2_48"
        android:layout_marginTop="@dimen/sys_padding_l"
        android:layout_marginStart="@dimen/sys_padding_xl"
        android:layout_marginEnd="@dimen/sys_padding_xxl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/siv_back"
            android:background="@drawable/custom_list_pressed_list_day_bg_selector"
            android:layout_width="@dimen/auto_dimen2_48"
            android:layout_height="@dimen/auto_dimen2_48"
            app:background4Night="@drawable/custom_list_pressed_list_night_bg_selector"
            app:background4Skin="@drawable/custom_list_pressed_list_day_bg_selector"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.autonavi.skin.view.SkinImageView
            android:layout_width="@dimen/auto_dimen2_32"
            android:layout_height="@dimen/auto_dimen2_32"
            android:src="@drawable/icon_setting_300ui_back_night"
            android:tint="@color/byd_search_text_day"
            app:layout_constraintBottom_toBottomOf="@+id/siv_back"
            app:layout_constraintEnd_toEndOf="@+id/siv_back"
            app:layout_constraintStart_toStartOf="@+id/siv_back"
            app:layout_constraintTop_toTopOf="@+id/siv_back"
            app:tint4Night="@color/byd_search_text_night"
            app:tint4Skin="@color/byd_search_text_day"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_20"
            android:textColor="@color/byd_search_text_day"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/stv_text_title_search_pic_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_poi_detail_photo_gallery"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/sys_color_default_dark"
            app:textColor4Skin="@color/byd_search_text_day"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
    <com.autonavi.skin.view.SkinGridView
        android:id="@+id/gv_photo_wall"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/sys_padding_xl"
        android:layout_marginBottom="@dimen/sys_padding_xl"
        android:listSelector="@android:color/transparent"
        android:cacheColorHint="@color/auto_ui_000000_00"
        android:horizontalSpacing="@dimen/auto_dimen2_16"
        android:verticalSpacing="@dimen/auto_dimen2_16"
        android:numColumns="4"
        android:layout_marginStart="@dimen/auto_dimen2_48"
        android:layout_marginEnd="@dimen/auto_dimen2_48"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_top_title"/>
</com.autonavi.skin.view.SkinConstraintLayout>
