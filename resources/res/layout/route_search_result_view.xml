<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_search_result_all"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/ensearch_filter_bar"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_32"
        android:layout_marginLeft="@dimen/auto_dimen2_6"
        android:layout_marginRight="@dimen/auto_dimen2_6"
        android:layout_marginHorizontal="@dimen/auto_dimen2_6"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/slv_search_result"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="-4dp"
        app:layout_goneMarginTop="@dimen/auto_dimen2_0"/>
    <com.autonavi.demo.view.fragment.framework.widget.pullToRefresh.PullToRefreshListView
        android:scrollbarThumbVertical="@drawable/byd_custom_scrollbar_thumb_day"
        android:scrollbarStyle="outsideInset"
        android:id="@+id/slv_search_result"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/auto_dimen2_8"
        android:layout_marginBottom="@dimen/auto_dimen2_24"
        android:listSelector="@color/auto_ui_000000_00"
        android:cacheColorHint="@color/auto_ui_000000_00"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:fastScrollEnabled="false"
        android:headerDividersEnabled="false"
        android:footerDividersEnabled="false"
        android:contentDescription="结果列表|纵向"
        android:paddingEnd="@dimen/auto_dimen2_8"
        android:layout_marginStart="@dimen/auto_dimen2_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ensearch_filter_bar"
        app:scrollbarThumbVertical4Night="@drawable/byd_custom_scrollbar_thumb_night"
        app:scrollbarThumbVertical4Skin="@drawable/byd_custom_scrollbar_thumb_day"/>
    <com.autonavi.skin.view.SkinView
        android:id="@+id/sv_bottom_shadow"
        android:background="@drawable/shape_listview_edge_gradient_day"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_32"
        android:layout_alignParentBottom="true"
        app:background4Night="@drawable/shape_listview_edge_gradient_night"
        app:background4Skin="@drawable/shape_listview_edge_gradient_day"
        app:layout_constraintBottom_toBottomOf="@+id/slv_search_result"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</merge>
