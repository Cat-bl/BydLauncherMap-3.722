<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_search_home"
    android:background="@drawable/byd_user_bg_day_port"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:background4Night="@drawable/byd_user_bg_night"
    app:background4Skin="@drawable/byd_user_bg_day_port">
    <com.autonavi.skin.view.SkinRelativeLayout
        android:id="@+id/layout_tittle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/auto_dimen2_48"
        android:layout_marginTop="@dimen/auto_dimen2_12"
        android:layout_marginStart="@dimen/auto_dimen2_28"
        android:layout_marginEnd="@dimen/auto_dimen2_24">
        <com.autonavi.skin.view.SkinRelativeLayout
            android:id="@+id/user_car_btn_back"
            android:background="@drawable/custom_list_pressed_list_day_bg_selector"
            android:layout_width="@dimen/auto_dimen2_48"
            android:layout_height="@dimen/auto_dimen2_48"
            app:background4Night="@drawable/custom_list_pressed_list_night_bg_selector"
            app:background4Skin="@drawable/custom_list_pressed_list_day_bg_selector">
            <com.autonavi.skin.view.SkinImageView
                android:background="@drawable/icon_setting_back_land_day"
                android:layout_width="@dimen/auto_dimen2_48"
                android:layout_height="@dimen/auto_dimen2_48"
                android:layout_centerVertical="true"
                app:background4Night="@drawable/icon_setting_back_land_night"
                app:background4Skin="@drawable/icon_setting_back_land_day"/>
        </com.autonavi.skin.view.SkinRelativeLayout>
        <com.autonavi.skin.view.SkinRelativeLayout
            android:id="@+id/rename_input"
            android:background="@drawable/rename_input_inner_day_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auto_dimen2_48"
            android:layout_marginLeft="@dimen/auto_dimen2_28"
            android:layout_marginRight="@dimen/auto_dimen2_188"
            android:layout_toRightOf="@+id/user_car_btn_back"
            app:background4Night="@drawable/rename_input_inner_night_bg"
            app:background4Skin="@drawable/rename_input_inner_day_bg">
            <com.autonavi.skin.view.SkinRelativeLayout
                android:gravity="center_horizontal"
                android:id="@+id/user_car_btn_pri"
                android:background="@drawable/byd_custom_btn_function3_day_bg_selector"
                android:layout_width="@dimen/auto_dimen2_90"
                android:layout_height="@dimen/auto_dimen2_32"
                android:layout_marginLeft="@dimen/auto_dimen2_16"
                android:layout_centerVertical="true"
                app:background4Night="@drawable/byd_custom_btn_function3_night_bg_selector"
                app:background4Skin="@drawable/byd_custom_btn_function3_day_bg_selector">
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_18"
                    android:textColor="@color/custom_btn_blue_day_1_color"
                    android:id="@+id/txt_prince"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="京"
                    android:layout_centerVertical="true"
                    app:textColor4Night="@color/custom_btn_blue_night_1_color"
                    app:textColor4Skin="@color/custom_btn_blue_day_1_color"/>
                <com.autonavi.skin.view.SkinImageView
                    android:id="@+id/txt_prince_img"
                    android:background="@drawable/search_switch_city_arrow_out_day_city_up"
                    android:layout_width="@dimen/auto_dimen2_24"
                    android:layout_height="@dimen/auto_dimen2_24"
                    android:layout_marginLeft="@dimen/auto_dimen2_5"
                    android:scaleType="fitCenter"
                    android:layout_toRightOf="@+id/txt_prince"
                    android:layout_centerVertical="true"
                    app:background4Night="@drawable/search_switch_city_arrow_out_night_city_up"
                    app:background4Skin="@drawable/search_switch_city_arrow_out_day_city_up"/>
            </com.autonavi.skin.view.SkinRelativeLayout>
            <com.autonavi.skin.view.SkinView
                android:id="@+id/user_car_btn_line"
                android:background="@color/car_input_box_color"
                android:layout_width="@dimen/auto_dimen2_1"
                android:layout_height="@dimen/auto_dimen2_24"
                android:layout_marginLeft="@dimen/auto_dimen2_18"
                android:layout_toRightOf="@+id/user_car_btn_pri"
                android:layout_centerVertical="true"
                app:background4Night="@color/car_input_box_color"
                app:background4Skin="@color/car_input_box_color"/>
            <com.autonavi.skin.view.SkinEditText
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/custom_text_day_color_100"
                android:textColorHint="@color/custom_text_day_color_55"
                android:gravity="center_vertical"
                android:id="@+id/skinEditText"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="1dp"
                android:hint="@string/user_car_edit_plate_hint"
                android:maxLength="8"
                android:inputType="textVisiblePassword"
                android:textCursorDrawable="@drawable/search_around_category_search_around_cursor_drawable"
                android:layout_marginStart="@dimen/auto_dimen2_27"
                android:layout_marginEnd="@dimen/auto_dimen2_1"
                android:layout_toStartOf="@+id/input_end_line"
                android:layout_toEndOf="@+id/user_car_btn_line"
                app:textColor4Night="@color/custom_text_night_color"
                app:textColor4Skin="@color/custom_text_day_color_100"
                app:textColorHint4Night="@color/custom_text_night_color_55"
                app:textColorHint4Skin="@color/custom_text_day_color_55"/>
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/plate_number_delete"
                android:background="@drawable/search_common_tips_clear"
                android:visibility="gone"
                android:layout_width="@dimen/auto_dimen2_48"
                android:layout_height="@dimen/auto_dimen2_48"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/auto_dimen2_30"
                android:layout_toStartOf="@+id/input_end_line"
                app:background4Night="@drawable/search_common_tips_clear_night"
                app:background4Skin="@drawable/search_common_tips_clear"/>
            <com.autonavi.skin.view.SkinTextView
                android:enabled="false"
                android:textSize="@dimen/auto_font_size_22"
                android:textColor="@color/team_rename_btn_text_color_selector_day"
                android:gravity="center"
                android:id="@+id/skinTextView_finish_"
                android:layout_width="@dimen/auto_dimen2_0"
                android:layout_height="match_parent"
                android:text="@string/user_car_edit_plate_complete"
                android:layout_alignParentRight="true"
                android:lineSpacingExtra="@dimen/auto_dimen2_4"
                app:textColor4Night="@color/team_rename_btn_text_color_selector_night"
                app:textColor4Skin="@color/team_rename_btn_text_color_selector_day"/>
            <com.autonavi.skin.view.SkinView
                android:id="@+id/input_end_line"
                android:background="@color/auto_color_D2DFE8"
                android:layout_width="@dimen/auto_dimen2_0"
                android:layout_height="@dimen/auto_dimen2_28"
                android:layout_toLeftOf="@+id/skinTextView_finish_"
                android:layout_centerVertical="true"
                app:background4Night="@color/auto_color_365173"
                app:background4Skin="@color/auto_color_D2DFE8"/>
        </com.autonavi.skin.view.SkinRelativeLayout>
        <com.autonavi.skin.view.SkinTextView
            android:enabled="false"
            android:textSize="@dimen/auto_font_size_18"
            android:textColor="@color/custom_text_day_color_85"
            android:gravity="center"
            android:id="@+id/skinTextView_finish"
            android:background="@drawable/byd_custom_btn_function1_btn_function1_day_bg_selector"
            android:layout_width="@dimen/auto_dimen2_160"
            android:layout_height="@dimen/auto_dimen2_48"
            android:text="@string/user_car_edit_plate_complete"
            android:layout_alignParentRight="true"
            android:lineSpacingExtra="@dimen/auto_dimen2_4"
            app:background4Night="@drawable/byd_custom_btn_function2_night_bg_selector"
            app:background4Skin="@drawable/byd_custom_btn_function1_btn_function1_day_bg_selector"
            app:textColor4Night="@color/custom_text_night_color_85"
            app:textColor4Skin="@color/custom_text_day_color_85"/>
    </com.autonavi.skin.view.SkinRelativeLayout>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_14"
        android:textColor="@color/custom_text_day_color_55"
        android:gravity="center"
        android:id="@+id/txt_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_24"
        android:text="@string/user_car_edit_plate_tip"
        android:layout_below="@+id/layout_tittle"
        android:layout_centerHorizontal="true"
        app:textColor4Night="@color/custom_text_night_color_55"
        app:textColor4Skin="@color/custom_text_day_color_55"/>
    <com.autonavi.skin.view.SkinGridView
        android:id="@+id/province_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_20"
        android:listSelector="@android:color/transparent"
        android:cacheColorHint="@color/auto_ui_000000_00"
        android:horizontalSpacing="@dimen/auto_dimen2_16"
        android:verticalSpacing="@dimen/auto_dimen2_16"
        android:numColumns="8"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:layout_below="@+id/txt_tip"
        android:layout_marginStart="@dimen/auto_dimen2_88"
        android:layout_marginEnd="@dimen/auto_dimen2_88"/>
</com.autonavi.skin.view.SkinRelativeLayout>
