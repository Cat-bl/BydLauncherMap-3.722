<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="@dimen/auto_dimen2_240">
    <com.autonavi.skin.view.SkinView
        android:layout_marginTop="@dimen/auto_dimen2_0"
        android:layout_marginBottom="@dimen/auto_dimen2_0"
        android:layout_marginStart="@dimen/auto_dimen2_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/style_card_bg"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_back"
        android:background="@drawable/search_common_back_day"
        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_48"
        android:layout_marginTop="@dimen/auto_dimen2_13"
        android:layout_marginStart="@dimen/auto_dimen2_20"
        app:background4Night="@drawable/search_common_back_night"
        app:background4Skin="@drawable/search_common_back_day"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_20"
        android:textColor="@color/byd_search_text_day"
        android:gravity="center_vertical"
        android:id="@+id/stv_text_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/search_charging_gun"
        android:layout_marginStart="@dimen/auto_dimen2_8"
        app:layout_constraintBottom_toBottomOf="@+id/siv_back"
        app:layout_constraintStart_toEndOf="@+id/siv_back"
        app:layout_constraintTop_toTopOf="@+id/siv_back"
        app:textColor4Night="@color/byd_search_text_night"
        app:textColor4Skin="@color/byd_search_text_day"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_charging_gun"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/auto_dimen2_20"
        android:layout_marginBottom="@dimen/auto_dimen2_20"
        android:layout_marginStart="@dimen/auto_dimen2_32"
        android:layout_marginEnd="@dimen/auto_dimen2_32"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stv_text_title"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_no_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siv_back">
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/cdw_default_wrong"
            android:background="@drawable/search_no_history_day"
            android:layout_width="@dimen/auto_dimen2_312"
            android:layout_height="@dimen/auto_dimen2_208"
            app:background4Night="@drawable/search_no_history_night"
            app:background4Skin="@drawable/search_no_history_day"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_16"
            android:textColor="@color/byd_search_text_day_70"
            android:gravity="center"
            android:id="@+id/stv_text_no_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_12"
            android:text="@string/auto_search_around_text_no_search_data"
            android:lineSpacingExtra="@dimen/auto_dimen2_4"
            app:layout_constraintEnd_toEndOf="@+id/cdw_default_wrong"
            app:layout_constraintStart_toStartOf="@+id/cdw_default_wrong"
            app:layout_constraintTop_toBottomOf="@+id/cdw_default_wrong"
            app:textColor4Night="@color/byd_search_text_night_70"
            app:textColor4Skin="@color/byd_search_text_day_70"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
