<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_auto_navi_info_panel_pem_hint"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/auto_dimen2_130"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_card_view_bg"
        android:background="@drawable/custom_aiem_hint_bg_night_opened"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:background4Night="@drawable/custom_aiem_hint_bg_night_opened"
        app:background4Skin="@drawable/custom_aiem_hint_bg_day_opened"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_aiem_title_icon"
        android:background="@drawable/custom_aiem_hint_icon_night"
        android:layout_width="@dimen/auto_dimen2_91"
        android:layout_height="@dimen/auto_dimen2_42"
        android:layout_marginTop="@dimen/auto_dimen2_17"
        app:background4Night="@drawable/custom_aiem_hint_icon_night"
        app:background4Skin="@drawable/custom_aiem_hint_icon_day"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/pem_tips_text_day"
        android:gravity="center"
        android:id="@+id/stv_tip"
        android:layout_width="@dimen/auto_dimen2_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_6"
        android:text="@string/auto_navi_text_pem_hint_unopen"
        android:lineSpacingMultiplier="1.2"
        android:paddingStart="@dimen/auto_dimen2_30"
        android:paddingEnd="@dimen/auto_dimen2_30"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siv_aiem_title_icon"
        app:textColor4Night="@color/pem_tips_text_night"
        app:textColor4Skin="@color/pem_tips_text_day"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_close_view"
        android:background="@drawable/icon_light_public_close_s_48"
        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_48"
        android:layout_marginTop="@dimen/auto_dimen2_8"
        android:contentDescription="关闭弹窗"
        android:layout_marginEnd="@dimen/auto_dimen2_8"
        app:background4Night="@drawable/icon_dark_public_close_s_48"
        app:background4Skin="@drawable/icon_light_public_close_s_48"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_open"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_21"
        android:layout_marginBottom="@dimen/auto_dimen2_26"
        android:contentDescription="开启"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stv_tip">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_18"
            android:textColor="@color/byd_custom_highlight_btn_text_color_selector_day"
            android:gravity="center"
            android:id="@+id/stv_open"
            android:background="@drawable/byd_custom_highlight_btn_bg_selector_day"
            android:layout_width="@dimen/auto_dimen2_164"
            android:layout_height="@dimen/auto_dimen2_40"
            android:text="@string/auto_navi_text_open"
            app:background4Night="@drawable/byd_custom_highlight_btn_bg_selector_night"
            app:background4Skin="@drawable/byd_custom_highlight_btn_bg_selector_day"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tag="DisableAtRunTime"
            app:textColor4Night="@color/byd_custom_highlight_btn_text_color_selector_night"
            app:textColor4Skin="@color/byd_custom_highlight_btn_text_color_selector_day"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
