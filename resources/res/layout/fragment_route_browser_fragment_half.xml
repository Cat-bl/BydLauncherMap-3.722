<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_route_browser_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.auto.common.view.AutoGuideLine
        android:orientation="horizontal"
        android:id="@+id/gl_line1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.48"
        app:layout_constraintGuide_percent4Landscape="0.48"
        app:layout_constraintGuide_percent4LandscapeWide="0.48"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_route_rect_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/auto_dimen2_100"
        android:layout_marginBottom="@dimen/auto_dimen2_24"
        android:layout_marginStart="@dimen/auto_dimen2_120"
        android:layout_marginEnd="@dimen/auto_dimen2_120"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gl_line1"/>
    <Space
        android:id="@+id/bottom_space"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/auto_dimen2_12"
        android:layout_marginEnd="@dimen/auto_dimen2_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.autonavi.view.custom.CustomBtnCircular3View
        android:id="@+id/cbc_zoom_btn"
        android:layout_marginEnd="@dimen/auto_dimen2_24"
        app:layout_constraintBottom_toTopOf="@+id/bottom_space"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/denza_zoom_btn_shadow_style"/>
    <com.autonavi.view.custom.CustomAutologoView
        android:id="@+id/ca_autologo"
        android:background="@color/auto_map_light_logo_bg"
        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_12"
        android:layout_marginBottom="@dimen/auto_dimen2_11"
        android:layout_marginEnd="@dimen/auto_dimen2_96"
        app:background4Night="@color/auto_map_dark_logo_bg"
        app:background4Skin="@color/auto_map_light_logo_bg"
        app:layout_constraintBottom_toTopOf="@+id/bottom_space"
        app:layout_constraintEnd_toEndOf="parent"/>
    <com.autonavi.view.custom.CustomAutoScaleLineView
        android:id="@+id/casl_scale"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/auto_dimen2_6"
        app:layout_constraintBottom_toTopOf="@+id/ca_autologo"
        app:layout_constraintEnd_toEndOf="@+id/ca_autologo"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cc_browser_constraint"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/auto_dimen2_1"
        app:layout_constraintBottom_toTopOf="@+id/gl_line1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.view.custom.CustomCardView
            android:id="@+id/cc_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginLeft="@dimen/auto_dimen2_24"
            android:layout_marginTop="@dimen/auto_dimen2_20"
            android:layout_marginRight="@dimen/auto_dimen2_24"
            app:bg_day="@drawable/custom_card_view_bg_day"
            app:bg_night="@drawable/custom_card_view_bg_night"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/cbts_bar_title"
            android:layout_width="0dp"
            android:layout_height="@dimen/auto_dimen2_48"
            android:layout_marginTop="@dimen/auto_dimen2_24"
            app:layout_constraintEnd_toEndOf="@+id/cc_bg"
            app:layout_constraintStart_toStartOf="@+id/cc_bg"
            app:layout_constraintTop_toTopOf="@+id/cc_bg">
            <com.autonavi.skin.view.SkinConstraintLayout
                android:id="@+id/cl_back"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/auto_dimen2_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.autonavi.view.custom.CustomListPressedView
                    android:id="@+id/clp_back"
                    android:layout_width="@dimen/auto_dimen2_48"
                    android:layout_height="@dimen/auto_dimen2_48"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.autonavi.skin.view.SkinImageView
                    android:id="@+id/siv_back_title_short"
                    android:background="@drawable/icon_route_pathbrow_back_day"
                    android:layout_width="@dimen/auto_dimen2_48"
                    android:layout_height="@dimen/auto_dimen2_48"
                    android:contentDescription="返回"
                    app:background4Night="@drawable/icon_route_pathbrow_back"
                    app:background4Skin="@drawable/icon_route_pathbrow_back_day"
                    app:layout_constraintBottom_toBottomOf="@+id/clp_back"
                    app:layout_constraintStart_toStartOf="@+id/clp_back"
                    app:layout_constraintTop_toTopOf="@+id/clp_back"/>
            </com.autonavi.skin.view.SkinConstraintLayout>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/cl_btn_startnavi"
            android:background="@drawable/byd_custom_normal_btn_bg_selector_day"
            android:layout_width="@dimen/auto_dimen2_180"
            android:layout_height="@dimen/auto_dimen2_48"
            android:layout_marginEnd="@dimen/auto_dimen2_32"
            app:background4Night="@drawable/byd_custom_normal_btn_bg_selector_night"
            app:background4Skin="@drawable/byd_custom_normal_btn_bg_selector_day"
            app:layout_constraintBottom_toBottomOf="@+id/cbts_bar_title"
            app:layout_constraintEnd_toEndOf="@+id/cbts_bar_title"
            app:layout_constraintTop_toTopOf="@+id/cbts_bar_title"
            app:tag="DisableAtRunTime">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/byd_custom_normal_btn_text_color_selector_day"
                android:gravity="left"
                android:id="@+id/stv_text_startnavi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auto_dimen2_12"
                android:layout_marginBottom="@dimen/auto_dimen2_9"
                android:text="@string/route_browser_fragment_text_startnavi"
                android:lineSpacingExtra="@dimen/auto_dimen2_4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:textColor4Night="@color/byd_custom_normal_btn_text_color_selector_night"
                app:textColor4Skin="@color/byd_custom_normal_btn_text_color_selector_day"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/cl_btn_avoidroute"
            android:background="@drawable/byd_custom_normal_btn_bg_selector_day"
            android:layout_width="@dimen/auto_dimen2_180"
            android:layout_height="@dimen/auto_dimen2_48"
            android:layout_marginEnd="@dimen/auto_dimen2_12"
            app:background4Night="@drawable/byd_custom_normal_btn_bg_selector_night"
            app:background4Skin="@drawable/byd_custom_normal_btn_bg_selector_day"
            app:layout_constraintBottom_toBottomOf="@+id/cbts_bar_title"
            app:layout_constraintEnd_toStartOf="@+id/cl_btn_startnavi"
            app:layout_constraintTop_toTopOf="@+id/cbts_bar_title"
            app:tag="DisableAtRunTime">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/byd_custom_normal_btn_text_color_selector_day"
                android:gravity="left"
                android:id="@+id/stv_text_avoidroute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auto_dimen2_12"
                android:layout_marginBottom="@dimen/auto_dimen2_9"
                android:text="@string/route_browser_fragment_text_avoidroute"
                android:lineSpacingExtra="@dimen/auto_dimen2_4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:textColor4Night="@color/byd_custom_normal_btn_text_color_selector_night"
                app:textColor4Skin="@color/byd_custom_normal_btn_text_color_selector_day"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_18"
            android:textColor="@color/byd_custom_highlight_btn_text_color_selector_day"
            android:gravity="center"
            android:id="@+id/stv_avoid"
            android:background="@drawable/byd_custom_highlight_btn_bg_selector_day"
            android:visibility="gone"
            android:layout_width="@dimen/auto_dimen2_180"
            android:layout_height="@dimen/auto_dimen2_48"
            android:text="@string/route_browser_fragment_avoid"
            android:lineSpacingExtra="@dimen/auto_dimen2_4"
            android:layout_marginEnd="@dimen/auto_dimen2_24"
            app:background4Night="@drawable/byd_custom_highlight_btn_bg_selector_night"
            app:background4Skin="@drawable/byd_custom_highlight_btn_bg_selector_day"
            app:layout_constraintBottom_toBottomOf="@+id/cbts_bar_title"
            app:layout_constraintEnd_toEndOf="@+id/cbts_bar_title"
            app:layout_constraintTop_toTopOf="@+id/cbts_bar_title"
            app:tag="DisableAtRunTime"
            app:textColor4Night="@color/byd_custom_highlight_btn_text_color_selector_night"
            app:textColor4Skin="@color/byd_custom_highlight_btn_text_color_selector_day"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_18"
            android:textColor="@color/custom_route_textcolor_btn_text_day_normal"
            android:id="@+id/tv_route_browser_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_16"
            android:text="@string/route_browser_route_details"
            android:layout_marginStart="@dimen/auto_dimen2_32"
            app:layout_constraintStart_toStartOf="@+id/cc_bg"
            app:layout_constraintTop_toBottomOf="@+id/cbts_bar_title"
            app:textColor4Night="@color/custom_route_btn_text_night"
            app:textColor4Skin="@color/custom_route_textcolor_btn_text_day_normal"/>
        <com.autonavi.view.route.RouteBarView
            android:id="@+id/dnp_info"
            android:layout_width="0dp"
            android:layout_height="@dimen/auto_dimen2_40"
            android:layout_marginTop="@dimen/auto_dimen2_12"
            android:layout_marginStart="@dimen/auto_dimen2_32"
            android:layout_marginEnd="@dimen/auto_dimen2_32"
            app:layout_constraintEnd_toEndOf="@+id/cc_bg"
            app:layout_constraintStart_toStartOf="@+id/cc_bg"
            app:layout_constraintTop_toBottomOf="@+id/tv_route_browser_title"/>
        <com.autonavi.skin.view.SkinListView
            android:scrollbarThumbVertical="@drawable/vertical_scrollbar_bg"
            android:id="@+id/slv_route_detail_list"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/auto_dimen2_13"
            android:layout_marginBottom="@dimen/auto_dimen2_16"
            android:listSelector="@color/auto_ui_000000_00"
            android:cacheColorHint="@color/auto_ui_000000_00"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:fastScrollEnabled="false"
            android:headerDividersEnabled="false"
            android:footerDividersEnabled="false"
            android:layout_marginEnd="@dimen/auto_dimen2_18"
            app:layout_constraintBottom_toBottomOf="@+id/cc_bg"
            app:layout_constraintEnd_toEndOf="@+id/cc_bg"
            app:layout_constraintStart_toStartOf="@+id/cc_bg"
            app:layout_constraintTop_toBottomOf="@+id/dnp_info"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
