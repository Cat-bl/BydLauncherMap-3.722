<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/remove_member_layout"
    android:layout_width="@dimen/auto_dimen2_150"
    android:layout_height="@dimen/auto_dimen2_120"
    android:layout_marginBottom="@dimen/auto_dimen2_32"
    android:layout_marginStart="@dimen/auto_dimen2_8">
    <com.autonavi.skin.view.SkinRelativeLayout
        android:layout_width="@dimen/auto_dimen2_88"
        android:layout_height="@dimen/auto_dimen2_88">
        <com.autonavi.view.custom.CustomCircleImageView
            android:gravity="center"
            android:id="@+id/civ_member_head"
            android:layout_width="@dimen/auto_dimen2_72"
            android:layout_height="@dimen/auto_dimen2_72"
            android:src="@drawable/icon_user_default_head_72"
            android:layout_centerInParent="true"
            app:civ_border_color="@color/color_team_member_border"
            app:civ_border_color_day="@color/color_team_member_border"
            app:civ_border_color_night="@color/custom_text_night_color_55"
            app:civ_border_width="@dimen/auto_dimen2_2"/>
        <com.autonavi.skin.view.SkinImageView
            android:background="@drawable/corner_mark_delete_image"
            android:layout_width="@dimen/auto_dimen2_40"
            android:layout_height="@dimen/auto_dimen2_40"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"/>
    </com.autonavi.skin.view.SkinRelativeLayout>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/custom_text_day_color_55"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/stv_member_name"
        android:layout_width="@dimen/auto_dimen2_150"
        android:layout_height="@dimen/auto_dimen2_32"
        android:maxLines="1"
        android:maxEms="6"
        app:textColor4Night="@color/custom_text_night_color_55"
        app:textColor4Skin="@color/custom_text_day_color_55"/>
</com.autonavi.skin.view.SkinLinearLayout>
