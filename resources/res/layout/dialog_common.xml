<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_dialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_center"
        android:background="@drawable/byd_custom_dialog_dialog_m_day_bg_selector"
        android:layout_width="@dimen/auto_dimen2_528"
        android:layout_height="@dimen/auto_dimen2_264"
        app:background4Night="@drawable/byd_custom_dialog_dialog_m_night_bg_selector"
        app:background4Skin="@drawable/byd_custom_dialog_dialog_m_day_bg_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.skin.view.SkinLinearLayout
            android:gravity="center_horizontal"
            android:id="@+id/cl_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/auto_dimen2_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_20"
                android:gravity="center"
                android:id="@+id/stv_left"
                android:visibility="gone"
                android:layout_width="@dimen/auto_dimen2_240"
                android:layout_height="@dimen/auto_dimen2_48"
                android:text="@string/dialog_left"
                style="@style/SysBtnLargePrimary"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_20"
                android:gravity="center"
                android:id="@+id/stv_middle"
                android:visibility="gone"
                android:layout_width="@dimen/auto_dimen2_240"
                android:layout_height="@dimen/auto_dimen2_48"
                android:text="@string/dialog_left"
                style="@style/SysBtnLargePrimary"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_20"
                android:gravity="center"
                android:id="@+id/stv_right"
                android:visibility="gone"
                android:layout_width="@dimen/auto_dimen2_240"
                android:layout_height="@dimen/auto_dimen2_48"
                android:text="@string/dialog_right"
                android:layout_marginStart="@dimen/auto_dimen2_16"
                style="@style/SysBtnLargeSecondary"/>
        </com.autonavi.skin.view.SkinLinearLayout>
        <com.autonavi.skin.view.SkinLinearLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/auto_dimen2_32"
            android:paddingRight="@dimen/auto_dimen2_32"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auto_dimen2_0"
            app:layout_constraintBottom_toTopOf="@+id/cl_buttons"
            app:layout_constraintTop_toTopOf="parent">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_22"
                android:textColor="@color/sys_inverseColor_secondary_light"
                android:gravity="center"
                android:id="@+id/stv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auto_dimen2_18"
                android:minHeight="@dimen/auto_dimen2_30"
                android:text="@string/settings_navi_traffic_mode"
                app:textColor4Night="@color/sys_color_secondary_dark"
                app:textColor4Skin="@color/sys_inverseColor_secondary_light"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_20"
                android:textColor="@color/sys_inverseColor_default_light"
                android:gravity="center"
                android:id="@+id/stv_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auto_dimen2_16"
                android:minHeight="@dimen/auto_dimen2_112"
                android:text="@string/settings_navi_traffic_mode"
                app:textColor4Night="@color/sys_color_default_dark"
                app:textColor4Skin="@color/sys_inverseColor_default_light"/>
        </com.autonavi.skin.view.SkinLinearLayout>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
