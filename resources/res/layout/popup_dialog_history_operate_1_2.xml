<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/cl_dialog"
    android:clipChildren="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinConstraintLayout
        android:orientation="vertical"
        android:background="@drawable/popup_dialog_history_operate_bg_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/auto_dimen2_8"
        android:minWidth="@dimen/auto_dimen2_200"
        android:layout_marginStart="@dimen/auto_dimen2_8"
        android:layout_marginEnd="@dimen/auto_dimen2_8"
        app:background4Night="@drawable/popup_dialog_history_operate_bg_night"
        app:background4Skin="@drawable/popup_dialog_history_operate_bg_day"
        app:shadowDx="@dimen/auto_dimen2_0"
        app:shadowDy="@dimen/auto_dimen2_2"
        style="@style/custom_card_shadow_style">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_18"
            android:textColor="@color/byd_search_text_day"
            android:gravity="start|center_vertical"
            android:id="@+id/stv_item2"
            android:layout_width="0dp"
            android:layout_height="@dimen/auto_dimen2_60"
            android:text="收藏"
            android:paddingStart="@dimen/auto_dimen2_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:textColor4Night="@color/byd_search_text_night"
            app:textColor4Skin="@color/byd_search_text_day"/>
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/cll_item_bottom_line"
            android:background="@color/pop_divider_line_light"
            android:layout_width="0dp"
            android:layout_height="@dimen/auto_dimen2_1"
            android:layout_marginLeft="@dimen/auto_dimen2_16"
            android:layout_marginRight="@dimen/auto_dimen2_16"
            android:maxWidth="@dimen/auto_dimen2_200"
            app:background4Night="@color/pop_divider_line_dark"
            app:background4Skin="@color/pop_divider_line_light"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/stv_item2"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_18"
            android:textColor="@color/byd_search_text_day"
            android:gravity="start|center_vertical"
            android:id="@+id/stv_item1"
            android:layout_width="0dp"
            android:layout_height="@dimen/auto_dimen2_60"
            android:text="删除记录"
            android:paddingStart="@dimen/auto_dimen2_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cll_item_bottom_line"
            app:textColor4Night="@color/byd_search_text_night"
            app:textColor4Skin="@color/byd_search_text_day"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinLinearLayout>
