<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_tip_font"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.view.custom.CustomHintContentView
        android:id="@+id/chc_tip_loading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/auto_dimen2_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_tip_loading"
        android:background="@drawable/auto_search_result_map_tip_loading"
        android:layout_width="@dimen/auto_dimen2_28"
        android:layout_height="@dimen/auto_dimen2_28"
        android:layout_marginLeft="@dimen/auto_dimen2_32"
        android:layout_marginTop="@dimen/auto_dimen2_8"
        android:layout_marginBottom="@dimen/auto_dimen2_9"
        app:background4Skin="@drawable/auto_search_result_map_tip_loading"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_24"
        android:textColor="@color/text_450_2_textcolor_day_selector"
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/stv_text_loading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/auto_dimen2_16"
        android:layout_marginTop="@dimen/auto_dimen2_10"
        android:layout_marginRight="@dimen/auto_dimen2_8"
        android:layout_marginBottom="@dimen/auto_dimen2_8"
        android:text="@string/auto_search_result_map_text_loading"
        android:singleLine="true"
        android:lineSpacingExtra="@dimen/auto_dimen2_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/siv_tip_loading"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/text_450_2_textcolor_night_selector"
        app:textColor4Skin="@color/text_450_2_textcolor_day_selector"/>
</com.autonavi.skin.view.SkinConstraintLayout>
