<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_20"
        android:textStyle="bold"
        android:textColor="@color/custom_text_day_color_white"
        android:gravity="center"
        android:id="@+id/stv_charging_type"
        android:layout_width="@dimen/auto_dimen2_56"
        android:layout_height="@dimen/auto_dimen2_56"
        android:layout_marginTop="@dimen/auto_dimen2_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_20"
        android:textColor="@color/custom_text_day_color"
        android:id="@+id/stv_charging_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/auto_dimen2_16"
        app:layout_constraintBottom_toTopOf="@+id/stv_charging_power"
        app:layout_constraintStart_toEndOf="@+id/stv_charging_type"
        app:layout_constraintTop_toTopOf="@+id/stv_charging_type"
        app:textColor4Night="@color/custom_text_night_color"
        app:textColor4Skin="@color/custom_text_day_color"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/custom_text_day_color_55"
        android:gravity="center"
        android:id="@+id/stv_charging_power"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_6"
        android:layout_marginStart="@dimen/auto_dimen2_16"
        app:layout_constraintStart_toEndOf="@+id/stv_charging_type"
        app:layout_constraintTop_toBottomOf="@+id/stv_charging_num"
        app:textColor4Night="@color/custom_text_night_color_55"
        app:textColor4Skin="@color/custom_text_day_color_55"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textStyle="bold"
        android:textColor="@color/byd_search_result_go_here_day"
        android:gravity="center"
        android:id="@+id/stv_charging_status"
        android:background="@drawable/search_btn_go_here_selector_day"
        android:focusable="false"
        android:layout_width="@dimen/auto_dimen2_84"
        android:layout_height="@dimen/auto_dimen2_40"
        app:background4Night="@drawable/custom_btn_major_night_bg_selector"
        app:background4Skin="@drawable/search_btn_go_here_selector_day"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/byd_search_result_go_here_night"
        app:textColor4Skin="@color/byd_search_result_go_here_day"/>
    <com.autonavi.view.custom.CustomListLineView
        android:layout_width="match_parent"
        android:layout_height="@dimen/auto_dimen2_1"
        android:layout_marginTop="@dimen/auto_dimen2_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stv_charging_type"/>
</androidx.constraintlayout.widget.ConstraintLayout>
