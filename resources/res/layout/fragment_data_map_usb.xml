<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_data_home"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinConstraintLayout
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/style_setting_bg">
        <com.autonavi.auto.common.view.AutoGuideLine
            android:orientation="vertical"
            android:id="@+id/gl_data_map"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="1"
            app:layout_constraintGuide_percent4Landscape="1"
            app:layout_constraintGuide_percent4LandscapeWide="0.8"/>
        <com.autonavi.skin.view.SkinTextView
            android:id="@+id/cc_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/gl_data_map"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/scl_title_bar"
            android:layout_width="0dp"
            android:layout_height="@dimen/auto_dimen2_60"
            app:layout_constraintEnd_toEndOf="@+id/cc_bg"
            app:layout_constraintStart_toStartOf="@+id/cc_bg"
            app:layout_constraintTop_toTopOf="@+id/cc_bg">
            <com.autonavi.view.custom.CustomListPressedView
                android:id="@+id/clp_back_hotspot"
                android:layout_width="@dimen/auto_dimen2_48"
                android:layout_height="@dimen/auto_dimen2_48"
                android:layout_marginTop="@dimen/auto_dimen2_12"
                android:contentDescription="返回"
                android:layout_marginStart="@dimen/auto_dimen2_28"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/siv_back"
                android:background="@drawable/icon_setting_back_land_day"
                android:layout_width="@dimen/auto_dimen2_48"
                android:layout_height="@dimen/auto_dimen2_48"
                app:background4Night="@drawable/icon_setting_back_land_night"
                app:background4Skin="@drawable/icon_setting_back_land_day"
                app:layout_constraintBottom_toBottomOf="@+id/clp_back_hotspot"
                app:layout_constraintEnd_toEndOf="@+id/clp_back_hotspot"
                app:layout_constraintStart_toStartOf="@+id/clp_back_hotspot"
                app:layout_constraintTop_toTopOf="@+id/clp_back_hotspot"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_20"
                android:textColor="@color/custom_text_day_color_85"
                android:gravity="center"
                android:id="@+id/stv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auto_dimen2_12"
                android:text="@string/u_update"
                android:lineSpacingExtra="@dimen/auto_dimen2_4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/siv_back"
                app:layout_constraintTop_toTopOf="parent"
                app:textColor4Night="@color/custom_text_night_color_85"
                app:textColor4Skin="@color/custom_text_day_color_85"/>
            <com.autonavi.skin.view.SkinConstraintLayout
                android:id="@+id/stv_text_update"
                android:background="@drawable/custom_list_pressed_list_day_bg_selector"
                android:visibility="visible"
                android:layout_width="@dimen/auto_dimen2_132"
                android:layout_height="@dimen/auto_dimen2_48"
                android:layout_marginEnd="@dimen/auto_dimen2_29"
                app:background4Night="@drawable/custom_list_pressed_list_night_bg_selector"
                app:background4Skin="@drawable/custom_list_pressed_list_day_bg_selector"
                app:layout_constraintBottom_toBottomOf="@+id/siv_back"
                app:layout_constraintEnd_toEndOf="parent">
                <com.autonavi.skin.view.SkinImageView
                    android:id="@+id/stv_text_update_icon"
                    android:background="@drawable/data_map_help_day_bg"
                    android:visibility="visible"
                    android:layout_width="@dimen/auto_dimen2_48"
                    android:layout_height="@dimen/auto_dimen2_48"
                    app:background4Night="@drawable/data_map_help_night_bg"
                    app:background4Skin="@drawable/data_map_help_day_bg"
                    app:layout_constraintBottom_toBottomOf="@+id/stv_text_update"
                    app:layout_constraintEnd_toStartOf="@+id/stv_text_update_text"
                    app:layout_constraintTop_toTopOf="@+id/stv_text_update"/>
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_18"
                    android:textColor="@color/custom_text_day_color_85"
                    android:id="@+id/stv_text_update_text"
                    android:paddingTop="@dimen/auto_dimen2_8"
                    android:paddingBottom="@dimen/auto_dimen2_8"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/u_update_help"
                    android:lineSpacingExtra="@dimen/auto_dimen2_4"
                    android:layout_marginEnd="@dimen/auto_dimen2_10"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:textColor4Night="@color/custom_text_night_color_85"
                    app:textColor4Skin="@color/custom_text_day_color_85"/>
            </com.autonavi.skin.view.SkinConstraintLayout>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinEditText
            android:textSize="@dimen/auto_font_size_18"
            android:textColor="@color/custom_text_day_color_70"
            android:textColorHint="@color/custom_text_day_color_70"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/set_search_city"
            android:background="@drawable/offline_map_search_input_background_day"
            android:layout_width="0dp"
            android:layout_height="@dimen/auto_dimen2_48"
            android:layout_marginTop="@dimen/auto_dimen2_24"
            android:text="@string/null_text"
            android:hint="@string/offline_map_search_input_hint"
            android:singleLine="true"
            android:maxLength="20"
            android:lineSpacingExtra="@dimen/auto_dimen2_4"
            android:contentDescription="搜索"
            android:textCursorDrawable="@drawable/search_around_category_search_around_cursor_drawable"
            android:paddingStart="@dimen/auto_dimen2_60"
            android:layout_marginStart="@dimen/auto_dimen2_24"
            android:layout_marginEnd="@dimen/auto_dimen2_24"
            app:background4Night="@drawable/offline_map_search_input_background_night"
            app:background4Skin="@drawable/offline_map_search_input_background_day"
            app:layout_constraintEnd_toEndOf="@+id/cc_bg"
            app:layout_constraintStart_toStartOf="@+id/cc_bg"
            app:layout_constraintTop_toBottomOf="@+id/scl_title_bar"
            app:textColor4Night="@color/custom_text_night_color_70"
            app:textColor4Skin="@color/custom_text_day_color_70"
            app:textColorHint4Night="@color/custom_text_night_color_70"
            app:textColorHint4Skin="@color/custom_text_day_color_70"/>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/cl_input_right"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/set_search_city"
            app:layout_constraintEnd_toEndOf="@+id/set_search_city"
            app:layout_constraintTop_toTopOf="@+id/set_search_city"
            app:tag="DisableAtRunTime">
            <com.autonavi.skin.view.SkinConstraintLayout
                android:id="@+id/cl_search_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/auto_dimen2_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/stv_line"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.autonavi.view.custom.CustomListPressedView
                    android:id="@+id/clp_search_delete_hotspot"
                    android:visibility="invisible"
                    android:layout_width="@dimen/auto_dimen2_48"
                    android:layout_height="@dimen/auto_dimen2_48"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.autonavi.skin.view.SkinImageView
                    android:id="@+id/siv_search_delete"
                    android:background="@drawable/search_common_tips_clear"
                    android:layout_width="@dimen/auto_dimen2_48"
                    android:layout_height="@dimen/auto_dimen2_48"
                    android:contentDescription="删除"
                    app:background4Night="@drawable/search_common_tips_clear_night"
                    app:background4Skin="@drawable/search_common_tips_clear"
                    app:layout_constraintBottom_toBottomOf="@+id/clp_search_delete_hotspot"
                    app:layout_constraintEnd_toEndOf="@+id/clp_search_delete_hotspot"
                    app:layout_constraintStart_toStartOf="@+id/clp_search_delete_hotspot"
                    app:layout_constraintTop_toTopOf="@+id/clp_search_delete_hotspot"/>
            </com.autonavi.skin.view.SkinConstraintLayout>
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/stv_line"
                android:background="@color/auto_color_D2DFE8"
                android:visibility="gone"
                android:layout_width="@dimen/auto_dimen2_1"
                android:layout_height="@dimen/auto_dimen2_28"
                android:layout_marginEnd="@dimen/auto_dimen2_20"
                app:background4Night="@color/auto_color_365173"
                app:background4Skin="@color/auto_color_D2DFE8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/stv_search"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_dimen2_22"
                android:textColor="@color/auto_color_24313F"
                android:textColorHint="@color/auto_color_86909B"
                android:gravity="center"
                android:id="@+id/stv_search"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginRight="@dimen/auto_dimen2_28"
                android:minWidth="@dimen/auto_dimen2_34"
                android:hint="@string/offline_map_search"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:textColor4Night="@color/auto_color_EBF4FE"
                app:textColor4Skin="@color/auto_color_24313F"/>
            <com.autonavi.view.custom.CustomLoadingSmallView
                android:id="@+id/cls_loading_small"
                android:visibility="gone"
                android:layout_width="@dimen/auto_dimen2_28"
                android:layout_height="@dimen/auto_dimen2_28"
                android:layout_marginRight="@dimen/auto_dimen2_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/siv_search"
            android:background="@drawable/icon_search_day_bg"
            android:layout_width="@dimen/auto_dimen2_48"
            android:layout_height="@dimen/auto_dimen2_48"
            android:layout_marginLeft="@dimen/auto_dimen2_8"
            app:background4Night="@drawable/icon_search_night_bg"
            app:background4Skin="@drawable/icon_search_day_bg"
            app:layout_constraintBottom_toBottomOf="@+id/set_search_city"
            app:layout_constraintStart_toStartOf="@+id/set_search_city"
            app:layout_constraintTop_toTopOf="@+id/set_search_city"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_search_input"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="set_search_city,set_search_city,siv_search,cl_input_right"/>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/cl_custom_default_empty"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/cc_bg"
            app:layout_constraintEnd_toEndOf="@+id/cc_bg"
            app:layout_constraintStart_toStartOf="@+id/cc_bg"
            app:layout_constraintTop_toBottomOf="@+id/set_search_city">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_20"
                android:textColor="@color/custom_text_day_color_100"
                android:id="@+id/stv_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_usb_detect_check"
                app:layout_constraintBottom_toTopOf="@+id/stv_empty_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:textColor4Night="@color/custom_text_night_color_100"
                app:textColor4Skin="@color/custom_text_day_color_100"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_16"
                android:textColor="@color/custom_text_day_color_55"
                android:gravity="center_vertical"
                android:id="@+id/stv_empty_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auto_dimen2_12"
                android:minHeight="@dimen/auto_dimen2_28"
                android:text="@string/go_download_gd"
                app:layout_constraintBottom_toTopOf="@+id/sbtn_reget_data"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/stv_empty_title"
                app:layout_constraintVertical_chainStyle="packed"
                app:textColor4Night="@color/custom_text_night_color_55"
                app:textColor4Skin="@color/custom_text_day_color_55"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/byd_custom_highlight_btn_text_color_selector_day"
                android:gravity="center"
                android:id="@+id/sbtn_reget_data"
                android:background="@drawable/byd_custom_highlight_btn_bg_selector_day"
                android:layout_width="@dimen/auto_dimen2_200"
                android:layout_height="@dimen/auto_dimen2_48"
                android:layout_marginBottom="@dimen/auto_dimen2_166"
                android:text="@string/reusb"
                app:background4Night="@drawable/byd_custom_highlight_btn_bg_selector_night"
                app:background4Skin="@drawable/byd_custom_highlight_btn_bg_selector_day"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:textColor4Night="@color/byd_custom_highlight_btn_text_color_selector_night"
                app:textColor4Skin="@color/byd_custom_highlight_btn_text_color_selector_day"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/siv_search_empty"
            android:background="@drawable/offline_map_no_data_day"
            android:visibility="visible"
            android:layout_width="@dimen/auto_dimen2_120"
            android:layout_height="@dimen/auto_dimen2_120"
            app:background4Night="@drawable/offline_map_no_data_night"
            app:background4Skin="@drawable/offline_map_no_data_day"
            app:layout_constraintBottom_toBottomOf="@+id/cc_bg"
            app:layout_constraintEnd_toEndOf="@+id/cc_bg"
            app:layout_constraintStart_toStartOf="@+id/cc_bg"
            app:layout_constraintTop_toTopOf="@+id/cc_bg"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_28"
            android:textColor="@color/custom_text_day_color_55"
            android:gravity="center_vertical"
            android:id="@+id/stv_no_data_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_20"
            android:minHeight="@dimen/auto_font_size_34"
            android:text="@string/offline_map_no_data"
            app:layout_constraintEnd_toEndOf="@+id/cc_bg"
            app:layout_constraintStart_toStartOf="@+id/cc_bg"
            app:layout_constraintTop_toBottomOf="@+id/siv_search_empty"
            app:textColor4Night="@color/custom_text_night_color_55"
            app:textColor4Skin="@color/custom_text_day_color_55"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_search_no_data_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="siv_search_empty, stv_no_data_tip"/>
        <com.autonavi.skin.view.SkinProgressBar
            android:id="@+id/cl_custom_progress"
            android:visibility="visible"
            android:layout_width="@dimen/auto_dimen2_64"
            android:layout_height="@dimen/auto_dimen2_64"
            android:indeterminateDrawable="@drawable/frame_animation_animation_list_loading_small"
            app:layout_constraintBottom_toBottomOf="@+id/cc_bg"
            app:layout_constraintEnd_toEndOf="@+id/cc_bg"
            app:layout_constraintStart_toStartOf="@+id/cc_bg"
            app:layout_constraintTop_toTopOf="@+id/scl_title_bar"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_24"
            android:textColor="@color/custom_text_day_color_55"
            android:gravity="center_vertical"
            android:id="@+id/stv_progress_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_20"
            android:minHeight="@dimen/auto_font_size_34"
            android:text="@string/base_map_loading"
            app:layout_constraintEnd_toEndOf="@+id/cc_bg"
            app:layout_constraintStart_toStartOf="@+id/cc_bg"
            app:layout_constraintTop_toBottomOf="@+id/cl_custom_progress"
            app:textColor4Night="@color/custom_text_night_color_55"
            app:textColor4Skin="@color/custom_text_day_color_55"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_progress_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="cl_custom_progress, stv_progress_tip"/>
        <com.autonavi.skin.view.SkinExpandableListView
            android:id="@+id/elv_city_data_map"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/auto_dimen2_148"
            android:listSelector="@drawable/offline_map_expandlistview_selector"
            android:groupIndicator="@null"
            android:childIndicator="@null"
            android:childDivider="@null"
            android:divider="@null"
            android:headerDividersEnabled="false"
            android:contentDescription="U盘更新列表|纵向"
            app:layout_constraintBottom_toBottomOf="@+id/cc_bg"
            app:layout_constraintEnd_toEndOf="@+id/set_search_city"
            app:layout_constraintStart_toStartOf="@+id/set_search_city"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
