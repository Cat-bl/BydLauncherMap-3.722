<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/widget_set_parent"
    android:focusable="true"
    android:clickable="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:elevation="@dimen/auto_dimen2_10">
    <com.autonavi.skin.view.SkinRelativeLayout style="@style/style_setting_bg_half">
        <com.autonavi.skin.view.SkinLinearLayout
            android:id="@+id/top_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/user_tittle_layout_1_2"/>
        </com.autonavi.skin.view.SkinLinearLayout>
        <com.autonavi.skin.view.SkinRelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_80"
            android:layout_below="@+id/top_bar_layout">
            <com.autonavi.skin.view.SkinRelativeLayout
                android:id="@+id/qr_layout"
                android:background="@drawable/refresh_code_bg_day"
                android:layout_width="@dimen/auto_dimen2_160"
                android:layout_height="@dimen/auto_dimen2_160"
                android:layout_centerHorizontal="true"
                app:background4Night="@drawable/refresh_code_bg"
                app:background4Skin="@drawable/refresh_code_bg_day">
                <com.autonavi.skin.view.SkinRelativeLayout
                    android:gravity="center"
                    android:id="@+id/clsv_qr_loading_"
                    android:background="@drawable/byd_custom_qrcode_background_day"
                    android:visibility="visible"
                    android:layout_width="@dimen/auto_dimen2_160"
                    android:layout_height="@dimen/auto_dimen2_160"
                    android:layout_centerInParent="true"
                    app:background4Night="@drawable/byd_custom_qrcode_background_night"
                    app:background4Skin="@drawable/byd_custom_qrcode_background_day">
                    <com.autonavi.view.custom.CustomLoadingSmallView
                        android:id="@+id/clsv_qr_loading"
                        android:visibility="invisible"
                        android:layout_width="@dimen/auto_dimen2_60"
                        android:layout_height="@dimen/auto_dimen2_60"
                        android:layout_centerInParent="true"/>
                </com.autonavi.skin.view.SkinRelativeLayout>
                <com.autonavi.skin.view.SkinImageView
                    android:id="@+id/img_code"
                    android:layout_width="@dimen/auto_dimen2_160"
                    android:layout_height="@dimen/auto_dimen2_160"
                    android:scaleType="fitXY"
                    android:layout_centerHorizontal="true"/>
                <com.autonavi.skin.view.SkinRelativeLayout
                    android:gravity="center"
                    android:id="@+id/img_code_time_out"
                    android:background="@drawable/byd_custom_qrcode_background_day"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    app:background4Night="@drawable/byd_custom_qrcode_background_night"
                    app:background4Skin="@drawable/byd_custom_qrcode_background_day">
                    <com.autonavi.skin.view.SkinImageView
                        android:id="@+id/img_code_refresh"
                        android:layout_width="@dimen/auto_dimen2_72"
                        android:layout_height="@dimen/auto_dimen2_72"
                        android:src="@drawable/refresh_code_day"
                        android:scaleType="fitXY"
                        android:layout_centerHorizontal="true"
                        app:src4Night="@drawable/refresh_code_night"
                        app:src4Skin="@drawable/refresh_code_day"/>
                </com.autonavi.skin.view.SkinRelativeLayout>
            </com.autonavi.skin.view.SkinRelativeLayout>
            <com.autonavi.skin.view.SkinLinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auto_dimen2_40"
                android:layout_below="@+id/qr_layout"
                android:layout_centerHorizontal="true">
                <com.autonavi.skin.view.SkinLinearLayout
                    android:orientation="vertical"
                    android:id="@+id/qr_code_tip_success_layout"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.autonavi.skin.view.SkinTextView
                        android:textSize="@dimen/auto_font_size_20"
                        android:textColor="@color/custom_text_day_color_100"
                        android:id="@+id/tips_first_step"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/auto_font_size_32"
                        android:text="@string/user_login_tip1"
                        app:textColor4Night="@color/custom_text_night_color_100"
                        app:textColor4Skin="@color/custom_text_day_color_100"/>
                    <com.autonavi.skin.view.SkinTextView
                        android:textSize="@dimen/auto_font_size_16"
                        android:textColor="@color/custom_text_day_color_55"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/auto_font_size_28"
                        android:text="@string/user_login_tip1_hint"
                        android:layout_marginStart="@dimen/auto_dimen2_16"
                        app:textColor4Night="@color/custom_text_night_color_55"
                        app:textColor4Skin="@color/custom_text_day_color_55"/>
                    <com.autonavi.skin.view.SkinTextView
                        android:textSize="@dimen/auto_font_size_20"
                        android:textColor="@color/custom_text_day_color_100"
                        android:gravity="center"
                        android:id="@+id/tips_second_step"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/auto_font_size_32"
                        android:layout_marginTop="@dimen/auto_dimen2_20"
                        android:text="@string/user_login_tip2"
                        app:textColor4Night="@color/custom_text_night_color"
                        app:textColor4Skin="@color/custom_text_day_color_100"/>
                    <com.autonavi.skin.view.SkinTextView
                        android:textSize="@dimen/auto_font_size_16"
                        android:textColor="@color/custom_text_day_color_55"
                        android:gravity="center"
                        android:id="@+id/tips_second_step_tip"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/auto_font_size_28"
                        android:text="@string/user_login_tip2_hint"
                        android:layout_marginStart="@dimen/auto_dimen2_16"
                        app:textColor4Night="@color/custom_text_night_color_55"
                        app:textColor4Skin="@color/custom_text_day_color_55"/>
                </com.autonavi.skin.view.SkinLinearLayout>
                <com.autonavi.skin.view.SkinLinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/qr_code_tip_expired_layout"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.autonavi.skin.view.SkinTextView
                        android:textSize="@dimen/auto_font_size_20"
                        android:textColor="@color/custom_text_day_color_100"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/auto_font_size_32"
                        android:text="@string/user_login_expired"
                        app:textColor4Night="@color/custom_text_night_color_100"
                        app:textColor4Skin="@color/custom_text_day_color_100"/>
                    <com.autonavi.skin.view.SkinTextView
                        android:textSize="@dimen/auto_font_size_16"
                        android:textColor="@color/custom_text_day_color_55"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/auto_font_size_28"
                        android:text="@string/user_login_fail_hint"
                        app:textColor4Night="@color/custom_text_night_color_55"
                        app:textColor4Skin="@color/custom_text_day_color_55"/>
                </com.autonavi.skin.view.SkinLinearLayout>
                <com.autonavi.skin.view.SkinLinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/qr_code_tip_failed_layout"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.autonavi.skin.view.SkinTextView
                        android:textSize="@dimen/auto_font_size_20"
                        android:textColor="@color/custom_text_day_color_100"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/auto_font_size_32"
                        android:text="@string/user_login_fail"
                        app:textColor4Night="@color/custom_text_night_color_100"
                        app:textColor4Skin="@color/custom_text_day_color_100"/>
                    <com.autonavi.skin.view.SkinTextView
                        android:textSize="@dimen/auto_font_size_16"
                        android:textColor="@color/custom_text_day_color_55"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/auto_font_size_28"
                        android:text="@string/user_login_fail_tip"
                        app:textColor4Night="@color/custom_text_night_color_55"
                        app:textColor4Skin="@color/custom_text_day_color_55"/>
                </com.autonavi.skin.view.SkinLinearLayout>
            </com.autonavi.skin.view.SkinLinearLayout>
        </com.autonavi.skin.view.SkinRelativeLayout>
        <com.autonavi.skin.view.SkinLinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/auto_dimen2_100"
            android:layout_alignParentBottom="true">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/byd_custom_highlight_btn_text_color_selector_day"
                android:gravity="center"
                android:id="@+id/txt_login_verification"
                android:background="@drawable/byd_custom_highlight_btn_bg_selector_day"
                android:layout_width="@dimen/auto_dimen2_200"
                android:layout_height="@dimen/auto_dimen2_48"
                android:text="@string/user_login_type_pic"
                android:layout_marginEnd="@dimen/auto_dimen2_24"
                app:background4Night="@drawable/byd_custom_highlight_btn_bg_selector_night"
                app:background4Skin="@drawable/byd_custom_highlight_btn_bg_selector_day"
                app:textColor4Night="@color/byd_custom_highlight_btn_text_color_selector_night"
                app:textColor4Skin="@color/byd_custom_highlight_btn_text_color_selector_day"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/byd_custom_highlight_btn_text_color_selector_day"
                android:gravity="center"
                android:id="@+id/txt_register"
                android:background="@drawable/byd_custom_highlight_btn_bg_selector_day"
                android:layout_width="@dimen/auto_dimen2_200"
                android:layout_height="@dimen/auto_dimen2_48"
                android:text="@string/user_login_register"
                android:layout_marginStart="@dimen/auto_dimen2_24"
                app:background4Night="@drawable/byd_custom_highlight_btn_bg_selector_night"
                app:background4Skin="@drawable/byd_custom_highlight_btn_bg_selector_day"
                app:textColor4Night="@color/byd_custom_highlight_btn_text_color_selector_night"
                app:textColor4Skin="@color/byd_custom_highlight_btn_text_color_selector_day"/>
        </com.autonavi.skin.view.SkinLinearLayout>
    </com.autonavi.skin.view.SkinRelativeLayout>
</com.autonavi.skin.view.SkinRelativeLayout>
