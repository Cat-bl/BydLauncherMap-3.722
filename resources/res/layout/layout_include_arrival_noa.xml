<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/scl_arrival_content_noa"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scl_driver_info">
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/ic_nao_title"
            android:background="@drawable/icon_navi_arrival_noa"
            android:layout_width="@dimen/auto_dimen2_24"
            android:layout_height="@dimen/auto_dimen2_24"
            app:background4Night="@drawable/icon_navi_arrival_noa"
            app:background4Skin="@drawable/icon_navi_arrival_noa"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_20"
            android:textColor="@color/dest_arrival_text_day"
            android:id="@+id/txt_nao_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/navi_arrival_trips_nao_title"
            android:layout_marginStart="@dimen/auto_dimen2_8"
            app:layout_constraintBottom_toBottomOf="@+id/ic_nao_title"
            app:layout_constraintStart_toEndOf="@+id/ic_nao_title"
            app:layout_constraintTop_toTopOf="@+id/ic_nao_title"
            app:textColor4Night="@color/dest_arrival_text_night"
            app:textColor4Skin="@color/dest_arrival_text_day"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_22"
            android:textColor="@color/dest_arrival_text_day"
            android:id="@+id/total_noa_mileage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_10"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="@+id/ic_nao_title"
            app:layout_constraintTop_toBottomOf="@+id/ic_nao_title"
            app:textColor4Night="@color/dest_arrival_text_night"
            app:textColor4Skin="@color/dest_arrival_text_day"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_16"
            android:textColor="@color/arrival_end_second_text_color_day"
            android:id="@+id/total_noa_mileage_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_trip_km_unit"
            android:layout_marginStart="@dimen/auto_dimen2_2"
            app:layout_constraintBaseline_toBaselineOf="@+id/total_noa_mileage"
            app:layout_constraintEnd_toEndOf="@+id/center_line"
            app:layout_constraintStart_toEndOf="@+id/total_noa_mileage"
            app:textColor4Night="@color/arrival_end_second_text_color_night"
            app:textColor4Skin="@color/arrival_end_second_text_color_day"/>
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/ic_noa_mileage"
            android:background="@drawable/icon_navi_arrival_noa_distance"
            android:layout_width="@dimen/auto_dimen2_24"
            android:layout_height="@dimen/auto_dimen2_24"
            android:layout_marginTop="@dimen/auto_dimen2_0"
            app:background4Night="@drawable/icon_navi_arrival_noa_distance"
            app:background4Skin="@drawable/icon_navi_arrival_noa_distance"
            app:layout_constraintStart_toStartOf="@+id/ic_nao_title"
            app:layout_constraintTop_toBottomOf="@+id/total_noa_mileage"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_16"
            android:textColor="@color/dest_arrival_text_day"
            android:id="@+id/noa_distance_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trip_noa_distance"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/ic_noa_mileage"
            app:layout_constraintStart_toEndOf="@+id/ic_noa_mileage"
            app:layout_constraintTop_toTopOf="@+id/ic_noa_mileage"
            app:textColor4Night="@color/dest_arrival_text_night"
            app:textColor4Skin="@color/dest_arrival_text_day"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_22"
            android:textColor="@color/dest_arrival_text_day"
            android:id="@+id/total_noa_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/total_noa_mileage"
            app:textColor4Night="@color/dest_arrival_text_night"
            app:textColor4Skin="@color/dest_arrival_text_day"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_16"
            android:textColor="@color/arrival_end_second_text_color_day"
            android:id="@+id/total_noa_percent_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/noa_percent_unit"
            android:layout_marginStart="@dimen/auto_dimen2_2"
            app:layout_constraintBaseline_toBaselineOf="@+id/total_noa_percent"
            app:layout_constraintEnd_toEndOf="@+id/center_line"
            app:layout_constraintStart_toEndOf="@+id/total_noa_percent"
            app:textColor4Night="@color/arrival_end_second_text_color_night"
            app:textColor4Skin="@color/arrival_end_second_text_color_day"/>
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/ic_noa_percent"
            android:background="@drawable/icon_navi_arrival_noa_percent"
            android:layout_width="@dimen/auto_dimen2_24"
            android:layout_height="@dimen/auto_dimen2_24"
            android:layout_marginTop="@dimen/auto_dimen2_0"
            app:background4Night="@drawable/icon_navi_arrival_noa_percent"
            app:background4Skin="@drawable/icon_navi_arrival_noa_percent"
            app:layout_constraintStart_toStartOf="@+id/total_noa_percent"
            app:layout_constraintTop_toBottomOf="@+id/total_noa_percent"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_16"
            android:textColor="@color/dest_arrival_text_day"
            android:id="@+id/noa_percent_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trip_noa_percent"
            android:layout_marginStart="@dimen/auto_dimen2_4"
            app:layout_constraintBottom_toBottomOf="@+id/ic_noa_percent"
            app:layout_constraintStart_toEndOf="@+id/ic_noa_percent"
            app:layout_constraintTop_toTopOf="@+id/ic_noa_percent"
            app:textColor4Night="@color/dest_arrival_text_night"
            app:textColor4Skin="@color/dest_arrival_text_day"/>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/scl_noa_action1"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_10"
            app:layout_constraintStart_toStartOf="@+id/ic_nao_title"
            app:layout_constraintTop_toBottomOf="@+id/ic_noa_mileage">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_22"
                android:textColor="@color/dest_arrival_text_day"
                android:id="@+id/noa_lane_change_times"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:textColor4Night="@color/dest_arrival_text_night"
                app:textColor4Skin="@color/dest_arrival_text_day"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_16"
                android:textColor="@color/arrival_end_second_text_color_day"
                android:id="@+id/noa_times1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/times"
                android:layout_marginStart="@dimen/auto_dimen2_2"
                app:layout_constraintBaseline_toBaselineOf="@+id/noa_lane_change_times"
                app:layout_constraintStart_toEndOf="@+id/noa_lane_change_times"
                app:textColor4Night="@color/arrival_end_second_text_color_night"
                app:textColor4Skin="@color/arrival_end_second_text_color_day"/>
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/ic_noa_lane_change"
                android:layout_width="@dimen/auto_dimen2_24"
                android:layout_height="@dimen/auto_dimen2_24"
                android:layout_marginTop="@dimen/auto_dimen2_0"
                app:layout_constraintStart_toStartOf="@+id/noa_lane_change_times"
                app:layout_constraintTop_toBottomOf="@+id/noa_lane_change_times"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_16"
                android:textColor="@color/dest_arrival_text_day"
                android:id="@+id/noa_lane_change_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trip_noa_lane_change_times"
                android:layout_marginStart="@dimen/auto_dimen2_4"
                app:layout_constraintBottom_toBottomOf="@+id/ic_noa_lane_change"
                app:layout_constraintStart_toEndOf="@+id/ic_noa_lane_change"
                app:layout_constraintTop_toTopOf="@+id/ic_noa_lane_change"
                app:textColor4Night="@color/dest_arrival_text_night"
                app:textColor4Skin="@color/dest_arrival_text_day"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/scl_noa_action2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_10"
            app:layout_constraintStart_toStartOf="@+id/ic_noa_percent"
            app:layout_constraintTop_toBottomOf="@+id/ic_noa_percent">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_22"
                android:textColor="@color/dest_arrival_text_day"
                android:id="@+id/noa_avoid_times"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="@+id/total_noa_percent"
                app:layout_constraintTop_toTopOf="@+id/noa_lane_change_times"
                app:textColor4Night="@color/dest_arrival_text_night"
                app:textColor4Skin="@color/dest_arrival_text_day"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_16"
                android:textColor="@color/arrival_end_second_text_color_day"
                android:id="@+id/noa_times2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/times"
                android:layout_marginStart="@dimen/auto_dimen2_2"
                app:layout_constraintBaseline_toBaselineOf="@+id/noa_avoid_times"
                app:layout_constraintStart_toEndOf="@+id/noa_avoid_times"
                app:textColor4Night="@color/arrival_end_second_text_color_night"
                app:textColor4Skin="@color/arrival_end_second_text_color_day"/>
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/ic_noa_avoid"
                android:layout_width="@dimen/auto_dimen2_24"
                android:layout_height="@dimen/auto_dimen2_24"
                android:layout_marginTop="@dimen/auto_dimen2_0"
                app:layout_constraintStart_toStartOf="@+id/noa_avoid_times"
                app:layout_constraintTop_toBottomOf="@+id/noa_avoid_times"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_16"
                android:textColor="@color/dest_arrival_text_day"
                android:id="@+id/noa_avoid_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trip_noa_avoid_times"
                android:layout_marginStart="@dimen/auto_dimen2_4"
                app:layout_constraintBottom_toBottomOf="@+id/ic_noa_avoid"
                app:layout_constraintStart_toEndOf="@+id/ic_noa_avoid"
                app:layout_constraintTop_toTopOf="@+id/ic_noa_avoid"
                app:textColor4Night="@color/dest_arrival_text_night"
                app:textColor4Skin="@color/dest_arrival_text_day"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/scl_noa_action3"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_10"
            app:layout_constraintStart_toStartOf="@+id/scl_noa_action1"
            app:layout_constraintTop_toBottomOf="@+id/scl_noa_action1">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_22"
                android:textColor="@color/dest_arrival_text_day"
                android:id="@+id/noa_title_times3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="@+id/ic_nao_title"
                app:layout_constraintTop_toTopOf="parent"
                app:textColor4Night="@color/dest_arrival_text_night"
                app:textColor4Skin="@color/dest_arrival_text_day"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_16"
                android:textColor="@color/arrival_end_second_text_color_day"
                android:id="@+id/noa_times3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/times"
                android:layout_marginStart="@dimen/auto_dimen2_2"
                app:layout_constraintBaseline_toBaselineOf="@+id/noa_title_times3"
                app:layout_constraintStart_toEndOf="@+id/noa_title_times3"
                app:textColor4Night="@color/arrival_end_second_text_color_night"
                app:textColor4Skin="@color/arrival_end_second_text_color_day"/>
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/ic_noa_icon3"
                android:layout_width="@dimen/auto_dimen2_24"
                android:layout_height="@dimen/auto_dimen2_24"
                android:layout_marginTop="@dimen/auto_dimen2_0"
                app:layout_constraintStart_toStartOf="@+id/noa_title_times3"
                app:layout_constraintTop_toBottomOf="@+id/noa_title_times3"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_16"
                android:textColor="@color/dest_arrival_text_day"
                android:id="@+id/noa_desc3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trip_noa_lane_change_times"
                android:layout_marginStart="@dimen/auto_dimen2_4"
                app:layout_constraintBottom_toBottomOf="@+id/ic_noa_icon3"
                app:layout_constraintStart_toEndOf="@+id/ic_noa_icon3"
                app:layout_constraintTop_toTopOf="@+id/ic_noa_icon3"
                app:textColor4Night="@color/dest_arrival_text_night"
                app:textColor4Skin="@color/dest_arrival_text_day"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/scl_noa_action4"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_10"
            app:layout_constraintStart_toStartOf="@+id/scl_noa_action2"
            app:layout_constraintTop_toBottomOf="@+id/scl_noa_action2">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_22"
                android:textColor="@color/dest_arrival_text_day"
                android:id="@+id/noa_title_times4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="@+id/noa_avoid_times"
                app:layout_constraintTop_toTopOf="@+id/noa_title_times3"
                app:textColor4Night="@color/dest_arrival_text_night"
                app:textColor4Skin="@color/dest_arrival_text_day"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_16"
                android:textColor="@color/arrival_end_second_text_color_day"
                android:id="@+id/noa_times4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/times"
                android:layout_marginStart="@dimen/auto_dimen2_2"
                app:layout_constraintBaseline_toBaselineOf="@+id/noa_title_times4"
                app:layout_constraintStart_toEndOf="@+id/noa_title_times4"
                app:textColor4Night="@color/arrival_end_second_text_color_night"
                app:textColor4Skin="@color/arrival_end_second_text_color_day"/>
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/ic_noa_icon4"
                android:layout_width="@dimen/auto_dimen2_24"
                android:layout_height="@dimen/auto_dimen2_24"
                android:layout_marginTop="@dimen/auto_dimen2_0"
                app:layout_constraintStart_toStartOf="@+id/noa_title_times4"
                app:layout_constraintTop_toBottomOf="@+id/noa_title_times4"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_16"
                android:textColor="@color/dest_arrival_text_day"
                android:id="@+id/noa_desc4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trip_noa_avoid_times"
                android:layout_marginStart="@dimen/auto_dimen2_4"
                app:layout_constraintBottom_toBottomOf="@+id/ic_noa_icon4"
                app:layout_constraintStart_toEndOf="@+id/ic_noa_icon4"
                app:layout_constraintTop_toTopOf="@+id/ic_noa_icon4"
                app:textColor4Night="@color/dest_arrival_text_night"
                app:textColor4Skin="@color/dest_arrival_text_day"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
    </com.autonavi.skin.view.SkinConstraintLayout>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/dest_arrival_ok_text_day"
        android:gravity="center"
        android:id="@+id/btn_upload_share"
        android:background="@drawable/custom_btn_major_day_bg_selector"
        android:visibility="visible"
        android:layout_width="@dimen/auto_dimen2_332"
        android:layout_height="@dimen/auto_dimen2_40"
        android:layout_marginTop="@dimen/auto_dimen2_12"
        android:text="@string/navi_arrive_noa_share_report"
        app:background4Night="@drawable/custom_btn_major_night_bg_selector"
        app:background4Skin="@drawable/custom_btn_major_day_bg_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scl_arrival_content_noa"
        app:textColor4Night="@color/dest_arrival_ok_text_night"
        app:textColor4Skin="@color/dest_arrival_ok_text_day"/>
</com.autonavi.skin.view.SkinConstraintLayout>
