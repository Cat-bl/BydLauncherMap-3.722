<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_custom_download_percent_bar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinProgressBar
        android:id="@+id/spb_download"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:max="100"
        android:progress="0"
        android:indeterminateOnly="false"
        android:progressDrawable="@drawable/byd_custom_bar_downloading1_loading2_day_layerlist_fui"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:progressDrawable4Night="@drawable/byd_custom_bar_downloading1_loading2_night_layerlist_fui"
        app:progressDrawable4Skin="@drawable/byd_custom_bar_downloading1_loading2_day_layerlist_fui"
        style="?android:attr/progressBarStyleHorizontal"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_download_status"
        android:layout_width="@dimen/auto_dimen2_26"
        android:layout_height="@dimen/auto_dimen2_26"
        android:layout_marginEnd="@dimen/auto_dimen2_2"
        app:layout_constraintBottom_toBottomOf="@+id/spb_download"
        app:layout_constraintEnd_toStartOf="@+id/stv_download_status"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/spb_download"
        app:layout_constraintTop_toTopOf="@+id/spb_download"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/custom_btn_blue_day_1_color"
        android:gravity="center"
        android:id="@+id/stv_download_status"
        android:layout_width="match_parent"
        android:layout_height="@dimen/auto_dimen2_48"
        android:minHeight="@dimen/auto_dimen2_26"
        android:text="@string/play_download"
        app:layout_constraintBottom_toBottomOf="@+id/spb_download"
        app:layout_constraintEnd_toEndOf="@+id/spb_download"
        app:layout_constraintStart_toEndOf="@+id/siv_download_status"
        app:layout_constraintTop_toTopOf="@+id/spb_download"
        app:textColor4Night="@color/custom_btn_blue_night_1_color"
        app:textColor4Skin="@color/custom_btn_blue_day_1_color"/>
</merge>
