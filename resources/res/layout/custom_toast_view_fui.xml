<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@drawable/toast_bg_fui"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textStyle="bold"
        android:textColor="@color/custom_toast_text_color"
        android:gravity="center_vertical"
        android:id="@+id/custom_toast"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/auto_dimen2_56"
        android:maxWidth="@dimen/auto_dimen2_612"
        android:minWidth="@dimen/auto_dimen2_86"
        android:minHeight="@dimen/auto_dimen2_56"
        android:paddingStart="@dimen/auto_dimen2_43"
        android:paddingEnd="@dimen/auto_dimen2_43"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/custom_toast_text_color"
        app:textColor4Skin="@color/custom_toast_text_color"/>
</com.autonavi.skin.view.SkinConstraintLayout>
