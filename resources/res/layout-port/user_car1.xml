<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_search_home"
    android:background="@drawable/byd_setting_bg_day"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:background4Night="@drawable/byd_setting_bg_night"
    app:background4Skin="@drawable/byd_setting_bg_day"
    app:designHeight="600"
    app:designWidth="1024">
    <include layout="@layout/user_tittle_layout"/>
    <com.autonavi.view.custom.CustomListPressedView
        android:id="@+id/user_car_login_tip_layout_delete"
        android:layout_width="@dimen/auto_dimen2_70"
        android:layout_height="@dimen/auto_dimen2_56"
        android:layout_marginTop="@dimen/auto_dimen2_68"
        android:layout_marginEnd="@dimen/auto_dimen2_40"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:background="@drawable/close_login_tip"
        android:layout_width="@dimen/auto_dimen2_40"
        android:layout_height="@dimen/auto_dimen2_40"
        app:background4Night="@drawable/close_login_tip"
        app:background4Skin="@drawable/close_login_tip"
        app:layout_constraintBottom_toBottomOf="@+id/user_car_login_tip_layout_delete"
        app:layout_constraintEnd_toEndOf="@+id/user_car_login_tip_layout_delete"
        app:layout_constraintStart_toStartOf="@+id/user_car_login_tip_layout_delete"
        app:layout_constraintTop_toTopOf="@+id/user_car_login_tip_layout_delete"/>
    <com.autonavi.skin.view.SkinRelativeLayout
        android:gravity="center"
        android:id="@+id/user_car_login_tip_layout"
        android:background="@drawable/user_account_title_text_day"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/auto_dimen2_48"
        android:layout_marginTop="@dimen/auto_dimen2_68"
        app:background4Night="@drawable/user_account_title_text_night"
        app:background4Skin="@drawable/user_account_title_text_day"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_dimen2_20"
            android:textColor="@color/byd_text_450_1_textcolor_day_selector"
            android:gravity="center_vertical"
            android:id="@+id/user_login_tip_txt"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/auto_dimen2_28"
            android:text="@string/user_car_login_tip"
            app:textColor4Night="@color/text_450_1_textcolor_night_selector"
            app:textColor4Skin="@color/text_450_1_textcolor_day_selector"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_dimen2_20"
            android:textColor="#0478d1"
            android:gravity="center"
            android:id="@+id/user_login_tip_txt_btn"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/auto_dimen2_28"
            android:layout_marginLeft="@dimen/auto_dimen2_5"
            android:text="@string/avatar_login"
            android:layout_toRightOf="@+id/user_login_tip_txt"
            app:textColor4Night="@color/text_450_1_textcolor_night_selector"
            app:textColor4Skin="@color/text_450_1_textcolor_day_selector"/>
    </com.autonavi.skin.view.SkinRelativeLayout>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/auto_dimen2_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/user_car_login_tip_layout">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_dimen2_28"
            android:textColor="@color/byd_text_450_1_textcolor_day_selector"
            android:gravity="center"
            android:id="@+id/plate_num_tittle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_car_plate_num"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/text_450_1_textcolor_night_selector"
            app:textColor4Skin="@color/text_450_1_textcolor_day_selector"/>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/plate_num_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/auto_dimen2_30"
            app:layout_constraintBottom_toBottomOf="@+id/plate_num_tittle"
            app:layout_constraintStart_toEndOf="@+id/plate_num_tittle"
            app:layout_constraintTop_toTopOf="parent">
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/prince_list_show"
                android:background="@drawable/search_home_carry_out_day_bg_selector"
                android:layout_width="@dimen/auto_dimen2_24"
                android:layout_height="@dimen/auto_dimen2_24"
                android:layout_centerVertical="true"
                app:background4Night="@drawable/search_home_carry_out_night_bg_selector"
                app:background4Skin="@drawable/search_home_carry_out_day_bg_selector"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_dimen2_22"
                android:textColor="@color/byd_text_450_1_textcolor_day_selector"
                android:gravity="center"
                android:id="@+id/plate_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/auto_dimen2_20"
                android:text="京"
                android:layout_centerVertical="true"
                app:layout_constraintEnd_toStartOf="@+id/prince_list_show"
                app:layout_constraintTop_toTopOf="parent"
                app:textColor4Night="@color/text_450_1_textcolor_night_selector"
                app:textColor4Skin="@color/text_450_1_textcolor_day_selector"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinView
            android:background="@color/auto_color_ffffff"
            android:layout_width="0dp"
            android:layout_height="1px"
            app:layout_constraintBottom_toBottomOf="@+id/plate_num_layout"
            app:layout_constraintEnd_toEndOf="@+id/plate_num_layout"
            app:layout_constraintStart_toStartOf="@+id/plate_num_layout"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_dimen2_28"
            android:textColor="@color/byd_text_450_1_textcolor_day_selector"
            android:gravity="center"
            android:id="@+id/car_power_type_tittle"
            android:paddingTop="@dimen/auto_dimen2_10"
            android:paddingBottom="@dimen/auto_dimen2_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_20"
            android:text="@string/user_car_power_type"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/plate_num_layout"
            app:textColor4Night="@color/text_450_1_textcolor_night_selector"
            app:textColor4Skin="@color/text_450_1_textcolor_day_selector"/>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/car_power_type_layout"
            android:layout_width="0dp"
            android:layout_height="@dimen/auto_dimen2_44"
            android:layout_marginTop="@dimen/auto_dimen2_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/car_power_type_tittle">
            <RadioGroup
                android:orientation="horizontal"
                android:id="@+id/user_car_Radio_group"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.autonavi.skin.view.SkinRadioButton
                    android:textSize="@dimen/auto_dimen2_18"
                    android:textColor="@color/byd_text_450_1_textcolor_day_selector"
                    android:gravity="center"
                    android:id="@+id/user_car_Radio_oil"
                    android:background="@drawable/check_trans"
                    android:layout_width="@dimen/auto_dimen2_136"
                    android:layout_height="match_parent"
                    android:checked="false"
                    android:button="@null"
                    android:text="@string/user_car_power_type_oil"
                    app:textColor4Night="@color/text_450_1_textcolor_night_selector"
                    app:textColor4Skin="@color/text_450_1_textcolor_day_selector"/>
                <com.autonavi.skin.view.SkinRadioButton
                    android:textSize="@dimen/auto_dimen2_18"
                    android:textColor="@color/byd_text_450_1_textcolor_day_selector"
                    android:gravity="center"
                    android:id="@+id/user_car_Radio_electricity"
                    android:background="@drawable/check_trans"
                    android:layout_width="@dimen/auto_dimen2_136"
                    android:layout_height="match_parent"
                    android:button="@null"
                    android:text="@string/user_car_power_type_electricity"
                    app:textColor4Night="@color/text_450_1_textcolor_night_selector"
                    app:textColor4Skin="@color/text_450_1_textcolor_day_selector"/>
                <com.autonavi.skin.view.SkinRadioButton
                    android:textSize="@dimen/auto_dimen2_18"
                    android:textColor="@color/byd_text_450_1_textcolor_day_selector"
                    android:gravity="center"
                    android:id="@+id/user_car_Radio_mix"
                    android:background="@drawable/check_trans"
                    android:layout_width="@dimen/auto_dimen2_136"
                    android:layout_height="match_parent"
                    android:button="@null"
                    android:text="@string/user_car_power_type_mix"
                    app:textColor4Night="@color/text_450_1_textcolor_night_selector"
                    app:textColor4Skin="@color/text_450_1_textcolor_day_selector"/>
            </RadioGroup>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_dimen2_28"
            android:textColor="@color/byd_text_450_1_textcolor_day_selector"
            android:gravity="center"
            android:id="@+id/car_limit_tittle"
            android:paddingTop="@dimen/auto_dimen2_10"
            android:paddingBottom="@dimen/auto_dimen2_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_20"
            android:text="@string/user_car_avoid_restrictions"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/car_power_type_layout"
            app:textColor4Night="@color/text_450_1_textcolor_night_selector"
            app:textColor4Skin="@color/text_450_1_textcolor_day_selector"/>
        <com.autonavi.skin.view.SkinCheckBox
            android:textSize="@dimen/auto_font_size_28"
            android:id="@+id/user_car_set_un_run"
            android:background="@drawable/user_switch_button"
            android:layout_width="@dimen/auto_dimen2_107"
            android:layout_height="@dimen/auto_dimen2_56"
            android:layout_marginTop="@dimen/auto_dimen2_20"
            android:checked="true"
            android:button="@null"
            app:layout_constraintStart_toStartOf="@+id/car_power_type_layout"
            app:layout_constraintTop_toBottomOf="@+id/car_limit_tittle"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_dimen2_28"
            android:textColor="@color/auto_color_ffffff"
            android:gravity="center"
            android:id="@+id/btn_saved"
            android:background="@drawable/user_button_bg_normal_day"
            android:layout_width="@dimen/auto_dimen2_240"
            android:layout_height="@dimen/auto_dimen2_56"
            android:layout_marginTop="@dimen/auto_dimen2_60"
            android:layout_marginBottom="@dimen/auto_dimen2_40"
            android:text="@string/user_car_edit_plate_saved"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/user_car_set_un_run"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
