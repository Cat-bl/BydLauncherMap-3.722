<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_custom_hud_drive_way_linear"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_rectangle"
        android:background="@drawable/custom_hud_drive_way_linear_rectangle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:background4Night="@drawable/custom_hud_drive_way_linear_rectangle_night"
        app:background4Skin="@drawable/custom_hud_drive_way_linear_rectangle"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_bitmapp"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_divide4"
        android:layout_width="@dimen/auto_dimen2_2"
        android:layout_height="@dimen/auto_dimen2_54"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_divide3"
        android:layout_width="@dimen/auto_dimen2_2"
        android:layout_height="@dimen/auto_dimen2_54"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_divide2"
        android:layout_width="@dimen/auto_dimen2_2"
        android:layout_height="@dimen/auto_dimen2_54"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_divide1"
        android:layout_width="@dimen/auto_dimen2_2"
        android:layout_height="@dimen/auto_dimen2_54"/>
</merge>
