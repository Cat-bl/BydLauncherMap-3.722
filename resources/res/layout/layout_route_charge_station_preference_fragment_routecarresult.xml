            android:id="@+id/stv_text_telaidian"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/routecarresult_text_telaidian"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cpb_telaidian"
            app:textColor4Night="@color/text_450_18_textcolor_night_selector"
            app:textColor4Skin="@color/text_450_11_textcolor_day_selector"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
