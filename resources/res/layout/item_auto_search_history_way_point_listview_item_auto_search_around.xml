<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_auto_search_history_listview_item"
    android:background="@drawable/list_bg_day_selector"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/auto_dimen2_82"
    app:background4Night="@drawable/list_bg_night_selector"
    app:background4Skin="@drawable/list_bg_day_selector"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinTextView
        android:textSize="14sp"
        android:textColor="@color/auto_color_serial_num_day"
        android:gravity="center"
        android:id="@+id/stv_serial_num"
        android:background="@drawable/auto_search_direction_arrow_day"
        android:visibility="gone"
        android:layout_width="@dimen/auto_dimen2_22"
        android:layout_height="@dimen/auto_dimen2_16"
        android:text="5"
        android:layout_marginEnd="@dimen/auto_dimen2_20"
        app:background4Night="@drawable/auto_search_direction_arrow_night"
        app:background4Skin="@drawable/auto_search_direction_arrow_day"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/stv_text_tittle"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/auto_color_serial_num_night"
        app:textColor4Skin="@color/auto_color_serial_num_day"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_historicalroute"
        android:background="@drawable/search_list_item_location_icon_day"
        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_48"
        app:background4Night="@drawable/search_list_item_location_icon"
        app:background4Skin="@drawable/search_list_item_location_icon_day"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_20"
        android:textColor="@color/byd_search_text_day"
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/stv_text_tittle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/auto_search_around_text_tittle"
        android:singleLine="true"
        android:lineSpacingExtra="@dimen/auto_dimen2_4"
        android:layout_marginStart="@dimen/auto_dimen2_12"
        android:layout_marginEnd="@dimen/auto_dimen2_2"
        app:layout_constraintBottom_toTopOf="@+id/stv_text_font"
        app:layout_constraintEnd_toStartOf="@+id/cl_history_item_plus_view"
        app:layout_constraintStart_toEndOf="@+id/siv_historicalroute"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:textColor4Night="@color/byd_search_text_night"
        app:textColor4Skin="@color/byd_search_text_day"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/byd_search_text_day_55"
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/stv_text_font"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_10"
        android:text="@string/auto_search_around_text_font"
        android:singleLine="true"
        android:lineSpacingExtra="@dimen/auto_dimen2_4"
        android:layout_marginEnd="@dimen/auto_dimen2_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cl_history_item_plus_view"
        app:layout_constraintStart_toStartOf="@+id/stv_text_tittle"
        app:layout_constraintTop_toBottomOf="@+id/stv_text_tittle"
        app:textColor4Night="@color/byd_search_text_night_55"
        app:textColor4Skin="@color/byd_search_text_day_55"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_history_item_plus_view"
        android:visibility="gone"
        android:layout_width="@dimen/auto_dimen2_118"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/auto_dimen2_32"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/cl_item_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_24"
                android:textColor="@color/auto_color_242424"
                android:gravity="center"
                android:id="@+id/stv_text_history_item_plus_view_distance"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/auto_search_around_text_history_item_plus_view_distance"
                android:lineSpacingExtra="@dimen/auto_dimen2_4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:textColor4Night="@color/text_450_2_textcolor_night_selector"
                app:textColor4Skin="@color/text_450_2_textcolor_day_selector"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
    </com.autonavi.skin.view.SkinConstraintLayout>
    <com.autonavi.view.custom.CustomListLineView
        android:id="@+id/view_horizontal_line_01"
        android:layout_width="@dimen/auto_dimen2_0"
        android:layout_height="@dimen/auto_dimen2_0_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/stv_text_tittle"
        app:layout_constraintStart_toStartOf="@+id/siv_historicalroute"/>
</com.autonavi.skin.view.SkinConstraintLayout>
