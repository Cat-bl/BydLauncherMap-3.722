<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/constant"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:shadowDayNightStyle="1"
    app:skinDayNightExtraStyle="true">
    <com.autonavi.gbl.map.adapter.MapSurfaceView
        android:id="@+id/presentationView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.auto.common.view.AutoGuideLine
        android:orientation="vertical"
        android:id="@+id/gl_cruise_lane_line_85"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.85"/>
    <com.autonavi.view.custom.CustomExtSmallNaviTrafficLaneView
        android:id="@+id/display_traffic_small_lane"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/auto_dimen2_52"
        android:layout_marginTop="@dimen/auto_dimen2_148"
        app:layout_constraintEnd_toEndOf="@+id/gl_cruise_lane_line_85"
        app:layout_constraintStart_toStartOf="@+id/gl_cruise_lane_line_85"
        app:layout_constraintTop_toTopOf="parent"
        app:shadowDayNightStyle="1"
        app:skinDayNightExtraStyle="true"/>
    <com.autonavi.auto.common.view.AutoGuideLine
        android:orientation="vertical"
        android:id="@+id/gl_cruise_lane_line_70"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.7"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/small_navi_bg_gradient"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.autonavi.skin.view.SkinLinearLayout
        android:orientation="vertical"
        android:id="@+id/cl_navi_and_route_container"
        android:visibility="gone"
        android:layout_width="@dimen/auto_dimen2_400"
        android:layout_height="@dimen/auto_dimen2_148"
        android:layout_marginTop="@dimen/auto_dimen2_228"
        android:layout_marginStart="@dimen/auto_dimen2_218"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ct_navigation_info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.autonavi.view.custom.CustomExtNaviTrafficLaneView
            android:id="@+id/display_traffic_lane"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auto_dimen2_64"
            app:shadowDayNightStyle="1"
            app:skinDayNightExtraStyle="true"/>
    </com.autonavi.skin.view.SkinLinearLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
