<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/byd_custom_color_dialog_secondary_btn_bg_normal_day_ocean"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/stv_text_location"
        android:background="@drawable/byd_custom_btn_bg_secondray_bg_day_ocean"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_40"
        android:text="@string/auto_search_result_map_text_location"
        android:singleLine="true"
        android:paddingStart="@dimen/auto_dimen2_12"
        android:paddingEnd="@dimen/auto_dimen2_12"
        app:background4Night="@drawable/byd_custom_btn_bg_secondray_bg_night_ocean"
        app:background4Skin="@drawable/byd_custom_btn_bg_secondray_bg_day_ocean"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/byd_custom_text_secondary_bg_night_ocean"
        app:textColor4Skin="@color/byd_custom_text_secondary_bg_day_ocean"/>
</com.autonavi.skin.view.SkinConstraintLayout>
