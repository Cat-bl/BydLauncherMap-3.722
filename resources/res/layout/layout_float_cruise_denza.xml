<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/si_cruise_float_theme_bg"
        android:background="@drawable/navi_float_window_bg_day_denza"
        android:layout_width="@dimen/auto_dimen2_300"
        android:layout_height="@dimen/auto_dimen2_110"
        android:layout_marginTop="@dimen/auto_dimen2_10"
        android:layout_marginStart="@dimen/auto_dimen2_8"
        app:background4Night="@drawable/navi_float_window_bg_night_denza"
        app:background4Skin="@drawable/navi_float_window_bg_day_denza"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/si_cruise_float_close"
        android:layout_width="@dimen/auto_dimen2_28"
        android:layout_height="@dimen/auto_dimen2_28"
        android:layout_marginTop="@dimen/auto_dimen2_20"
        android:layout_marginEnd="@dimen/auto_dimen2_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_dimen2_48"
        android:textColor="@color/navi_float_window_title_color_day_denza"
        android:gravity="center"
        android:id="@+id/stv_cruise_float_current_speed"
        android:layout_width="@dimen/auto_dimen2_110"
        android:layout_height="@dimen/auto_dimen2_58"
        android:layout_marginLeft="@dimen/auto_dimen2_16"
        android:layout_marginTop="@dimen/auto_dimen2_12"
        android:text="200"
        app:layout_constraintStart_toStartOf="@+id/si_cruise_float_theme_bg"
        app:layout_constraintTop_toTopOf="@+id/si_cruise_float_theme_bg"
        app:textColor4Night="@color/navi_card_title_color_night"
        app:textColor4Skin="@color/navi_float_window_title_color_day_denza"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_dimen2_20"
        android:textColor="@color/navi_float_window_title_color_day_denza"
        android:gravity="center"
        android:id="@+id/stv_cruise_float_speed_unit"
        android:layout_width="@dimen/auto_dimen2_110"
        android:layout_height="@dimen/auto_dimen2_34"
        android:layout_marginLeft="@dimen/auto_dimen2_16"
        android:text="@string/auto_navi_text_unit"
        app:layout_constraintEnd_toEndOf="@+id/stv_cruise_float_current_speed"
        app:layout_constraintTop_toBottomOf="@+id/stv_cruise_float_current_speed"
        app:textColor4Night="@color/navi_card_title_color_night"
        app:textColor4Skin="@color/navi_float_window_title_color_day_denza"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_dimen2_20"
        android:textColor="@color/navi_float_window_title_color_day_denza"
        android:ellipsize="end"
        android:id="@+id/stv_cruise_float_road_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_current_route"
        android:maxLines="2"
        android:maxEms="5"
        android:layout_marginStart="@dimen/auto_dimen2_18"
        android:layout_marginEnd="@dimen/auto_dimen2_20"
        app:layout_constraintBottom_toBottomOf="@+id/si_cruise_float_theme_bg"
        app:layout_constraintEnd_toEndOf="@+id/si_cruise_float_theme_bg"
        app:layout_constraintStart_toEndOf="@+id/stv_cruise_float_current_speed"
        app:layout_constraintTop_toTopOf="@+id/si_cruise_float_theme_bg"
        app:textColor4Night="@color/navi_card_title_color_night"
        app:textColor4Skin="@color/navi_float_window_title_color_day_denza"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_19"
        android:textColor="@color/navi_float_speed_limit_color_day_denza"
        android:gravity="center"
        android:id="@+id/stv_cruise_float_speed_limit"
        android:background="@drawable/ic_speed_limit"
        android:visibility="gone"
        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_48"
        android:text="100"
        app:layout_constraintBottom_toTopOf="@+id/stv_cruise_float_edog_remain_distance"
        app:layout_constraintEnd_toStartOf="@+id/stv_cruise_float_edog_left"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/stv_cruise_float_current_speed"
        app:layout_goneMarginBottom="@dimen/auto_dimen2_28"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/stv_cruise_float_edog_left"
        android:visibility="visible"
        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_48"
        app:layout_constraintBottom_toTopOf="@+id/stv_cruise_float_edog_remain_distance"
        app:layout_constraintEnd_toStartOf="@+id/stv_cruise_float_edog_right"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/stv_cruise_float_speed_limit"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/stv_cruise_float_edog_right"
        android:visibility="visible"
        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_48"
        app:layout_constraintBottom_toTopOf="@+id/stv_cruise_float_edog_remain_distance"
        app:layout_constraintEnd_toEndOf="@+id/si_cruise_float_theme_bg"
        app:layout_constraintStart_toEndOf="@+id/stv_cruise_float_edog_left"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_dimen2_18"
        android:textColor="@color/navi_float_window_title_color_day_denza"
        android:gravity="center"
        android:id="@+id/stv_cruise_float_edog_remain_distance"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/auto_dimen2_28"
        android:layout_marginBottom="@dimen/auto_dimen2_18"
        android:text="200米"
        app:layout_constraintBottom_toBottomOf="@+id/si_cruise_float_theme_bg"
        app:layout_constraintEnd_toEndOf="@+id/si_cruise_float_theme_bg"
        app:layout_constraintStart_toEndOf="@+id/stv_cruise_float_current_speed"
        app:textColor4Night="@color/navi_card_title_color_night"
        app:textColor4Skin="@color/navi_float_window_title_color_day_denza"/>
    <com.autonavi.view.custom.CustomCruiseTrafficLaneView
        android:gravity="center"
        android:id="@+id/navi_float_traffic_lane"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_45"
        android:layout_marginTop="@dimen/auto_dimen2_4"
        app:layout_constraintEnd_toEndOf="@+id/si_cruise_float_theme_bg"
        app:layout_constraintStart_toStartOf="@+id/si_cruise_float_theme_bg"
        app:layout_constraintTop_toTopOf="@+id/space"/>
    <Space
        android:id="@+id/space"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_14"
        app:layout_constraintBottom_toBottomOf="@+id/si_cruise_float_theme_bg"
        app:layout_constraintEnd_toEndOf="@+id/si_cruise_float_theme_bg"
        app:layout_constraintStart_toStartOf="@+id/si_cruise_float_theme_bg"/>
</com.autonavi.skin.view.SkinConstraintLayout>
