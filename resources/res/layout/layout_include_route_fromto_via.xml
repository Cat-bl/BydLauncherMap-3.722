<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_v4_fromto_car_detail_item"
    android:layout_width="match_parent"
    android:layout_height="@dimen/auto_dimen2_54"
    app:tag="DisableAtRunTime">
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_icon_via"
        android:background="@drawable/route_browser_fragment_icon_via_day_small"
        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_48"
        android:layout_marginLeft="@dimen/auto_dimen2_12"
        app:background4Night="@drawable/route_browser_fragment_icon_via_night_small"
        app:background4Skin="@drawable/route_browser_fragment_icon_via_day_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/custom_route_textcolor_day_normal"
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/route_fromto_layout_via_stv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/route_browser_fragment_text_distance_des"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/auto_dimen2_72"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/siv_icon_via"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/custom_route_textcolor_night_normal"
        app:textColor4Skin="@color/custom_route_textcolor_day_normal"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_bottom_line"
        android:background="@color/custom_route_line_day"
        android:layout_width="@dimen/auto_dimen2_0"
        android:layout_height="@dimen/auto_dimen2_1"
        app:background4Night="@color/custom_route_line_night"
        app:background4Skin="@color/custom_route_line_day"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/siv_icon_via"/>
    <View
        android:id="@+id/stv_route_via_add"
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="1dp"/>
    <View
        android:id="@+id/siv_delete_via"
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="1dp"/>
    <View
        android:id="@+id/stv_route_via_num"
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="1dp"/>
</com.autonavi.skin.view.SkinConstraintLayout>
