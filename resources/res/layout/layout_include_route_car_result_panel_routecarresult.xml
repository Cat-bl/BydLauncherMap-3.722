<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_route_car_result_panel"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:designHeight="600"
    app:designWidth="1024">
    <include
        android:id="@+id/ct_auto_route_fromto_combine"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/auto_dimen2_24"
        android:layout_marginEnd="@dimen/auto_dimen2_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_include_route_fromto_combine"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ct_auto_route_panel_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:weightSum="3"
        android:divider="@drawable/route_result_item_divider"
        android:minHeight="@dimen/auto_dimen2_192"
        android:showDividers="middle"
        android:layout_marginStart="@dimen/auto_dimen2_24"
        android:layout_marginEnd="@dimen/auto_dimen2_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ct_auto_route_fromto_combine"/>
    <include
        android:id="@+id/ac_bottom_left_home_position"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_48"
        android:layout_marginTop="@dimen/auto_dimen2_5"
        android:layout_marginBottom="@dimen/auto_dimen2_16"
        android:layout_marginStart="@dimen/auto_dimen2_24"
        android:layout_marginEnd="@dimen/auto_dimen2_24"
        app:interface_key="bottom_left_home_position"
        app:layout_constraintBottom_toTopOf="@+id/route_panel_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ct_auto_route_panel_content"
        layout="@layout/layout_no_home_bottom_left_routecarresult"/>
    <View
        android:id="@+id/route_panel_bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/auto_dimen2_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ac_bottom_left_home_position"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/route_panel_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="ct_auto_route_panel_content,    ac_bottom_left_home_position, bottom_view"/>
    <com.autonavi.skin.view.SkinLinearLayout
        android:gravity="center"
        android:id="@+id/no_permission_sll"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/auto_dimen2_180"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ct_auto_route_fromto_combine">
        <com.autonavi.skin.view.SkinImageView
            android:background="@drawable/route_permission_refresh_day"
            android:layout_width="@dimen/auto_font_size_48"
            android:layout_height="@dimen/auto_font_size_48"
            app:background4Night="@drawable/route_permission_refresh_night"
            app:background4Skin="@drawable/route_permission_refresh_day"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_20"
            android:textColor="@color/text_450_1_textcolor_day_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="路线失败，请稍后重试"
            app:textColor4Night="@color/text_450_4_textcolor_night_normal"
            app:textColor4Skin="@color/text_450_1_textcolor_day_normal"/>
    </com.autonavi.skin.view.SkinLinearLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
