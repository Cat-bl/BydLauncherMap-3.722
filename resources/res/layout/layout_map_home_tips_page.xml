<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/map_beginner_guidance_bg_day_slipt"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:background4Night="@drawable/map_beginner_guidance_bg_night_slipt"
    app:background4Skin="@drawable/map_beginner_guidance_bg_day_slipt"
    app:designHeight="720"
    app:designWidth="1280">
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_24"
        android:textColor="@color/auto_color_tip_title_day_color"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_135"
        android:text="@string/map_shallow_depth_model_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/auto_color_tip_title_night_color"
        app:textColor4Skin="@color/auto_color_tip_title_day_color"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/auto_color_tip_content_day_color"
        android:id="@+id/tv_tip_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_12"
        android:text="@string/map_shallow_depth_model_content_one_text"
        android:layout_marginStart="@dimen/auto_dimen2_24"
        android:layout_marginEnd="@dimen/auto_dimen2_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        app:textColor4Night="@color/auto_color_tip_content_night_color"
        app:textColor4Skin="@color/auto_color_tip_content_day_color"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tip_recyclerView"
        android:layout_width="@dimen/auto_dimen2_774"
        android:layout_height="@dimen/auto_dimen2_456"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_tip_content"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/iv_indicator_one"
        android:background="@drawable/item_tip_indicator_select"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/auto_dimen2_4"
        android:layout_marginBottom="@dimen/auto_dimen2_18"
        android:layout_marginEnd="@dimen/auto_dimen2_2"
        app:background4Night="@drawable/item_tip_indicator_select"
        app:background4Skin="@drawable/item_tip_indicator_select"
        app:layout_constraintBottom_toBottomOf="@+id/tip_recyclerView"
        app:layout_constraintEnd_toStartOf="@+id/ver_guideline"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/iv_indicator_two"
        android:background="@drawable/item_tip_indicator_select_no_day"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/auto_dimen2_4"
        android:layout_marginBottom="@dimen/auto_dimen2_18"
        android:layout_marginStart="@dimen/auto_dimen2_2"
        app:background4Night="@drawable/item_tip_indicator_select_no_night"
        app:background4Skin="@drawable/item_tip_indicator_select_no_day"
        app:layout_constraintBottom_toBottomOf="@+id/tip_recyclerView"
        app:layout_constraintStart_toEndOf="@+id/ver_guideline"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/ver_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/auto_color_tip_day_color"
        android:gravity="center"
        android:id="@+id/stv_close"
        android:background="@drawable/custom_btn_map_home_tip_day_selector"
        android:layout_width="@dimen/auto_dimen2_144"
        android:layout_height="@dimen/auto_dimen2_40"
        android:layout_marginTop="@dimen/auto_dimen2_6"
        android:text="@string/map_close_text"
        android:layout_marginEnd="@dimen/auto_dimen2_32"
        app:background4Night="@drawable/custom_btn_map_home_tip_night_selector"
        app:background4Skin="@drawable/custom_btn_map_home_tip_day_selector"
        app:layout_constraintEnd_toEndOf="@+id/ver_guideline"
        app:layout_constraintTop_toBottomOf="@+id/tip_recyclerView"
        app:textColor4Night="@color/auto_color_tip_night_color"
        app:textColor4Skin="@color/auto_color_tip_day_color"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/auto_color_tip_step_day_color"
        android:gravity="center"
        android:id="@+id/stv_next"
        android:background="@drawable/custom_btn_map_home_tip_step_day_selector"
        android:layout_width="@dimen/auto_dimen2_144"
        android:layout_height="@dimen/auto_dimen2_40"
        android:layout_marginTop="@dimen/auto_dimen2_6"
        android:text="@string/map_next_step_text"
        android:layout_marginStart="@dimen/auto_dimen2_32"
        app:background4Night="@drawable/custom_btn_map_home_tip_step_night_selector"
        app:background4Skin="@drawable/custom_btn_map_home_tip_step_day_selector"
        app:layout_constraintStart_toStartOf="@+id/ver_guideline"
        app:layout_constraintTop_toBottomOf="@+id/tip_recyclerView"
        app:textColor4Night="@color/auto_color_tip_step_night_color"
        app:textColor4Skin="@color/auto_color_tip_step_day_color"/>
</com.autonavi.skin.view.SkinConstraintLayout>
