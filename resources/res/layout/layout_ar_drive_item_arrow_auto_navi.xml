<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_ar_drive_item_arrow"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_bg"
        android:layout_width="@dimen/auto_dimen2_44"
        android:layout_height="@dimen/auto_dimen2_65"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_arrow_btm"
        android:layout_width="@dimen/auto_dimen2_44"
        android:layout_height="@dimen/auto_dimen2_4"
        app:layout_constraintBottom_toBottomOf="@+id/siv_bg"
        app:layout_constraintEnd_toEndOf="@+id/siv_bg"
        app:layout_constraintStart_toStartOf="@+id/siv_bg"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_right_extend_divider"
        android:layout_width="@dimen/auto_dimen2_10"
        android:layout_height="@dimen/auto_dimen2_41"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_left_extend_divider"
        android:layout_width="@dimen/auto_dimen2_10"
        android:layout_height="@dimen/auto_dimen2_41"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_drive_way_arrow"
        android:layout_width="@dimen/auto_dimen2_44"
        android:layout_height="@dimen/auto_dimen2_58"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_arrow_extend"
        android:layout_width="@dimen/auto_dimen2_37"
        android:layout_height="@dimen/auto_dimen2_47"
        android:layout_marginTop="@dimen/auto_dimen2_5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.autonavi.skin.view.SkinConstraintLayout>
