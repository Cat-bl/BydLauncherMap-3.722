        android:id="@+id/setting_navi_avoid_jan_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/autorouteplansetting_text_avoid_jan"
        android:layout_marginStart="@dimen/auto_dimen2_24"
        app:layout_constraintBottom_toBottomOf="@+id/setting_navi_avoid_jan_image"
        app:layout_constraintStart_toStartOf="@+id/setting_navi_bcv_avoid_jan"
        app:layout_constraintTop_toTopOf="@+id/setting_navi_avoid_jan_image"
