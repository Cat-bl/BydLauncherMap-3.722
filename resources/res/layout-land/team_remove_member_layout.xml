<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scl_remove_member_layout"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.autonavi.view.custom.CustomMongoliaView
        android:id="@+id/cm_mongolia"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/scl_top_panel_layout"
        android:focusable="true"
        android:clickable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/team_setting_view_size_land_style">
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/siv_bg"
            android:background="@drawable/custom_card_view_team__m_bg_day"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:background4Night="@drawable/custom_card_view_team__m_bg_night"
            app:background4Skin="@drawable/custom_card_view_team__m_bg_day"/>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/top_bar_layout"
            android:layout_width="0dp"
            android:layout_height="@dimen/auto_dimen2_74"
            app:layout_constraintEnd_toEndOf="@+id/siv_bg"
            app:layout_constraintStart_toStartOf="@+id/siv_bg"
            app:layout_constraintTop_toTopOf="@+id/siv_bg">
            <com.autonavi.skin.view.SkinTextView
                android:id="@+id/stv__back_hotspot"
                android:background="@drawable/custom_list_pressed_list_day_bg_selector"
                android:layout_width="@dimen/auto_dimen2_48"
                android:layout_height="@dimen/auto_dimen2_48"
                android:contentDescription="返回"
                android:layout_marginStart="@dimen/auto_dimen2_20"
                app:background4Night="@drawable/custom_list_pressed_list_night_bg_selector"
                app:background4Skin="@drawable/custom_list_pressed_list_day_bg_selector"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/favorite_back"
                android:background="@drawable/icon_setting_back_land_day"
                android:layout_width="@dimen/auto_dimen2_48"
                android:layout_height="@dimen/auto_dimen2_48"
                app:background4Night="@drawable/icon_setting_back_land_night"
                app:background4Skin="@drawable/icon_setting_back_land_day"
                app:layout_constraintBottom_toBottomOf="@+id/stv__back_hotspot"
                app:layout_constraintEnd_toEndOf="@+id/stv__back_hotspot"
                app:layout_constraintStart_toStartOf="@+id/stv__back_hotspot"
                app:layout_constraintTop_toTopOf="@+id/stv__back_hotspot"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_20"
                android:textColor="@color/custom_text_day_color_100"
                android:gravity="center_vertical"
                android:id="@+id/stv_title_team"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/auto_dimen2_8"
                android:text="@string/user_team_setting_team_remove_member_title"
                android:singleLine="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/favorite_back"
                app:layout_constraintTop_toTopOf="parent"
                app:textColor4Night="@color/custom_text_night_color_100"
                app:textColor4Skin="@color/custom_text_day_color_100"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinRelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_bar_layout">
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="horizontal"
                android:id="@+id/rv_remove_member"
                android:paddingTop="@dimen/auto_dimen2_28"
                android:paddingBottom="@dimen/auto_dimen2_24"
                android:visibility="gone"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/auto_dimen2_8"
                android:paddingEnd="@dimen/auto_dimen2_8"/>
            <com.autonavi.skin.view.SkinLinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/sll_no_member_layout"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.autonavi.skin.view.SkinImageView
                    android:layout_width="@dimen/auto_dimen2_312"
                    android:layout_height="@dimen/auto_dimen2_208"
                    android:layout_marginTop="@dimen/auto_dimen2_52"
                    android:src="@drawable/team_no_member_day_img"
                    app:src4Night="@drawable/team_no_member_night_img"
                    app:src4Skin="@drawable/team_no_member_day_img"/>
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/auto_font_size_16"
                    android:textColor="@color/custom_text_day_color_70"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/auto_dimen2_24"
                    android:text="@string/user_team_remove_member_no_member"
                    app:textColor4Night="@color/custom_text_night_color_70"
                    app:textColor4Skin="@color/custom_text_day_color_70"/>
            </com.autonavi.skin.view.SkinLinearLayout>
        </com.autonavi.skin.view.SkinRelativeLayout>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
