        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/autorouteplansetting_text_using_highway"
        android:layout_marginStart="@dimen/auto_dimen2_24"
        app:layout_constraintBottom_toBottomOf="@+id/setting_navi_using_highway_image"
        app:layout_constraintStart_toStartOf="@+id/setting_navi_bcv_using_highway"
        app:layout_constraintTop_toTopOf="@+id/setting_navi_using_highway_image"
        app:textColor4Night="@color/byd_custom_setting_station_color"
        app:textColor4Skin="@color/byd_custom_setting_station_color_day"/>
