<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.autonavi.skin.view.SkinLinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/phone_connect_car_gaode_help2_sll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/phone_connect_car_gaode_help2_siv"
            android:background="@drawable/img_interconnection_gaode_help2_land"
            android:layout_marginEnd="@dimen/auto_dimen2_100"
            app:background4Night="@drawable/img_interconnection_gaode_help2_night_land"
            app:background4Skin="@drawable/img_interconnection_gaode_help2_land"
            style="@style/style_interconnection_img1_land"/>
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/phone_connect_car_gaode_help2_2_siv"
            android:background="@drawable/img_interconnection_gaode_help2_2_land"
            android:layout_marginStart="@dimen/auto_dimen2_100"
            app:background4Night="@drawable/img_interconnection_gaode_help2_2_night_land"
            app:background4Skin="@drawable/img_interconnection_gaode_help2_2_land"
            style="@style/style_interconnection_img1_land"/>
    </com.autonavi.skin.view.SkinLinearLayout>
    <com.autonavi.skin.view.SkinLinearLayout
        app:layout_constraintTop_toBottomOf="@+id/phone_connect_car_gaode_help2_sll"
        style="@style/style_interconnection_tip_land">
        <com.autonavi.skin.view.SkinTextView
            android:id="@+id/connect_net_flag"
            android:text="2"
            style="@style/style_interconnection_step"/>
        <com.autonavi.skin.view.SkinTextView
            android:id="@+id/phone_connect_car_gaode_help2_tip"
            android:text="@string/interconnection_gaode_help2_tip"
            style="@style/style_interconnection_tip_text"/>
    </com.autonavi.skin.view.SkinLinearLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
