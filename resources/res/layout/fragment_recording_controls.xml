<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/id_fragmentrecordingcontrols"
    android:focusable="false"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false">
    <LinearLayout
        android:orientation="horizontal"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:weightSum="4">
        <View
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <View
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="12sp"
            android:textColor="@color/textColorPrimary"
            android:gravity="center_horizontal"
            android:id="@+id/id_textView_Placemarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:freezesText="true"
            android:layout_weight="1"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="12sp"
            android:textColor="@color/textColorPrimary"
            android:gravity="center_horizontal"
            android:id="@+id/id_textView_GeoPoints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:freezesText="true"
            android:layout_weight="1"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:src="@drawable/shadow"/>
    <LinearLayout
        android:background="@color/colorRecControlBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:weightSum="4">
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="12sp"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/id_lock"
            android:paddingLeft="12dp"
            android:paddingTop="5dp"
            android:paddingRight="12dp"
            android:paddingBottom="4dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:freezesText="true"
            android:layout_weight="1"
            app:drawableTopCompat="@drawable/ic_lock_24"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="12sp"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/id_stop"
            android:paddingLeft="12dp"
            android:paddingTop="5dp"
            android:paddingRight="12dp"
            android:paddingBottom="4dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/stop"
            android:maxLines="1"
            android:freezesText="true"
            android:layout_weight="1"
            app:drawableTopCompat="@drawable/ic_stop_24"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="12sp"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/id_annotate"
            android:paddingLeft="12dp"
            android:paddingTop="5dp"
            android:paddingRight="12dp"
            android:paddingBottom="4dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/annotate"
            android:maxLines="1"
            android:freezesText="true"
            android:layout_weight="1"
            app:drawableTopCompat="@drawable/ic_add_location_24dp"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="12sp"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:id="@+id/id_record"
            android:paddingLeft="12dp"
            android:paddingTop="5dp"
            android:paddingRight="12dp"
            android:paddingBottom="4dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:freezesText="true"
            android:layout_weight="1"
            app:drawableTopCompat="@drawable/ic_record_24"/>
    </LinearLayout>
</LinearLayout>
