<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/search_home_clear_history_bg_day_selector"
    android:layout_width="match_parent"
    android:layout_height="@dimen/auto_dimen2_32"
    android:stateListAnimator="@animator/anim_button_press"
    app:background4Night="@drawable/search_home_clear_history_bg_night_selector"
    app:background4Skin="@drawable/search_home_clear_history_bg_day_selector">
    <com.autonavi.skin.view.SkinLinearLayout
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/sys_padding_s"
        android:paddingEnd="@dimen/sys_padding_s"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_14"
            android:textColor="@color/byd_search_text_day"
            android:ellipsize="end"
            android:id="@+id/stv_text_tittle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:lineSpacingExtra="@dimen/auto_dimen2_6"
            app:textColor4Night="@color/byd_search_text_night"
            app:textColor4Skin="@color/byd_search_text_day"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_14"
            android:textColor="@color/search_suggest_child_poi"
            android:ellipsize="end"
            android:id="@+id/stv_text_ratio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:lineSpacingExtra="@dimen/auto_dimen2_6"
            android:layout_marginStart="@dimen/sys_padding_xs"
            app:layout_constraintStart_toEndOf="@+id/stv_text_tittle"/>
    </com.autonavi.skin.view.SkinLinearLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
