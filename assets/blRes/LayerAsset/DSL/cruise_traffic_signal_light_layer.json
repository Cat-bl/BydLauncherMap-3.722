        {
          "type": "style_if",
          "brief": "style_scene",
          "value": {
            "case": {
              "true": {
                "if": {
                  "case": {
                    "true": {
                      "switch": {
                        "case": {
                          "512": "point_cruise_traffic_signal_light_secondary_right_up",
                          "1024": "point_cruise_traffic_signal_light_secondary_left_up",
                          "default": "point_cruise_traffic_signal_light_secondary_left_up"
