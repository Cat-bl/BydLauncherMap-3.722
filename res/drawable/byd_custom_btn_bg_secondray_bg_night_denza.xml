        <shape android:shape="rectangle">
            <corners android:radius="@dimen/auto_dimen2_4" />
            <stroke android:width="@dimen/auto_dimen2_1" android:color="#08ffffff" />
            <solid android:color="#99323538" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/auto_dimen2_4" />
            <stroke android:width="@dimen/auto_dimen2_1" android:color="#0dffffff" />
            <solid android:color="#ff323538" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/auto_dimen2_4" />
            <stroke android:width="@dimen/auto_dimen2_1" android:color="#0dffffff" />
            <solid android:color="#ff323538" />
        </shape>
    </item>
</selector>
