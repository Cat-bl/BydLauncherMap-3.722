<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/auto_dimen2_74"
    app:designHeight="720"
    app:designWidth="1280">
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/cll_item_msg_bottom_line"
        android:background="@color/auto_color_item_msg_bottom_line"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_1"
        android:layout_marginStart="@dimen/auto_dimen2_24"
        android:layout_marginEnd="@dimen/auto_dimen2_24"
        app:background4Night="@color/auto_color_12FFFFFF"
        app:background4Skin="@color/auto_color_item_msg_bottom_line"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="14sp"
        android:textColor="@color/auto_color_serial_num_day"
        android:gravity="center"
        android:id="@+id/stv_serial_num"
        android:background="@drawable/auto_search_direction_arrow_day"
        android:visibility="gone"
        android:layout_width="@dimen/auto_dimen2_22"
        android:layout_height="@dimen/auto_dimen2_16"
        android:text="10"
        android:textAlignment="center"
        android:layout_marginEnd="@dimen/auto_dimen2_20"
        app:background4Night="@drawable/auto_search_direction_arrow_night"
        app:background4Skin="@drawable/auto_search_direction_arrow_day"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/srl_content_layout"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/auto_color_serial_num_night"
        app:textColor4Skin="@color/auto_color_serial_num_day"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/sv_item_image"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/auto_dimen2_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/srl_content_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/item_route_image"
            android:background="@drawable/user_msg_route_indicate_day_img"
            android:layout_width="@dimen/auto_dimen2_48"
            android:layout_height="@dimen/auto_dimen2_48"
            android:scaleType="center"
            app:background4Night="@drawable/user_msg_route_indicate_night_img"
            app:background4Skin="@drawable/user_msg_route_indicate_day_img"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/item_poi_image"
            android:background="@drawable/user_msg_poi_indicate_day_img"
            android:visibility="gone"
            android:layout_width="@dimen/auto_dimen2_48"
            android:layout_height="@dimen/auto_dimen2_48"
            android:scaleType="center"
            app:background4Night="@drawable/user_msg_poi_indicate_night_img"
            app:background4Skin="@drawable/user_msg_poi_indicate_day_img"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/item_broadcast_image"
            android:background="@drawable/user_msg_broadcast_indicate_day_img"
            android:visibility="gone"
            android:layout_width="@dimen/auto_dimen2_48"
            android:layout_height="@dimen/auto_dimen2_48"
            android:scaleType="center"
            app:background4Night="@drawable/user_msg_broadcast_indicate_night_img"
            app:background4Skin="@drawable/user_msg_broadcast_indicate_day_img"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
    <com.autonavi.skin.view.SkinRelativeLayout
        android:id="@+id/srl_content_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_6"
        android:layout_marginStart="@dimen/auto_dimen2_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/stv_item_time"
        app:layout_constraintStart_toEndOf="@+id/sv_item_image"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_20"
            android:textColor="@color/custom_text_day_color_100"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/stv_item_name"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auto_font_size_32"
            android:singleLine="true"
            app:textColor4Night="@color/custom_text_night_color_100"
            app:textColor4Skin="@color/custom_text_day_color_100"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_16"
            android:textColor="@color/custom_text_day_color_55"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/stv_item_address"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auto_font_size_26"
            android:singleLine="true"
            android:layout_below="@+id/stv_item_name"
            app:textColor4Night="@color/custom_text_night_color_55"
            app:textColor4Skin="@color/custom_text_day_color_55"/>
    </com.autonavi.skin.view.SkinRelativeLayout>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/custom_text_day_color_55"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/stv_item_time"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:singleLine="true"
        android:layout_marginStart="@dimen/auto_dimen2_20"
        android:layout_marginEnd="@dimen/auto_dimen2_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/siv_item_next_image"
        app:layout_constraintStart_toEndOf="@+id/srl_content_layout"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/custom_text_night_color_55"
        app:textColor4Skin="@color/custom_text_day_color_55"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_item_next_image"
        android:background="@drawable/item_next_indicate_img_day"
        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_48"
        android:layout_marginEnd="@dimen/auto_dimen2_8"
        app:background4Night="@drawable/item_next_indicate_img"
        app:background4Skin="@drawable/item_next_indicate_img_day"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/stv_item_time"
        app:layout_constraintTop_toTopOf="parent"/>
</com.autonavi.skin.view.SkinConstraintLayout>
