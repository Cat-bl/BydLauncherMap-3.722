<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_storage"
    android:background="@drawable/byd_user_bg_day"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:background4Night="@drawable/byd_data_bg_night"
    app:background4Skin="@drawable/byd_user_bg_day"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.auto.common.view.AutoGuideLine
        android:orientation="vertical"
        android:id="@+id/gl_data_map"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="1"
        app:layout_constraintGuide_percent4Landscape="1"
        app:layout_constraintGuide_percent4LandscapeWide="0.8"/>
    <com.autonavi.skin.view.SkinTextView
        android:id="@+id/cc_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/gl_data_map"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.view.custom.CustomListPressedView
        android:id="@+id/clp_back_hotspot"
        android:layout_width="@dimen/auto_dimen2_104"
        android:layout_height="@dimen/auto_dimen2_88"
        app:layout_constraintStart_toStartOf="@+id/cc_bg"
        app:layout_constraintTop_toTopOf="@+id/cc_bg"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_back"
        android:background="@drawable/setting_back_day"
        android:layout_width="@dimen/auto_dimen2_40"
        android:layout_height="@dimen/auto_dimen2_40"
        app:background4Skin="@drawable/setting_back_day"
        app:layout_constraintBottom_toBottomOf="@+id/clp_back_hotspot"
        app:layout_constraintEnd_toEndOf="@+id/clp_back_hotspot"
        app:layout_constraintStart_toStartOf="@+id/clp_back_hotspot"
        app:layout_constraintTop_toTopOf="@+id/clp_back_hotspot"/>
    <com.autonavi.skin.view.SkinTextView
        android:id="@+id/cbts_bar_title"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_88"
        app:layout_constraintEnd_toEndOf="@+id/cc_bg"
        app:layout_constraintStart_toStartOf="@+id/cc_bg"
        app:layout_constraintTop_toTopOf="@+id/cc_bg"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_28"
        android:textColor="@color/byd_text_450_1_textcolor_day_selector"
        android:gravity="center"
        android:id="@+id/stv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/data_storage"
        android:lineSpacingExtra="@dimen/auto_dimen2_4"
        app:layout_constraintBottom_toBottomOf="@+id/cbts_bar_title"
        app:layout_constraintEnd_toEndOf="@+id/cbts_bar_title"
        app:layout_constraintStart_toStartOf="@+id/cbts_bar_title"
        app:layout_constraintTop_toTopOf="@+id/cbts_bar_title"
        app:textColor4Night="@color/byd_text_450_1_textcolor_night_selector"
        app:textColor4Skin="@color/byd_text_450_1_textcolor_day_selector"/>
    <com.autonavi.skin.view.SkinListView
        android:id="@+id/slv_storage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/auto_dimen2_32"
        android:layout_marginTop="@dimen/auto_dimen2_12"
        android:layout_marginRight="@dimen/auto_dimen2_32"
        android:layout_marginBottom="@dimen/auto_dimen2_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cbts_bar_title"/>
</com.autonavi.skin.view.SkinConstraintLayout>
