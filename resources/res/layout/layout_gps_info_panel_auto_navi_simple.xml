<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_gps_info_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_loading_bottom_space"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_10"
        app:layout_constraintEnd_toEndOf="@+id/ccn_navi_tbt"
        app:layout_constraintStart_toStartOf="@+id/ccn_navi_tbt"
        app:layout_constraintTop_toBottomOf="@+id/ccn_navi_tbt"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/ccn_navi_tbt"
        android:background="@drawable/navi_normal_card_split_top_bg_day"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_96"
        android:layout_marginLeft="@dimen/auto_dimen2_8"
        android:layout_marginTop="@dimen/auto_dimen2_6"
        android:layout_marginRight="@dimen/auto_dimen2_8"
        app:background4Night="@drawable/navi_normal_card_split_top_bg_night"
        app:background4Skin="@drawable/navi_normal_card_split_top_bg_day"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shadowColor="@color/auto_ui_000000_33"
        app:shadowColorNight="@color/auto_ui_000000_33"
        app:shadowCorner="@dimen/auto_dimen2_0"
        app:shadowCornerBottomLeft="@dimen/auto_dimen2_0"
        app:shadowCornerBottomRight="@dimen/auto_dimen2_0"
        app:shadowCornerTopLeft="@dimen/auto_dimen2_4"
        app:shadowCornerTopRight="@dimen/auto_dimen2_4"
        app:shadowDx="@dimen/auto_dimen2_0"
        app:shadowDy="@dimen/auto_dimen2_2"
        app:shadowRadius="@dimen/auto_dimen2_8"
        app:shadowShapeType="rectangle"
        app:shadowSide="all"
        app:shadowVisibility="true"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_24"
        android:textColor="@color/text_450_1_textcolor_day_selector"
        android:gravity="left"
        android:id="@+id/stv_text_gps_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/auto_dimen2_8"
        android:layout_marginTop="@dimen/auto_dimen2_20"
        android:text="@string/auto_navi_simple_text_gps_loading"
        android:lineSpacingExtra="@dimen/auto_dimen2_21"
        app:layout_constraintStart_toEndOf="@+id/cl_"
        app:layout_constraintTop_toTopOf="@+id/ccn_navi_tbt"
        app:textColor4Night="@color/text_450_1_textcolor_night_selector"
        app:textColor4Skin="@color/text_450_1_textcolor_day_selector"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_20"
        android:textColor="@color/text_450_1_textcolor_day_selector"
        android:gravity="left"
        android:id="@+id/stv_text_route_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/auto_dimen2_8"
        android:text="@string/auto_navi_simple_text_route_loading"
        android:lineSpacingExtra="@dimen/auto_dimen2_13"
        app:layout_constraintBottom_toBottomOf="@+id/ccn_navi_tbt"
        app:layout_constraintStart_toEndOf="@+id/cl_"
        app:layout_constraintTop_toTopOf="@+id/ccn_navi_tbt"
        app:textColor4Night="@color/text_450_1_textcolor_night_selector"
        app:textColor4Skin="@color/text_450_1_textcolor_day_selector"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/text_450_1_textcolor_day_selector"
        android:gravity="left"
        android:id="@+id/stv_text_gps_describe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_13"
        android:text="@string/auto_navi_simple_text_gps_describe"
        android:lineSpacingExtra="@dimen/auto_dimen2_13"
        app:layout_constraintStart_toStartOf="@+id/stv_text_gps_loading"
        app:layout_constraintTop_toBottomOf="@+id/stv_text_gps_loading"
        app:textColor4Night="@color/text_450_1_textcolor_night_selector"
        app:textColor4Skin="@color/text_450_1_textcolor_day_selector"/>
    <com.autonavi.view.custom.CustomLoadingView
        android:id="@+id/cl_"
        android:layout_width="@dimen/auto_dimen2_36"
        android:layout_height="@dimen/auto_dimen2_36"
        android:layout_marginLeft="@dimen/auto_dimen2_16"
        app:layout_constraintBottom_toBottomOf="@+id/ccn_navi_tbt"
        app:layout_constraintStart_toStartOf="@+id/ccn_navi_tbt"
        app:layout_constraintTop_toTopOf="@+id/ccn_navi_tbt"/>
</com.autonavi.skin.view.SkinConstraintLayout>
