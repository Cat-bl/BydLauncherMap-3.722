<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_navigation_info_landscape_changanmca"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:designHeight="600"
    app:designWidth="1024">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/g_exit_views"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="v_exit_anchor,stv_exit,stv_text_exit_location"/>
    <View
        android:id="@+id/v_exit_anchor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/auto_dimen2_22"
        android:layout_marginStart="@dimen/auto_dimen2_26"
        app:layout_constraintBottom_toTopOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintEnd_toEndOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_dimen2_30"
        android:textColor="@color/auto_color_white"
        android:gravity="center"
        android:id="@+id/stv_exit"
        android:background="@drawable/ic_exit_bg"
        android:paddingLeft="@dimen/auto_dimen2_6"
        android:paddingRight="@dimen/auto_dimen2_6"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_40"
        android:layout_marginBottom="@dimen/auto_dimen2_10"
        android:singleLine="true"
        android:maxLength="7"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/v_exit_anchor"
        app:layout_constraintStart_toStartOf="@+id/v_exit_anchor"
        app:shadowDayNightStyle="1"
        app:skinDayNightExtraStyle="true"
        app:textColor4Night="@color/auto_color_white"
        app:textColor4Skin="@color/auto_color_white"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_30"
        android:textColor="@color/auto_color_white"
        android:ellipsize="end"
        android:id="@+id/stv_text_exit_location"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/auto_dimen2_20"
        android:layout_marginEnd="@dimen/auto_dimen2_20"
        app:layout_constraintBottom_toBottomOf="@+id/stv_exit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/stv_exit"
        app:layout_constraintTop_toTopOf="@+id/stv_exit"
        app:shadowDayNightStyle="1"
        app:skinDayNightExtraStyle="true"
        app:textColor4Night="@color/navi_card_title_color_night"
        app:textColor4Skin="@color/auto_color_white"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_turn_by_turn_arrow"
        android:layout_width="@dimen/auto_dimen2_82"
        android:layout_height="@dimen/auto_dimen2_82"
        android:layout_marginBottom="@dimen/auto_dimen2_17"
        android:layout_marginStart="@dimen/auto_dimen2_26"
        app:layout_constraintBottom_toTopOf="@+id/stv_exit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_exit_anchor"
        app:layout_goneMarginBottom="@dimen/auto_dimen2_17"
        app:layout_goneMarginTop="@dimen/auto_dimen2_22"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_exit_toll_gate"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/auto_navi_drive_toll_gate"
        app:layout_constraintBottom_toBottomOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintEnd_toEndOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintStart_toStartOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintTop_toTopOf="@+id/siv_turn_by_turn_arrow"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_text_distance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/auto_dimen2_10"
        android:layout_marginEnd="@dimen/auto_dimen2_10"
        app:layout_constraintBottom_toBottomOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/siv_turn_by_turn_arrow"
        app:layout_constraintTop_toTopOf="@+id/siv_turn_by_turn_arrow">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_72"
            android:textColor="@color/auto_color_white"
            android:id="@+id/stv_text_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shadowDayNightStyle="1"
            app:skinDayNightExtraStyle="true"
            app:textColor4Night="@color/navi_card_title_color_night"
            app:textColor4Skin="@color/auto_color_white"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_72"
            android:textColor="@color/auto_color_white"
            android:id="@+id/stv_text_distance_cn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@+id/stv_text_distance"
            app:layout_constraintTop_toTopOf="@+id/stv_text_distance"
            app:shadowDayNightStyle="1"
            app:skinDayNightExtraStyle="true"
            app:textColor4Night="@color/navi_card_title_color_night"
            app:textColor4Skin="@color/auto_color_white"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_30"
            android:textColor="@color/auto_color_white"
            android:id="@+id/stv_text_meter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auto_dimen2_8"
            app:layout_constraintBaseline_toBaselineOf="@+id/stv_text_distance"
            app:layout_constraintStart_toEndOf="@+id/stv_text_distance"
            app:shadowDayNightStyle="1"
            app:skinDayNightExtraStyle="true"
            app:textColor4Night="@color/navi_card_title_color_night"
            app:textColor4Skin="@color/auto_color_white"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_30"
            android:textColor="@color/auto_color_86909B"
            android:id="@+id/stv_text_enter_into"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auto_dimen2_10"
            app:layout_constraintStart_toEndOf="@+id/stv_text_meter"
            app:layout_constraintTop_toTopOf="@+id/stv_text_meter"
            app:shadowDayNightStyle="1"
            app:skinDayNightExtraStyle="true"
            app:textColor4Night="@color/auto_color_86909B"
            app:textColor4Skin="@color/auto_color_86909B"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_30"
            android:textColor="@color/auto_color_white"
            android:ellipsize="end"
            android:id="@+id/stv_text_next_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/stv_text_distance"
            app:shadowDayNightStyle="1"
            app:skinDayNightExtraStyle="true"
            app:textColor4Night="@color/navi_card_title_color_night"
            app:textColor4Skin="@color/auto_color_white"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
