<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/auto_dimen2_16"
    android:layout_width="match_parent"
    android:layout_height="@dimen/auto_dimen2_80">
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/scl_layout"
        android:background="@drawable/auto_navi_energy_background_fui"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/auto_color_ffffff"
        android:id="@+id/stv_text_energy_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/auto_dimen2_24"
        android:layout_marginEnd="@dimen/auto_dimen2_24"
        app:layout_constraintBottom_toBottomOf="@+id/scl_layout"
        app:layout_constraintEnd_toStartOf="@+id/stv_text_energy_distance"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/scl_layout"
        app:layout_constraintTop_toTopOf="@+id/scl_layout"
        app:textColor4Night="@color/auto_color_ffffff"
        app:textColor4Skin="@color/auto_color_ffffff"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/auto_color_ffffff"
        android:id="@+id/stv_text_energy_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginEnd="@dimen/auto_dimen2_2"
        app:layout_constraintBottom_toTopOf="@+id/stv_text_energy_time"
        app:layout_constraintEnd_toStartOf="@+id/stv_text_energy_distance_unit"
        app:layout_constraintTop_toTopOf="@+id/scl_layout"
        app:layout_constraintVertical_chainStyle="packed"
        app:textColor4Night="@color/auto_color_ffffff"
        app:textColor4Skin="@color/auto_color_ffffff"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/auto_color_ffffff"
        android:id="@+id/stv_text_energy_distance_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginEnd="@dimen/auto_dimen2_24"
        app:layout_constraintBottom_toBottomOf="@+id/stv_text_energy_distance"
        app:layout_constraintEnd_toEndOf="@+id/scl_layout"
        app:layout_constraintTop_toTopOf="@+id/stv_text_energy_distance"
        app:textColor4Night="@color/auto_color_ffffff"
        app:textColor4Skin="@color/auto_color_ffffff"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/auto_color_ccffffff"
        android:id="@+id/stv_text_energy_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginEnd="@dimen/auto_dimen2_2"
        app:layout_constraintBottom_toBottomOf="@+id/scl_layout"
        app:layout_constraintEnd_toStartOf="@+id/stv_text_energy_time_unit"
        app:layout_constraintTop_toBottomOf="@+id/stv_text_energy_distance"
        app:textColor4Night="@color/auto_color_ccffffff"
        app:textColor4Skin="@color/auto_color_ccffffff"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/auto_color_ccffffff"
        android:id="@+id/stv_text_energy_time_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginEnd="@dimen/auto_dimen2_24"
        app:layout_constraintBottom_toBottomOf="@+id/stv_text_energy_time"
        app:layout_constraintEnd_toEndOf="@+id/scl_layout"
        app:layout_constraintTop_toTopOf="@+id/stv_text_energy_time"
        app:textColor4Night="@color/auto_color_ccffffff"
        app:textColor4Skin="@color/auto_color_ccffffff"/>
</androidx.constraintlayout.widget.ConstraintLayout>
