<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_top_status"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cbsb_bg"
        android:background="@drawable/custom_normal_card_bg_day"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_48"
        app:background4Night="@drawable/custom_normal_card_bg_night"
        app:background4Skin="@drawable/custom_normal_card_bg_day"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_left_margin"
        android:layout_width="@dimen/auto_dimen2_10"
        android:layout_height="@dimen/auto_dimen2_1"
        app:layout_constraintBottom_toBottomOf="@+id/cbsb_bg"
        app:layout_constraintEnd_toStartOf="@+id/siv_phone"
        app:layout_constraintTop_toTopOf="@+id/cbsb_bg"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_right_margin"
        android:layout_width="@dimen/auto_dimen2_4"
        android:layout_height="@dimen/auto_dimen2_1"
        app:layout_constraintBottom_toBottomOf="@+id/cbsb_bg"
        app:layout_constraintEnd_toEndOf="@+id/cbsb_bg"
        app:layout_constraintTop_toTopOf="@+id/cbsb_bg"/>
    <com.autonavi.view.custom.CustomRedPointSmallView
        android:id="@+id/crps_phone_point"
        android:visibility="gone"
        android:layout_width="@dimen/auto_dimen2_12"
        android:layout_height="@dimen/auto_dimen2_12"
        android:layout_marginLeft="@dimen/auto_dimen2_23"
        android:layout_marginTop="@dimen/auto_dimen2_10"
        app:layout_constraintStart_toStartOf="@+id/siv_phone"
        app:layout_constraintTop_toTopOf="@+id/cbsb_bg"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_phone"
        android:background="@drawable/icon_no_phone_signal_normal_day"
        android:layout_width="@dimen/auto_dimen2_28"
        android:layout_height="@dimen/auto_dimen2_28"
        android:layout_marginTop="@dimen/auto_dimen2_10"
        android:layout_marginBottom="@dimen/auto_dimen2_10"
        android:layout_marginEnd="@dimen/auto_dimen2_4"
        app:background4Night="@drawable/icon_no_phone_signal_normal_night"
        app:background4Skin="@drawable/icon_no_phone_signal_normal_day"
        app:layout_constraintBottom_toBottomOf="@+id/cbsb_bg"
        app:layout_constraintEnd_toStartOf="@+id/siv_wifi"
        app:layout_constraintTop_toTopOf="@+id/cbsb_bg"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_wifi"
        android:background="@drawable/icon_wifi_day_bg"
        android:layout_width="@dimen/auto_dimen2_28"
        android:layout_height="@dimen/auto_dimen2_28"
        android:layout_marginTop="@dimen/auto_dimen2_10"
        android:layout_marginBottom="@dimen/auto_dimen2_10"
        android:layout_marginEnd="@dimen/auto_dimen2_10"
        app:background4Night="@drawable/icon_wifi_night_bg"
        app:background4Skin="@drawable/icon_wifi_day_bg"
        app:layout_constraintBottom_toBottomOf="@+id/cbsb_bg"
        app:layout_constraintEnd_toStartOf="@+id/siv_gps"
        app:layout_constraintTop_toTopOf="@+id/cbsb_bg"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_gps"
        android:layout_width="@dimen/auto_dimen2_28"
        android:layout_height="@dimen/auto_dimen2_28"
        android:layout_marginTop="@dimen/auto_dimen2_10"
        android:layout_marginBottom="@dimen/auto_dimen2_10"
        android:layout_marginEnd="@dimen/auto_dimen2_10"
        app:layout_constraintBottom_toBottomOf="@+id/cbsb_bg"
        app:layout_constraintEnd_toStartOf="@+id/siv_volumn"
        app:layout_constraintTop_toTopOf="@+id/cbsb_bg"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_volumn"
        android:background="@drawable/icon_broadcast_silence_on"
        android:layout_width="@dimen/auto_dimen2_28"
        android:layout_height="@dimen/auto_dimen2_28"
        android:layout_marginTop="@dimen/auto_dimen2_10"
        android:layout_marginBottom="@dimen/auto_dimen2_10"
        android:layout_marginEnd="@dimen/auto_dimen2_4"
        app:background4Night="@drawable/icon_broadcast_silence_on"
        app:background4Skin="@drawable/icon_broadcast_silence_on"
        app:layout_constraintBottom_toBottomOf="@+id/cbsb_bg"
        app:layout_constraintEnd_toStartOf="@+id/siv_status_traffic"
        app:layout_constraintTop_toTopOf="@+id/cbsb_bg"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_status_traffic"
        android:background="@drawable/icon_traffic_open_day_bg"
        android:layout_width="@dimen/auto_dimen2_21"
        android:layout_height="@dimen/auto_dimen2_28"
        android:layout_marginTop="@dimen/auto_dimen2_10"
        android:layout_marginBottom="@dimen/auto_dimen2_10"
        android:layout_marginEnd="@dimen/auto_dimen2_6"
        app:background4Night="@drawable/icon_traffic_open_night_bg"
        app:background4Skin="@drawable/icon_traffic_open_day_bg"
        app:layout_constraintBottom_toBottomOf="@+id/cbsb_bg"
        app:layout_constraintEnd_toStartOf="@+id/stv_time"
        app:layout_constraintTop_toTopOf="@+id/cbsb_bg"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_20"
        android:textColor="@color/custom_text_day_color"
        android:gravity="center"
        android:id="@+id/stv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_12"
        android:layout_marginBottom="@dimen/auto_dimen2_10"
        android:lineSpacingExtra="@dimen/auto_dimen2_8"
        android:fontFamily="sans-serif"
        android:layout_marginEnd="@dimen/auto_dimen2_10"
        app:layout_constraintBottom_toBottomOf="@+id/cbsb_bg"
        app:layout_constraintEnd_toEndOf="@+id/cbsb_bg"
        app:layout_constraintTop_toTopOf="@+id/cbsb_bg"
        app:textColor4Night="@color/color_status_bar_time_night_color"
        app:textColor4Skin="@color/custom_text_day_color"/>
</merge>
