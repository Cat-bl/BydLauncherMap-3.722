<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/auto_dimen2_2"
    android:layout_width="match_parent"
    android:layout_height="@dimen/auto_dimen2_62"
    android:layout_marginStart="@dimen/auto_dimen2_2">
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/space_content"
        android:background="@drawable/custom_low_power_day"
        android:paddingLeft="@dimen/auto_dimen2_6"
        android:paddingTop="@dimen/auto_dimen2_3"
        android:paddingRight="@dimen/auto_dimen2_6"
        android:paddingBottom="@dimen/auto_dimen2_10"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:background4Night="@drawable/custom_low_power_night"
        app:background4Skin="@drawable/custom_low_power_day">
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/icon_oil_low"
            android:background="@drawable/icon_car_oil_low_night_bg"
            android:layout_width="@dimen/auto_dimen2_24"
            android:layout_height="@dimen/auto_dimen2_24"
            android:layout_marginTop="@dimen/auto_dimen2_12"
            android:layout_marginBottom="@dimen/auto_dimen2_12"
            android:layout_marginStart="@dimen/auto_dimen2_24"
            app:background4Night="@drawable/icon_car_oil_low_night_bg"
            app:background4Skin="@drawable/icon_car_oil_low_night_bg"
            app:layout_constraintBottom_toBottomOf="@+id/space_content"
            app:layout_constraintStart_toStartOf="@+id/space_content"
            app:layout_constraintTop_toTopOf="@+id/space_content"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_16"
            android:textColor="@color/custom_text_day_color"
            android:id="@+id/tv_warning_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auto_dimen2_8"
            app:layout_constraintBottom_toBottomOf="@+id/icon_oil_low"
            app:layout_constraintRight_toLeftOf="@+id/tv_go_query"
            app:layout_constraintStart_toEndOf="@+id/icon_oil_low"
            app:layout_constraintTop_toTopOf="@+id/icon_oil_low"
            app:textColor4Night="@color/custom_text_night_color"
            app:textColor4Skin="@color/custom_text_day_color"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_16"
            android:textColor="@color/custom_btn_blue_day_color"
            android:gravity="right"
            android:id="@+id/tv_go_query"
            android:layout_width="@dimen/auto_dimen2_140"
            android:layout_height="wrap_content"
            android:text="@string/electric_warning_find"
            android:layout_marginEnd="@dimen/auto_dimen2_8"
            app:layout_constraintBottom_toBottomOf="@+id/space_content"
            app:layout_constraintRight_toLeftOf="@+id/iv_close"
            app:layout_constraintTop_toTopOf="@+id/space_content"
            app:textColor4Night="@color/custom_btn_blue_night_color"
            app:textColor4Skin="@color/custom_btn_blue_day_color"/>
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/iv_close"
            android:background="@drawable/icon_light_public_close_ss_48"
            android:layout_width="@dimen/auto_dimen2_48"
            android:layout_height="@dimen/auto_dimen2_48"
            android:layout_marginRight="@dimen/auto_dimen2_8"
            android:contentDescription="关闭"
            app:background4Night="@drawable/icon_dark_public_close_ss_48"
            app:background4Skin="@drawable/icon_light_public_close_ss_48"
            app:layout_constraintBottom_toBottomOf="@+id/space_content"
            app:layout_constraintEnd_toEndOf="@+id/space_content"
            app:layout_constraintTop_toTopOf="@+id/space_content"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
