<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_custom_point_new"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/custom_point_new_point_textcolor_day_selector"
        android:gravity="center"
        android:id="@+id/stv_point"
        android:background="@drawable/custom_point_new_point_day_bg_selector"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/custom_point_new_point"
        app:background4Night="@drawable/custom_point_new_point_night_bg_selector"
        app:background4Skin="@drawable/custom_point_new_point_day_bg_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/custom_point_new_point_textcolor_night_selector"
        app:textColor4Skin="@color/custom_point_new_point_textcolor_day_selector"/>
</merge>
