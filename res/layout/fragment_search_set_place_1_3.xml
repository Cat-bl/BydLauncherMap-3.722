<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@id/cl_search_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    app:designHeight="600"
    app:designWidth="1024">

    <com.autonavi.skin.view.SkinConstraintLayout
        android:layout_width="@dimen/auto_dimen2_0"
        android:layout_height="@dimen/auto_dimen2_0"
        android:layout_marginEnd="@dimen/auto_dimen2_32"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/style_card_bg">

        <include
            android:id="@id/layout_top"
            layout="@layout/layout_search_top_bar"
            android:layout_width="0.0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/auto_dimen2_8"
            android:layout_marginTop="@dimen/auto_dimen2_16"
            android:layout_marginEnd="@dimen/auto_dimen2_12"
            app:layout_constraintEnd_toStartOf="@id/stv_start_search"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.autonavi.skin.view.SkinImageView
            android:id="@id/siv_back_to_suggestion_city"
            android:layout_width="@dimen/auto_dimen2_48"
            android:layout_height="@dimen/auto_dimen2_48"
            android:layout_marginStart="@dimen/auto_dimen2_8"
            android:layout_marginTop="@dimen/auto_dimen2_16"
            android:contentDescription="返回"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.autonavi.skin.view.SkinTextView
            android:id="@id/stv_start_search"
            style="@style/SysBtnMediumSecondary"
            android:layout_width="@dimen/auto_dimen2_80"
            android:layout_height="0.0dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="@dimen/auto_dimen2_16"
            android:enabled="false"
            android:gravity="center"
            android:padding="@dimen/auto_dimen2_0"
            android:text="@string/search_button"
            android:textSize="@dimen/auto_font_size_20"
            app:layout_constraintBottom_toBottomOf="@id/layout_top"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/layout_top" />

        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@id/scl_my_location"
            android:layout_width="0.0dp"
            android:layout_height="@dimen/auto_dimen2_48"
            android:layout_marginStart="@dimen/auto_dimen2_8"
            android:layout_marginTop="@dimen/auto_dimen2_16"
            android:layout_marginEnd="@dimen/auto_dimen2_12"
            android:background="@drawable/user_favorite_home_or_company_bg_view_day"
            app:background4Night="@drawable/user_favorite_home_or_company_bg_view_night"
            app:background4Skin="@drawable/user_favorite_home_or_company_bg_view_day"
            app:layout_constraintEnd_toStartOf="@id/scl_select_on_map"
            app:layout_constraintStart_toStartOf="@id/layout_top"
            app:layout_constraintTop_toBottomOf="@id/layout_top">

            <com.autonavi.skin.view.SkinImageView
                android:id="@id/siv_my_location"
                android:layout_width="@dimen/auto_dimen2_24"
                android:layout_height="@dimen/auto_dimen2_24"
                android:layout_marginStart="@dimen/auto_dimen2_12"
                android:src="@drawable/search_set_place_location"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:src4Night="@drawable/search_set_place_location"
                app:src4Skin="@drawable/search_set_place_location_day" />

            <com.autonavi.skin.view.SkinTextView
                android:id="@id/stv_my_location_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/auto_dimen2_8"
                android:text="@string/index_text_my_position"
                android:textColor="@color/byd_search_text_day"
                android:textSize="@dimen/auto_font_size_16"
                app:layout_constraintBottom_toBottomOf="@id/siv_my_location"
                app:layout_constraintStart_toEndOf="@id/siv_my_location"
                app:layout_constraintTop_toTopOf="@id/siv_my_location"
                app:textColor4Night="@color/byd_search_text_night"
                app:textColor4Skin="@color/byd_search_text_day" />
        </com.autonavi.skin.view.SkinConstraintLayout>

        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@id/scl_select_on_map"
            android:layout_width="0.0dp"
            android:layout_height="0.0dp"
            android:background="@drawable/user_favorite_home_or_company_bg_view_day"
            app:background4Night="@drawable/user_favorite_home_or_company_bg_view_night"
            app:background4Skin="@drawable/user_favorite_home_or_company_bg_view_day"
            app:layout_constraintBottom_toBottomOf="@id/scl_my_location"
            app:layout_constraintEnd_toEndOf="@id/stv_start_search"
            app:layout_constraintStart_toEndOf="@id/scl_my_location"
            app:layout_constraintTop_toTopOf="@id/scl_my_location">

            <com.autonavi.skin.view.SkinImageView
                android:id="@id/siv_select_on_map"
                android:layout_width="@dimen/auto_dimen2_24"
                android:layout_height="@dimen/auto_dimen2_24"
                android:layout_marginStart="@dimen/auto_dimen2_12"
                android:src="@drawable/search_set_place_map_point"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:src4Night="@drawable/search_set_place_map_point"
                app:src4Skin="@drawable/search_set_place_map_point" />

            <com.autonavi.skin.view.SkinTextView
                android:id="@id/stv_select_on_map_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/auto_dimen2_8"
                android:text="@string/search_base_fragment_text_map_chose"
                android:textColor="@color/byd_search_text_day"
                android:textSize="@dimen/auto_font_size_16"
                app:layout_constraintBottom_toBottomOf="@id/siv_select_on_map"
                app:layout_constraintStart_toEndOf="@id/siv_select_on_map"
                app:layout_constraintTop_toTopOf="@id/siv_select_on_map"
                app:textColor4Night="@color/byd_search_text_night"
                app:textColor4Skin="@color/byd_search_text_day" />
        </com.autonavi.skin.view.SkinConstraintLayout>

        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@id/cl_no_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scl_my_location"
            app:layout_constraintVertical_bias="0.4">

            <com.autonavi.skin.view.SkinConstraintLayout
                android:id="@id/cdw_default_wrong"
                android:layout_width="@dimen/auto_dimen2_160"
                android:layout_height="@dimen/auto_dimen2_160"
                android:background="@drawable/search_no_history_day"
                app:background4Night="@drawable/search_no_history_night"
                app:background4Skin="@drawable/search_no_history_day"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.autonavi.skin.view.SkinTextView
                android:id="@id/stv_text_no_history"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/auto_dimen2_24"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/auto_dimen2_4"
                android:text="@string/auto_search_around_text_no_history"
                android:textColor="@color/byd_search_home_common_tip_day"
                android:textSize="@dimen/auto_font_size_16"
                app:layout_constraintEnd_toEndOf="@id/cdw_default_wrong"
                app:layout_constraintStart_toStartOf="@id/cdw_default_wrong"
                app:layout_constraintTop_toBottomOf="@id/cdw_default_wrong"
                app:textColor4Night="@color/custom_text_night_color_70"
                app:textColor4Skin="@color/byd_search_home_common_tip_day" />
        </com.autonavi.skin.view.SkinConstraintLayout>

        <com.autonavi.skin.view.SkinListView
            android:id="@id/slv_search_result_listview"
            android:layout_width="0.0dp"
            android:layout_height="0.0dp"
            android:layout_marginStart="@dimen/auto_dimen2_8"
            android:layout_marginTop="@dimen/auto_dimen2_16"
            android:layout_marginEnd="@dimen/auto_dimen2_8"
            android:layout_marginBottom="@dimen/auto_dimen2_12"
            android:cacheColorHint="@color/auto_ui_000000_00"
            android:contentDescription="预搜索列表|纵向"
            android:divider="@null"
            android:dividerHeight="0.0dp"
            android:fastScrollEnabled="false"
            android:footerDividersEnabled="false"
            android:headerDividersEnabled="false"
            android:listSelector="@color/auto_ui_000000_00"
            android:scrollbarSize="@dimen/auto_dimen2_4"
            android:scrollbarStyle="outsideInset"
            android:scrollbarThumbVertical="@drawable/vertical_scrollbar_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scl_my_location" />

        <com.autonavi.skin.view.SkinListView
            android:id="@id/slv_search_result_history_listview"
            android:layout_width="0.0dp"
            android:layout_height="0.0dp"
            android:layout_marginTop="@dimen/auto_dimen2_16"
            android:layout_marginEnd="@dimen/auto_dimen2_8"
            android:layout_marginBottom="@dimen/auto_dimen2_12"
            android:cacheColorHint="@color/auto_ui_000000_00"
            android:contentDescription="搜索历史记录列表|纵向"
            android:divider="@null"
            android:dividerHeight="0.0dp"
            android:fastScrollEnabled="false"
            android:footerDividersEnabled="false"
            android:headerDividersEnabled="false"
            android:listSelector="@color/auto_ui_000000_00"
            android:paddingStart="@dimen/auto_dimen2_16"
            android:paddingEnd="@dimen/auto_dimen2_8"
            android:scrollbarSize="@dimen/auto_dimen2_4"
            android:scrollbarStyle="outsideInset"
            android:scrollbarThumbVertical="@drawable/vertical_scrollbar_bg"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scl_my_location" />

        <include
            android:id="@id/cl_search_suggestion_city"
            layout="@layout/layout_search_suggestion_city"
            android:layout_width="@dimen/auto_dimen2_0"
            android:layout_height="@dimen/auto_dimen2_0"
            android:layout_marginStart="@dimen/auto_dimen2_24"
            android:layout_marginTop="@dimen/auto_dimen2_16"
            android:layout_marginEnd="@dimen/auto_dimen2_24"
            android:layout_marginBottom="@dimen/auto_dimen2_16"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scl_my_location" />
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
