<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/widget_set_parent"
    android:focusable="true"
    android:clickable="true"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:elevation="@dimen/auto_dimen2_10">
    <com.autonavi.skin.view.SkinLinearLayout
        android:orientation="vertical"
        style="@style/style_setting_bg">
        <include layout="@layout/user_tittle_layout"/>
        <com.autonavi.skin.view.SkinLinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/content_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_106">
            <com.autonavi.skin.view.SkinRelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/auto_dimen2_128"
                android:layout_marginEnd="@dimen/auto_dimen2_128">
                <com.autonavi.skin.view.SkinRelativeLayout
                    android:id="@+id/txt_phone_num_layout"
                    android:background="@drawable/user_login_phone_input_bg_day"
                    android:layout_width="@dimen/auto_dimen2_464"
                    android:layout_height="@dimen/auto_dimen2_48"
                    app:background4Night="@drawable/user_login_phone_input_bg_night"
                    app:background4Skin="@drawable/user_login_phone_input_bg_day">
                    <com.autonavi.skin.view.SkinEditText
                        android:textSize="@dimen/auto_font_size_18"
                        android:textColor="@color/custom_text_day_color_100"
                        android:textColorHint="@color/custom_text_day_color_70"
                        android:id="@+id/txt_phone_num"
                        android:background="@null"
                        android:paddingTop="@dimen/auto_dimen2_12"
                        android:paddingBottom="@dimen/auto_dimen2_12"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="@string/user_login_phone_num_hint"
                        android:maxLength="11"
                        android:inputType="phone"
                        android:contentDescription="输入手机号"
                        android:textCursorDrawable="@drawable/auto_search_around_search_around_cursor_drawable"
                        android:paddingStart="@dimen/auto_dimen2_18"
                        android:layout_toStartOf="@+id/phone_number_delete"
                        app:textColor4Night="@color/custom_text_night_color_70"
                        app:textColor4Skin="@color/custom_text_day_color_100"
                        app:textColorHint4Night="@color/custom_text_night_color_70"
                        app:textColorHint4Skin="@color/custom_text_day_color_70"/>
                    <com.autonavi.skin.view.SkinImageView
                        android:id="@+id/phone_number_delete"
                        android:background="@drawable/search_common_tips_clear"
                        android:visibility="gone"
                        android:layout_width="@dimen/auto_dimen2_48"
                        android:layout_height="@dimen/auto_dimen2_48"
                        android:layout_centerVertical="true"
                        android:contentDescription="删除"
                        android:layout_marginStart="@dimen/auto_dimen2_12"
                        android:layout_marginEnd="@dimen/auto_dimen2_20"
                        android:layout_alignParentEnd="true"
                        app:background4Night="@drawable/search_common_tips_clear_night"
                        app:background4Skin="@drawable/search_common_tips_clear"/>
                </com.autonavi.skin.view.SkinRelativeLayout>
                <com.autonavi.skin.view.SkinRelativeLayout
                    android:id="@+id/edit_layout"
                    android:background="@drawable/user_login_phone_input_bg_day"
                    android:visibility="visible"
                    android:layout_width="@dimen/auto_dimen2_288"
                    android:layout_height="@dimen/auto_dimen2_48"
                    android:layout_marginTop="@dimen/auto_dimen2_16"
                    android:layout_below="@+id/txt_phone_num_layout"
                    app:background4Night="@drawable/user_login_phone_input_bg_night"
                    app:background4Skin="@drawable/user_login_phone_input_bg_day">
                    <com.autonavi.skin.view.SkinEditText
                        android:textSize="@dimen/auto_font_size_18"
                        android:textColor="@color/custom_text_day_color_100"
                        android:textColorHint="@color/custom_text_day_color_70"
                        android:id="@+id/txt_verification_code"
                        android:background="@null"
                        android:paddingTop="@dimen/auto_dimen2_12"
                        android:paddingBottom="@dimen/auto_dimen2_12"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="@string/user_login_verification_hint"
                        android:maxLength="6"
                        android:inputType="number"
                        android:contentDescription="输入验证码"
                        android:textCursorDrawable="@drawable/auto_search_around_search_around_cursor_drawable"
                        android:paddingStart="@dimen/auto_dimen2_18"
                        android:layout_toStartOf="@+id/verification_code_delete"
                        app:textColor4Night="@color/custom_text_night_color_70"
                        app:textColor4Skin="@color/custom_text_day_color_100"
                        app:textColorHint4Night="@color/custom_text_night_color_70"
                        app:textColorHint4Skin="@color/custom_text_day_color_70"/>
                    <com.autonavi.skin.view.SkinImageView
                        android:id="@+id/verification_code_delete"
                        android:background="@drawable/search_common_tips_clear"
                        android:visibility="gone"
                        android:layout_width="@dimen/auto_dimen2_48"
                        android:layout_height="@dimen/auto_dimen2_48"
                        android:layout_centerVertical="true"
                        android:contentDescription="删除"
                        android:layout_marginStart="@dimen/auto_dimen2_12"
                        android:layout_marginEnd="@dimen/auto_dimen2_12"
                        android:layout_toStartOf="@+id/txt_get_verification_"
                        app:background4Night="@drawable/search_common_tips_clear_night"
                        app:background4Skin="@drawable/search_common_tips_clear"/>
                    <com.autonavi.skin.view.SkinTextView
                        android:enabled="false"
                        android:gravity="center"
                        android:id="@+id/txt_get_verification_"
                        android:layout_width="@dimen/auto_dimen2_1"
                        android:layout_height="match_parent"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"/>
                </com.autonavi.skin.view.SkinRelativeLayout>
                <com.autonavi.skin.view.SkinTextView
                    android:enabled="false"
                    android:textSize="@dimen/auto_font_size_18"
                    android:textColor="@color/login_and_register_text_color_selector_day"
                    android:gravity="center"
                    android:id="@+id/txt_get_verification"
                    android:background="@drawable/byd_custom_btn_login_day_bg_selector"
                    android:layout_width="@dimen/auto_dimen2_160"
                    android:layout_height="@dimen/auto_dimen2_48"
                    android:layout_marginLeft="@dimen/auto_dimen2_16"
                    android:layout_marginTop="@dimen/auto_dimen2_16"
                    android:text="@string/user_login_get_verification"
                    android:layout_toRightOf="@+id/edit_layout"
                    android:layout_below="@+id/txt_phone_num_layout"
                    app:background4Night="@drawable/byd_custom_btn_login_night_bg_selector"
                    app:background4Skin="@drawable/byd_custom_btn_login_day_bg_selector"
                    app:textColor4Night="@color/login_and_register_text_color_selector_night"
                    app:textColor4Skin="@color/login_and_register_text_color_selector_day"/>
                <com.autonavi.skin.view.SkinTextView
                    android:enabled="false"
                    android:textSize="@dimen/auto_font_size_18"
                    android:textColor="@color/login_and_register_text_color_selector_day"
                    android:gravity="center"
                    android:id="@+id/btn_login_by_verification"
                    android:background="@drawable/byd_custom_btn_login_day_bg_selector"
                    android:padding="@dimen/auto_dimen2_10"
                    android:layout_width="@dimen/auto_dimen2_200"
                    android:layout_height="@dimen/auto_dimen2_48"
                    android:layout_marginTop="@dimen/auto_dimen2_42"
                    android:text="@string/user_login_btn"
                    android:layout_below="@+id/edit_layout"
                    android:layout_centerHorizontal="true"
                    app:background4Night="@drawable/byd_custom_btn_login_night_bg_selector"
                    app:background4Skin="@drawable/byd_custom_btn_login_day_bg_selector"
                    app:textColor4Night="@color/login_and_register_text_color_selector_night"
                    app:textColor4Skin="@color/login_and_register_text_color_selector_day"/>
            </com.autonavi.skin.view.SkinRelativeLayout>
            <com.autonavi.skin.view.SkinLinearLayout
                android:layout_gravity="center"
                android:id="@+id/keyboard_sll"
                android:background="@drawable/bg_keyboard_background_day"
                android:paddingTop="@dimen/auto_dimen2_16"
                android:layout_width="@dimen/auto_dimen2_418"
                android:layout_height="@dimen/auto_dimen2_296"
                android:layout_marginTop="@dimen/auto_dimen2_250"
                app:background4Night="@drawable/bg_keyboard_background"
                app:background4Skin="@drawable/bg_keyboard_background_day">
                <com.autosdk.view.MyKeyBoardView
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/keyboard_view"
                    android:background="#00000000"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#00000000"
                    android:shadowRadius="0"
                    android:keyBackground="@android:color/transparent"
                    android:keyTextSize="@dimen/auto_font_size_28"
                    android:labelTextSize="@dimen/auto_font_size_28"
                    android:keyTextColor="@color/custom_text_night_color_85"/>
            </com.autonavi.skin.view.SkinLinearLayout>
        </com.autonavi.skin.view.SkinLinearLayout>
    </com.autonavi.skin.view.SkinLinearLayout>
</com.autonavi.skin.view.SkinLinearLayout>
