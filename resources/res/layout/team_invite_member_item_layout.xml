<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:layout_gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/invite_member_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/auto_dimen2_24"
    android:paddingStart="@dimen/auto_dimen2_20"
    android:paddingEnd="@dimen/auto_dimen2_20"
    android:layout_marginStart="@dimen/auto_dimen2_10"
    android:layout_marginEnd="@dimen/auto_dimen2_10">
    <com.autonavi.skin.view.SkinRelativeLayout
        android:layout_width="@dimen/auto_dimen2_72"
        android:layout_height="@dimen/auto_dimen2_72">
        <com.autonavi.view.custom.CustomCircleImageView
            android:gravity="center"
            android:layout_width="@dimen/auto_dimen2_72"
            android:layout_height="@dimen/auto_dimen2_72"
            android:src="@drawable/user_team_invite_member_img"
            android:layout_centerInParent="true"/>
    </com.autonavi.skin.view.SkinRelativeLayout>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/custom_text_day_color_55"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_width="@dimen/auto_dimen2_200"
        android:layout_height="@dimen/auto_dimen2_32"
        android:layout_marginTop="@dimen/auto_dimen2_8"
        android:text="@string/user_team_invite_member_title"
        android:maxLines="1"
        android:singleLine="true"
        android:maxLength="7"
        app:textColor4Night="@color/custom_text_night_color_55"
        app:textColor4Skin="@color/custom_text_day_color_55"/>
</com.autonavi.skin.view.SkinLinearLayout>
