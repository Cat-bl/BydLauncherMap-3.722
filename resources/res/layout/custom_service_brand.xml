<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_custom_service_brand"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_bg_green"
        android:background="@drawable/custom_service_brand_bg_green_day_bg_selector"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:background4Night="@drawable/custom_service_brand_bg_green_night_bg_selector"
        app:background4Skin="@drawable/custom_service_brand_bg_green_day_bg_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_bg"
        android:background="@drawable/custom_service_brand_bg_day_bg_selector"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/auto_dimen2_4"
        android:layout_marginTop="@dimen/auto_dimen2_4"
        android:layout_marginRight="@dimen/auto_dimen2_4"
        android:layout_marginBottom="@dimen/auto_dimen2_4"
        app:background4Night="@drawable/custom_service_brand_bg_night_bg_selector"
        app:background4Skin="@drawable/custom_service_brand_bg_day_bg_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
