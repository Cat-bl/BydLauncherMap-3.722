<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_auto_destination_no_history"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_no_history"
        android:background="@drawable/search_no_history_day"
        android:layout_width="@dimen/auto_dimen2_312"
        android:layout_height="@dimen/auto_dimen2_208"
        app:background4Night="@drawable/search_no_history_night"
        app:background4Skin="@drawable/search_no_history_day"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/byd_search_text_day_70"
        android:gravity="center"
        android:id="@+id/stv_text_big"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/search_home_text_big"
        android:lineSpacingExtra="@dimen/auto_dimen2_9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siv_no_history"
        app:textColor4Night="@color/byd_search_text_night_70"
        app:textColor4Skin="@color/byd_search_text_day_70"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_14"
        android:textColor="@color/byd_search_text_day_55"
        android:gravity="left"
        android:id="@+id/stv_text_first"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_30"
        android:layout_marginBottom="@dimen/auto_dimen2_20"
        android:text="@string/search_home_text_first"
        android:lineSpacingExtra="@dimen/auto_dimen2_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/stv_text_big"
        app:layout_constraintHorizontal_bias="0.3"
        app:layout_constraintStart_toStartOf="@+id/stv_text_big"
        app:layout_constraintTop_toBottomOf="@+id/stv_text_big"
        app:textColor4Night="@color/byd_search_text_night_55"
        app:textColor4Skin="@color/byd_search_text_day_55"/>
</com.autonavi.skin.view.SkinConstraintLayout>
