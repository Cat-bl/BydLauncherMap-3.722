        android:id="@+id/setting_navi_avoid_highway_image"
        android:background="@drawable/byd_setting_day_navigation_expressway_no_select"
        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_48"
        android:layout_marginTop="@dimen/auto_dimen2_10"
        android:layout_marginEnd="@dimen/auto_dimen2_8"
