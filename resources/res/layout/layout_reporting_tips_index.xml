<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_reporting_tips"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.view.custom.CustomTipTriangleRightView
        android:id="@+id/cttr_triangle"
        android:layout_width="@dimen/auto_dimen2_13"
        android:layout_height="@dimen/auto_dimen2_19"
        android:layout_marginRight="@dimen/auto_dimen2_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_24"
        android:textColor="@color/text_450_1_textcolor_day_selector"
        android:gravity="center"
        android:id="@+id/stv_reporting_title"
        android:background="@drawable/custom_tip_bg_bg_day_bg_selector"
        android:paddingLeft="@dimen/auto_dimen2_16"
        android:paddingRight="@dimen/auto_dimen2_16"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/auto_dimen2_64"
        android:layout_marginRight="@dimen/auto_dimen2_29"
        android:text="@string/index_reporting_title"
        app:background4Night="@drawable/custom_tip_bg_bg_night_bg_selector"
        app:background4Skin="@drawable/custom_tip_bg_bg_day_bg_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/text_450_1_textcolor_night_selector"
        app:textColor4Skin="@color/text_450_1_textcolor_day_selector"/>
</com.autonavi.skin.view.SkinConstraintLayout>
