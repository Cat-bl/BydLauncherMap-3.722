<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/auto_dimen2_4"/>
            <stroke
                android:width="@dimen/auto_dimen2_1"
                android:color="#05ffffff"/>
            <solid android:color="#66323538"/>
        </shape>
    </item>
    <item
        android:state_selected="true"
        android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/auto_dimen2_4"/>
            <solid android:color="#99dae1eb"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/auto_dimen2_4"/>
            <solid android:color="#ffdae1eb"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/auto_dimen2_4"/>
            <stroke
                android:width="@dimen/auto_dimen2_1"
                android:color="#08ffffff"/>
            <solid android:color="#99323538"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/auto_dimen2_4"/>
            <stroke
                android:width="@dimen/auto_dimen2_1"
                android:color="#0dffffff"/>
            <solid android:color="#ff323538"/>
        </shape>
    </item>
</selector>
