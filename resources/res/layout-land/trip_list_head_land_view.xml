<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/total_distance_layout"
    android:paddingTop="@dimen/auto_dimen2_32"
    android:paddingBottom="@dimen/auto_dimen2_28"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.autonavi.skin.view.SkinLinearLayout
        android:orientation="vertical"
        android:id="@+id/user_total_distance_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_80"
            android:textStyle="bold"
            android:textColor="@color/custom_text_day_color_100"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/user_total_distance_txt"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/auto_dimen2_94"
            android:layout_marginEnd="@dimen/auto_dimen2_8"
            app:textColor4Night="@color/custom_text_night_color_100"
            app:textColor4Skin="@color/custom_text_day_color_100"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_18"
            android:textColor="@color/custom_text_day_color_55"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/user_total_distance_txt_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_my_trips_total_distance_unit"
            app:textColor4Night="@color/custom_text_night_color_55"
            app:textColor4Skin="@color/custom_text_day_color_55"/>
    </com.autonavi.skin.view.SkinLinearLayout>
    <com.autonavi.skin.view.SkinRelativeLayout
        android:id="@+id/msg_none"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_113"
        android:layout_centerHorizontal="true">
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/msg_none_pic"
            android:background="@drawable/search_no_history_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            app:background4Night="@drawable/search_no_history_night"
            app:background4Skin="@drawable/search_no_history_day"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_18"
            android:textColor="@color/custom_text_day_color_70"
            android:gravity="center"
            android:id="@+id/msg_none_txt"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/auto_dimen2_27"
            android:text="@string/set_my_trips_none_list"
            android:layout_below="@+id/msg_none_pic"
            android:layout_centerHorizontal="true"
            android:lineSpacingExtra="@dimen/auto_dimen2_4"
            app:textColor4Night="@color/custom_text_night_color_70"
            app:textColor4Skin="@color/custom_text_day_color_70"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_14"
            android:textColor="@color/custom_text_day_color_55"
            android:gravity="center"
            android:id="@+id/msg_none_txt2"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/auto_dimen2_21"
            android:text="@string/set_my_trips_none_list2"
            android:layout_below="@+id/msg_none_txt"
            android:layout_centerHorizontal="true"
            android:lineSpacingExtra="@dimen/auto_dimen2_4"
            app:textColor4Night="@color/custom_text_night_color_55"
            app:textColor4Skin="@color/custom_text_day_color_55"/>
    </com.autonavi.skin.view.SkinRelativeLayout>
</com.autonavi.skin.view.SkinRelativeLayout>
