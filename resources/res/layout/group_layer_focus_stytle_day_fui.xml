<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scl_focus_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/top_info_layout"
        android:background="@drawable/group_layer_focus_info_bg_day_img_fui"
        android:paddingTop="@dimen/auto_dimen2_2"
        android:paddingBottom="@dimen/auto_dimen2_2"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/auto_dimen2_72"
        android:maxWidth="@dimen/auto_dimen2_220"
        android:minWidth="@dimen/auto_dimen2_100"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/top_info_layout2"
            android:paddingLeft="@dimen/auto_dimen2_3"
            android:paddingRight="@dimen/auto_dimen2_3"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/auto_dimen2_26"
            android:layout_marginBottom="@dimen/auto_dimen2_3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/custom_text_day_color"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auto_dimen2_26"
                android:maxLines="1"
                android:maxEms="4"
                android:paddingStart="@dimen/auto_dimen2_2"/>
            <TextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/custom_text_day_color"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/distance"
                android:layout_width="match_parent"
                android:layout_height="@dimen/auto_dimen2_26"
                android:maxLines="1"
                android:paddingStart="@dimen/auto_dimen2_6"
                android:paddingEnd="@dimen/auto_dimen2_2"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/auto_font_size_16"
            android:textColor="@color/custom_text_day_color"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/auto_dimen2_26"
            android:maxLines="1"/>
    </LinearLayout>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:layout_width="@dimen/auto_dimen2_72"
        android:layout_height="@dimen/auto_dimen2_72"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_info_layout">
        <ImageView
            android:id="@+id/team_layer_normal_head_bg"
            android:background="@drawable/group_layer_focus_head_bg_day_selector_fui"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.autonavi.view.custom.CustomCircleImageView
            android:id="@+id/team_layer_normal_head"
            android:paddingTop="@dimen/auto_dimen2_32"
            android:paddingBottom="@dimen/auto_dimen2_14"
            android:layout_width="@dimen/auto_dimen2_85"
            android:layout_height="@dimen/auto_dimen2_85"
            android:layout_marginRight="@dimen/auto_dimen2_2"
            android:layout_marginBottom="@dimen/auto_dimen2_8"
            android:src="@drawable/icon_user_default_head_180"
            app:layout_constraintBottom_toBottomOf="@+id/team_layer_normal_head_bg"
            app:layout_constraintEnd_toEndOf="@+id/team_layer_normal_head_bg"
            app:layout_constraintStart_toStartOf="@+id/team_layer_normal_head_bg"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
