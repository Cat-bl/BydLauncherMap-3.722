<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/cl_dialog"
    android:background="@drawable/custom_history_operate_bg_day"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="@dimen/auto_dimen2_200"
    app:background4Night="@drawable/custom_history_operate_bg_night"
    app:background4Skin="@drawable/custom_history_operate_bg_day"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/byd_search_text_day"
        android:gravity="start|center_vertical"
        android:id="@+id/stv_item2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/auto_dimen2_60"
        android:text="收藏"
        android:paddingStart="@dimen/auto_dimen2_24"
        app:textColor4Night="@color/byd_search_text_night"
        app:textColor4Skin="@color/byd_search_text_day"/>
    <com.autonavi.view.custom.CustomListLineView
        android:id="@+id/cll_item_bottom_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/auto_dimen2_0_5"
        android:layout_marginLeft="@dimen/auto_dimen2_18"
        android:layout_marginRight="@dimen/auto_dimen2_18"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/byd_search_text_day"
        android:gravity="start|center_vertical"
        android:id="@+id/stv_item1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/auto_dimen2_60"
        android:text="删除记录"
        android:paddingStart="@dimen/auto_dimen2_24"
        app:textColor4Night="@color/byd_search_text_night"
        app:textColor4Skin="@color/byd_search_text_day"/>
</com.autonavi.skin.view.SkinLinearLayout>
