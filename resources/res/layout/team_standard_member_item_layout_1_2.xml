<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/standard_member_layout"
    android:background="@drawable/team_member_item_day_bg_selector"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/auto_dimen2_24"
    android:layout_marginStart="@dimen/auto_dimen2_10"
    android:layout_marginEnd="@dimen/auto_dimen2_10"
    app:background4Night="@drawable/team_member_item_night_bg_selector"
    app:background4Skin="@drawable/team_member_item_day_bg_selector">
    <com.autonavi.skin.view.SkinRelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.autonavi.view.custom.CustomCircleImageView
            android:gravity="center"
            android:id="@+id/civ_member_head"
            android:layout_width="@dimen/auto_dimen2_72"
            android:layout_height="@dimen/auto_dimen2_72"
            android:src="@drawable/icon_user_default_head_72"
            android:layout_centerInParent="true"
            app:civ_border_width="@dimen/auto_dimen2_2"/>
        <com.autonavi.skin.view.SkinTextView
            android:id="@+id/bottom_line"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_below="@+id/civ_member_head"
            android:layout_centerHorizontal="true"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_11"
            android:textColor="@color/color_team_leader_name"
            android:gravity="center"
            android:id="@+id/stv_member_mark"
            android:background="@drawable/team_leader_mark_label_bg_day"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/auto_dimen2_18"
            android:minWidth="@dimen/auto_dimen2_40"
            android:text="@string/user_team_leader_mark_label"
            android:layout_alignRight="@+id/civ_member_head"
            android:layout_alignBottom="@+id/civ_member_head"
            app:background4Night="@drawable/team_leader_mark_label_bg"
            app:background4Skin="@drawable/team_leader_mark_label_bg_day"
            app:textColor4Night="@color/custom_text_night_color_ex"
            app:textColor4Skin="@color/color_team_leader_name"/>
    </com.autonavi.skin.view.SkinRelativeLayout>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/custom_text_day_color_55"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/stv_member_name"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/auto_dimen2_32"
        android:layout_marginTop="@dimen/auto_dimen2_8"
        android:maxLines="1"
        android:maxEms="8"
        app:textColor4Night="@color/custom_text_night_color_55"
        app:textColor4Skin="@color/custom_text_day_color_55"/>
</com.autonavi.skin.view.SkinLinearLayout>
