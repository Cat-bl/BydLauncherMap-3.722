        app:layout_constraintTop_toTopOf="@+id/setting_navi_recommond_route"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_20"
        android:textColor="@color/byd_custom_setting_station_color_day"
        android:gravity="center"
        android:id="@+id/setting_navi_avoid_charge_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/autorouteplansetting_text_little_charge_port"
        android:layout_marginStart="@dimen/auto_dimen2_24"
        app:layout_constraintBottom_toBottomOf="@+id/setting_navi_avoid_charge_image"
        app:layout_constraintStart_toStartOf="@+id/setting_navi_bcv_avoid_charge"
        app:layout_constraintTop_toTopOf="@+id/setting_navi_avoid_charge_image"
        app:textColor4Night="@color/byd_custom_setting_station_color"
        app:textColor4Skin="@color/byd_custom_setting_station_color_day"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/setting_navi_avoid_charge_image"
        android:background="@drawable/byd_setting_day_navigation_nomoney_select"
        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_48"
        android:layout_marginTop="@dimen/auto_dimen2_10"
        android:layout_marginEnd="@dimen/auto_dimen2_8"
        app:background4Night="@drawable/byd_setting_dark_navigation_nomoney_select"
        app:background4Skin="@drawable/byd_setting_day_navigation_nomoney_select"
        app:layout_constraintEnd_toEndOf="@+id/setting_navi_bcv_avoid_charge"
        app:layout_constraintTop_toTopOf="@+id/setting_navi_bcv_avoid_charge"/>
