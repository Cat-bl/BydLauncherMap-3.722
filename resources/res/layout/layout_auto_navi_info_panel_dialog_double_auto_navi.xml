        app:layout_constraintStart_toStartOf="@+id/cvv_traffic_jam"
        app:layout_constraintTop_toTopOf="@+id/cvv_traffic_jam">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_24"
            android:textColor="@color/text_450_7_textcolor_day_selector"
            android:ellipsize="end"
            android:gravity="left"
            android:id="@+id/stv_traffic_descrine"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_17"
            android:maxLines="2"
            android:lineSpacingExtra="@dimen/auto_dimen2_5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/stv_traffic_heading"
            app:layout_constraintTop_toBottomOf="@+id/stv_traffic_heading"
            app:textColor4Night="@color/text_450_7_textcolor_night_selector"
