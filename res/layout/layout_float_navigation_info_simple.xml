<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@color/transparent"
    android:clipChildren="false">

    <com.autonavi.skin.view.SkinImageView
        android:id="@id/si_navi_float_theme_bg"
        android:layout_width="@dimen/auto_dimen2_300"
        android:layout_height="@dimen/auto_dimen2_210"
        android:background="@drawable/navi_float_window_all_bg_day"
        app:background4Night="@drawable/navi_float_window_all_bg_night"
        app:background4Skin="@drawable/navi_float_window_all_bg_day"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@id/si_navi_float_close_view"
        android:layout_width="@dimen/auto_dimen2_56"
        android:layout_height="@dimen/auto_dimen2_56"
        app:layout_constraintEnd_toEndOf="@id/si_navi_float_theme_bg"
        app:layout_constraintTop_toTopOf="@id/si_navi_float_theme_bg" />

    <com.autonavi.skin.view.SkinImageView
        android:id="@id/si_navi_float_close"
        android:layout_width="@dimen/auto_dimen2_40"
        android:layout_height="@dimen/auto_dimen2_40"
        android:layout_marginTop="@dimen/auto_dimen2_8"
        android:layout_marginEnd="@dimen/auto_dimen2_8"
        android:background="@drawable/ic_navi_float_close_day"
        app:background4Night="@drawable/ic_navi_float_close_night"
        app:background4Skin="@drawable/ic_navi_float_close_day"
        app:layout_constraintEnd_toEndOf="@id/si_navi_float_theme_bg"
        app:layout_constraintTop_toTopOf="@id/si_navi_float_theme_bg" />

    <com.autonavi.skin.view.SkinImageView
        android:id="@id/si_navi_float_turn_icon"
        android:layout_width="@dimen/auto_dimen2_64"
        android:layout_height="@dimen/auto_dimen2_64"
        android:layout_marginStart="@dimen/auto_dimen2_16"
        android:layout_marginTop="@dimen/auto_dimen2_18"
        app:layout_constraintStart_toStartOf="@id/si_navi_float_theme_bg"
        app:layout_constraintTop_toTopOf="@id/si_navi_float_theme_bg" />

    <com.autonavi.skin.view.SkinTextView
        android:id="@id/stv_navi_float_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/auto_dimen2_8"
        android:layout_marginTop="@dimen/auto_dimen2_16"
        android:textColor="@color/custom_text_day_color"
        android:textSize="@dimen/auto_font_size_40"
        app:layout_constraintStart_toEndOf="@id/si_navi_float_turn_icon"
        app:layout_constraintTop_toTopOf="@id/si_navi_float_theme_bg"
        app:textColor4Night="@color/custom_text_night_color"
        app:textColor4Skin="@color/custom_text_day_color" />

    <com.autonavi.skin.view.SkinTextView
        android:id="@id/stv_navi_float_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/auto_dimen2_4"
        android:layout_marginTop="@dimen/auto_dimen2_14"
        android:textColor="@color/custom_text_day_color"
        android:textSize="@dimen/auto_font_size_18"
        app:layout_constraintStart_toEndOf="@id/stv_navi_float_distance"
        app:layout_constraintTop_toTopOf="@id/stv_navi_float_distance"
        app:textColor4Night="@color/custom_text_night_color"
        app:textColor4Skin="@color/custom_text_day_color" />

    <com.autonavi.skin.view.SkinTextView
        android:id="@id/stv_text_eta_needtime"
        android:layout_width="@dimen/auto_dimen2_124"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_2"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/custom_text_day_color"
        android:textSize="@dimen/auto_font_size_18"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/stv_navi_float_distance"
        app:layout_constraintTop_toBottomOf="@id/stv_navi_float_distance"
        app:textColor4Night="@color/custom_text_night_color"
        app:textColor4Skin="@color/custom_text_day_color" />

    <View
        android:id="@id/camera_holder"
        android:layout_width="@dimen/auto_dimen2_32"
        android:layout_height="@dimen/auto_dimen2_1"
        android:layout_marginTop="@dimen/auto_dimen2_27"
        android:layout_marginEnd="@dimen/auto_dimen2_44"
        app:layout_constraintEnd_toEndOf="@id/si_navi_float_theme_bg"
        app:layout_constraintTop_toTopOf="@id/si_navi_float_theme_bg" />

    <com.autonavi.skin.view.SkinImageView
        android:id="@id/stv_navi_float_edog_left"
        android:layout_width="@dimen/auto_dimen2_32"
        android:layout_height="@dimen/auto_dimen2_32"
        android:background="@drawable/ic_edog_camera"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/stv_navi_float_edog_right"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@id/camera_holder"
        app:layout_constraintTop_toTopOf="@id/camera_holder" />

    <com.autonavi.skin.view.SkinImageView
        android:id="@id/stv_navi_float_edog_right"
        android:layout_width="@dimen/auto_dimen2_32"
        android:layout_height="@dimen/auto_dimen2_32"
        android:background="@drawable/ic_edog_camera"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/camera_holder"
        app:layout_constraintStart_toEndOf="@id/stv_navi_float_edog_left"
        app:layout_constraintTop_toTopOf="@id/camera_holder" />

    <com.autonavi.skin.view.SkinTextView
        android:id="@id/stv_navi_float_speed_limit"
        android:layout_width="@dimen/auto_dimen2_32"
        android:layout_height="@dimen/auto_dimen2_32"
        android:background="@drawable/ic_speed_limit"
        android:gravity="center"
        android:textColor="@color/navi_card_title_color_day"
        android:textSize="@dimen/auto_font_size_12"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/stv_navi_float_edog_left"
        app:layout_constraintStart_toStartOf="@id/camera_holder"
        app:layout_constraintTop_toTopOf="@id/camera_holder" />

    <com.autonavi.skin.view.SkinTextView
        android:id="@id/stv_navi_float_edog_remain_distance"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/auto_dimen2_20"
        android:layout_marginTop="@dimen/auto_dimen2_34"
        android:gravity="center"
        android:textColor="@color/custom_text_day_color"
        android:textSize="@dimen/auto_font_size_14"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/camera_holder"
        app:layout_constraintStart_toStartOf="@id/camera_holder"
        app:layout_constraintTop_toTopOf="@id/camera_holder"
        app:textColor4Night="@color/custom_text_night_color"
        app:textColor4Skin="@color/custom_text_day_color" />

    <com.autonavi.view.custom.CustomCruiseTrafficLaneView
        android:id="@id/navi_float_traffic_lane"
        android:layout_width="0.0dip"
        android:layout_height="@dimen/auto_dimen2_48"
        android:layout_marginStart="@dimen/auto_dimen2_16"
        android:layout_marginTop="@dimen/auto_dimen2_6"
        android:layout_marginEnd="@dimen/auto_dimen2_16"
        android:gravity="center"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="@id/si_navi_float_theme_bg"
        app:layout_constraintStart_toStartOf="@id/si_navi_float_theme_bg"
        app:layout_constraintTop_toBottomOf="@id/stv_text_eta_needtime" />

    <com.autonavi.view.drive.NaviHorizontalTmcBarView
        android:id="@id/navi_float_traffic_bar"
        android:layout_width="0.0dip"
        android:layout_height="@dimen/auto_dimen2_20"
        android:layout_marginTop="@dimen/auto_dimen2_6"
        android:background="@color/transparent_color"
        app:carIconNavi="@drawable/global_image_traffic_bar_car_label_horizontal"
        app:carIconSizeNavi="@dimen/auto_dimen2_20"
        app:layout_constraintEnd_toEndOf="@id/si_navi_float_theme_bg"
        app:layout_constraintStart_toStartOf="@id/si_navi_float_theme_bg"
        app:layout_constraintTop_toBottomOf="@id/navi_float_traffic_lane"
        app:noTrafficColor="#ff161c22"
        app:noTrafficColorNight="#ff161c22"
        app:trafficBarSizeNavi="@dimen/auto_dimen2_4" />

    <include
        android:id="@id/cl_time_info"
        layout="@layout/layout_include_cl_time_info_float"
        android:layout_width="0.0dip"
        android:layout_height="@dimen/auto_dimen2_42"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/si_navi_float_theme_bg"
        app:layout_constraintStart_toStartOf="@id/si_navi_float_theme_bg"
        app:layout_constraintTop_toBottomOf="@id/navi_float_traffic_bar" />

    <com.autonavi.view.custom.CustomDriveAlarmAnimalView
        android:id="@id/cl_tbt_bottom_dnp_wrapper"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/auto_dimen2_10"
        android:layout_marginEnd="@dimen/auto_dimen2_10"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/si_navi_float_theme_bg"
        app:layout_constraintStart_toStartOf="@id/si_navi_float_theme_bg"
        app:layout_constraintTop_toBottomOf="@id/cl_time_info">

        <com.autonavi.skin.view.SkinView
            android:layout_width="0.0dip"
            android:layout_marginStart="@dimen/auto_dimen2_6"
            android:layout_marginEnd="@dimen/auto_dimen2_6"
            android:layout_marginBottom="@dimen/auto_dimen2_4"
            app:layout_constraintBottom_toTopOf="@id/cl_tbt_bottom_dnp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TbtHorizontalLine" />

        <com.autonavi.view.custom.CustomDriveAlarmFloatWindowView
            android:id="@id/cl_tbt_bottom_dnp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/auto_dimen2_4"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </com.autonavi.view.custom.CustomDriveAlarmAnimalView>

    <Space
        android:id="@id/space1"
        android:layout_width="0.0dip"
        android:layout_height="@dimen/auto_dimen2_8"
        app:layout_constraintEnd_toEndOf="@id/cl_tbt_bottom_dnp_wrapper"
        app:layout_constraintStart_toStartOf="@id/cl_tbt_bottom_dnp_wrapper"
        app:layout_constraintTop_toBottomOf="@id/cl_tbt_bottom_dnp_wrapper" />

    <com.autonavi.view.custom.CustomDnpEndView
        android:id="@id/co_dnp_end"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginStart="@dimen/auto_dimen2_17"
        android:layout_marginTop="@dimen/auto_dimen2_19"
        android:layout_marginEnd="@dimen/auto_dimen2_10"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</com.autonavi.skin.view.SkinConstraintLayout>
