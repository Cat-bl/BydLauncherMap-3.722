<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/byd_search_text_day"
        android:id="@+id/stv_search_suggestion_no_city"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_24"
        android:text="@string/search_suggestion_no_city_tips"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/byd_search_text_night"
        app:textColor4Skin="@color/byd_search_text_day"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/sys_inverseColor_secondary_light"
        android:id="@+id/stv_search_suggestion_choose_city"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_24"
        android:text="@string/search_suggestion_choose_city_tips"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stv_search_suggestion_no_city"
        app:textColor4Night="@color/sys_color_secondary_dark"
        app:textColor4Skin="@color/sys_inverseColor_secondary_light"/>
    <com.autonavi.skin.view.SkinGridView
        android:scrollbarSize="@dimen/auto_dimen2_4"
        android:scrollbarThumbVertical="@drawable/vertical_scrollbar_bg"
        android:scrollbarTrackVertical="@drawable/vertical_scrollbar_track_bg"
        android:scrollbarStyle="outsideInset"
        android:gravity="center"
        android:id="@+id/sgv_search_suggestion_city"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/auto_dimen2_8"
        android:layout_marginTop="@dimen/auto_dimen2_16"
        android:layout_marginRight="@dimen/auto_dimen2_8"
        android:layout_marginBottom="@dimen/auto_dimen2_8"
        android:listSelector="@android:color/transparent"
        android:groupIndicator="@null"
        android:horizontalSpacing="@dimen/auto_dimen2_16"
        android:verticalSpacing="@dimen/auto_dimen2_16"
        android:numColumns="@integer/search_category_num_normal"
        android:divider="@null"
        android:contentDescription="更多列表|纵向"
        android:layout_marginHorizontal="@dimen/auto_dimen2_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stv_search_suggestion_choose_city"/>
</com.autonavi.skin.view.SkinConstraintLayout>
