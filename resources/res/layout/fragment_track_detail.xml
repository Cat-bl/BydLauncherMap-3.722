                    app:textColor4Night="@color/byd_track_total_info_value_text_color_night"
                    app:textColor4Skin="@color/byd_track_total_info_value_text_color_night"/>
            </com.autonavi.skin.view.SkinConstraintLayout>
            <com.autonavi.skin.view.SkinConstraintLayout
