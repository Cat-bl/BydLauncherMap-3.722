<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_auto_search_history_listview_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/auto_dimen2_80"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_14"
        android:textColor="@color/search_item_index_text_day"
        android:gravity="center"
        android:id="@+id/siv_historicalroute"
        android:background="@drawable/auto_search_direction_arrow_day"
        android:layout_width="@dimen/auto_dimen2_22"
        android:layout_height="@dimen/auto_dimen2_16"
        android:layout_marginStart="@dimen/auto_dimen2_8"
        app:background4Night="@drawable/auto_search_direction_arrow_night"
        app:background4Skin="@drawable/auto_search_direction_arrow_day"
        app:layout_constraintBottom_toBottomOf="@+id/stv_text_tittle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/stv_text_tittle"
        app:textColor4Night="@color/search_item_index_text_night"
        app:textColor4Skin="@color/search_item_index_text_day"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_20"
        android:textColor="@color/custom_text_day_color_100"
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/stv_text_tittle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_15"
        android:text="@string/auto_search_around_text_tittle"
        android:maxLines="1"
        android:lineSpacingExtra="@dimen/auto_dimen2_4"
        android:layout_marginStart="@dimen/auto_dimen2_10"
        app:layout_constraintBottom_toTopOf="@+id/stv_text_font"
        app:layout_constraintEnd_toStartOf="@+id/scl_text_tittle_right"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/siv_historicalroute"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"
        app:layout_goneMarginEnd="@dimen/auto_dimen2_10"
        app:textColor4Night="@color/byd_search_text_night"
        app:textColor4Skin="@color/custom_text_day_color_100"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/scl_text_tittle_right"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/auto_dimen2_86"
        android:layout_marginStart="@dimen/auto_dimen2_40"
        android:layout_marginEnd="@dimen/auto_dimen2_48"
        app:layout_constraintBottom_toBottomOf="@+id/stv_text_tittle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/stv_text_tittle"
        app:layout_constraintTop_toTopOf="@+id/stv_text_tittle">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_14"
            android:textColor="@color/route_history_listview_item_source_name_day"
            android:gravity="center"
            android:id="@+id/stv_text_route_source"
            android:background="@drawable/item_auto_search_route_listview_item_route_source_night"
            android:paddingLeft="@dimen/auto_dimen2_5"
            android:paddingRight="@dimen/auto_dimen2_5"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/auto_dimen2_24"
            android:text="@string/route_history_listview_item_source_copilot_name"
            app:background4Night="@drawable/item_auto_search_route_listview_item_route_source_night"
            app:background4Skin="@drawable/item_auto_search_route_listview_item_route_source_day"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/route_history_listview_item_source_name_night"
            app:textColor4Skin="@color/route_history_listview_item_source_name_day"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/byd_search_text_day_55"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/stv_text_way_point_tip"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_search_result_map_way_point"
        android:singleLine="true"
        android:paddingEnd="@dimen/auto_dimen2_2"
        android:layout_marginEnd="@dimen/auto_dimen2_4"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/stv_text_font"
        app:layout_constraintEnd_toStartOf="@+id/stv_text_font"
        app:layout_constraintStart_toStartOf="@+id/stv_text_tittle"
        app:layout_constraintTop_toTopOf="@+id/stv_text_font"
        app:textColor4Night="@color/byd_search_text_night_55"
        app:textColor4Skin="@color/byd_search_text_day_55"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/byd_search_text_day_55"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/stv_text_font"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_8"
        android:text="@string/auto_search_around_text_font"
        android:singleLine="true"
        android:lineSpacingExtra="@dimen/auto_dimen2_4"
        android:layout_marginEnd="@dimen/auto_dimen2_34"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/cll_item_bottom_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/stv_text_way_point_tip"
        app:layout_constraintTop_toBottomOf="@+id/stv_text_tittle"
        app:textColor4Night="@color/byd_search_text_night_55"
        app:textColor4Skin="@color/byd_search_text_day_55"/>
    <com.autonavi.view.custom.CustomListLineView
        android:id="@+id/cll_item_bottom_line"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_0_1"
        android:layout_marginTop="@dimen/auto_dimen2_12"
        android:layout_marginEnd="@dimen/auto_dimen2_34"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/siv_historicalroute"
        app:layout_constraintTop_toBottomOf="@+id/stv_text_font"/>
</com.autonavi.skin.view.SkinConstraintLayout>
