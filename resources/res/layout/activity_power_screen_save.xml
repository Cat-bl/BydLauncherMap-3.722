<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/screen_3d_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/mScreenSaver"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/power_layout"
        android:background="@drawable/byd_custom_power_wallpaper_bg_day"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginBottom="167dp"
        android:minWidth="194dp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        app:background4Night="@drawable/byd_custom_power_wallpaper_bg_night"
        app:background4Skin="@drawable/byd_custom_power_wallpaper_bg_day"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/siv_multe"
            android:background="@drawable/byd_custom_power_wallpaper_bg_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/siv_multe_icon"
            android:background="@drawable/ic_icon_power_screen_saver"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.autonavi.skin.view.SkinTextView
            android:textColor="@color/sys_color_default_light"
            android:id="@+id/stv_multe_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="@string/screen_save_power_text"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/siv_multe_icon"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Sys.TextAppearance.Body1"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
