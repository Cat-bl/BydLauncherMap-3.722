<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/index_light_home_login_hint_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/auto_dimen2_57"
    app:background4Night="@drawable/index_dark_home_login_hint_bg"
    app:background4Skin="@drawable/index_light_home_login_hint_bg"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_dimen2_16"
        android:textColor="@color/custom_head_text_day_color"
        android:ellipsize="end"
        android:id="@+id/m_sl_text_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/auto_dimen2_13"
        android:maxLines="1"
        android:layout_marginStart="@dimen/auto_dimen2_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/m_iv_exit_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:textColor4Night="@color/text_450_18_textcolor_night_normal"
        app:textColor4Skin="@color/custom_head_text_day_color"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/m_iv_exit_bg"
        android:background="@drawable/icon_light_public_close_ss_48"
        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_48"
        app:background4Night="@drawable/icon_dark_public_close_ss_48"
        app:background4Skin="@drawable/icon_light_public_close_ss_48"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</com.autonavi.skin.view.SkinConstraintLayout>
