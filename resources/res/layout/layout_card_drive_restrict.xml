<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_navigation_info_landscape_low_power"
    android:layout_width="match_parent"
    android:layout_height="@dimen/auto_dimen2_160"
    android:minHeight="@dimen/auto_dimen2_160"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinView
        android:background="@drawable/custom_normal_card_bg_day"
        android:paddingLeft="@dimen/auto_dimen2_6"
        android:paddingTop="@dimen/auto_dimen2_4"
        android:paddingRight="@dimen/auto_dimen2_6"
        android:paddingBottom="@dimen/auto_dimen2_10"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:background4Night="@drawable/custom_normal_card_bg_night"
        app:background4Skin="@drawable/custom_normal_card_bg_day"
        app:layout_constraintBottom_toBottomOf="@+id/layout_navigation_info_landscape_low_power"
        app:layout_constraintEnd_toEndOf="@+id/layout_navigation_info_landscape_low_power"
        app:layout_constraintStart_toStartOf="@+id/layout_navigation_info_landscape_low_power"
        app:layout_constraintTop_toTopOf="@+id/layout_navigation_info_landscape_low_power"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/cl_chargingstation"
        android:background="@drawable/auto_navi_drive_icon_restrict"
        android:layout_width="@dimen/auto_dimen2_24"
        android:layout_height="@dimen/auto_dimen2_24"
        android:layout_marginTop="@dimen/auto_dimen2_20"
        android:layout_marginStart="@dimen/auto_dimen2_24"
        app:background4Night="@drawable/auto_navi_drive_icon_restrict"
        app:background4Skin="@drawable/auto_navi_drive_icon_restrict"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/navi_card_subtitle_color_day"
        android:ellipsize="end"
        android:gravity="top|left"
        android:id="@+id/tv_policy_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_12"
        android:text="@string/restrict_warning_tip"
        android:maxLines="2"
        android:layout_marginEnd="@dimen/auto_dimen2_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/cl_chargingstation"
        app:layout_constraintTop_toBottomOf="@+id/cl_chargingstation"
        app:textColor4Night="@color/navi_card_subtitle_color_night"
        app:textColor4Skin="@color/navi_card_subtitle_color_day"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv1"
        android:layout_width="@dimen/auto_dimen2_40"
        android:layout_height="@dimen/auto_dimen2_40"
        android:src="@drawable/auto_navi_drive_icon_restrict_notify"
        app:layout_constraintBottom_toBottomOf="@+id/tv_policy_des"
        app:layout_constraintEnd_toStartOf="@+id/tv_policy_des"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_policy_des"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_20"
        android:textColor="@color/navi_card_title_color_day"
        android:id="@+id/tv_policy_des"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/auto_dimen2_28"
        android:text="@string/restrict_warning_not_avoid"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/siv1"
        app:textColor4Night="@color/navi_card_title_color_night"
        app:textColor4Skin="@color/navi_card_title_color_day"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_20"
        android:textColor="@color/navi_card_title_color_day"
        android:gravity="center"
        android:id="@+id/tv_policy_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/restrict_warning_tip"
        android:singleLine="true"
        android:layout_marginStart="@dimen/auto_dimen2_8"
        app:layout_constraintBottom_toBottomOf="@+id/cl_chargingstation"
        app:layout_constraintStart_toEndOf="@+id/cl_chargingstation"
        app:layout_constraintTop_toTopOf="@+id/cl_chargingstation"
        app:textColor4Night="@color/navi_card_title_color_night"
        app:textColor4Skin="@color/navi_card_title_color_day"/>
</com.autonavi.skin.view.SkinConstraintLayout>
