<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_navigation_info"
    android:layout_width="@dimen/auto_dimen2_322"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_tbt_bottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ac_navigation_info_land">
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/cvn_eta"
            android:background="@drawable/navi_normal_card_split_bottom_bg_day"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:background4Night="@drawable/navi_normal_card_split_bottom_bg_night"
            app:background4Skin="@drawable/navi_normal_card_split_bottom_bg_day"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shadowColor="@color/auto_ui_000000_33"
            app:shadowColorNight="@color/auto_ui_000000_33"
            app:shadowCorner="@dimen/auto_dimen2_0"
            app:shadowCornerBottomLeft="@dimen/auto_dimen2_4"
            app:shadowCornerBottomRight="@dimen/auto_dimen2_4"
            app:shadowCornerTopLeft="@dimen/auto_dimen2_0"
            app:shadowCornerTopRight="@dimen/auto_dimen2_0"
            app:shadowDx="@dimen/auto_dimen2_0"
            app:shadowDy="@dimen/auto_dimen2_2"
            app:shadowRadius="@dimen/auto_dimen2_8"
            app:shadowShapeType="rectangle"
            app:shadowSide="all"
            app:shadowVisibility="true"/>
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/siv_tbt_bottom_space"
            android:layout_width="0dp"
            android:layout_height="@dimen/auto_dimen2_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cl_energy"/>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/cl_time_info"
            android:layout_width="0dp"
            android:layout_height="@dimen/auto_dimen2_48"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.autonavi.skin.view.SkinConstraintLayout
                android:id="@+id/cl_etc_time"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/auto_dimen2_56"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/navi_info_card_eta_text_size_main_land"
                    android:textColor="@color/auto_color_24313F"
                    android:gravity="center"
                    android:id="@+id/stv_text_eta_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:lineSpacingExtra="@dimen/auto_dimen2_4"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:textColor4Night="@color/auto_color_EBF4FE"
                    app:textColor4Skin="@color/auto_color_24313F"/>
                <com.autonavi.skin.view.SkinTextView
                    android:textSize="@dimen/navi_info_card_eta_text_size_vice_land"
                    android:textColor="@color/auto_color_24313F"
                    android:gravity="center"
                    android:id="@+id/stv_text_eta_daytime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/auto_dimen2_3"
                    android:singleLine="true"
                    android:lineSpacingExtra="@dimen/auto_dimen2_3"
                    app:layout_constraintStart_toEndOf="@+id/stv_text_eta_time"
                    app:layout_constraintTop_toTopOf="parent"
                    app:textColor4Night="@color/auto_color_EBF4FE"
                    app:textColor4Skin="@color/auto_color_24313F"/>
            </com.autonavi.skin.view.SkinConstraintLayout>
        </com.autonavi.skin.view.SkinConstraintLayout>
        <com.autonavi.skin.view.SkinView
            android:id="@+id/view1"
            android:background="@color/auto_color_D2DFE8"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/auto_dimen2_24"
            android:layout_marginEnd="@dimen/auto_dimen2_24"
            app:background4Night="@color/auto_color_0FFFFFFF"
            app:background4Skin="@color/auto_color_D2DFE8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_energy"
        android:background="@drawable/auto_navi_energy_background"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_68"
        android:layout_marginTop="@dimen/auto_dimen2_16"
        android:layout_marginBottom="@dimen/auto_dimen2_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_tbt_bottom"
        app:layout_constraintVertical_bias="0">
        <com.autonavi.view.custom.CustomEnergyConsthumbView
            android:id="@+id/cec_energy"
            android:visibility="gone"
            android:layout_width="@dimen/auto_dimen2_102"
            android:layout_height="@dimen/auto_dimen2_36"
            android:layout_marginLeft="@dimen/auto_dimen2_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_24"
            android:textColor="@color/auto_color_EBF4FE"
            android:ellipsize="end"
            android:gravity="left"
            android:id="@+id/stv_text_energy_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/auto_dimen2_12"
            android:singleLine="true"
            android:lineSpacingExtra="@dimen/auto_dimen2_9"
            android:layout_marginStart="@dimen/auto_dimen2_28"
            android:layout_marginEnd="@dimen/auto_dimen2_28"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/stv_text_energy_distance"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/auto_color_EBF4FE"
            app:textColor4Skin="@color/auto_color_EBF4FE"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_32"
            android:textColor="@color/auto_color_EBF4FE"
            android:id="@+id/stv_text_energy_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:lineSpacingExtra="@dimen/auto_dimen2_9"
            android:layout_marginEnd="@dimen/auto_dimen2_2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/stv_text_energy_distance_unit"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/auto_color_EBF4FE"
            app:textColor4Skin="@color/auto_color_EBF4FE"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_22"
            android:textColor="@color/auto_color_EBF4FE"
            android:id="@+id/stv_text_energy_distance_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:lineSpacingExtra="@dimen/auto_dimen2_9"
            android:layout_marginEnd="@dimen/auto_dimen2_28"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/auto_color_EBF4FE"
            app:textColor4Skin="@color/auto_color_EBF4FE"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/auto_dimen2_16"
        app:layout_constraintTop_toBottomOf="@+id/cl_energy"/>
    <com.autonavi.adapter.container.ACNavigationInfoLandAutoNaviSimpleView
        android:id="@+id/ac_navigation_info_land"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_120"
        app:interface_key="navigation_info_land"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.autonavi.skin.view.SkinConstraintLayout>
