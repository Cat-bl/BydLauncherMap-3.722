<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/auto_dimen2_39" />
            <solid android:color="@color/custom_alarm_bg_day_pressed" />
        </shape>
    </item>
    <item android:state_pressed="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/auto_dimen2_39" />
            <solid android:color="@color/denza_custom_alarm_bg_day" />
        </shape>
    </item>
    <item android:state_enabled="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/auto_dimen2_39" />
            <solid android:color="@color/custom_alarm_bg_day" />
        </shape>
    </item>
</selector>
