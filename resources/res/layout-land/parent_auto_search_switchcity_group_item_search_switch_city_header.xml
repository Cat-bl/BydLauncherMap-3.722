<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/auto_dimen2_16"
    android:paddingEnd="0dp"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/byd_search_text_day_55"
        android:gravity="left"
        android:id="@+id/stv_text_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_24"
        android:text="@string/search_switch_city_text_switchcity"
        android:lineSpacingExtra="@dimen/auto_dimen2_4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/byd_search_text_night_55"
        app:textColor4Skin="@color/byd_search_text_day_55"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_often_city"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/stv_text_label"
        app:layout_constraintTop_toBottomOf="@+id/stv_text_label">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_18"
            android:textColor="@color/byd_custom_normal_btn_text_color_selector_day"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/stv_text_switchcity_1"
            android:background="@drawable/search_home_btn_bg_day_selector"
            android:paddingTop="@dimen/auto_dimen2_10"
            android:paddingBottom="@dimen/auto_dimen2_10"
            android:layout_width="@dimen/auto_dimen2_144"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_8"
            android:layout_marginBottom="@dimen/auto_dimen2_18"
            android:text="@string/search_home_text_city"
            android:maxLines="1"
            android:maxEms="6"
            android:lineSpacingExtra="@dimen/auto_dimen2_4"
            android:paddingStart="@dimen/auto_dimen2_20"
            android:paddingEnd="@dimen/auto_dimen2_20"
            android:layout_marginStart="@dimen/auto_dimen2_2"
            app:background4Night="@drawable/search_home_btn_bg_night_selector"
            app:background4Skin="@drawable/search_home_btn_bg_day_selector"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/stv_text_switchcity_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/byd_custom_normal_btn_text_color_selector_night"
            app:textColor4Skin="@color/byd_custom_normal_btn_text_color_selector_day"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_18"
            android:textColor="@color/byd_custom_normal_btn_text_color_selector_day"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/stv_text_switchcity_2"
            android:background="@drawable/search_home_btn_bg_day_selector"
            android:paddingTop="@dimen/auto_dimen2_10"
            android:paddingBottom="@dimen/auto_dimen2_10"
            android:layout_width="@dimen/auto_dimen2_144"
            android:layout_height="wrap_content"
            android:text="@string/search_city_shanghai"
            android:maxLines="1"
            android:maxEms="6"
            android:lineSpacingExtra="@dimen/auto_dimen2_4"
            android:paddingStart="@dimen/auto_dimen2_20"
            android:paddingEnd="@dimen/auto_dimen2_20"
            android:layout_marginStart="@dimen/auto_dimen2_16"
            app:background4Night="@drawable/search_home_btn_bg_night_selector"
            app:background4Skin="@drawable/search_home_btn_bg_day_selector"
            app:layout_constraintBottom_toBottomOf="@+id/stv_text_switchcity_1"
            app:layout_constraintEnd_toStartOf="@+id/stv_text_switchcity_3"
            app:layout_constraintStart_toEndOf="@+id/stv_text_switchcity_1"
            app:layout_constraintTop_toTopOf="@+id/stv_text_switchcity_1"
            app:textColor4Night="@color/byd_custom_normal_btn_text_color_selector_night"
            app:textColor4Skin="@color/byd_custom_normal_btn_text_color_selector_day"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_18"
            android:textColor="@color/byd_custom_normal_btn_text_color_selector_day"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/stv_text_switchcity_3"
            android:background="@drawable/search_home_btn_bg_day_selector"
            android:paddingTop="@dimen/auto_dimen2_10"
            android:paddingBottom="@dimen/auto_dimen2_10"
            android:layout_width="@dimen/auto_dimen2_144"
            android:layout_height="wrap_content"
            android:text="@string/search_city_guangzhou"
            android:maxLines="1"
            android:maxEms="6"
            android:lineSpacingExtra="@dimen/auto_dimen2_4"
            android:paddingStart="@dimen/auto_dimen2_20"
            android:paddingEnd="@dimen/auto_dimen2_20"
            android:layout_marginStart="@dimen/auto_dimen2_16"
            app:background4Night="@drawable/search_home_btn_bg_night_selector"
            app:background4Skin="@drawable/search_home_btn_bg_day_selector"
            app:layout_constraintBottom_toBottomOf="@+id/stv_text_switchcity_2"
            app:layout_constraintEnd_toStartOf="@+id/stv_text_switchcity_4"
            app:layout_constraintStart_toEndOf="@+id/stv_text_switchcity_2"
            app:layout_constraintTop_toTopOf="@+id/stv_text_switchcity_2"
            app:textColor4Night="@color/byd_custom_normal_btn_text_color_selector_night"
            app:textColor4Skin="@color/byd_custom_normal_btn_text_color_selector_day"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_18"
            android:textColor="@color/byd_custom_normal_btn_text_color_selector_day"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/stv_text_switchcity_4"
            android:background="@drawable/search_home_btn_bg_day_selector"
            android:paddingTop="@dimen/auto_dimen2_10"
            android:paddingBottom="@dimen/auto_dimen2_10"
            android:layout_width="@dimen/auto_dimen2_144"
            android:layout_height="wrap_content"
            android:text="@string/search_city_shenzhen"
            android:maxLines="1"
            android:maxEms="6"
            android:lineSpacingExtra="@dimen/auto_dimen2_4"
            android:paddingStart="@dimen/auto_dimen2_20"
            android:paddingEnd="@dimen/auto_dimen2_20"
            android:layout_marginStart="@dimen/auto_dimen2_16"
            android:layout_marginEnd="@dimen/auto_dimen2_2"
            app:background4Night="@drawable/search_home_btn_bg_night_selector"
            app:background4Skin="@drawable/search_home_btn_bg_day_selector"
            app:layout_constraintBottom_toBottomOf="@+id/stv_text_switchcity_3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/stv_text_switchcity_3"
            app:layout_constraintTop_toTopOf="@+id/stv_text_switchcity_3"
            app:textColor4Night="@color/byd_custom_normal_btn_text_color_selector_night"
            app:textColor4Skin="@color/byd_custom_normal_btn_text_color_selector_day"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
