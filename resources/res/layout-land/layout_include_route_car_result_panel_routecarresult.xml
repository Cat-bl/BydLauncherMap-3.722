<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_route_car_result_panel"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <include
        android:id="@+id/ct_auto_route_fromto_combine"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_include_route_fromto_combine"/>
    <include
        android:id="@+id/ac_bottom_left_home_position"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_80"
        android:layout_marginBottom="@dimen/auto_dimen2_18"
        app:interface_key="bottom_left_home_position"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/layout_no_home_bottom_left_routecarresult"/>
    <ScrollView
        android:orientation="vertical"
        android:id="@+id/route_panel_scroll"
        android:scrollbars="none"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/auto_dimen2_16"
        app:layout_constraintBottom_toTopOf="@+id/ac_bottom_left_home_position"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ct_auto_route_fromto_combine">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ct_auto_route_panel_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
    <com.autonavi.skin.view.SkinView
        android:id="@+id/sv_bottom_fade"
        android:background="@drawable/shape_listview_edge_gradient_day"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_12"
        android:layout_marginTop="@dimen/auto_dimen2_16"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/auto_dimen2_12"
        android:layout_marginEnd="@dimen/auto_dimen2_12"
        app:background4Night="@drawable/shape_listview_edge_gradient_night"
        app:background4Skin="@drawable/shape_listview_edge_gradient_day"
        app:layout_constraintBottom_toBottomOf="@+id/route_panel_scroll"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/route_panel_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="route_panel_scroll,ac_bottom_left_home_position"/>
    <com.autonavi.skin.view.SkinLinearLayout
        android:gravity="center"
        android:id="@+id/no_permission_sll"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ct_auto_route_fromto_combine">
        <com.autonavi.skin.view.SkinImageView
            android:background="@drawable/icon_setting_img_about_content_refresh_day"
            android:layout_width="@dimen/auto_font_size_48"
            android:layout_height="@dimen/auto_font_size_48"
            app:background4Night="@drawable/icon_setting_img_about_content_refresh_day"
            app:background4Skin="@drawable/auto_navi_drive_button_refresh_night"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_20"
            android:textColor="@color/text_450_1_textcolor_day_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="路线失败，请稍后重试"
            app:textColor4Night="@color/text_450_4_textcolor_night_normal"
            app:textColor4Skin="@color/text_450_1_textcolor_day_normal"/>
    </com.autonavi.skin.view.SkinLinearLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
