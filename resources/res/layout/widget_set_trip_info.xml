<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/widget_set_car_info_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinRelativeLayout
        android:gravity="center"
        android:background="@drawable/custom_prediction_info_day_bg"
        android:padding="@dimen/auto_dimen2_20"
        android:layout_width="@dimen/auto_dimen2_0"
        android:layout_height="match_parent"
        android:layout_weight="1"
        app:background4Night="@drawable/custom_prediction_info_day_night_bg"
        app:background4Skin="@drawable/custom_prediction_info_day_bg">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_28"
            android:textColor="@color/byd_text_450_1_textcolor_day_selector"
            android:id="@+id/user_trip_km"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            app:textColor4Night="@color/text_450_1_textcolor_night_selector"
            app:textColor4Skin="@color/text_450_1_textcolor_day_selector"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_20"
            android:textColor="@color/byd_text_450_1_textcolor_day_selector"
            android:id="@+id/user_trip_km_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_trip_km_unit"
            android:layout_toRightOf="@+id/user_trip_km"
            android:layout_alignBottom="@+id/user_trip_km"
            app:textColor4Night="@color/text_450_1_textcolor_night_selector"
            app:textColor4Skin="@color/text_450_1_textcolor_day_selector"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_20"
            android:textColor="@color/byd_text_450_1_textcolor_day_selector"
            android:id="@+id/user_trip_km_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_10"
            android:text="@string/user_trip_km_tip"
            android:layout_below="@+id/user_trip_km"
            app:textColor4Night="@color/text_450_1_textcolor_night_selector"
            app:textColor4Skin="@color/text_450_1_textcolor_day_selector"/>
    </com.autonavi.skin.view.SkinRelativeLayout>
    <com.autonavi.skin.view.SkinView
        android:background="@color/auto_color_b2c5d5ea"
        android:visibility="gone"
        android:layout_width="@dimen/auto_dimen2_2"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_30"
        android:layout_marginBottom="@dimen/auto_dimen2_30"/>
    <com.autonavi.skin.view.SkinRelativeLayout
        android:gravity="center"
        android:background="@drawable/custom_prediction_info_day_bg"
        android:padding="@dimen/auto_dimen2_20"
        android:layout_width="@dimen/auto_dimen2_0"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/auto_dimen2_10"
        app:background4Night="@drawable/custom_prediction_info_day_night_bg"
        app:background4Skin="@drawable/custom_prediction_info_day_bg">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_28"
            android:textColor="@color/byd_text_450_1_textcolor_day_selector"
            android:id="@+id/user_trip_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            app:textColor4Night="@color/text_450_1_textcolor_night_selector"
            app:textColor4Skin="@color/text_450_1_textcolor_day_selector"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_20"
            android:textColor="@color/byd_text_450_1_textcolor_day_selector"
            android:id="@+id/user_trip_city_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_trip_city_unit"
            android:layout_toRightOf="@+id/user_trip_city"
            android:layout_alignBottom="@+id/user_trip_city"
            app:textColor4Night="@color/text_450_1_textcolor_night_selector"
            app:textColor4Skin="@color/text_450_1_textcolor_day_selector"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_20"
            android:textColor="@color/byd_text_450_1_textcolor_day_selector"
            android:id="@+id/user_trip_city_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_10"
            android:text="@string/user_trip_city_tip"
            android:layout_below="@+id/user_trip_city"
            app:textColor4Night="@color/text_450_1_textcolor_night_selector"
            app:textColor4Skin="@color/text_450_1_textcolor_day_selector"/>
    </com.autonavi.skin.view.SkinRelativeLayout>
</com.autonavi.skin.view.SkinLinearLayout>
