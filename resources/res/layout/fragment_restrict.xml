<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinConstraintLayout
        android:background="#3d4146"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/auto_dimen2_20"
        android:layout_marginTop="@dimen/auto_dimen2_20"
        android:layout_marginBottom="@dimen/auto_dimen2_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.4">
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/iv_back"
            android:background="@drawable/auto_search_result_map_back"
            android:layout_width="@dimen/auto_dimen2_38"
            android:layout_height="@dimen/auto_dimen2_42"
            android:layout_marginLeft="@dimen/auto_dimen2_20"
            android:layout_marginTop="@dimen/auto_dimen2_20"
            android:scaleType="fitXY"
            android:layout_marginStart="@dimen/auto_dimen2_20"
            app:background4Skin="@drawable/auto_search_result_map_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_28"
            android:textColor="@color/text_450_1_textcolor_day_selector"
            android:id="@+id/tv_warning_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/restrict_policy"
            app:layout_constraintBottom_toBottomOf="@+id/iv_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_back"
            app:textColor4Night="@color/text_450_1_textcolor_night_selector"
            app:textColor4Skin="@color/text_450_1_textcolor_day_selector"/>
        <com.autonavi.view.custom.CustomVerticalLineView
            android:id="@+id/line"
            android:background="@color/auto_color_white"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auto_dimen2_2"
            android:layout_marginTop="@dimen/auto_dimen2_20"
            app:layout_constraintTop_toBottomOf="@+id/iv_back"/>
        <com.autonavi.skin.view.SkinListView
            android:id="@+id/slv_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:divider="#43474c"
            android:dividerHeight="1px"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/line"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
    <com.autonavi.view.custom.CustomBtnCircular3View
        android:id="@+id/cbc_search"
        android:layout_width="@dimen/auto_dimen2_64"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/auto_dimen2_20"
        android:layout_marginBottom="@dimen/auto_dimen2_11"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:shadowColor="@color/auto_ui_000000_33"
        app:shadowColorNight="@color/auto_ui_000000_33"
        app:shadowCorner="@dimen/auto_dimen2_6"
        app:shadowCornerBottomLeft="@dimen/auto_dimen2_0"
        app:shadowCornerBottomRight="@dimen/auto_dimen2_0"
        app:shadowCornerTopLeft="@dimen/auto_dimen2_0"
        app:shadowCornerTopRight="@dimen/auto_dimen2_0"
        app:shadowDx="@dimen/auto_dimen2_0"
        app:shadowDy="@dimen/auto_dimen2_2"
        app:shadowRadius="@dimen/auto_dimen2_8"
        app:shadowShapeType="rectangle"
        app:shadowSide="all"
        app:shadowVisibility="true"/>
    <com.autonavi.view.custom.CustomBarStatusView
        android:id="@+id/cbs_search"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/auto_dimen2_72"
        android:layout_marginTop="@dimen/auto_dimen2_24"
        android:layout_marginRight="@dimen/auto_dimen2_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.view.custom.CustomAutoScaleLineView
        android:id="@+id/casl_scale_line"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/auto_dimen2_32"
        android:layout_marginRight="@dimen/auto_dimen2_24"
        android:layout_marginBottom="@dimen/auto_dimen2_6"
        app:layout_constraintBottom_toTopOf="@+id/ca_autologo"
        app:layout_constraintEnd_toStartOf="@+id/cbc_search"/>
    <com.autonavi.view.custom.CustomAutologoView
        android:id="@+id/ca_autologo"
        android:background="@color/auto_map_light_logo_bg"
        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_12"
        android:layout_marginBottom="@dimen/auto_dimen2_2"
        app:background4Night="@color/auto_map_dark_logo_bg"
        app:background4Skin="@color/auto_map_light_logo_bg"
        app:layout_constraintBottom_toBottomOf="@+id/cbc_search"
        app:layout_constraintEnd_toEndOf="@+id/casl_scale_line"/>
</com.autonavi.skin.view.SkinConstraintLayout>
