        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_48"
        android:layout_marginTop="@dimen/auto_dimen2_10"
        android:layout_marginEnd="@dimen/auto_dimen2_8"
        app:background4Night="@drawable/byd_setting_dark_navigation_bimianyongdu_select"
        app:background4Skin="@drawable/byd_setting_day_navigation_bimianyongdu_select"
        app:layout_constraintEnd_toEndOf="@+id/setting_navi_bcv_avoid_jan"
        app:layout_constraintTop_toTopOf="@+id/setting_navi_bcv_avoid_jan"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_bcv_fastest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="setting_navi_bcv_fastest,setting_navi_fastest_text,setting_navi_fastest_image"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_bcv_big_road"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="setting_navi_bcv_big_road,setting_navi_big_road_text,setting_navi_big_road_image"/>
    <com.autonavi.view.custom.CustomBtnCheckbox1View
        android:id="@+id/setting_navi_bcv_using_highway"
        android:layout_width="@dimen/auto_dimen2_0"
        android:layout_height="@dimen/auto_dimen2_78"
        android:layout_marginStart="@dimen/auto_dimen2_4"
        app:custom_card_backgroud="@drawable/byd_custom_setting_bg_item_prot_night_select"
        app:custom_card_portrait="true"
        app:layout_constraintEnd_toEndOf="@+id/setting_navi_bcv_avoid_highway"
        app:layout_constraintStart_toEndOf="@+id/setting_navi_bcv_fastest"
        app:layout_constraintTop_toTopOf="@+id/setting_navi_bcv_fastest"/>
