<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_bg"
        android:background="@drawable/icon_continue_pop_right_day_background"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_51"
        app:background4Night="@drawable/icon_continue_pop_right_day_background"
        app:background4Skin="@drawable/icon_continue_pop_right_day_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/auto_color_24313F"
        android:gravity="center_vertical"
        android:id="@+id/stv_poi_index"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_14"
        android:layout_marginStart="@dimen/auto_dimen2_18"
        app:layout_constraintEnd_toStartOf="@+id/siv_poi_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_poi_icon"
        android:background="@drawable/icon_global_image_continue_charge_default"
        android:layout_width="@dimen/auto_dimen2_32"
        android:layout_height="@dimen/auto_dimen2_32"
        android:layout_marginTop="@dimen/auto_dimen2_6"
        android:layout_marginBottom="@dimen/auto_dimen2_14"
        android:layout_marginStart="@dimen/auto_dimen2_2"
        app:layout_constraintBottom_toBottomOf="@+id/siv_bg"
        app:layout_constraintStart_toEndOf="@+id/stv_poi_index"
        app:layout_constraintTop_toTopOf="@+id/siv_bg"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_16"
        android:textColor="@color/auto_color_24313F"
        android:gravity="center_vertical"
        android:id="@+id/stv_via_charge_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_8"
        android:minHeight="@dimen/auto_dimen2_28"
        android:paddingEnd="@dimen/auto_dimen2_8"
        android:layout_marginStart="@dimen/auto_dimen2_4"
        app:layout_constraintBottom_toTopOf="@+id/stv_via_charge_percent"
        app:layout_constraintStart_toEndOf="@+id/siv_poi_icon"
        app:layout_constraintTop_toTopOf="@+id/siv_bg"/>
</com.autonavi.skin.view.SkinConstraintLayout>
