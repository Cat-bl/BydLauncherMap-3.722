<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_pressed="true"
        android:drawable="@drawable/custom_card_bottom_round_bg_pressed_night_denza"/>
    <item android:state_enabled="true">
        <shape android:shape="rectangle">
            <corners
                android:bottomLeftRadius="@dimen/auto_dimen2_8"
                android:bottomRightRadius="@dimen/auto_dimen2_8"/>
            <solid android:color="@color/transparent_color"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners
                android:bottomLeftRadius="@dimen/auto_dimen2_8"
                android:bottomRightRadius="@dimen/auto_dimen2_8"/>
            <solid android:color="@color/custom_night_btn_color_disabled_denza"/>
        </shape>
    </item>
</selector>
