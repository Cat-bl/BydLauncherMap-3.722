<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_keyboard_key_background_night_pressed"/>
            <corners android:radius="@dimen/auto_dimen2_16"/>
            <stroke
                android:width="@dimen/auto_font_size_1"
                android:color="@color/color_keyboard_key_background_stroke_night_pressed"/>
        </shape>
    </item>
    <item android:state_pressed="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_keyboard_key_background_night"/>
            <corners android:radius="@dimen/auto_dimen2_16"/>
            <stroke
                android:width="@dimen/auto_font_size_1"
                android:color="@color/color_keyboard_key_background_stroke_night"/>
        </shape>
    </item>
</selector>
