<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/auto_dimen2_8" />
            <gradient android:startColor="#99464d5c" android:endColor="#99464d5c" android:angle="180.0" android:centerX="0.5" />
        </shape>
    </item>
    <item android:state_pressed="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/auto_dimen2_8" />
            <gradient android:startColor="#ff11161c" android:endColor="#ff192029" android:angle="180.0" android:centerX="0.5" />
        </shape>
    </item>
</selector>
