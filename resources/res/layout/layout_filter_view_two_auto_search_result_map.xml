<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_filter_view_two"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_20"
        android:textColor="@color/byd_search_text_day_85"
        android:gravity="left"
        android:id="@+id/stv_text_filer_tittle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_29"
        android:text="@string/auto_search_result_map_text_filer_tittle"
        android:lineSpacingExtra="@dimen/auto_dimen2_4"
        android:layout_marginStart="@dimen/auto_dimen2_32"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:textColor4Night="@color/byd_search_text_night_85"
        app:textColor4Skin="@color/byd_search_text_day_85"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/clp_filter_close_hotspot"
        android:layout_width="@dimen/auto_dimen2_80"
        android:layout_height="@dimen/auto_dimen2_80"
        android:contentDescription="关闭"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_filter_close"
        android:background="@drawable/icon_common_close_day"
        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_48"
        app:background4Night="@drawable/icon_common_close_night"
        app:background4Skin="@drawable/icon_common_close_day"
        app:layout_constraintBottom_toBottomOf="@+id/clp_filter_close_hotspot"
        app:layout_constraintEnd_toEndOf="@+id/clp_filter_close_hotspot"
        app:layout_constraintStart_toStartOf="@+id/clp_filter_close_hotspot"
        app:layout_constraintTop_toTopOf="@+id/clp_filter_close_hotspot"/>
    <com.autonavi.skin.view.SkinGridView
        android:gravity="center"
        android:id="@+id/sgv_screening_two"
        android:scrollbars="vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/auto_dimen2_48"
        android:layout_marginBottom="@dimen/auto_dimen2_24"
        android:listSelector="@android:color/transparent"
        android:cacheColorHint="@color/auto_ui_000000_00"
        android:horizontalSpacing="@dimen/auto_dimen2_60"
        android:verticalSpacing="@dimen/auto_dimen2_24"
        android:numColumns="2"
        android:layout_marginStart="@dimen/auto_dimen2_32"
        android:layout_marginEnd="@dimen/auto_dimen2_33"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/siv_filter_close"/>
</com.autonavi.skin.view.SkinConstraintLayout>
