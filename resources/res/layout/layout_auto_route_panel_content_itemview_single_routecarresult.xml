<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_auto_route_panel_content_itemview_single"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_auto_route_panel_content"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_120"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.view.custom.CustomContentSelectedView
            android:id="@+id/ccs_item_bg"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginRight="@dimen/auto_dimen2_1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/cl_auto_route_panel_content_detail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/auto_dimen2_24"
            android:layout_marginRight="@dimen/auto_dimen2_40"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_24"
                android:textColor="@color/text_450_1_textcolor_day_selector"
                android:gravity="left"
                android:id="@+id/stv_auto_panel_content_route_pref"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/routecarresult_auto_panel_content_route_pref"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:textColor4Night="@color/text_450_1_textcolor_night_selector"
                app:textColor4Skin="@color/text_450_1_textcolor_day_selector"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_30"
                android:textColor="@color/text_450_2_textcolor_day_selector"
                android:ellipsize="end"
                android:gravity="left"
                android:id="@+id/stv_auto_panel_content_time_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auto_dimen2_42"
                android:text="@string/routecarresult_auto_panel_content_time_des"
                android:singleLine="true"
                android:lineSpacingExtra="@dimen/auto_dimen2_9"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:textColor4Night="@color/text_450_2_textcolor_night_selector"
                app:textColor4Skin="@color/text_450_2_textcolor_day_selector"/>
            <com.autonavi.view.custom.CustomVerticalLineView
                android:id="@+id/cvl_text_line"
                android:layout_width="@dimen/auto_dimen2_2"
                android:layout_height="0dp"
                android:layout_marginLeft="@dimen/auto_dimen2_15"
                android:layout_marginBottom="@dimen/auto_dimen2_4"
                app:layout_constraintBottom_toBottomOf="@+id/stv_auto_panel_content_time_des"
                app:layout_constraintStart_toEndOf="@+id/stv_auto_panel_content_time_des"
                app:layout_constraintTop_toTopOf="@+id/stv_auto_panel_content_time_des"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_24"
                android:textColor="@color/text_450_2_textcolor_day_selector"
                android:gravity="left"
                android:id="@+id/stv_auto_panel_content_distance_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/auto_dimen2_17"
                android:text="@string/routecarresult_auto_panel_content_distance_des"
                android:lineSpacingExtra="@dimen/auto_dimen2_5"
                app:layout_constraintBottom_toBottomOf="@+id/stv_auto_panel_content_time_des"
                app:layout_constraintStart_toEndOf="@+id/cvl_text_line"
                app:layout_constraintTop_toTopOf="@+id/stv_auto_panel_content_time_des"
                app:textColor4Night="@color/text_450_2_textcolor_night_selector"
                app:textColor4Skin="@color/text_450_2_textcolor_day_selector"/>
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/siv_icon_traffic_light"
                android:background="@drawable/routecarresult_icon_traffic_light_day_bg_selector"
                android:layout_width="@dimen/auto_dimen2_18"
                android:layout_height="@dimen/auto_dimen2_18"
                android:layout_marginLeft="@dimen/auto_dimen2_8"
                android:layout_marginBottom="@dimen/auto_dimen2_4"
                app:background4Night="@drawable/routecarresult_icon_traffic_light_night_bg_selector"
                app:background4Skin="@drawable/routecarresult_icon_traffic_light_day_bg_selector"
                app:layout_constraintBottom_toBottomOf="@+id/stv_auto_panel_content_distance_des"
                app:layout_constraintStart_toEndOf="@+id/stv_auto_panel_content_fee_des"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_24"
                android:textColor="@color/text_450_2_textcolor_day_selector"
                android:gravity="left"
                android:id="@+id/stv_auto_panel_content_traffic_des"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/auto_dimen2_4"
                android:text="@string/routecarresult_auto_panel_content_traffic_des"
                app:layout_constraintBottom_toBottomOf="@+id/stv_auto_panel_content_time_des"
                app:layout_constraintStart_toEndOf="@+id/siv_icon_traffic_light"
                app:layout_constraintTop_toTopOf="@+id/stv_auto_panel_content_time_des"
                app:textColor4Night="@color/text_450_2_textcolor_night_selector"
                app:textColor4Skin="@color/text_450_2_textcolor_day_selector"/>
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/siv_icon_yuan"
                android:background="@drawable/routecarresult_icon_yuan_day_bg_selector"
                android:layout_width="@dimen/auto_dimen2_20"
                android:layout_height="@dimen/auto_dimen2_20"
                android:layout_marginLeft="@dimen/auto_dimen2_6"
                android:layout_marginBottom="@dimen/auto_dimen2_4"
                app:background4Night="@drawable/routecarresult_icon_yuan_night_bg_selector"
                app:background4Skin="@drawable/routecarresult_icon_yuan_day_bg_selector"
                app:layout_constraintBottom_toBottomOf="@+id/stv_auto_panel_content_distance_des"
                app:layout_constraintStart_toEndOf="@+id/stv_auto_panel_content_distance_des"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_24"
                android:textColor="@color/text_450_2_textcolor_day_selector"
                android:ellipsize="end"
                android:gravity="left"
                android:id="@+id/stv_auto_panel_content_fee_des"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/auto_dimen2_4"
                android:text="@string/routecarresult_auto_panel_content_fee_des"
                android:singleLine="true"
                app:layout_constraintBottom_toBottomOf="@+id/stv_auto_panel_content_time_des"
                app:layout_constraintStart_toEndOf="@+id/siv_icon_yuan"
                app:layout_constraintTop_toTopOf="@+id/stv_auto_panel_content_time_des"
                app:textColor4Night="@color/text_450_2_textcolor_night_selector"
                app:textColor4Skin="@color/text_450_2_textcolor_day_selector"/>
            <com.autonavi.skin.view.SkinImageView
                android:id="@+id/siv_icon_dnp"
                android:layout_width="@dimen/auto_dimen2_20"
                android:layout_height="@dimen/auto_dimen2_20"
                android:layout_marginStart="@dimen/auto_dimen2_8"
                app:layout_constraintBottom_toBottomOf="@+id/siv_text_dnp"
                app:layout_constraintStart_toEndOf="@+id/stv_auto_panel_content_traffic_des"
                app:layout_constraintTop_toTopOf="@+id/siv_text_dnp"/>
            <com.autonavi.skin.view.SkinTextView
                android:textSize="@dimen/auto_font_size_18"
                android:textColor="@color/custom_route_textcolor_btn_text_day"
                android:gravity="left"
                android:id="@+id/siv_text_dnp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/auto_dimen2_2"
                app:layout_constraintBottom_toBottomOf="@+id/stv_auto_panel_content_traffic_des"
                app:layout_constraintStart_toEndOf="@+id/siv_icon_dnp"
                app:layout_constraintTop_toTopOf="@+id/stv_auto_panel_content_traffic_des"
                app:textColor4Night="@color/custom_route_textcolor_btn_text_night"
                app:textColor4Skin="@color/custom_route_textcolor_btn_text_day"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/siv_dnp_group"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="siv_text_dnp,siv_icon_dnp"/>
        </com.autonavi.skin.view.SkinConstraintLayout>
    </com.autonavi.skin.view.SkinConstraintLayout>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_auto_panel_content_detail_icon_closed"
        android:background="@drawable/routecarresult_auto_panel_content_detail_icon_closed"
        android:layout_width="@dimen/auto_dimen2_40"
        android:layout_height="@dimen/auto_dimen2_40"
        android:contentDescription="更多"
        app:background4Skin="@drawable/routecarresult_auto_panel_content_detail_icon_closed"
        app:layout_constraintBottom_toBottomOf="@+id/cl_auto_route_panel_content"
        app:layout_constraintEnd_toEndOf="@+id/cl_auto_route_panel_content"
        app:layout_constraintTop_toTopOf="@+id/cl_auto_route_panel_content"/>
</com.autonavi.skin.view.SkinConstraintLayout>
