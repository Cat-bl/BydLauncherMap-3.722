<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_custom_bar_title_noback"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_light1"
        android:background="@drawable/custom_bar_title_noback_light1_day_bg_selector"
        android:layout_width="0dp"
        android:layout_height="@dimen/auto_dimen2_2"
        app:background4Night="@drawable/custom_bar_title_noback_light1_night_bg_selector"
        app:background4Skin="@drawable/custom_bar_title_noback_light1_day_bg_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_light2"
        android:background="@drawable/custom_bar_title_noback_light2_day_bg_selector"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:background4Night="@drawable/custom_bar_title_noback_light2_night_bg_selector"
        app:background4Skin="@drawable/custom_bar_title_noback_light2_day_bg_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_light3"
        android:background="@drawable/custom_bar_title_noback_light3_day"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/auto_dimen2_34"
        app:background4Night="@drawable/custom_bar_title_noback_light3_night"
        app:background4Skin="@drawable/custom_bar_title_noback_light3_day"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
