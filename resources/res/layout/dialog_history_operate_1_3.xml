<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_dialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_center"
        android:layout_width="@dimen/auto_dimen2_196"
        android:layout_height="@dimen/auto_dimen2_154"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.skin.view.SkinConstraintLayout
            android:id="@+id/cd_bg"
            android:background="@drawable/custom_history_operate_bg_day"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:background4Night="@drawable/custom_history_operate_bg_night"
            app:background4Skin="@drawable/custom_history_operate_bg_day"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_18"
            android:textColor="@color/byd_dialog_history_operate_text_day"
            android:gravity="center"
            android:id="@+id/stv_item2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="删除记录"
            app:layout_constraintBottom_toTopOf="@+id/stv_item1"
            app:layout_constraintEnd_toEndOf="@+id/cd_bg"
            app:layout_constraintStart_toStartOf="@+id/cd_bg"
            app:layout_constraintTop_toTopOf="@+id/cd_bg"
            app:textColor4Night="@color/byd_dialog_history_operate_text_night"
            app:textColor4Skin="@color/byd_dialog_history_operate_text_day"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_18"
            android:textColor="@color/byd_dialog_history_operate_text_day"
            android:gravity="center"
            android:id="@+id/stv_item1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="收藏"
            app:layout_constraintBottom_toBottomOf="@+id/cd_bg"
            app:layout_constraintEnd_toEndOf="@+id/cd_bg"
            app:layout_constraintStart_toStartOf="@+id/cd_bg"
            app:layout_constraintTop_toBottomOf="@+id/stv_item2"
            app:textColor4Night="@color/byd_dialog_history_operate_text_night"
            app:textColor4Skin="@color/byd_dialog_history_operate_text_day"/>
        <com.autonavi.skin.view.SkinView
            android:id="@+id/cll_item_bottom_line"
            android:background="@color/byd_search_home_common_line_day"
            android:layout_width="0dp"
            android:layout_height="@dimen/auto_dimen2_1"
            android:layout_marginLeft="@dimen/auto_dimen2_18"
            android:layout_marginRight="@dimen/auto_dimen2_18"
            app:background4Night="@color/byd_search_home_common_line_day"
            app:background4Skin="@color/byd_search_home_common_line_day"
            app:layout_constraintBottom_toTopOf="@+id/stv_item2"
            app:layout_constraintEnd_toEndOf="@+id/cd_bg"
            app:layout_constraintStart_toStartOf="@+id/cd_bg"
            app:layout_constraintTop_toBottomOf="@+id/stv_item1"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
