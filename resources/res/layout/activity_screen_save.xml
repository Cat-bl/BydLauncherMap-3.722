<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/screen_3d_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/mScreenSaver"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="90dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.autonavi.skin.view.SkinTextView
            android:textColor="@color/byg_btn_system_gray_text_color_selector_night"
            android:gravity="center"
            android:id="@+id/mBtnUse"
            android:background="@drawable/byg_btn_system_gray"
            android:visibility="gone"
            android:layout_width="176dp"
            android:layout_height="48dp"
            android:text="@string/screen_save_btn_apply"
            android:textAllCaps="false"
            android:layout_marginEnd="16dp"
            app:background4Night="@drawable/byg_btn_system_gray"
            app:background4Skin="@drawable/byg_btn_system_gray"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/guideline"
            app:textColor4Night="@color/byg_btn_system_gray_text_color_selector_night"
            app:textColor4Skin="@color/byg_btn_system_gray_text_color_selector_night"
            style="@style/Sys.TextAppearance.Body1"/>
        <com.autonavi.skin.view.SkinTextView
            android:textColor="@color/byg_btn_system_black_text_color_selector_night"
            android:gravity="center"
            android:id="@+id/mBtnCancel"
            android:background="@drawable/byg_btn_system_black"
            android:visibility="gone"
            android:layout_width="176dp"
            android:layout_height="48dp"
            android:text="@string/screen_save_btn_cancel"
            android:textAllCaps="false"
            android:layout_marginStart="16dp"
            app:background4Night="@drawable/byg_btn_system_black"
            app:background4Skin="@drawable/byg_btn_system_black"
            app:layout_constraintBottom_toBottomOf="@+id/mBtnUse"
            app:layout_constraintStart_toEndOf="@+id/guideline"
            app:textColor4Night="@color/byg_btn_system_black_text_color_selector_night"
            app:textColor4Skin="@color/byg_btn_system_black_text_color_selector_night"
            style="@style/Sys.TextAppearance.Body1"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
