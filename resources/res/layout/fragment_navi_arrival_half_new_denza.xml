                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ic_park"
                        app:layout_constraintTop_toTopOf="@+id/ic_park"
                        app:textColor4Night="@color/dest_arrival_text_night"
                        app:textColor4Skin="@color/dest_arrival_text_day"/>
                </com.autonavi.skin.view.SkinConstraintLayout>
