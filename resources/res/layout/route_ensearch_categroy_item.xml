<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:background="@drawable/search_more_child_image_item_bg_day_selector"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:background4Night="@drawable/search_more_child_image_item_bg_night_selector"
    app:background4Skin="@drawable/search_more_child_image_item_bg_day_selector">
    <View
        android:id="@+id/ctb_search_along_item_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:orientation="vertical"
        android:id="@+id/cl_search_along_item_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.autonavi.skin.view.SkinImageView
            android:background="@drawable/global_bg_radius_circle_bg_day"
            android:layout_width="@dimen/auto_dimen2_80"
            android:layout_height="@dimen/auto_dimen2_80"
            android:layout_marginTop="@dimen/auto_dimen2_4"
            app:background4Night="@color/transparent_color"
            app:background4Skin="@drawable/global_bg_radius_circle_bg_day"
            app:layout_constraintBottom_toBottomOf="@+id/siv_search_along_item_icon"
            app:layout_constraintEnd_toEndOf="@+id/siv_search_along_item_icon"
            app:layout_constraintStart_toStartOf="@+id/siv_search_along_item_icon"
            app:layout_constraintTop_toTopOf="@+id/siv_search_along_item_icon"/>
        <com.autonavi.skin.view.SkinImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/siv_search_along_item_icon"
            android:background="@drawable/global_bg_radius_circle_day"
            android:padding="@dimen/auto_dimen2_8"
            android:layout_width="@dimen/auto_dimen2_64"
            android:layout_height="@dimen/auto_dimen2_64"
            android:layout_marginTop="@dimen/auto_dimen2_8"
            android:src="@drawable/icon_routecarresult_gas_station_day"
            app:background4Night="@drawable/global_bg_radius_circle_night"
            app:background4Skin="@drawable/global_bg_radius_circle_day"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:src4Night="@drawable/icon_routecarresult_gas_station_night"
            app:src4Skin="@drawable/icon_routecarresult_gas_station_day"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_16"
            android:textColor="@color/byd_custom_btn_medium_secondary_text_color_selector_day"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/stv_search_along_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_4"
            android:maxWidth="@dimen/auto_dimen2_64"
            android:text="@string/routecarresult_gas_station"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/siv_search_along_item_icon"
            app:textColor4Night="@color/byd_custom_btn_medium_secondary_text_color_selector_night"
            app:textColor4Skin="@color/byd_custom_btn_medium_secondary_text_color_selector_day"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
