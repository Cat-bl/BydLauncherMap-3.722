<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.autonavi.skin.view.SkinTextView
        android:id="@+id/setting_navi_roadline_bg"
        android:background="@drawable/byd_custom_setting_bg_land_day"
        android:layout_width="match_parent"
        android:layout_height="@dimen/auto_dimen2_244"
        app:background4Night="@drawable/byd_custom_setting_bg_land_night"
        app:background4Skin="@drawable/byd_custom_setting_bg_land_day"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_20"
        android:textColor="@color/byd_text_FF262D33"
        android:gravity="center"
        android:id="@+id/setting_navi_tv_roadline"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/auto_dimen2_28"
        android:layout_marginTop="@dimen/auto_dimen2_16"
        android:text="@string/settings_navi_routeplan"
        android:layout_marginStart="@dimen/auto_dimen2_24"
        app:layout_constraintStart_toStartOf="@+id/setting_navi_roadline_bg"
        app:layout_constraintTop_toTopOf="@+id/setting_navi_roadline_bg"
        app:textColor4Night="@color/byd_text_FFDAE1EB"
        app:textColor4Skin="@color/byd_text_FF262D33"/>
    <com.autonavi.view.custom.CustomBtnCheckbox1View
        android:id="@+id/setting_navi_recommond_route"
        android:layout_width="@dimen/auto_dimen2_118"
        android:layout_height="@dimen/auto_dimen2_160"
        android:layout_marginTop="@dimen/auto_dimen2_18"
        app:custom_card_backgroud="@drawable/byd_custom_setting_bg_item_prot_night_select"
        app:custom_card_portrait="true"
        app:layout_constraintStart_toStartOf="@+id/setting_navi_tv_roadline"
        app:layout_constraintTop_toBottomOf="@+id/setting_navi_tv_roadline"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_20"
        android:textColor="@color/byd_custom_setting_station_color_day"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/setting_navi_recommend_text"
        android:layout_width="@dimen/auto_dimen2_118"
        android:layout_height="@dimen/auto_dimen2_28"
        android:layout_marginTop="@dimen/auto_dimen2_8"
        android:text="@string/autorouteplansetting_text_recommend"
        android:singleLine="true"
        android:lineSpacingExtra="@dimen/auto_dimen2_12"
        app:layout_constraintEnd_toEndOf="@+id/setting_navi_recommond_route"
        app:layout_constraintStart_toStartOf="@+id/setting_navi_recommond_route"
        app:layout_constraintTop_toBottomOf="@+id/setting_navi_recommend_image"
        app:textColor4Night="@color/byd_custom_setting_station_color"
        app:textColor4Skin="@color/byd_custom_setting_station_color_day"/>
    <com.autonavi.skin.view.SkinImageView
        android:gravity="center"
        android:id="@+id/setting_navi_recommend_image"
        android:background="@drawable/byd_setting_day_navigation_smart_select"
        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_48"
        android:layout_marginTop="@dimen/auto_dimen2_34"
        app:background4Night="@drawable/byd_setting_dark_navigation_smart_select"
        app:background4Skin="@drawable/byd_setting_day_navigation_smart_select"
        app:layout_constraintEnd_toEndOf="@+id/setting_navi_recommond_route"
        app:layout_constraintStart_toStartOf="@+id/setting_navi_recommond_route"
        app:layout_constraintTop_toTopOf="@+id/setting_navi_recommond_route"/>
    <com.autonavi.view.custom.CustomBtnCheckbox1View
        android:id="@+id/setting_navi_bcv_avoid_jan"
        android:layout_width="@dimen/auto_dimen2_0"
        android:layout_height="@dimen/auto_dimen2_78"
        android:layout_marginStart="@dimen/auto_dimen2_4"
        app:custom_card_backgroud="@drawable/byd_custom_setting_bg_item_prot_night_select"
        app:custom_card_portrait="true"
        app:layout_constraintEnd_toStartOf="@+id/setting_navi_bcv_avoid_highway"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/setting_navi_bcv_avoid_charge"
        app:layout_constraintTop_toTopOf="@+id/setting_navi_bcv_avoid_charge"/>
