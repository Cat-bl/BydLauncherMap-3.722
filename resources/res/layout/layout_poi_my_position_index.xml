<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_poi_my_position"
    android:background="@drawable/search_panel_view_bg_day"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:background4Night="@drawable/search_panel_view_bg_night"
    app:background4Skin="@drawable/search_panel_view_bg_day"
    app:designHeight="600"
    app:designWidth="1024"
    style="@style/custom_card_shadow_style">
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_close_icon"
        android:layout_width="@dimen/auto_dimen2_48"
        android:layout_height="@dimen/auto_dimen2_48"
        android:layout_marginTop="@dimen/auto_dimen2_8"
        android:src="@drawable/icon_light_public_close_s_48"
        android:tint="@color/byd_search_text_day"
        android:contentDescription="关闭"
        android:layout_marginEnd="@dimen/auto_dimen2_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint4Night="@color/byd_search_text_night"
        app:tint4Skin="@color/byd_search_text_day"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_20"
        android:textColor="@color/byd_search_text_day"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/stv_text_my_position"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/index_text_my_position"
        android:maxLines="4"
        android:layout_marginStart="@dimen/auto_dimen2_24"
        android:layout_marginEnd="@dimen/auto_dimen2_24"
        app:layout_constraintBottom_toBottomOf="@+id/siv_close_icon"
        app:layout_constraintEnd_toStartOf="@+id/siv_close_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/siv_close_icon"
        app:textColor4Night="@color/byd_search_text_night"
        app:textColor4Skin="@color/byd_search_text_day"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/byd_search_home_item_sub_tip_day"
        android:gravity="start"
        android:id="@+id/stv_text_address_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auto_dimen2_8"
        android:layout_marginStart="@dimen/auto_dimen2_24"
        android:layout_marginEnd="@dimen/auto_dimen2_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stv_text_my_position"
        app:textColor4Night="@color/byd_search_home_item_sub_tip_night"
        app:textColor4Skin="@color/byd_search_home_item_sub_tip_day"/>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_lookuptheperiphery"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/auto_dimen2_48"
        android:layout_marginTop="@dimen/auto_dimen2_16"
        android:layout_marginBottom="@dimen/auto_dimen2_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="@+id/stv_text_address_details"
        app:layout_constraintTop_toBottomOf="@+id/stv_text_address_details"
        app:tag="DisableAtRunTime">
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/button_text_search_and_collect"
            android:textColor="@color/byd_search_text_day"
            android:gravity="center"
            android:id="@+id/stv_text_lookuptheperiphery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/index_text_lookuptheperiphery"
            android:layout_marginStart="@dimen/auto_dimen2_6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/siv_search"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/byd_search_text_night"
            app:textColor4Skin="@color/byd_search_text_day"/>
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/siv_search"
            android:background="@drawable/icon_light_public_search"
            android:layout_width="@dimen/auto_dimen2_48"
            android:layout_height="@dimen/auto_dimen2_48"
            app:background4Night="@drawable/icon_dark_public_search"
            app:background4Skin="@drawable/icon_light_public_search"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/stv_text_lookuptheperiphery"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
    <com.autonavi.skin.view.SkinConstraintLayout
        android:id="@+id/cl_collection"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/auto_dimen2_48"
        android:layout_marginStart="@dimen/sys_padding_l"
        app:layout_constraintBottom_toBottomOf="@+id/cl_lookuptheperiphery"
        app:layout_constraintStart_toEndOf="@+id/cl_lookuptheperiphery"
        app:layout_constraintTop_toTopOf="@+id/cl_lookuptheperiphery">
        <com.autonavi.skin.view.SkinImageView
            android:id="@+id/siv_collection"
            android:background="@drawable/icon_collection_normal"
            android:layout_width="@dimen/auto_dimen2_48"
            android:layout_height="@dimen/auto_dimen2_48"
            android:contentDescription="收藏&amp;取消收藏"
            app:background4Night="@drawable/icon_collection_normal_night"
            app:background4Skin="@drawable/icon_collection_normal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/stv_text_collection"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/button_text_search_and_collect"
            android:textColor="@color/byd_search_text_day"
            android:gravity="left"
            android:id="@+id/stv_text_collection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/auto_dimen2_60"
            android:text="@string/index_text_collection"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:textColor4Night="@color/byd_search_text_night"
            app:textColor4Skin="@color/byd_search_text_day"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.skin.view.SkinConstraintLayout>
