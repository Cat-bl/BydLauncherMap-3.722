<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_custom_download_percent_bar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinProgressBar
        android:id="@+id/spb_download"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:max="100"
        android:progress="100"
        android:indeterminateOnly="false"
        android:progressDrawable="@drawable/byd_custom_bar_downloading1_loading2_night_layerlist_fui"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:progressDrawable4Night="@drawable/byd_custom_bar_downloading1_loading2_night_layerlist_fui"
        app:progressDrawable4Skin="@drawable/byd_custom_bar_downloading1_loading2_night_layerlist_fui"
        style="?android:attr/progressBarStyleHorizontal"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/siv_download_status1"
        android:visibility="gone"
        android:layout_width="@dimen/auto_dimen2_32"
        android:layout_height="@dimen/auto_dimen2_32"
        android:src="@drawable/byd_custom_bar_downloading1_loading2_progress_img_selector_day"
        android:layout_marginEnd="@dimen/auto_dimen2_2"
        app:layout_constraintBottom_toBottomOf="@+id/spb_download"
        app:layout_constraintEnd_toStartOf="@+id/stv_download_status"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/spb_download"
        app:layout_constraintTop_toTopOf="@+id/spb_download"
        app:src4Night="@drawable/byd_custom_bar_downloading1_loading2_progress_img_selector_night"
        app:src4Skin="@drawable/byd_custom_bar_downloading1_loading2_progress_img_selector_day"/>
    <com.autonavi.skin.view.SkinImageView
        android:gravity="center"
        android:id="@+id/siv_download_status"
        android:background="@drawable/byd_custom_bar_downloading1_loading2_progress_presses_night"
        android:layout_width="@dimen/auto_dimen2_160"
        android:layout_height="@dimen/auto_dimen2_48"
        app:background4Night="@drawable/byd_custom_bar_downloading1_loading2_progress_presses_night"
        app:background4Skin="@drawable/byd_custom_bar_downloading1_loading2_progress_presses_night"
        app:layout_constraintBottom_toBottomOf="@+id/spb_download"
        app:layout_constraintEnd_toEndOf="@+id/spb_download"
        app:layout_constraintStart_toStartOf="@+id/spb_download"
        app:layout_constraintTop_toTopOf="@+id/spb_download"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/byd_text_450_6_textcolor_day_pressed"
        android:gravity="center"
        android:id="@+id/stv_download_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/auto_dimen2_34"
        android:text="@string/play_download"
        app:layout_constraintBottom_toBottomOf="@+id/spb_download"
        app:layout_constraintEnd_toEndOf="@+id/spb_download"
        app:layout_constraintStart_toStartOf="@+id/spb_download"
        app:layout_constraintTop_toTopOf="@+id/spb_download"
        app:textColor4Night="@color/custom_text_night_color_86"
        app:textColor4Skin="@color/byd_text_450_6_textcolor_day_pressed"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_18"
        android:textColor="@color/byd_text_450_6_textcolor_day_pressed"
        android:gravity="center"
        android:id="@+id/stv_download_status_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/auto_dimen2_34"
        app:layout_constraintBottom_toBottomOf="@+id/spb_download"
        app:layout_constraintEnd_toEndOf="@+id/spb_download"
        app:layout_constraintStart_toStartOf="@+id/spb_download"
        app:layout_constraintTop_toTopOf="@+id/spb_download"
        app:textColor4Night="@color/custom_text_night_color_87"
        app:textColor4Skin="@color/byd_text_450_6_textcolor_day_pressed"/>
</merge>
