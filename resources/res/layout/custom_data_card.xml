<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_custom_data_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.view.custom.CustomFunctionEntranceBgView
        android:id="@+id/cfeb_more"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/auto_dimen2_15"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.autonavi.skin.view.SkinImageView
        android:id="@+id/img_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/global_image_default_path_weather_200_201_202_203_204_big_icon_normal"
        app:layout_constraintBottom_toBottomOf="@+id/cfeb_more"
        app:layout_constraintEnd_toEndOf="@+id/cfeb_more"
        app:layout_constraintHeight_percent="0.3"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@+id/cfeb_more"
        app:layout_constraintTop_toTopOf="@+id/cfeb_more"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintWidth_percent="0.3"/>
    <com.autonavi.auto.common.view.AutoGuideLine
        android:orientation="horizontal"
        android:id="@+id/gl_cstm_data_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.4"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_26"
        android:textColor="@color/custom_btn_switch_text_close_textcolor_day_selector"
        android:id="@+id/stv_text_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/auto_dimen2_24"
        android:layout_marginTop="@dimen/auto_dimen2_24"
        android:layout_marginRight="@dimen/auto_dimen2_24"
        app:layout_constraintBottom_toTopOf="@+id/stv_text_subtitle"
        app:layout_constraintEnd_toEndOf="@+id/cfeb_more"
        app:layout_constraintStart_toStartOf="@+id/cfeb_more"
        app:layout_constraintTop_toTopOf="@+id/cfeb_more"
        app:textColor4Night="@color/custom_btn_switch_text_close_textcolor_night_selector"
        app:textColor4Skin="@color/custom_btn_switch_text_close_textcolor_day_selector"/>
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_22"
        android:textColor="@color/custom_btn_switch_text_close_textcolor_day_selector"
        android:id="@+id/stv_text_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/auto_dimen2_24"
        android:layout_marginTop="@dimen/auto_dimen2_10"
        android:layout_marginRight="@dimen/auto_dimen2_24"
        app:layout_constraintBottom_toTopOf="@+id/gl_cstm_data_card"
        app:layout_constraintEnd_toEndOf="@+id/stv_text_title"
        app:layout_constraintStart_toStartOf="@+id/cfeb_more"
        app:layout_constraintTop_toBottomOf="@+id/stv_text_title"
        app:textColor4Night="@color/custom_btn_switch_text_close_textcolor_night_selector"
        app:textColor4Skin="@color/custom_btn_switch_text_close_textcolor_day_selector"/>
</merge>
