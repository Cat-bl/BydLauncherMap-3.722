<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.skin.view.SkinLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/plate_item_layout"
    android:layout_width="@dimen/auto_dimen2_100"
    android:layout_height="@dimen/auto_dimen2_96">
    <com.autonavi.skin.view.SkinTextView
        android:textSize="@dimen/auto_font_size_half_32"
        android:textStyle="bold"
        android:textColor="@color/custom_text_day_color"
        android:gravity="center"
        android:id="@+id/item_province"
        android:background="@drawable/user_car_plate_num_day_selecter"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:button="@null"
        android:text="@string/auto_search_around_text_search_font"
        android:lineSpacingExtra="@dimen/auto_dimen2_4"
        app:background4Night="@drawable/user_car_plate_num_night_selecter"
        app:background4Skin="@drawable/user_car_plate_num_day_selecter"
        app:textColor4Night="@color/custom_text_night_color"
        app:textColor4Skin="@color/custom_text_day_color"/>
</com.autonavi.skin.view.SkinLinearLayout>
