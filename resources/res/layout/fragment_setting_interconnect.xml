<?xml version="1.0" encoding="utf-8"?>
<com.autonavi.auto.common.view.BaseScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:scrollbarThumbVertical="@color/auto_color_ffffff_ff"
    android:id="@+id/cl_search_home"
    android:fitsSystemWindows="true"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="always"
    app:designHeight="600"
    app:designWidth="1024">
    <com.autonavi.skin.view.SkinConstraintLayout
        android:orientation="vertical"
        android:id="@+id/cl_setting_interconnection"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.autonavi.skin.view.SkinTextView
            android:id="@+id/setting_interconnect_theme"
            android:background="@drawable/byd_custom_setting_bg_land_day"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auto_dimen2_274"
            app:background4Night="@drawable/byd_custom_setting_bg_land_night"
            app:background4Skin="@drawable/byd_custom_setting_bg_land_day"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_20"
            android:id="@+id/setting_interconnect_theme_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_15"
            android:text="@string/interconnection_index_tip"
            android:layout_marginStart="@dimen/auto_dimen2_24"
            app:layout_constraintStart_toStartOf="@+id/setting_interconnect_theme"
            app:layout_constraintTop_toTopOf="@+id/setting_interconnect_theme"
            style="@style/style_text_color"/>
        <com.autonavi.skin.view.SkinImageView
            android:background="@drawable/img_interconnection_day_land"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auto_dimen2_213"
            android:layout_marginTop="@dimen/auto_dimen2_15"
            android:maxWidth="@dimen/auto_dimen2_620"
            android:layout_marginStart="@dimen/auto_dimen2_24"
            android:layout_marginEnd="@dimen/auto_dimen2_24"
            app:background4Night="@drawable/img_interconnection_night_land"
            app:background4Skin="@drawable/img_interconnection_day_land"
            app:layout_constraintStart_toStartOf="@+id/setting_interconnect_theme"
            app:layout_constraintTop_toBottomOf="@+id/setting_interconnect_theme_title"/>
        <com.autonavi.skin.view.SkinTextView
            android:id="@+id/setting_interconnect_app_theme"
            android:background="@drawable/byd_custom_setting_bg_land_day"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auto_dimen2_140"
            android:layout_marginTop="@dimen/auto_dimen2_16"
            app:background4Night="@drawable/byd_custom_setting_bg_land_night"
            app:background4Skin="@drawable/byd_custom_setting_bg_land_day"
            app:layout_constraintTop_toBottomOf="@+id/setting_interconnect_theme"/>
        <com.autonavi.skin.view.SkinTextView
            android:textSize="@dimen/auto_font_size_20"
            android:id="@+id/setting_interconnect_app_theme_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/auto_dimen2_15"
            android:text="@string/interconnection_use_tip"
            android:layout_marginStart="@dimen/auto_dimen2_24"
            app:layout_constraintStart_toStartOf="@+id/setting_interconnect_app_theme"
            app:layout_constraintTop_toTopOf="@+id/setting_interconnect_app_theme"
            style="@style/style_text_color"/>
        <include
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/auto_dimen2_17"
            android:layout_marginStart="@dimen/auto_dimen2_24"
            app:layout_constraintStart_toStartOf="@+id/setting_interconnect_app_theme_title"
            app:layout_constraintTop_toBottomOf="@+id/setting_interconnect_app_theme_title"
            layout="@layout/interconnection_detail_application_icons_layout"/>
    </com.autonavi.skin.view.SkinConstraintLayout>
</com.autonavi.auto.common.view.BaseScrollView>
